<Project>
  <PropertyGroup>
    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Material Symbols needs SkiaSharp's variable-font instancing API, which first ships in 4.x.
      Avalonia 12.1 declares a pre-4.0 dependency range; this repository deliberately runs it
      against the managed/native version below; render tests guard this override.
    -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.5" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="PropertyGenerator.Avalonia" Version="1.3.1" />
    <PackageVersion Include="IgnoresAccessChecksToGenerator" Version="1.0.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="SkiaSharp" Version="4.154.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="4.154.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.macOS" Version="4.154.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.154.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.154.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />
    <PackageVersion Include="Avalonia.Markup.Xaml.Loader" Version="12.1.5" />
    <PackageVersion Include="HotAvalonia" Version="3.1.4" />
    <PackageVersion Include="Shirasagi0012.MaterialColorUtilities" Version="0.4.0-alpha" />
    <PackageVersion Include="Shirasagi0012.MaterialSymbols.Avalonia.Rounded" Version="0.1.2-alpha" />
  </ItemGroup>
</Project>
