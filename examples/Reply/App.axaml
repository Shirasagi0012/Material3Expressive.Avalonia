<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
             xmlns:styles="clr-namespace:Material3Expressive.Styles;assembly=Material3Expressive"
             xmlns:local="using:Reply"
             x:Class="Reply.App" RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <m3:MaterialResource>
          <local:ReplyColorTokens />
        </m3:MaterialResource>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <styles:MaterialTheme />
    <StyleInclude Source="/ReplyStyles.axaml" />
  </Application.Styles>
</Application>
