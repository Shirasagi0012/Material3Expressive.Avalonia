<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="using:ComposeAnimationRuntime.Demo.Pages"
        x:Class="ComposeAnimationRuntime.Demo.MainWindow"
        Title="Compose Animation Runtime · Catalog"
        Width="1080"
        Height="700"
        MinWidth="820"
        MinHeight="520"
        RequestedThemeVariant="Light"
        Opened="OnOpened">
  <Grid ColumnDefinitions="220,*">
    <Border Grid.Column="0" Background="#F3F4F6" Padding="12">
      <ListBox x:Name="Navigation" SelectedIndex="0">
        <ListBoxItem Content="Overview" />
        <ListBoxItem Content="Spring" />
        <ListBoxItem Content="Decay" />
        <ListBoxItem Content="Keyframes" />
        <ListBoxItem Content="Visibility" />
        <ListBoxItem Content="Transition" />
        <ListBoxItem Content="AnimatedVisibility" />
        <ListBoxItem Content="AnimatedContent" />
        <ListBoxItem Content="AnimatedSize" />
        <ListBoxItem Content="AnimatedBounds" />
        <ListBoxItem Content="GestureSurface" />
        <ListBoxItem Content="Path &amp; Bezier" />
        <ListBoxItem Content="Transition Coordinator" />
        <ListBoxItem Content="SharedBounds" />
        <ListBoxItem Content="SharedElement" />
      </ListBox>
    </Border>
    <Border Grid.Column="1" Padding="28">
      <ContentControl x:Name="PageHost">
        <pages:OverviewPage />
      </ContentControl>
    </Border>
  </Grid>
</Window>
