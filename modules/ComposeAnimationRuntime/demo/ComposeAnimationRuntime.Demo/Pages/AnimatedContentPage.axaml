<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:motion="using:ComposeAnimationRuntime.Avalonia" x:Class="ComposeAnimationRuntime.Demo.Pages.AnimatedContentPage">
  <StackPanel Spacing="12">
    <TextBlock Text="AnimatedContent" FontSize="28" FontWeight="SemiBold" />
    <TextBlock Text="State-driven content transitions use a factory and stable keys." TextWrapping="Wrap" />
    <Separator />
    <motion:AnimatedContent x:Name="ContentAnimator" Height="100" />
    <Button Content="Switch state" HorizontalAlignment="Left" Click="OnSwitch" />
    <TextBlock x:Name="Status" Text="state = A" Foreground="Gray" />
  </StackPanel>
</UserControl>
