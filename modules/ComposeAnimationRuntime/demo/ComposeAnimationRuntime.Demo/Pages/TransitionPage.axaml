<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ComposeAnimationRuntime.Demo.Pages.TransitionPage">
  <StackPanel Spacing="12">
    <TextBlock Text="Transition" FontSize="28" FontWeight="SemiBold" />
    <TextBlock Text="One logical state change coordinates multiple animated values." TextWrapping="Wrap" />
    <Separator />
    <Border Height="240" Background="#F5F6F8" CornerRadius="14">
      <Canvas>
        <Border x:Name="Box" Width="96" Height="96" CornerRadius="20" Background="#D14B72" />
      </Canvas>
    </Border>
    <Button Content="Toggle state" HorizontalAlignment="Left" Click="OnToggle" />
    <TextBlock x:Name="Status" Text="state = resting" Foreground="Gray" />
  </StackPanel>
</UserControl>
