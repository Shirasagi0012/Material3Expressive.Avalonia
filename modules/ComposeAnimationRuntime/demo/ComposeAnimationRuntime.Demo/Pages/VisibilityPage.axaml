<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ComposeAnimationRuntime.Demo.Pages.VisibilityPage">
  <StackPanel Spacing="12">
    <TextBlock Text="Visibility" FontSize="28" FontWeight="SemiBold" />
    <TextBlock Text="Enter and exit motion can retain content while it fades out." TextWrapping="Wrap" />
    <Separator />
    <Border x:Name="Card" Width="260" Height="130" Background="#8C5DE8" CornerRadius="18">
      <TextBlock Text="VisibilityMotion" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Show" Click="OnShow" />
      <Button Content="Hide" Click="OnHide" />
    </StackPanel>
    <TextBlock x:Name="Status" Text="Visible" Foreground="Gray" />
  </StackPanel>
</UserControl>
