<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ComposeAnimationRuntime.Demo.Pages.OverviewPage">
  <StackPanel Spacing="12">
    <TextBlock Text="Animation catalog" FontSize="28" FontWeight="SemiBold" />
    <TextBlock Text="Interactive examples of the runtime and its Avalonia adapter." TextWrapping="Wrap" />
    <Separator />
    <Border Background="#E8F0FE" CornerRadius="16" Padding="24">
      <StackPanel Spacing="8">
        <TextBlock Text="Compose-inspired motion for .NET" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="Use the navigation to inspect live Spring, Decay, Keyframes, Visibility, and Transition samples." TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <TextBlock Text="All samples use Animatable&lt;T&gt;, explicit animation specs, and the same Avalonia frame host." Margin="0,16,0,0" />
  </StackPanel>
</UserControl>
