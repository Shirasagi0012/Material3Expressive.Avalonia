<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:motion="using:ComposeAnimationRuntime.Avalonia" x:Class="ComposeAnimationRuntime.Demo.Pages.SharedBoundsPage">
  <StackPanel Spacing="12">
    <TextBlock Text="SharedBounds" FontSize="28" FontWeight="SemiBold" />
    <TextBlock Text="Pairs source and destination bounds and animates the destination from the source geometry." TextWrapping="Wrap" />
    <Separator />
    <motion:SharedTransitionRoot x:Name="Root" Height="260" Background="#F5F6F8" />
    <Button Content="Run bounds transition" HorizontalAlignment="Left" Click="OnRun" />
    <TextBlock x:Name="Status" Text="Ready" Foreground="Gray" />
  </StackPanel>
</UserControl>
