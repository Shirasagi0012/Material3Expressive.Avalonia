<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:motion="using:ComposeAnimationRuntime.Avalonia" x:Class="ComposeAnimationRuntime.Demo.Pages.GestureSurfacePage">
  <StackPanel Spacing="12">
    <TextBlock Text="GestureSurface" FontSize="28" FontWeight="SemiBold" />
    <TextBlock Text="Drag the card. Pointer motion drives position and interactive progress; release settles the motion." TextWrapping="Wrap" />
    <Separator />
    <Border Height="280" Background="#F5F6F8" CornerRadius="14" ClipToBounds="True">
      <motion:GestureSurface x:Name="Surface">
        <Border Width="120" Height="86" Background="#4F7CFF" CornerRadius="18" Padding="16"><TextBlock Text="Drag me" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
      </motion:GestureSurface>
    </Border>
    <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Height="8" />
    <TextBlock x:Name="Status" Text="position = 0, 0" Foreground="Gray" />
  </StackPanel>
</UserControl>
