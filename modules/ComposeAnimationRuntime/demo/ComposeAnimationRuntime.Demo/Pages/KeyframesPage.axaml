<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ComposeAnimationRuntime.Demo.Pages.KeyframesPage">
  <StackPanel Spacing="12">
    <TextBlock Text="Keyframes" FontSize="28" FontWeight="SemiBold" />
    <TextBlock Text="Keyframes describe a precise multi-segment trajectory." TextWrapping="Wrap" />
    <Separator />
    <Border Height="240" Background="#F5F6F8" CornerRadius="14">
      <Canvas>
        <Border x:Name="Box" Width="96" Height="96" CornerRadius="20" Background="#2D9D78" />
      </Canvas>
    </Border>
    <Button Content="Play keyframes" HorizontalAlignment="Left" Click="OnAnimate" />
    <TextBlock x:Name="Status" Text="Ready" Foreground="Gray" />
  </StackPanel>
</UserControl>
