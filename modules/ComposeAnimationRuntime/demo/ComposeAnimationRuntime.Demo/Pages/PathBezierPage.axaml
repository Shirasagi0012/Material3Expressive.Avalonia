<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ComposeAnimationRuntime.Demo.Pages.PathBezierPage">
  <StackPanel Spacing="12">
    <TextBlock Text="Path &amp; Bezier" FontSize="28" FontWeight="SemiBold" />
    <TextBlock Text="Compare a segmented path with a cubic Bézier trajectory." TextWrapping="Wrap" />
    <Separator />
    <Border Height="300" Background="#F5F6F8" CornerRadius="14" ClipToBounds="True">
      <Canvas>
        <Border x:Name="PathBox" Width="44" Height="44" CornerRadius="22" Background="#2D9D78" />
        <Border x:Name="BezierBox" Width="44" Height="44" CornerRadius="22" Background="#E87532" />
      </Canvas>
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Play path" Click="OnPath" /><Button Content="Play Bézier" Click="OnBezier" /></StackPanel>
    <TextBlock x:Name="Status" Text="Ready" Foreground="Gray" />
  </StackPanel>
</UserControl>
