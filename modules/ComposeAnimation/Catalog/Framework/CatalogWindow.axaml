<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Catalog.Framework.CatalogWindow" Title="ComposeAnimation"
        Width="1180" Height="820" MinWidth="1020" MinHeight="640"
        Background="{DynamicResource CatalogWindowBackgroundBrush}">
    <Grid ColumnDefinitions="220,*">
        <Grid RowDefinitions="Auto,*,Auto" Margin="12,28,12,16">
            <StackPanel Margin="12,0,0,28" Spacing="4">
                <TextBlock Text="ComposeAnimation" FontWeight="SemiBold" FontSize="17" />
                <TextBlock Text="Catalog" Classes="demo-caption" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Navigation" Spacing="12" />
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="8,16,0,0">
                <Button x:Name="ThemeButton" Content="主题" />
                <Button x:Name="ToolsButton" Content="开发工具" />
            </StackPanel>
        </Grid>
        <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="28,30,28,28">
            <TextBlock x:Name="SectionTitle" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24" />
            <ScrollViewer x:Name="DemoScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="DemoHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
