<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Catalog 设计语言：令牌 + 样式类，全部跟随 Fluent 主题变体（浅色/深色）。
      演示使用统一的蓝色主题色。demo 内一律用
      Classes 与 DynamicResource 引用这里的令牌，不写硬编码颜色/间距。
    -->
    <Styles.Resources>
        <ResourceDictionary>
            <!-- ============ 主题无关令牌 ============ -->
            <SolidColorBrush x:Key="CatalogActorBrush" Color="#4878E8" />
            <SolidColorBrush x:Key="CatalogActorAltBrush" Color="#83A6F5" />
            <SolidColorBrush x:Key="CatalogActorTintBrush" Color="#4878E8" Opacity="0.28" />
            <SolidColorBrush x:Key="CatalogOnActorBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CatalogZoneABrush" Color="#4878E8" Opacity="0.10" />
            <SolidColorBrush x:Key="CatalogZoneBBrush" Color="#4878E8" Opacity="0.25" />

            <!-- ============ 尺寸令牌 ============ -->
            <CornerRadius x:Key="CatalogCardCornerRadius">12</CornerRadius>
            <CornerRadius x:Key="CatalogStageCornerRadius">8</CornerRadius>
            <Thickness x:Key="CatalogStagePadding">16</Thickness>
            <x:Double x:Key="CatalogSectionSpacing">12</x:Double>
            <x:Double x:Key="CatalogControlsSpacing">8</x:Double>

            <!-- ============ 随主题变体切换的令牌 ============ -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CatalogWindowBackgroundBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="CatalogCardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CatalogDetailsBrush" Color="#F0F1F3" />
                    <SolidColorBrush x:Key="CatalogCardBorderBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="CatalogStageBackgroundBrush" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="CatalogStageBorderBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="CatalogTrackBrush" Color="#2E000000" />
                    <SolidColorBrush x:Key="CatalogMarkerBrush" Color="#59000000" />
                    <SolidColorBrush x:Key="CatalogFaintSurfaceBrush" Color="#08000000" />
                    <SolidColorBrush x:Key="CatalogBadgeBackgroundBrush"
                                     Color="#4878E8" Opacity="0.14" />
                    <SolidColorBrush x:Key="CatalogBadgeForegroundBrush"
                                     Color="{DynamicResource SystemAccentColorDark2}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CatalogWindowBackgroundBrush" Color="#202020" />
                    <SolidColorBrush x:Key="CatalogCardBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="CatalogDetailsBrush" Color="#353537" />
                    <SolidColorBrush x:Key="CatalogCardBorderBrush" Color="#17FFFFFF" />
                    <SolidColorBrush x:Key="CatalogStageBackgroundBrush" Color="#242424" />
                    <SolidColorBrush x:Key="CatalogStageBorderBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="CatalogTrackBrush" Color="#40FFFFFF" />
                    <SolidColorBrush x:Key="CatalogMarkerBrush" Color="#73FFFFFF" />
                    <SolidColorBrush x:Key="CatalogFaintSurfaceBrush" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="CatalogBadgeBackgroundBrush"
                                     Color="#4878E8" Opacity="0.22" />
                    <SolidColorBrush x:Key="CatalogBadgeForegroundBrush"
                                     Color="#83A6F5" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ============ 结构骨架 ============ -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource CatalogCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CatalogCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource CatalogCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CatalogCardBorderBrush}" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <!-- 演示舞台 / 操作栏 -->
    <Style Selector="StackPanel.demo-root">
        <Setter Property="Spacing" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- demo 内小节标题 -->
    <Style Selector="TextBlock.demo-heading">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 操作行：按钮/开关横排 -->
    <Style Selector="StackPanel.demo-controls">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="{DynamicResource CatalogControlsSpacing}" />
    </Style>

    <!-- ============ 表面 ============ -->

    <!-- 舞台：动画发生的区域 -->
    <Style Selector="Border.demo-stage">
        <Setter Property="Background" Value="{DynamicResource CatalogStageBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CatalogStageBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CatalogStageCornerRadius}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- 凹槽：舞台内的次级表面（轨道行、对照槽位）；用卡片色使其在舞台灰上可见 -->
    <Style Selector="Border.demo-well">
        <Setter Property="Background" Value="{DynamicResource CatalogCardBrush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- 主角：被动画的卡片/小球 -->
    <Style Selector="Border.demo-actor">
        <Setter Property="Background" Value="{DynamicResource CatalogActorBrush}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.demo-actor TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource CatalogOnActorBrush}" />
    </Style>

    <!-- 参照区域：用于区分的成对容器（同主题色的两种透明度）。:is() 让 Panel 子类（如 LookaheadBox）也命中 -->
    <Style Selector="Border.demo-zone-a">
        <Setter Property="Background" Value="{DynamicResource CatalogZoneABrush}" />
    </Style>
    <Style Selector=":is(Panel).demo-zone-a">
        <Setter Property="Background" Value="{DynamicResource CatalogZoneABrush}" />
    </Style>
    <Style Selector="Border.demo-zone-b">
        <Setter Property="Background" Value="{DynamicResource CatalogZoneBBrush}" />
    </Style>
    <Style Selector=":is(Panel).demo-zone-b">
        <Setter Property="Background" Value="{DynamicResource CatalogZoneBBrush}" />
    </Style>

    <!-- 引导线/端点刻度（:is(Shape) 命中 Line 等子类） -->
    <Style Selector=":is(Shape).demo-guide">
        <Setter Property="Stroke" Value="{DynamicResource CatalogTrackBrush}" />
    </Style>
    <Style Selector=":is(Shape).demo-marker">
        <Setter Property="Stroke" Value="{DynamicResource CatalogMarkerBrush}" />
    </Style>

    <!-- ============ 徽章与外壳 ============ -->

    <!-- 实验性徽章（由 DemoFrame 按 [Demo(Experimental = true)] 自动展示） -->
    <Style Selector="Border.demo-badge">
        <Setter Property="Background" Value="{DynamicResource CatalogBadgeBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.demo-badge > TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource CatalogBadgeForegroundBrush}" />
    </Style>

    <!-- demo 卡片外壳（DemoFrame） -->
    <Style Selector="Border.demo-frame">
        <Setter Property="Background" Value="{DynamicResource CatalogCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CatalogCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CatalogCardCornerRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- 侧边导航 -->
    <Style Selector="ListBox.catalog-nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ListBox.catalog-nav ListBoxItem">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="2,1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.catalog-nav ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
    </Style>
    <Style Selector="ListBox.catalog-nav ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource CatalogZoneBBrush}" />
    </Style>
    <Style Selector="Expander.nav-group">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="4">
                    <ToggleButton x:Name="PART_Header" Classes="nav-header"
                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="*,Auto">
                            <ContentPresenter Content="{TemplateBinding Header}" />
                            <PathIcon x:Name="PART_Arrow" Grid.Column="1" Width="10" Height="6"
                                      Data="M 0,0 L 5,5 L 10,0 L 11,1 L 5,7 L -1,1 Z" />
                        </Grid>
                    </ToggleButton>
                    <ContentPresenter Content="{TemplateBinding Content}" IsVisible="{TemplateBinding IsExpanded}"
                                      Margin="8,0,0,4" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Expander.nav-group:expanded /template/ PathIcon#PART_Arrow">
        <Setter Property="RenderTransform"><RotateTransform Angle="180" /></Setter>
    </Style>
    <Style Selector="ToggleButton.nav-header">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.nav-header:pointerover /template/ Border#PART_Surface">
        <Setter Property="Background" Value="{DynamicResource CatalogFaintSurfaceBrush}" />
    </Style>
    <Style Selector="ToggleButton.nav-header:focus-visible /template/ Border#PART_Surface">
        <Setter Property="BorderBrush" Value="{DynamicResource CatalogActorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.demo-caption, TextBlock.nav-heading, Grid.diagnostic-heading TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    </Style>
    <Style Selector="TextBlock.nav-heading">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.diagnostic-value">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ToggleButton.details-toggle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" VerticalContentAlignment="Center"
                                      HorizontalContentAlignment="Stretch" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.details-toggle:pointerover /template/ Border#PART_Surface">
        <Setter Property="Background" Value="{DynamicResource CatalogFaintSurfaceBrush}" />
    </Style>
    <Style Selector="ToggleButton.details-toggle:focus-visible /template/ Border#PART_Surface">
        <Setter Property="BorderBrush" Value="{DynamicResource CatalogActorBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
</Styles>
