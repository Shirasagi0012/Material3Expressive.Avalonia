<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ca="https://github.com/Shirasagi0012/ComposeAnimation" x:Class="Catalog.Demos.Bounds.BoundsBoundaryDemo">
    <StackPanel Classes="demo-root" VerticalAlignment="Top">
        <Border Classes="demo-stage" Padding="0" Height="280" HorizontalAlignment="Stretch">
            <ca:LookaheadBox x:Name="Scene">
                <ca:AnimatedBounds x:Name="Card" TargetSize="170,110" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <ca:LookaheadBoundary x:Name="Boundary" Padding="14" ContentAlignment="TopStart">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <TextBlock Text="内容裁剪" FontWeight="SemiBold"/>
                            <Button x:Name="LiveButton" Grid.Row="1" Margin="0,6" HorizontalAlignment="Stretch" Click="LiveButton_OnClick">点击 0</Button>
                            <TextBox Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" Text="这段内容保持布局，随外框逐渐显露。"/>
                        </Grid>
                    </ca:LookaheadBoundary>
                </ca:AnimatedBounds>
            </ca:LookaheadBox>
        </Border>
        <StackPanel Classes="demo-controls" HorizontalAlignment="Left">
            <Button x:Name="ToggleButton" Click="ToggleButton_OnClick">展开 / 收起</Button>
        </StackPanel>
    </StackPanel>
</UserControl>
