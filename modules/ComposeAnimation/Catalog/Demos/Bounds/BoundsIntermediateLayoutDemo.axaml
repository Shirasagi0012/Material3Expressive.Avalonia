<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ca="https://github.com/Shirasagi0012/ComposeAnimation" x:Class="Catalog.Demos.Bounds.BoundsIntermediateLayoutDemo">
    <StackPanel Classes="demo-root" VerticalAlignment="Top">
        <Border Classes="demo-stage" Padding="0" Height="260" HorizontalAlignment="Stretch">
            <ca:LookaheadBox x:Name="Scene">
                <ca:AnimatedBounds x:Name="Card" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <ca:LookaheadTextBlock Width="300" FontSize="14" TextWrapping="Wrap" Background="{DynamicResource CatalogActorTintBrush}" Text="内边距与尺寸的组合顺序，决定内容拥有的空间。"/>
                </ca:AnimatedBounds>
            </ca:LookaheadBox>
        </Border>
        <StackPanel Classes="demo-controls" HorizontalAlignment="Left">
            <Button x:Name="OrderButton" Click="OrderButton_OnClick">顺序：尺寸→Padding / Padding→尺寸</Button>
            <Button x:Name="OffsetButton" Click="OffsetButton_OnClick">切换内层偏移 (50, 20)</Button>
        </StackPanel>
    </StackPanel>
</UserControl>
