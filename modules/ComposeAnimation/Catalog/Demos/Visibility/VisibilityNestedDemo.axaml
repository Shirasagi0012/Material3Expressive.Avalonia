<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ca="https://github.com/Shirasagi0012/ComposeAnimation" mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="360" x:Class="Catalog.Demos.Visibility.VisibilityNestedDemo">
    <StackPanel Classes="demo-root" VerticalAlignment="Top">
        <Border Classes="demo-stage" Height="300" HorizontalAlignment="Stretch">
            <ca:AnimatedVisibility x:Name="Visibility" Visible="{Binding #VisibilityToggle.IsChecked}" HorizontalAlignment="Center" Label="Nested" VerticalAlignment="Center">
                <ca:AnimatedVisibility.Enter>
                    <ca:EnterTransitionGroup>
                        <ca:FadeIn/>
                        <ca:ExpandVertically ExpandFrom="Top"/>
                    </ca:EnterTransitionGroup>
                </ca:AnimatedVisibility.Enter>
                <ca:AnimatedVisibility.Exit>
                    <ca:ExitTransitionGroup>
                        <ca:FadeOut>
                            <ca:FadeOut.Spec>
                                <ca:DoubleTweenSpec Duration="0:0:0.35"/>
                            </ca:FadeOut.Spec>
                        </ca:FadeOut>
                        <ca:ShrinkVertically ShrinkTowards="Top"/>
                    </ca:ExitTransitionGroup>
                </ca:AnimatedVisibility.Exit>
                <Border Width="420" Classes="demo-actor" Padding="24">
                    <StackPanel Spacing="12">
                        <TextBlock Text="父级 · 350 ms" FontSize="18" TextWrapping="Wrap"/>
                        <TextBlock Text="子级 · 500 ms" TextWrapping="Wrap"/>
                        <ca:AnimateEnterExit Label="Details action">
                            <ca:AnimateEnterExit.Enter>
                                <ca:SlideInHorizontally InitialOffsetRatio="0.3"/>
                            </ca:AnimateEnterExit.Enter>
                            <ca:AnimateEnterExit.Exit>
                                <ca:SlideOutHorizontally TargetOffsetRatio="1">
                                    <ca:SlideOutHorizontally.Spec>
                                        <ca:VectorTweenSpec Duration="0:0:0.5"/>
                                    </ca:SlideOutHorizontally.Spec>
                                </ca:SlideOutHorizontally>
                            </ca:AnimateEnterExit.Exit>
                            <Button Content="子级内容" HorizontalAlignment="Left"/>
                        </ca:AnimateEnterExit>
                    </StackPanel>
                </Border>
            </ca:AnimatedVisibility>
        </Border>
        <StackPanel Classes="demo-controls" HorizontalAlignment="Left">
            <ToggleSwitch x:Name="VisibilityToggle" IsChecked="True" Content="显示详情"/>
        </StackPanel>
    </StackPanel>
</UserControl>
