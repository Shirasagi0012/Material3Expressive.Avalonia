<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
        x:Class="Material3Expressive.Catalog.DragHandleDemo" Width="760" Height="560" Title="Vertical drag handle">
  <StackPanel Margin="32" Spacing="20">
    <TextBlock Text="VerticalDragHandle" m3:MaterialText.Style="{m3:Typography HeadlineSmall}" />
    <TextBlock Text="Drag horizontally to resize the panels. The host shares drag interactions with the handle, first card and chip. Dragging raises their elevation without changing selection." TextWrapping="Wrap" />
    <Grid x:Name="Panels" Height="180" ColumnDefinitions="240,48,*">
      <m3:ElevatedCard x:Name="LinkedCard" IsClickable="True" Width="240" Height="180"
                       HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <TextBlock Text="First panel" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </m3:ElevatedCard>
      <Border x:Name="DragRegion" Grid.Column="1" Background="Transparent" Cursor="SizeWestEast"
              PointerPressed="OnPressed" PointerMoved="OnMoved" PointerReleased="OnReleased" PointerCaptureLost="OnCaptureLost">
        <m3:VerticalDragHandle x:Name="Handle" />
      </Border>
      <Border Grid.Column="2" Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SecondaryContainer}}" CornerRadius="16">
        <TextBlock Text="Second panel" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </Grid>
    <TextBlock x:Name="Status" Text="Ready" />
    <StackPanel Orientation="Horizontal" Spacing="24">
      <m3:VerticalDragHandle />
      <m3:VerticalDragHandle x:Name="CustomHandle" />
      <m3:VerticalDragHandle x:Name="CutHandle">
        <m3:VerticalDragHandle.Shape><m3:CutCornerShape TopStart="50%" BottomEnd="50%" /></m3:VerticalDragHandle.Shape>
        <m3:VerticalDragHandle.PressedShape><m3:CutCornerShape TopEnd="50%" BottomStart="50%" /></m3:VerticalDragHandle.PressedShape>
        <m3:VerticalDragHandle.DraggedShape><m3:CutCornerShape TopStart="50%" TopEnd="50%" BottomEnd="50%" BottomStart="50%" /></m3:VerticalDragHandle.DraggedShape>
      </m3:VerticalDragHandle>
      <TextBlock Text="Default / custom / cut corners" VerticalAlignment="Center" />
      <m3:InputChip x:Name="LinkedChip" Content="Shared drag" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="16">
      <CheckBox x:Name="FeedbackEnabled" Content="Enable card and chip" IsChecked="True" />
      <Button Content="Change elevations" Click="OnChangeElevations" />
    </StackPanel>
    <TextBlock Text="Disable while dragging to snap to the disabled elevation; enable again to restore the active interaction. Changing the configuration keeps the current transition continuous." TextWrapping="Wrap" />
  </StackPanel>
</Window>
