<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
        x:Class="Material3Expressive.Catalog.DateTimePickerDemo" Title="Date and time pickers" Width="1100" Height="850">
  <Grid>
    <ScrollViewer>
      <StackPanel Margin="24" Spacing="24">
        <TextBlock Text="Date and time pickers" FontSize="28" />
        <WrapPanel>
          <Button Content="Light / dark" Click="ToggleTheme" Margin="0,0,12,0" />
          <Button Content="LTR / RTL" Click="ToggleDirection" Margin="0,0,12,0" />
          <Button Content="12 / 24 hours" Click="ToggleClock" />
          <Button Content="Custom date format" Click="ToggleDateFormatter" Margin="12,0,0,0" />
          <Button Content="Date language: 中文 / English" Click="ToggleDateLanguage" Margin="12,0,0,0" />
        </WrapPanel>
        <TextBlock Text="Compose date content — calendar and input modes" FontSize="20" />
        <TextBlock Text="Months: use the navigation arrows for animated paging, swipe with touch and release to snap, or scroll horizontally on a trackpad. Reverse an animation with the other arrow. Vertical wheel scrolling remains available to this page." TextWrapping="Wrap" />
        <TextBlock Text="{Binding #Date.DisplayedMonth, StringFormat='First visible month: {0:yyyy-MM}'}" />
        <TextBlock Text="Date keyboard: open the year selector, use arrows and Enter, or Tab / Shift+Tab to leave and return. In the calendar, Left / Right skips disabled dates and animates across month boundaries." TextWrapping="Wrap" />
        <WrapPanel>
          <m3:DatePicker Name="Date" Margin="0,0,24,0" />
          <m3:DateRangePicker Name="Range" Width="420" Height="600" />
        </WrapPanel>
        <WrapPanel>
          <Button Content="Range: previous month" Click="PreviousRangeMonth" Margin="0,0,12,0" />
          <Button Content="Range: next month" Click="NextRangeMonth" />
          <TextBlock Text="{Binding #Range.DisplayedMonth, StringFormat='First range month: {0:yyyy-MM}'}" Margin="12,0,0,0" VerticalAlignment="Center" />
        </WrapPanel>
        <TextBlock Text="Range calendar: swipe vertically and release for continuous inertia, or use the wheel. Each month heading has localized previous / next month accessibility actions. Tab leaves the calendar; Shift+Tab returns to its header. Navigation keeps the selected dates." TextWrapping="Wrap" />
        <TextBlock Text="TimePicker · TimeInput · TimeScroll — shared valid value" FontSize="20" />
        <TextBlock Text="Keyboard: activate an hour/minute selector, use arrows to move around the dial, Enter/Space to choose, and Tab or Shift+Tab to leave. In 24-hour mode, arrows connect both rings." TextWrapping="Wrap" />
        <TextBlock Text="Pointer: tap a five-minute mark or drag to any minute. Choosing an hour advances after the selector animation; drag release advances immediately. Switch fields during the transition to try interruption." TextWrapping="Wrap" />
        <CheckBox Name="TouchExploration" Content="Touch exploration enabled — keep the hour selected on the dial and during text entry" />
        <TextBlock Text="Dial opacity — the selector track follows the same opacity as the labels" />
        <Slider Name="DialOpacity" Minimum="0.1" Maximum="1" Value="1" MaxWidth="320" HorizontalAlignment="Left" />
        <WrapPanel>
          <Border RenderOptions.RequiresFullOpacityHandling="True">
            <m3:TimePicker TouchExplorationEnabled="{Binding #TouchExploration.IsChecked}" Name="Dial" Layout="Vertical" Margin="0,0,32,0" Opacity="{Binding #DialOpacity.Value}" />
          </Border>
          <StackPanel Spacing="24">
            <m3:TimeInput Name="Input" TouchExplorationEnabled="{Binding #TouchExploration.IsChecked}" SelectedTime="{Binding #Dial.SelectedTime, Mode=TwoWay}" Is24Hour="{Binding #Dial.Is24Hour}" />
            <TextBlock Text="Scroll entry: drag and fling either column, use the mouse wheel, or focus it and press Up/Down. Click a neighbouring number to animate to it; reverse before settling to try interruption. Hours and minutes wrap independently." TextWrapping="Wrap" MaxWidth="340" />
            <m3:TimeScroll Name="Scroll" SelectedTime="{Binding #Dial.SelectedTime, Mode=TwoWay}" Is24Hour="{Binding #Dial.Is24Hour}" />
            <TextBlock Text="{Binding #Dial.SelectedTime}" />
            <TextBlock Text="{Binding #Input.IsInputValid, StringFormat='Input valid: {0}'}" />
          </StackPanel>
        </WrapPanel>
        <TextBlock Text="Vibrant / horizontal / uncontained" FontSize="20" />
        <m3:TimePicker TouchExplorationEnabled="{Binding #TouchExploration.IsChecked}" Name="Vibrant" Variant="Vibrant" Layout="Horizontal" SelectedTime="{Binding #Dial.SelectedTime, Mode=TwoWay}" Is24Hour="{Binding #Dial.Is24Hour}" />
        <TextBlock Text="Use the side button to switch text / scroll entry. Only the selected text field is editable. Try an invalid value (99), then select the other field to inspect the retained draft." TextWrapping="Wrap" />
        <m3:TimeInput Name="Uncontained" Variant="Vibrant" TouchExplorationEnabled="{Binding #TouchExploration.IsChecked}" SelectedTime="{Binding #Dial.SelectedTime, Mode=TwoWay}" Is24Hour="{Binding #Dial.Is24Hour}">
          <m3:TimeInput.ToggleTemplate><DataTemplate>
            <m3:TimeScrollDisplayModeToggle DisplayMode="Input" Click="ToggleEntryMode" />
          </DataTemplate></m3:TimeInput.ToggleTemplate>
        </m3:TimeInput>
        <m3:TimeScroll Name="UncontainedScroll" IsVisible="False" SelectedTime="{Binding #Dial.SelectedTime, Mode=TwoWay}" Is24Hour="{Binding #Dial.Is24Hour}">
          <m3:TimeScroll.ToggleTemplate><DataTemplate>
            <m3:TimeScrollDisplayModeToggle DisplayMode="Scroll" Click="ToggleEntryMode" />
          </DataTemplate></m3:TimeScroll.ToggleTemplate>
        </m3:TimeScroll>
        <TextBlock Text="Avalonia native controls — original API and flyout behavior" FontSize="20" />
        <WrapPanel>
          <DatePicker Margin="0,0,24,0" />
          <TimePicker UseSeconds="True" MinuteIncrement="5" SecondIncrement="5" Margin="0,0,24,0" />
          <CalendarDatePicker PlaceholderText="Enter a date" />
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
