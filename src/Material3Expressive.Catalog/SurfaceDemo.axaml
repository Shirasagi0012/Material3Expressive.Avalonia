<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
        x:Class="Material3Expressive.Catalog.SurfaceDemo" Title="Interactive surfaces" Width="680" Height="620">
  <Window.Styles>
    <Style Selector="m3|SelectableSurface:selected, m3|ToggleableSurface:checked">
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SecondaryContainer}}" />
      <Setter Property="BorderBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.Primary}}" />
    </Style>
  </Window.Styles>
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="20">
      <TextBlock Text="Interactive surfaces" m3:MaterialText.Style="{m3:Typography HeadlineSmall}" />
      <TextBlock Text="Surfaces provide a shape, content color and interaction feedback. This example supplies the selection colors and writes selection requests back to the controls." TextWrapping="Wrap" />
      <m3:ClickableSurface CornerRadius="20" Padding="24" TonalElevation="3" Click="OnOpen">
        <StackPanel Spacing="8">
          <TextBlock Text="Open workspace" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
          <TextBlock Text="Click, Enter or Space" />
        </StackPanel>
      </m3:ClickableSurface>
      <TextBlock x:Name="Status" Text="No action yet" />
      <TextBlock Text="Tonal elevation environment" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
      <CheckBox x:Name="TonalEnabled" IsChecked="True" Content="Enable tonal tint in this group" />
      <m3:MaterialSurface TonalElevation="3" CornerRadius="20" Padding="20"
                          m3:MaterialTonalElevation.IsEnabled="{Binding #TonalEnabled.IsChecked}">
        <StackPanel Spacing="16">
          <TextBlock Text="Parent elevation 3; children still accumulate elevation when tint is disabled." TextWrapping="Wrap" />
          <m3:ClickableSurface TonalElevation="3" ShadowElevation="2" CornerRadius="12" Padding="16" Click="OnOpen" Content="Inherit the group setting" />
          <m3:ClickableSurface TonalElevation="3" CornerRadius="12" Padding="16" Click="OnOpen"
                               m3:MaterialTonalElevation.IsEnabled="True" Content="Always tinted at cumulative elevation 6" />
        </StackPanel>
      </m3:MaterialSurface>
      <TextBlock Text="Cut corners and shared outlines" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
      <CheckBox x:Name="CutRtl" Content="Right-to-left shapes" />
      <StackPanel x:Name="CutExamples" Orientation="Horizontal" Spacing="16">
        <m3:ClickableSurface Width="160" Height="80" Padding="20" TonalElevation="3" Click="OnOpen"
                             m3:MaterialInteraction.FocusFeedback="InsetRing">
          <m3:ClickableSurface.Shape><m3:CutCornerShape TopStart="24" TopEnd="8" BottomEnd="24" BottomStart="8" /></m3:ClickableSurface.Shape>
          <TextBlock Text="Cut surface" />
        </m3:ClickableSurface>
        <m3:ElevatedCard Width="160" Height="80" IsClickable="True" Click="OnOpen"
                         m3:MaterialInteraction.FocusFeedback="InsetRing">
          <m3:ElevatedCard.Shape><m3:CutCornerShape TopStart="25%" TopEnd="25%" BottomEnd="25%" BottomStart="25%" /></m3:ElevatedCard.Shape>
          <TextBlock Text="Percentage cuts" Margin="24" />
        </m3:ElevatedCard>
        <m3:OutlinedCard Width="160" Height="80" IsClickable="True" Click="OnOpen"
                         m3:MaterialInteraction.FocusFeedback="InsetRing">
          <m3:OutlinedCard.Shape><m3:CutCornerShape TopStart="32" BottomEnd="32" /></m3:OutlinedCard.Shape>
          <TextBlock Text="Cut outline" Margin="24" />
        </m3:OutlinedCard>
      </StackPanel>
      <TextBlock Text="Cut button morphs · press and release quickly to reverse; hold to reach percentage corners" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="16">
        <Button Content="Cut filled" Click="OnOpen" Height="56">
          <m3:MaterialButton.Shape><m3:CutCornerShape TopStart="24" TopEnd="8" BottomEnd="24" BottomStart="8" /></m3:MaterialButton.Shape>
          <m3:MaterialButton.PressedShape><m3:CutCornerShape TopStart="12%" TopEnd="12%" BottomEnd="12%" BottomStart="12%" /></m3:MaterialButton.PressedShape>
        </Button>
        <Button Content="Cut outlined" Theme="{StaticResource MaterialOutlinedButtonTheme}" Click="OnOpen" Height="56">
          <m3:MaterialButton.Shape><m3:CutCornerShape TopStart="28" BottomEnd="28" /></m3:MaterialButton.Shape>
          <m3:MaterialButton.PressedShape><m3:CutCornerShape TopStart="8" TopEnd="8" BottomEnd="8" BottomStart="8" /></m3:MaterialButton.PressedShape>
        </Button>
        <Button Content="Static cut tonal" Theme="{StaticResource MaterialTonalButtonTheme}" Click="OnOpen" Height="56">
          <m3:MaterialButton.Shape><m3:CutCornerShape TopStart="24" BottomEnd="24" /></m3:MaterialButton.Shape>
        </Button>
      </StackPanel>
      <TextBlock Text="Ripple origin and quick taps" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
      <TextBlock Text="Press near an edge, release quickly, or tap again while the previous wave is fading. Each wave finishes its expansion before fading out." TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="24">
        <m3:ClickableSurface Width="97" Height="53" Background="White" Foreground="Black" Click="OnOpen" />
        <m3:ClickableSurface Width="213" Height="49" Background="White" Foreground="Black" Click="OnOpen" />
      </StackPanel>
      <TextBlock Text="Choose a view" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
      <StackPanel x:Name="Views" Orientation="Horizontal" Spacing="16">
        <m3:SelectableSurface IsSelected="True" CornerRadius="16" Padding="24" BorderThickness="1" Click="OnSelect" Content="List" />
        <m3:SelectableSurface CornerRadius="16" Padding="24" BorderThickness="1" Click="OnSelect" Content="Board" />
        <m3:SelectableSurface CornerRadius="16" Padding="24" BorderThickness="1" Click="OnSelect" Content="Calendar" />
      </StackPanel>
      <m3:ToggleableSurface CornerRadius="16" Padding="24" BorderThickness="1" CheckedChangeRequested="OnToggle">
        <StackPanel Spacing="8">
          <TextBlock Text="Pin workspace" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
          <TextBlock Text="The application owns the checked state" />
        </StackPanel>
      </m3:ToggleableSurface>
      <CheckBox x:Name="Enable" Content="Enable surfaces" IsChecked="True" />
      <m3:ClickableSurface IsEnabled="{Binding #Enable.IsChecked}" CornerRadius="12" Padding="16" TonalElevation="1" Click="OnOpen" Content="Enabled state keeps the same colors" />
      <TextBlock Text="Transparent surfaces · elevation 1" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
      <StackPanel Orientation="Horizontal" Spacing="24" Margin="8">
        <m3:MaterialSurface Width="64" Height="32" CornerRadius="7.6246843338012695" Background="Transparent" ShadowElevation="1" />
        <m3:MaterialSurface Width="64" Height="32" CornerRadius="16" Background="Transparent" ShadowElevation="1" />
        <m3:MaterialSurface Width="72" Height="72" CornerRadius="36" Background="Transparent" ShadowElevation="1" />
      </StackPanel>
      <TextBlock Text="Custom elevation · 16 and 40" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
      <WrapPanel ItemSpacing="64" LineSpacing="48" Margin="40">
        <m3:MaterialSurface Width="56" Height="56" CornerRadius="16" ShadowElevation="16" />
        <m3:MaterialSurface Width="56" Height="56" CornerRadius="16" ShadowElevation="40" />
        <m3:MaterialSurface Width="56" Height="56" CornerRadius="28" Background="Transparent" ShadowElevation="40" />
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
