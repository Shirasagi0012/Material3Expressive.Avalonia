<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
        xmlns:local="using:Material3Expressive.Catalog"
        x:Class="Material3Expressive.Catalog.TabRowDemo" Title="Material tabs" Width="640" Height="640">
  <ScrollViewer>
    <ScrollViewer.Resources>
      <ControlTemplate x:Key="ElasticIndicator">
        <local:ElasticTabIndicator>
          <Border Margin="5" BorderThickness="2" CornerRadius="5"
                  BorderBrush="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.Primary}}" />
        </local:ElasticTabIndicator>
      </ControlTemplate>
    </ScrollViewer.Resources>
    <StackPanel Margin="24" Spacing="20">
      <TextBlock Text="Primary tabs · application selection" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
      <m3:TabRow SelectedIndex="0">
        <m3:Tab Content="Music" IsSelected="True" Click="OnTabClick" />
        <m3:Tab Content="Videos" Click="OnTabClick" />
        <m3:Tab Content="Photos" Click="OnTabClick" />
      </m3:TabRow>
      <TextBlock Text="Changing labels" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
      <Button Content="Change selected label" HorizontalAlignment="Left" Click="OnChangeLabel" />
      <m3:TabRow SelectedIndex="0">
        <m3:Tab IsSelected="True"><TextBlock x:Name="ChangingLabel" Text="Inbox" /></m3:Tab>
        <m3:Tab Content="Sent" />
      </m3:TabRow>
      <TabControl Height="100">
        <TabItem x:Name="ChangingNativeTab" Header="Inbox"><TextBlock Text="The indicator follows the label width." Margin="16" /></TabItem>
        <TabItem Header="Sent" />
      </TabControl>
      <TextBlock Text="Stacked tabs · badge bounds" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
      <m3:TabRow SelectedIndex="0">
        <m3:Tab Content="Inbox" IsSelected="True" Click="OnTabClick">
          <m3:Tab.Icon>
            <m3:BadgedBox>
              <m3:BadgedBox.Badge><m3:Badge Content="99+" AutomationProperties.Name="99 unread messages" /></m3:BadgedBox.Badge>
              <m3:MaterialSymbol Symbol="Mail" Width="24" Height="24" />
            </m3:BadgedBox>
          </m3:Tab.Icon>
        </m3:Tab>
        <m3:Tab Content="Sent" Icon="{m3:Symbol Send}" Click="OnTabClick" />
      </m3:TabRow>
      <TextBlock Text="Secondary tabs · leading icons" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
      <m3:TabRow Variant="Secondary" SelectedIndex="0">
        <m3:Tab Content="Music" Icon="{m3:Symbol MusicNote}" ContentLayout="Leading" IsSelected="True" Click="OnTabClick" />
        <m3:Tab Content="Photos" Icon="{m3:Symbol Photo}" ContentLayout="Leading" Click="OnTabClick" />
      </m3:TabRow>
      <TextBlock Text="Leading icon badge · label paints last" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
      <m3:Tab Content="Inbox" ContentLayout="Leading" HorizontalAlignment="Left" IsSelected="True">
        <m3:Tab.Icon>
          <m3:BadgedBox>
            <m3:BadgedBox.Badge><m3:Badge Content="99+" MinWidth="48" AutomationProperties.Name="99 unread messages" /></m3:BadgedBox.Badge>
            <m3:MaterialSymbol Symbol="Mail" Width="24" Height="24" />
          </m3:BadgedBox>
        </m3:Tab.Icon>
      </m3:Tab>
      <TextBlock Text="Indicator width independent of variant" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
      <CheckBox x:Name="MatchIndicator" Content="Match content width" IsChecked="True" />
      <m3:TabRow Variant="Secondary" IndicatorMatchContentSize="{Binding IsChecked, ElementName=MatchIndicator}" SelectedIndex="0">
        <m3:Tab Content="Inbox" IsSelected="True" Click="OnTabClick" />
        <m3:Tab Content="Saved messages" Click="OnTabClick" />
      </m3:TabRow>
      <TabControl Height="100" m3:TabRowAppearance.IndicatorMatchContentSize="{Binding IsChecked, ElementName=MatchIndicator}">
        <TabItem Header="Inbox"><TextBlock Text="Change width while the indicator is moving." Margin="16" /></TabItem>
        <TabItem Header="Saved messages" />
      </TabControl>
      <TextBlock Text="Standalone indicators · size and shape" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
      <StackPanel Spacing="12">
        <m3:PrimaryTabIndicator />
        <m3:PrimaryTabIndicator IndicatorWidth="64" IndicatorHeight="10">
          <m3:PrimaryTabIndicator.Shape><m3:CutCornerShape TopStart="6" BottomEnd="6" /></m3:PrimaryTabIndicator.Shape>
        </m3:PrimaryTabIndicator>
        <m3:SecondaryTabIndicator Width="180" IndicatorHeight="4" HorizontalAlignment="Left" />
      </StackPanel>
      <m3:TabRow SelectedIndex="0">
        <m3:TabRow.Indicator>
          <ControlTemplate>
            <m3:PrimaryTabIndicator IndicatorWidth="NaN" IndicatorHeight="6" HorizontalAlignment="Stretch">
              <m3:PrimaryTabIndicator.Shape><m3:CutCornerShape TopStart="4" TopEnd="4" /></m3:PrimaryTabIndicator.Shape>
            </m3:PrimaryTabIndicator>
          </ControlTemplate>
        </m3:TabRow.Indicator>
        <m3:Tab Content="Inbox" IsSelected="True" Click="OnTabClick" />
        <m3:Tab Content="Saved messages" Click="OnTabClick" />
      </m3:TabRow>
      <TextBlock Text="Custom indicator · independent animated edges" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
      <m3:TabRow Indicator="{StaticResource ElasticIndicator}" SelectedIndex="0">
        <m3:Tab Content="Music" IsSelected="True" Click="OnTabClick" />
        <m3:Tab Content="Videos" Click="OnTabClick" />
        <m3:Tab Content="Photos" Click="OnTabClick" />
      </m3:TabRow>
      <TabControl m3:TabRowAppearance.IsScrollable="True" m3:TabRowAppearance.Indicator="{StaticResource ElasticIndicator}" Height="100">
        <TabItem Header="All albums"><TextBlock Margin="16" Text="Select tabs rapidly to reverse the elastic indicator." /></TabItem>
        <TabItem Header="Recently added" /><TabItem Header="Favourites" /><TabItem Header="Downloaded" />
        <TabItem Header="Shared albums" />
      </TabControl>
      <TextBlock Text="Scrollable tabs" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
      <m3:TabRow IsScrollable="True" SelectedIndex="0">
        <m3:Tab Content="All albums" IsSelected="True" Click="OnTabClick" />
        <m3:Tab Content="Recently added" Click="OnTabClick" />
        <m3:Tab Content="Favourites" Click="OnTabClick" />
        <m3:Tab Content="Downloaded" Click="OnTabClick" />
        <m3:Tab Content="Shared albums" Click="OnTabClick" />
      </m3:TabRow>
      <TextBlock Text="Native TabControl · selection and pages" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
      <TextBlock Text="Legacy tabs · primary color, full tab indicator" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
      <m3:TabRow Variant="Legacy" SelectedIndex="0">
        <m3:Tab Content="Overview" IsSelected="True" Click="OnTabClick" />
        <m3:Tab Content="Activity" Click="OnTabClick" />
        <m3:Tab Content="Details" Click="OnTabClick" />
      </m3:TabRow>
      <m3:TabRow Variant="Legacy" IsScrollable="True" SelectedIndex="0">
        <m3:Tab Content="All albums" IsSelected="True" Click="OnTabClick" />
        <m3:Tab Content="Recently added" Click="OnTabClick" />
        <m3:Tab Content="Favourites" Click="OnTabClick" />
        <m3:Tab Content="Downloaded" Click="OnTabClick" />
        <m3:Tab Content="Shared albums" Click="OnTabClick" />
      </m3:TabRow>
      <TabControl m3:TabRowAppearance.Variant="Legacy" Height="100">
        <TabItem Header="Overview"><TextBlock Text="Legacy indicator with native page selection." Margin="16" /></TabItem>
        <TabItem Header="Activity" />
      </TabControl>
      <TextBlock Text="Native TabControl · secondary scrollable" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
      <TabControl m3:TabRowAppearance.Variant="Secondary" m3:TabRowAppearance.IsScrollable="True" Height="160">
        <TabItem Header="Music"><TextBlock Text="Music library" Margin="16" /></TabItem>
        <TabItem Header="Videos"><TextBlock Text="Video library" Margin="16" /></TabItem>
        <TabItem Header="Photos"><TextBlock Text="Photo library" Margin="16" /></TabItem>
        <TabItem Header="Downloads"><TextBlock Text="Downloads" Margin="16" /></TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</Window>
