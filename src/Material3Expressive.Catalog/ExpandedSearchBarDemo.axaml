<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
        x:Class="Material3Expressive.Catalog.ExpandedSearchBarDemo" Title="Search popup" Width="620" Height="640">
  <Window.Resources><m3:SearchBarState x:Key="SearchState" /></Window.Resources>
  <Grid>
    <StackPanel Margin="24" Spacing="16">
      <TextBlock Text="SearchBar + ExpandedDockedSearchBar" m3:MaterialText.Style="{m3:Typography HeadlineSmall}" TextWrapping="Wrap" />
      <TextBlock Text="搜索结果在独立弹层中展开，不推动下方内容。Escape 或点击外部收起；窗口缩小时结果高度随之限制。" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="明 / 暗" Click="ToggleTheme" />
        <Button Content="LTR / RTL" Click="ToggleDirection" />
      </StackPanel>
      <m3:SearchBar State="{StaticResource SearchState}">
        <Button x:Name="SearchAnchor" Content="搜索组件" Width="360" Height="56" Click="OpenSearch"
                Theme="{StaticResource MaterialTextButtonTheme}" HorizontalContentAlignment="Left" />
      </m3:SearchBar>
      <TextBlock x:Name="Status" Text="尚未选择结果" />
      <Button Content="其他页面操作" HorizontalAlignment="Left" />
    </StackPanel>
    <m3:ExpandedDockedSearchBar State="{StaticResource SearchState}">
      <m3:ExpandedDockedSearchBar.InputField>
        <m3:SearchBarInputField x:Name="Query" IsExpanded="True" PlaceholderText="搜索组件"
                               TextChanged="QueryChanged" SearchRequested="SearchSubmitted" AutomationProperties.Name="搜索组件" />
      </m3:ExpandedDockedSearchBar.InputField>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Results" Margin="8" Spacing="4" />
      </ScrollViewer>
    </m3:ExpandedDockedSearchBar>
  </Grid>
</Window>
