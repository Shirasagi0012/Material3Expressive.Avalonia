<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
        x:Class="Material3Expressive.Catalog.ExpandedSearchBarDemo" Title="Search popup" Width="620" Height="640">
  <Window.Styles>
    <Style Selector="m3|SearchBarInputField.contained">
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.ContainerColor}}" />
    </Style>
  </Window.Styles>
  <Window.Resources><m3:SearchBarState x:Key="SearchState" /></Window.Resources>
  <Grid x:Name="Root" m3:MaterialInteraction.FocusFeedback="InsetRing">
    <StackPanel Margin="24" Spacing="16">
      <TextBlock x:Name="Heading" Text="SearchBar + ExpandedDockedSearchBar" m3:MaterialText.Style="{m3:Typography HeadlineSmall}" TextWrapping="Wrap" />
      <TextBlock x:Name="Description" Text="点击输入框，或 Tab 聚焦后输入 / 按 ↓ 展开。Escape 或点击外部收起；收起与展开输入共享查询。" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="明 / 暗" Click="ToggleTheme" />
        <Button Content="LTR / RTL" Click="ToggleDirection" />
        <Button Content="切角 / 默认形状" Click="ToggleShape" />
        <Button Content="焦点环 / 常规" Click="ToggleFocusFeedback" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="16">
        <CheckBox x:Name="AllowEscape" Content="Escape 关闭" IsChecked="True" IsCheckedChanged="DismissalPolicyChanged" />
        <CheckBox x:Name="AllowOutside" Content="弹层外点击关闭" IsChecked="True" IsCheckedChanged="DismissalPolicyChanged" />
      </StackPanel>
      <TextBlock Text="开关控制平台关闭请求；带罩变体的遮罩仍是独立关闭按钮。输入框返回按钮和选择结果始终可收起。" TextWrapping="Wrap" />
      <m3:SearchBar x:Name="CollapsedSearch" State="{StaticResource SearchState}">
        <m3:SearchBarInputField x:Name="SearchAnchor" State="{StaticResource SearchState}" PlaceholderText="搜索组件"
                                Text="{Binding Text, ElementName=Query, Mode=TwoWay}" SearchRequested="SearchSubmitted" />
      </m3:SearchBar>
      <TextBlock x:Name="Status" Text="尚未选择结果" />
      <Button Content="其他页面操作" HorizontalAlignment="Left" />
    </StackPanel>
    <m3:ExpandedDockedSearchBar x:Name="SearchPopup" State="{StaticResource SearchState}">
      <m3:ExpandedDockedSearchBar.InputField>
        <m3:SearchBarInputField x:Name="Query" State="{StaticResource SearchState}" PlaceholderText="搜索组件"
                               TextChanged="QueryChanged" SearchRequested="SearchSubmitted" AutomationProperties.Name="搜索组件">
          <m3:MaterialTextField.LeadingIcon>
            <Button Content="←" Click="CloseSearch" Theme="{StaticResource MaterialTextButtonTheme}" Width="48" Height="48" AutomationProperties.Name="关闭搜索" />
          </m3:MaterialTextField.LeadingIcon>
        </m3:SearchBarInputField>
      </m3:ExpandedDockedSearchBar.InputField>
      <ScrollViewer Width="{Binding Bounds.Width, ElementName=Query}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Results" Margin="8" Spacing="4" />
      </ScrollViewer>
    </m3:ExpandedDockedSearchBar>
  </Grid>
</Window>
