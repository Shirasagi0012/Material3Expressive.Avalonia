<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" RequestedThemeVariant="Light"
        x:Class="Material3Expressive.Catalog.MainWindow"
        Title="Material3Expressive.Catalog">
    <Grid ColumnDefinitions="Auto,*">
        <m3:ModalWideNavigationRail x:Name="DemoNavigationRail">
            <m3:ModalWideNavigationRail.ExpandedHeader>
                <m3:IconButton Symbol="MenuOpen" 
                               Click="OnToggleModalRail" />
            </m3:ModalWideNavigationRail.ExpandedHeader>            
            <m3:ModalWideNavigationRail.Header>
                <m3:IconButton Symbol="Menu" 
                               Click="OnToggleModalRail" />
            </m3:ModalWideNavigationRail.Header>
            <m3:WideNavigationRailItem Label="Home" IsSelected="True" Click="OnModalDestinationClick">
                <m3:WideNavigationRailItem.Icon>
                    <m3:MaterialSymbol Symbol="HomeAndGarden" Width="24" Height="24" />
                </m3:WideNavigationRailItem.Icon>
            </m3:WideNavigationRailItem>
            <m3:WideNavigationRailItem Label="Search" Click="OnModalDestinationClick">
                <m3:WideNavigationRailItem.Icon>
                    <m3:MaterialSymbol Symbol="Search" Width="24" Height="24" />
                </m3:WideNavigationRailItem.Icon>
            </m3:WideNavigationRailItem>
            <m3:WideNavigationRailItem Label="Settings" Click="OnModalDestinationClick">
                <m3:WideNavigationRailItem.Icon>
                    <m3:MaterialSymbol Symbol="Settings" Width="24" Height="24" />
                </m3:WideNavigationRailItem.Icon>
            </m3:WideNavigationRailItem>
        </m3:ModalWideNavigationRail>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Margin="32" Background="White">
                <TextBlock Text="RadioButton" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <RadioButton GroupName="CatalogRadio" Content="First" IsChecked="True" />
                    <RadioButton GroupName="CatalogRadio" Content="Second" />
                    <RadioButton GroupName="CatalogDisabledRadio" Content="Disabled selected" IsChecked="True" IsEnabled="False" />
                    <RadioButton GroupName="CatalogDisabledRadio" Content="Disabled unselected" IsEnabled="False" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16" FlowDirection="RightToLeft">
                    <RadioButton GroupName="CatalogRadioRtl" Content="RTL first" IsChecked="True" />
                    <RadioButton GroupName="CatalogRadioRtl" Content="RTL second" />
                    <RadioButton GroupName="CatalogCustomRadio" Content="Custom color" IsChecked="True">
                        <RadioButton.Resources>
                            <Color x:Key="{x:Static m3:MaterialTokens+Comp+RadioButton.SelectedColor}">#008080</Color>
                        </RadioButton.Resources>
                    </RadioButton>
                </StackPanel>
                <TextBlock Text="CheckBox" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <CheckBox Content="Option" />
                    <CheckBox Content="Selected" IsChecked="True" />
                    <CheckBox Content="Disabled" IsChecked="True" IsEnabled="False" />
                    <CheckBox Content="Three states" IsThreeState="True" IsChecked="{x:Null}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <CheckBox Content="Rounded strokes" IsChecked="True">
                        <m3:CheckBoxAppearance.CheckmarkStroke>
                            <m3:CheckBoxStroke Width="3" Cap="Round" Join="Round" />
                        </m3:CheckBoxAppearance.CheckmarkStroke>
                        <m3:CheckBoxAppearance.OutlineStroke>
                            <m3:CheckBoxStroke Width="3" />
                        </m3:CheckBoxAppearance.OutlineStroke>
                    </CheckBox>
                    <CheckBox x:Name="GroupCheckBox" Content="Select group" IsThreeState="True"
                              IsChecked="{x:Null}" Click="OnGroupCheckBoxClick" />
                    <CheckBox x:Name="GroupFirst" Content="First" IsChecked="True" Click="OnGroupChildClick" />
                    <CheckBox x:Name="GroupSecond" Content="Second" Click="OnGroupChildClick" />
                </StackPanel>
                <TextBlock Text="Divider" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <Separator />
                <Separator Margin="16,0" m3:MaterialDivider.Thickness="2" m3:MaterialDivider.Color="#6750A4" />
                <Grid Height="48" ColumnDefinitions="*,Auto,*">
                    <Border Grid.Column="0" Background="#E8DEF8" Margin="0,0,16,0" />
                    <Separator Grid.Column="1" m3:MaterialDivider.Orientation="Vertical" />
                    <Border Grid.Column="2" Background="#D0BCFF" Margin="16,0,0,0" />
                </Grid>
                <TextBlock Text="Badges" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                    <m3:BadgedBox>
                        <m3:BadgedBox.Badge><m3:Badge /></m3:BadgedBox.Badge>
                        <m3:MaterialSymbol Symbol="Favorite" Width="24" Height="24" />
                    </m3:BadgedBox>
                    <m3:BadgedBox>
                        <m3:BadgedBox.Badge><m3:Badge x:Name="DemoBadge" Content="8" AutomationProperties.Name="8 notifications" /></m3:BadgedBox.Badge>
                        <m3:MaterialSymbol Symbol="Search" Width="24" Height="24" />
                    </m3:BadgedBox>
                    <m3:BadgedBox>
                        <m3:BadgedBox.Badge><m3:Badge Content="999+" /></m3:BadgedBox.Badge>
                        <m3:MaterialSymbol Symbol="Settings" Width="24" Height="24" />
                    </m3:BadgedBox>
                    <Button Content="Change badge" Click="OnChangeBadge" />
                </StackPanel>
                <TextBlock Text="NavigationBar" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <m3:NavigationBar x:Name="DemoNavigationBar">
                    <m3:NavigationBarItem Label="Home" IsSelected="True" Click="OnBarDestinationClick">
                        <m3:NavigationBarItem.Icon><m3:MaterialSymbol Symbol="HomeAndGarden" Width="24" Height="24" /></m3:NavigationBarItem.Icon>
                    </m3:NavigationBarItem>
                    <m3:NavigationBarItem Label="Search" Click="OnBarDestinationClick">
                        <m3:NavigationBarItem.Icon>
                            <m3:BadgedBox>
                                <m3:BadgedBox.Badge><m3:Badge Content="99+" /></m3:BadgedBox.Badge>
                                <m3:MaterialSymbol Symbol="Search" Width="24" Height="24" />
                            </m3:BadgedBox>
                        </m3:NavigationBarItem.Icon>
                    </m3:NavigationBarItem>
                    <m3:NavigationBarItem Label="Settings" Click="OnBarDestinationClick">
                        <m3:NavigationBarItem.Icon><m3:MaterialSymbol Symbol="Settings" Width="24" Height="24" /></m3:NavigationBarItem.Icon>
                    </m3:NavigationBarItem>
                </m3:NavigationBar>
                <TextBlock Text="Selected labels" m3:MaterialText.Style="{m3:Typography TitleSmall}" />
                <m3:NavigationBar>
                    <m3:NavigationBarItem Label="Home" AlwaysShowLabel="False" IsSelected="True" Click="OnBarDestinationClick">
                        <m3:NavigationBarItem.Icon><m3:MaterialSymbol Symbol="HomeAndGarden" Width="24" Height="24" /></m3:NavigationBarItem.Icon>
                    </m3:NavigationBarItem>
                    <m3:NavigationBarItem Label="Search" AlwaysShowLabel="False" Click="OnBarDestinationClick">
                        <m3:NavigationBarItem.Icon><m3:MaterialSymbol Symbol="Search" Width="24" Height="24" /></m3:NavigationBarItem.Icon>
                    </m3:NavigationBarItem>
                    <m3:NavigationBarItem Label="Settings" AlwaysShowLabel="False" Click="OnBarDestinationClick">
                        <m3:NavigationBarItem.Icon><m3:MaterialSymbol Symbol="Settings" Width="24" Height="24" /></m3:NavigationBarItem.Icon>
                    </m3:NavigationBarItem>
                    <m3:NavigationBarItem Label="Disabled" AlwaysShowLabel="False" IsEnabled="False">
                        <m3:NavigationBarItem.Icon><m3:MaterialSymbol Symbol="Favorite" Width="24" Height="24" /></m3:NavigationBarItem.Icon>
                    </m3:NavigationBarItem>
                </m3:NavigationBar>
                <TextBlock Text="ShortNavigationBar — Top / EqualWeight" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <m3:ShortNavigationBar x:Name="DemoShortNavigationBar">
                    <m3:ShortNavigationBarItem Label="Home" IsSelected="True" Click="OnShortBarDestinationClick">
                        <m3:ShortNavigationBarItem.Icon><m3:MaterialSymbol Symbol="HomeAndGarden" Width="24" Height="24" /></m3:ShortNavigationBarItem.Icon>
                    </m3:ShortNavigationBarItem>
                    <m3:ShortNavigationBarItem Label="Search" IsSelected="False" Click="OnShortBarDestinationClick">
                        <m3:ShortNavigationBarItem.Icon><m3:MaterialSymbol Symbol="Search" Width="24" Height="24" /></m3:ShortNavigationBarItem.Icon>
                    </m3:ShortNavigationBarItem>
                    <m3:ShortNavigationBarItem Label="Settings" IsSelected="False" Click="OnShortBarDestinationClick">
                        <m3:ShortNavigationBarItem.Icon><m3:MaterialSymbol Symbol="Settings" Width="24" Height="24" /></m3:ShortNavigationBarItem.Icon>
                    </m3:ShortNavigationBarItem>
                </m3:ShortNavigationBar>
                <TextBlock Text="ShortNavigationBar — Start / Centered" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <m3:ShortNavigationBar Arrangement="Centered">
                    <m3:ShortNavigationBarItem Label="Home" IconPosition="Start" IsSelected="True" IsEnabled="True" Click="OnShortBarDestinationClick">
                        <m3:ShortNavigationBarItem.Icon><m3:MaterialSymbol Symbol="HomeAndGarden" Width="24" Height="24" /></m3:ShortNavigationBarItem.Icon>
                    </m3:ShortNavigationBarItem>
                    <m3:ShortNavigationBarItem Label="Search" IconPosition="Start" IsSelected="False" IsEnabled="True" Click="OnShortBarDestinationClick">
                        <m3:ShortNavigationBarItem.Icon><m3:MaterialSymbol Symbol="Search" Width="24" Height="24" /></m3:ShortNavigationBarItem.Icon>
                    </m3:ShortNavigationBarItem>
                    <m3:ShortNavigationBarItem Label="Settings" IconPosition="Start" IsSelected="False" IsEnabled="True" Click="OnShortBarDestinationClick">
                        <m3:ShortNavigationBarItem.Icon><m3:MaterialSymbol Symbol="Settings" Width="24" Height="24" /></m3:ShortNavigationBarItem.Icon>
                    </m3:ShortNavigationBarItem>
                    <m3:ShortNavigationBarItem Label="Disabled" IconPosition="Start" IsSelected="False" IsEnabled="False" Click="OnShortBarDestinationClick">
                        <m3:ShortNavigationBarItem.Icon><m3:MaterialSymbol Symbol="Favorite" Width="24" Height="24" /></m3:ShortNavigationBarItem.Icon>
                    </m3:ShortNavigationBarItem>
                </m3:ShortNavigationBar>
                <TextBlock Text="Switches" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <ToggleSwitch Content="Notifications" />
                    <ToggleSwitch Content="Thumb icon" IsChecked="True">
                        <m3:SwitchAppearance.ThumbContent>
                            <m3:MaterialSymbol Symbol="Check" Width="16" Height="16" />
                        </m3:SwitchAppearance.ThumbContent>
                    </ToggleSwitch>
                    <ToggleSwitch Content="Disabled" IsChecked="True" IsEnabled="False" />
                    <ToggleSwitch Content="State label" OnContent="On" OffContent="Off" />
                </StackPanel>
                <TextBlock Text="Sliders" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <Grid ColumnDefinitions="*,Auto">
                    <Slider x:Name="VolumeSlider" Value="35" />
                    <TextBlock Grid.Column="1" Margin="16,0,0,0" MinWidth="72" VerticalAlignment="Center"
                               Text="{Binding #VolumeSlider.Value, StringFormat='Value: {0:F0}'}"
                               m3:MaterialText.Style="{m3:Typography BodyMedium}" />
                </Grid>
                <Slider Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" SmallChange="10" LargeChange="10" Value="50" />
                <Slider Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Value="0.5" IsEnabled="False" />
                <Slider Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Value="0.35"
                        m3:SliderAppearance.IsCentered="True" m3:SliderAppearance.EnableCornerShrinking="True" />
                <m3:RangeSlider Minimum="0" Maximum="100" Steps="9" RangeStart="20" RangeEnd="80" />
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <Slider Orientation="Vertical" IsDirectionReversed="True" Height="180" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Value="0.35" />
                    <Slider Orientation="Vertical" Height="180" Minimum="0" Maximum="1" TickFrequency="0.25" IsSnapToTickEnabled="True" SmallChange="0.25" LargeChange="0.25" Value="0.5" />
                </StackPanel>
                <Grid ColumnDefinitions="Auto,*" Height="360">
                    <m3:WideNavigationRail x:Name="DemoWideNavigationRail">
                        <m3:WideNavigationRail.Header>
                            <m3:IconButton Symbol="Menu" Click="OnToggleWideRail" />
                        </m3:WideNavigationRail.Header>
                        <m3:WideNavigationRailItem Label="Home" IsSelected="True" Click="OnWideDestinationClick">
                            <m3:WideNavigationRailItem.Icon>
                                <m3:MaterialSymbol Symbol="HomeAndGarden" Width="24" Height="24" />
                            </m3:WideNavigationRailItem.Icon>
                        </m3:WideNavigationRailItem>
                        <m3:WideNavigationRailItem Label="Search" Click="OnWideDestinationClick">
                            <m3:WideNavigationRailItem.Icon>
                                <m3:MaterialSymbol Symbol="Search" Width="24" Height="24" />
                            </m3:WideNavigationRailItem.Icon>
                        </m3:WideNavigationRailItem>
                        <m3:WideNavigationRailItem Label="Settings" Click="OnWideDestinationClick">
                            <m3:WideNavigationRailItem.Icon>
                                <m3:MaterialSymbol Symbol="Settings" Width="24" Height="24" />
                            </m3:WideNavigationRailItem.Icon>
                        </m3:WideNavigationRailItem>
                    </m3:WideNavigationRail>
                    <Border Grid.Column="1"
                            Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainerLow}}"
                            Padding="16">
                        <TextBlock Text="Wide NavigationRail" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                    </Border>
                </Grid>
                <Grid ColumnDefinitions="Auto,*" Height="360">
                    <StackPanel Grid.Column="1" Margin="16" Spacing="12">
                        <TextBlock Text="Modal Wide NavigationRail" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                        <Button Content="Toggle modal rail" Click="OnToggleModalRail"
                                Theme="{StaticResource MaterialTonalButtonTheme}" />
                        <Button Content="Open hidden modal rail" Tag="hidden" Click="OnToggleModalRail"
                                Theme="{StaticResource MaterialTonalButtonTheme}" />
                    </StackPanel>
                    <m3:ModalWideNavigationRail x:Name="DemoHiddenModalRail" HideOnCollapse="True">
                        <m3:ModalWideNavigationRail.ExpandedHeader>
                            <m3:IconButton Symbol="MenuOpen" Tag="hidden" Click="OnToggleModalRail" />
                        </m3:ModalWideNavigationRail.ExpandedHeader>
                        <m3:WideNavigationRailItem Label="Home" IsSelected="True" Click="OnModalDestinationClick">
                            <m3:WideNavigationRailItem.Icon>
                                <m3:MaterialSymbol Symbol="HomeAndGarden" Width="24" Height="24" />
                            </m3:WideNavigationRailItem.Icon>
                        </m3:WideNavigationRailItem>
                        <m3:WideNavigationRailItem Label="Search" Click="OnModalDestinationClick">
                            <m3:WideNavigationRailItem.Icon>
                                <m3:MaterialSymbol Symbol="Search" Width="24" Height="24" />
                            </m3:WideNavigationRailItem.Icon>
                        </m3:WideNavigationRailItem>
                    </m3:ModalWideNavigationRail>
                </Grid>
                <Button Theme="{StaticResource MaterialFilledButtonTheme}" HorizontalAlignment="Center">Welcome to Avalonia!</Button>
                <Button Theme="{StaticResource MaterialElevatedButtonTheme}" HorizontalAlignment="Center">Welcome to Avalonia!</Button>
                <Button Theme="{StaticResource MaterialTonalButtonTheme}" HorizontalAlignment="Center">Welcome to Avalonia!</Button>
                <Button Theme="{StaticResource MaterialOutlinedButtonTheme}" HorizontalAlignment="Center">Welcome to Avalonia!</Button>
                <Button Theme="{StaticResource MaterialTextButtonTheme}" HorizontalAlignment="Center">Welcome to Avalonia!</Button>

                <m3:IconButton Theme="{StaticResource MaterialFilledIconButtonTheme}" Symbol="HomeAndGarden"
                               Classes="medium">
                </m3:IconButton>

                <m3:MaterialSurface Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.Surface}}"
                                    Padding="40" Margin="16"
                                    TonalElevation="{m3:Token {x:Static m3:MaterialTokens+Sys+Elevation.Level1}}"
                                    CornerRadius="{m3:Token {x:Static m3:MaterialTokens+Sys+Shape.Large}}">
                    <StackPanel Spacing="16">
                        <m3:MaterialSurface Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.Surface}}"
                                            Width="200" Height="200"
                                            CornerRadius="{m3:Token {x:Static m3:MaterialTokens+Sys+Shape.Small}}"
                                            ShadowElevation="{Binding #ShadowElevationSlider.Value}"
                                            TonalElevation="{Binding #ShadowElevationSlider.Value}"
                                            m3:MaterialInteraction.IsInteractive="True">
                        </m3:MaterialSurface>

                        <StackPanel>
                            <Label Content="ShadowElevation" />

                            <Grid ColumnDefinitions="*,50">

                                <Slider x:Name="ShadowElevationSlider" Minimum="0" Maximum="50"></Slider>

                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           Text="{Binding #ShadowElevationSlider.Value  ,StringFormat='{}{0:F2}'}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </m3:MaterialSurface>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
