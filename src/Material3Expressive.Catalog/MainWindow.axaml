<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" RequestedThemeVariant="Light"
        x:Class="Material3Expressive.Catalog.MainWindow"
        Title="Material3Expressive.Catalog">
    <Window.Resources>
        <m3:MaterialInteractionSource x:Key="SelectionPreviewSource" />
        <m3:MaterialInteractionSource x:Key="FabElevationPreviewSource" />
    </Window.Resources>
    <Grid ColumnDefinitions="Auto,*">
        <m3:ModalWideNavigationRail x:Name="DemoNavigationRail">
            <m3:ModalWideNavigationRail.ExpandedHeader>
                <m3:IconButton Symbol="MenuOpen" 
                               Click="OnToggleModalRail" />
            </m3:ModalWideNavigationRail.ExpandedHeader>            
            <m3:ModalWideNavigationRail.Header>
                <m3:IconButton Symbol="Menu" 
                               Click="OnToggleModalRail" />
            </m3:ModalWideNavigationRail.Header>
            <m3:WideNavigationRailItem Label="Home" IsSelected="True" Click="OnModalDestinationClick" Icon="{m3:Symbol HomeAndGarden}" />
            <m3:WideNavigationRailItem Label="Search" Click="OnModalDestinationClick" Icon="{m3:Symbol Search}" />
            <m3:WideNavigationRailItem Label="Settings" Click="OnModalDestinationClick" Icon="{m3:Symbol Settings}" />
        </m3:ModalWideNavigationRail>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Margin="32" Background="White">
                <TextBlock Text="FloatingActionButton" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <m3:FloatingActionButton Size="Small" Icon="{m3:Symbol Add}" />
                    <m3:FloatingActionButton Icon="{m3:Symbol Add}" />
                    <m3:FloatingActionButton Size="Medium" Icon="{m3:Symbol Add}" />
                    <m3:FloatingActionButton Size="Large" Icon="{m3:Symbol Add}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <m3:ExtendedFloatingActionButton x:Name="DemoExtendedFab" Content="Create" Icon="{m3:Symbol Add}">
                        <m3:ExtendedFloatingActionButton.Shape>
                            <m3:CutCornerShape TopStart="25%" TopEnd="8" BottomEnd="25%" BottomStart="8" />
                        </m3:ExtendedFloatingActionButton.Shape>
                    </m3:ExtendedFloatingActionButton>
                    <Button Content="Expand / collapse" Click="OnToggleExtendedFab" />
                    <Button Content="Show / hide" Click="OnToggleFabVisibility" />
                </StackPanel>
                <WrapPanel ItemSpacing="16" LineSpacing="12">
                    <m3:FloatingActionButton x:Name="DemoElevationFab" Icon="{m3:Symbol Add}"
                        InteractionSource="{StaticResource FabElevationPreviewSource}" AutomationProperties.Name="Elevation preview" />
                    <Button Content="Hold / release hover" Click="OnFabElevationHover" />
                    <Button Content="Change hover elevation" Click="OnFabElevationChange" />
                    <Button Content="Replace interaction source" Click="OnFabElevationSourceChange" />
                </WrapPanel>
                <m3:FloatingActionButtonMenu x:Name="DemoFabMenu" HorizontalAlignment="Left">
                    <m3:FloatingActionButtonMenu.Button>
                        <m3:ToggleFloatingActionButton x:Name="DemoToggleFab" Size="Medium" CheckedChangeRequested="OnFabCheckedChange">
                            <m3:ToggleFloatingActionButtonIcon>
                                <DrawingImage>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="Red" Geometry="M 2,10 L 10,10 L 10,2 L 14,2 L 14,10 L 22,10 L 22,14 L 14,14 L 14,22 L 10,22 L 10,14 L 2,14 Z" />
                                        <GeometryDrawing Brush="#800000FF" Geometry="M 14,2 L 22,2 L 22,10 L 14,10 Z" />
                                    </DrawingGroup>
                                </DrawingImage>
                            </m3:ToggleFloatingActionButtonIcon>
                        </m3:ToggleFloatingActionButton>
                    </m3:FloatingActionButtonMenu.Button>
                    <m3:FloatingActionButtonMenuItem Content="Create" Click="OnFabMenuItem" Icon="{m3:Symbol Add}" />
                    <m3:FloatingActionButtonMenuItem Content="Edit" Click="OnFabMenuItem" Icon="{m3:Symbol Edit}" />
                </m3:FloatingActionButtonMenu>
                <Button Content="Inset focus ring demo" Click="OnInsetFocusRingDemo" HorizontalAlignment="Left" />
                <Button Content="TextField demo" Click="OnTextFieldDemo" HorizontalAlignment="Left" />
                <Button Content="Date / time pickers" Click="OnDateTimePickerDemo" HorizontalAlignment="Left" />
                <Button Content="Docked search" Click="OnSearchBarDemo" HorizontalAlignment="Left" />
                <Button Content="Search popup" Click="OnExpandedSearchBarDemo" HorizontalAlignment="Left" />
                <Button Content="Search popup with gap" Click="OnSearchBarGapDemo" HorizontalAlignment="Left" />
                <Button Content="Full-screen search" Click="OnFullScreenSearchDemo" HorizontalAlignment="Left" />
                <Button Content="Search app bar" Click="OnSearchAppBarDemo" HorizontalAlignment="Left" />
                <Button Content="Contained search" Click="OnContainedSearchDemo" HorizontalAlignment="Left" />
                <Button Content="Navigation drawers" Click="OnNavigationDrawerDemo" HorizontalAlignment="Left" />
                <Button Content="Swipe to dismiss" Click="OnSwipeToDismissDemo" HorizontalAlignment="Left" />
                <Button Content="SecureTextField demo" Click="OnSecureTextFieldDemo" HorizontalAlignment="Left" />
                <Button Content="NumericUpDown demo" Click="OnNumericUpDownDemo" HorizontalAlignment="Left" />
                <Button Content="RepeatButton demo" Click="OnRepeatButtonDemo" HorizontalAlignment="Left" />
                <Button Content="HyperlinkButton demo" Click="OnHyperlinkButtonDemo" HorizontalAlignment="Left" />
                <Button Content="DropDownButton demo" Click="OnDropDownButtonDemo" HorizontalAlignment="Left" />
                <Button Content="ButtonGroup demo" Click="OnButtonGroupDemo" HorizontalAlignment="Left" />
                <Button Content="Interactive surfaces" Click="OnSurfaceDemo" HorizontalAlignment="Left" />
                <Button Content="GroupBox demo" Click="OnGroupBoxDemo" HorizontalAlignment="Left" />
                <Button Content="Expander demo" Click="OnExpanderDemo" HorizontalAlignment="Left" />
                <Button Content="Menu bar demo" Click="OnMenuBarDemo" HorizontalAlignment="Left" />
                <Button Content="TabRow demo" Click="OnTabRowDemo" HorizontalAlignment="Left" />
                <Button Content="Progress Indicator demo" Click="OnProgressIndicatorDemo" HorizontalAlignment="Left" />
                <Button Content="Loading Indicator demo" Click="OnLoadingIndicatorDemo" HorizontalAlignment="Left" />
                <Button Content="Pull to refresh indicators" Click="OnPullToRefreshDemo" HorizontalAlignment="Left" />
                <Button Content="Multi-aspect carousel" Click="OnCarouselDemo" HorizontalAlignment="Left" />
                <Button Content="Scroll fields" Click="OnScrollFieldDemo" HorizontalAlignment="Left" />
                <Button Content="List items demo" Click="OnListItemDemo" HorizontalAlignment="Left" />

                <Button Content="FloatingToolbar demo" Click="OnFloatingToolbarDemo" HorizontalAlignment="Left" />
                <Button Content="ScrollBar demo" Click="OnScrollBarDemo" HorizontalAlignment="Left" />
                <Button Content="AlertDialog demo" Click="OnAlertDialogDemo" HorizontalAlignment="Left" />
                <Button Content="Picker dialogs demo" Click="OnPickerDialogDemo" HorizontalAlignment="Left" />
                <Button Content="Menu / DropdownMenu demo" Click="OnMenuDemo" HorizontalAlignment="Left" />
                <Button Content="Bitmap / vector icons" Click="OnIconDemo" HorizontalAlignment="Left" />
                <Button Content="CommandBar demo" Click="OnCommandBarDemo" HorizontalAlignment="Left" />
                <Button Content="ComboBox demo" Click="OnComboBoxDemo" HorizontalAlignment="Left" />
                <TextBlock Text="Precision pointer sizing" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <CheckBox x:Name="PrecisionSizing" Content="使用精确指针尺寸" IsChecked="False" />
                <WrapPanel m3:MaterialPrecisionPointer.IsEnabled="{Binding IsChecked, ElementName=PrecisionSizing}">
                    <Button Content="Save" Margin="0,0,12,0" />
                    <Button Content="Add" m3:MaterialButton.Icon="{m3:Symbol Add}" Margin="0,0,12,0" />
                    <ToggleButton Content="Pin" m3:MaterialButton.Icon="{m3:Symbol PushPin}" Margin="0,0,12,0" />
                    <ToggleButton Content="Cut toggle" Theme="{StaticResource MaterialOutlinedToggleButtonTheme}" Margin="0,0,12,0">
                        <m3:MaterialButton.Shape><m3:CutCornerShape TopStart="16" BottomEnd="16" /></m3:MaterialButton.Shape>
                        <m3:ToggleButtonAppearance.CheckedShape><m3:RoundedCornerShape TopStart="25%" TopEnd="25%" BottomEnd="25%" BottomStart="25%" /></m3:ToggleButtonAppearance.CheckedShape>
                        <m3:MaterialButton.PressedShape><m3:CutCornerShape TopStart="4" TopEnd="4" BottomEnd="4" BottomStart="4" /></m3:MaterialButton.PressedShape>
                    </ToggleButton>
                    <Button Content="Medium" Classes="medium" Margin="0,0,12,0" />
                    <Button Content="Standard override" m3:MaterialPrecisionPointer.IsEnabled="False" />
                </WrapPanel>
                <TextBlock Text="Card" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <WrapPanel>
                    <m3:Card Width="180" Height="100" Margin="0,0,16,16">
                        <m3:CardColumn Margin="16"><TextBlock Text="Filled" m3:MaterialText.Style="{m3:Typography TitleMedium}" /><TextBlock Text="Passive content" /></m3:CardColumn>
                    </m3:Card>
                    <m3:ElevatedCard Width="180" Height="100" Margin="0,0,16,16">
                        <m3:CardColumn Margin="16"><TextBlock Text="Elevated" m3:MaterialText.Style="{m3:Typography TitleMedium}" /><TextBlock Text="Passive content" /></m3:CardColumn>
                    </m3:ElevatedCard>
                    <m3:OutlinedCard Width="180" Height="100" Margin="0,0,16,16">
                        <m3:CardColumn Margin="16"><TextBlock Text="Outlined" m3:MaterialText.Style="{m3:Typography TitleMedium}" /><TextBlock Text="Passive content" /></m3:CardColumn>
                    </m3:OutlinedCard>
                </WrapPanel>
                <WrapPanel>
                    <m3:Card IsClickable="True" Click="OnCardClick" Width="180" Height="100" Margin="0,0,16,16">
                        <m3:CardColumn Margin="16"><TextBlock Text="Filled" m3:MaterialText.Style="{m3:Typography TitleMedium}" /><TextBlock Text="Clickable content" /></m3:CardColumn>
                    </m3:Card>
                    <m3:ElevatedCard IsClickable="True" Click="OnCardClick" Width="180" Height="100" Margin="0,0,16,16">
                        <m3:CardColumn Margin="16"><TextBlock Text="Elevated" m3:MaterialText.Style="{m3:Typography TitleMedium}" /><TextBlock Text="Clickable content" /></m3:CardColumn>
                    </m3:ElevatedCard>
                    <m3:OutlinedCard IsClickable="True" Click="OnCardClick" Width="180" Height="100" Margin="0,0,16,16">
                        <m3:CardColumn Margin="16"><TextBlock Text="Outlined" m3:MaterialText.Style="{m3:Typography TitleMedium}" /><TextBlock Text="Clickable content" /></m3:CardColumn>
                    </m3:OutlinedCard>
                    <m3:OutlinedCard IsClickable="True" IsEnabled="False" Width="180" Height="100" Margin="0,0,16,16">
                        <m3:CardColumn Margin="16"><TextBlock Text="Disabled" m3:MaterialText.Style="{m3:Typography TitleMedium}" /><TextBlock Text="Clickable content" /></m3:CardColumn>
                    </m3:OutlinedCard>
                </WrapPanel>
                <TextBlock x:Name="DemoCardStatus" Text="Click a card" />
                <TextBlock Text="Weighted card content" m3:MaterialText.Style="{m3:Typography TitleSmall}" />
                <CheckBox x:Name="CardColumnFill" Content="Fill weighted hosts" IsChecked="True" />
                <WrapPanel>
                    <m3:Card Width="240" Height="200" Margin="0,0,16,16">
                        <m3:CardColumn Margin="16">
                            <TextBlock Text="Header (preferred height)" />
                            <m3:CardColumnItem Weight="1" Fill="{Binding IsChecked, ElementName=CardColumnFill}" Alignment="Start">
                                <TextBlock Text="Weight 1 · Start" />
                            </m3:CardColumnItem>
                            <m3:CardColumnItem Weight="2" Fill="{Binding IsChecked, ElementName=CardColumnFill}" Alignment="End">
                                <TextBlock Text="Weight 2 · End" />
                            </m3:CardColumnItem>
                            <TextBlock Text="Footer (preferred height)" />
                        </m3:CardColumn>
                    </m3:Card>
                    <m3:OutlinedCard Width="240" Height="200" FlowDirection="RightToLeft" Margin="0,0,16,16">
                        <m3:CardColumn Margin="16">
                            <TextBlock Text="RTL" />
                            <m3:CardColumnItem Weight="1" Alignment="Start"><TextBlock Text="Start" /></m3:CardColumnItem>
                            <m3:CardColumnItem Weight="1" Alignment="Center"><TextBlock Text="Center" /></m3:CardColumnItem>
                            <m3:CardColumnItem Weight="1" Alignment="End"><TextBlock Text="End" /></m3:CardColumnItem>
                        </m3:CardColumn>
                    </m3:OutlinedCard>
                </WrapPanel>
                <TextBlock Text="Segmented button" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <m3:SingleChoiceSegmentedButtonRow>
                    <m3:SegmentedButton Content="Day" IsSelected="True" Click="OnSingleSegmentClick" />
                    <m3:SegmentedButton Content="Week" Click="OnSingleSegmentClick" />
                    <m3:SegmentedButton Content="Month" Click="OnSingleSegmentClick" />
                </m3:SingleChoiceSegmentedButtonRow>
                <m3:MultiChoiceSegmentedButtonRow>
                    <m3:SegmentedButton Content="Unread" Click="OnMultiSegmentClick" />
                    <m3:SegmentedButton Content="Starred" IsSelected="True" Click="OnMultiSegmentClick" />
                    <m3:SegmentedButton Content="Archived" IsEnabled="False" />
                </m3:MultiChoiceSegmentedButtonRow>
                <m3:SingleChoiceSegmentedButtonRow BaseShape="8">
                    <m3:SegmentedButton Content="List" Click="OnSingleSegmentClick" InactiveIcon="{m3:Symbol List}" />
                    <m3:SegmentedButton Content="Grid" IsSelected="True" Click="OnSingleSegmentClick" InactiveIcon="{m3:Symbol GridView}" />
                </m3:SingleChoiceSegmentedButtonRow>
                <m3:SingleChoiceSegmentedButtonRow>
                    <m3:SegmentedButton Content="Cut start" IsSelected="True" Click="OnSingleSegmentClick">
                        <m3:SegmentedButton.Shape><m3:CutCornerShape TopStart="16" BottomStart="16" /></m3:SegmentedButton.Shape>
                    </m3:SegmentedButton>
                    <m3:SegmentedButton Content="Middle" Click="OnSingleSegmentClick" />
                    <m3:SegmentedButton Content="Cut end" Click="OnSingleSegmentClick">
                        <m3:SegmentedButton.Shape><m3:CutCornerShape TopEnd="16" BottomEnd="16" /></m3:SegmentedButton.Shape>
                    </m3:SegmentedButton>
                </m3:SingleChoiceSegmentedButtonRow>
                <TextBlock Text="Reusable selection icons" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <CheckBox x:Name="StandaloneIconSelection" Content="Selected" IsChecked="True" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Border Width="40" Height="32">
                        <m3:SegmentedButtonIcon IsActive="{Binding IsChecked, ElementName=StandaloneIconSelection}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <m3:SegmentedButtonIcon IsActive="{Binding IsChecked, ElementName=StandaloneIconSelection}"
                                            InactiveContent="{m3:Symbol StarBorder}" ActiveContent="{m3:Symbol Star}"
                                            Foreground="#6750A4" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <m3:SegmentedButtonIcon IsActive="{Binding IsChecked, ElementName=StandaloneIconSelection}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <m3:SegmentedButtonIcon.ActiveContent>
                            <Border Width="28" Height="12" Background="#146C4C" CornerRadius="4" />
                        </m3:SegmentedButtonIcon.ActiveContent>
                        <m3:SegmentedButtonIcon.InactiveContent>
                            <Border Width="12" Height="20" Background="#79747E" CornerRadius="4" />
                        </m3:SegmentedButtonIcon.InactiveContent>
                    </m3:SegmentedButtonIcon>
                </StackPanel>
                <Button Content="AppBar demo" Click="OnAppBarDemo" HorizontalAlignment="Left" />
                <Button Content="Tooltip demo" Click="OnTooltipDemo" HorizontalAlignment="Left" />
                <Button Content="Drag handle demo" Click="OnDragHandleDemo" HorizontalAlignment="Left" />
                <Button Content="Snackbar demo" Click="OnSnackbarDemo" HorizontalAlignment="Left" />
                <TextBlock Text="Chip" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <WrapPanel>
                    <m3:AssistChip Content="Add to calendar" Margin="0,0,12,0" LeadingIcon="{m3:Symbol CalendarMonth}" />
                    <m3:AssistChip Content="Elevated assist" IsElevated="True" Margin="0,0,12,0" />
                    <m3:SuggestionChip Content="Suggestion" Margin="0,0,12,0" />
                    <m3:SuggestionChip Content="Elevated suggestion" IsElevated="True" />
                </WrapPanel>
                <WrapPanel>
                    <m3:FilterChip Content="Filter" Click="OnChipClick" Margin="0,0,12,0" />
                    <m3:FilterChip Content="Selected" IsSelected="True" Click="OnChipClick" Margin="0,0,12,0" />
                    <m3:FilterChip Content="Shape morph" Click="OnChipClick" Margin="0,0,12,0" />
                    <m3:FilterChip Content="Elevated filter" IsElevated="True" Click="OnChipClick" Margin="0,0,12,0" />
                    <m3:InputChip Content="Contact" Click="OnChipClick" Margin="0,0,12,0" TrailingIcon="{m3:Symbol Close}">
                        <m3:InputChip.Avatar><Border Width="24" Height="24" Background="#E8DEF8" Child="{m3:Symbol Person, Size=18}" /></m3:InputChip.Avatar>
                    </m3:InputChip>
                    <m3:InputChip Content="Disabled contact" IsSelected="True" IsEnabled="False" />
                </WrapPanel>
                <TextBlock Text="Fixed cut chips" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <WrapPanel>
                    <m3:AssistChip Content="Cut assist" IsElevated="True" Margin="0,0,12,0">
                        <m3:AssistChip.Shape><m3:CutCornerShape TopStart="12" BottomEnd="12" /></m3:AssistChip.Shape>
                    </m3:AssistChip>
                    <m3:SuggestionChip Content="Cut suggestion" Margin="0,0,12,0">
                        <m3:SuggestionChip.Shape><m3:CutCornerShape TopStart="25%" BottomEnd="25%" /></m3:SuggestionChip.Shape>
                    </m3:SuggestionChip>
                    <m3:FilterChip Content="Fixed cut filter" Click="OnChipClick" Margin="0,0,12,0">
                        <m3:FilterChip.Shape><m3:CutCornerShape TopStart="12" TopEnd="4" BottomEnd="12" BottomStart="4" /></m3:FilterChip.Shape>
                    </m3:FilterChip>
                    <m3:InputChip Content="Cut contact" Click="OnChipClick" TrailingIcon="{m3:Symbol Close}">
                        <m3:InputChip.Shape><m3:CutCornerShape TopStart="8" TopEnd="8" BottomEnd="8" BottomStart="8" /></m3:InputChip.Shape>
                    </m3:InputChip>
                </WrapPanel>
                <TextBlock Text="State shape chips" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <TextBlock Text="Click to select; hold to press. Cut corners interpolate, mixed families switch at the spring midpoint." TextWrapping="Wrap" />
                <WrapPanel>
                    <m3:FilterChip Content="Cut morph" Click="OnChipClick" Margin="0,0,12,0">
                        <m3:FilterChip.Shapes>
                            <m3:ChipShapes>
                                <m3:ChipShapes.Shape><m3:CutCornerShape TopStart="12" TopEnd="4" BottomEnd="8" BottomStart="2" /></m3:ChipShapes.Shape>
                                <m3:ChipShapes.SelectedShape><m3:CutCornerShape TopStart="50%" TopEnd="50%" BottomEnd="50%" BottomStart="50%" /></m3:ChipShapes.SelectedShape>
                                <m3:ChipShapes.PressedShape><m3:CutCornerShape TopStart="4" TopEnd="4" BottomEnd="4" BottomStart="4" /></m3:ChipShapes.PressedShape>
                            </m3:ChipShapes>
                        </m3:FilterChip.Shapes>
                    </m3:FilterChip>
                    <m3:InputChip Content="Cut / round" Click="OnChipClick" TrailingIcon="{m3:Symbol Close}">
                        <m3:InputChip.Shapes>
                            <m3:ChipShapes>
                                <m3:ChipShapes.Shape><m3:CutCornerShape TopStart="12" TopEnd="12" BottomEnd="12" BottomStart="12" /></m3:ChipShapes.Shape>
                                <m3:ChipShapes.SelectedShape><m3:RoundedCornerShape TopStart="50%" TopEnd="50%" BottomEnd="50%" BottomStart="50%" /></m3:ChipShapes.SelectedShape>
                                <m3:ChipShapes.PressedShape><m3:CutCornerShape TopStart="4" TopEnd="4" BottomEnd="4" BottomStart="4" /></m3:ChipShapes.PressedShape>
                            </m3:ChipShapes>
                        </m3:InputChip.Shapes>
                    </m3:InputChip>
                </WrapPanel>
                <TextBlock Text="Chip slot arrangements" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <WrapPanel>
                    <m3:FilterChip Width="180" Content="Start" HorizontalArrangement="Start" Click="OnChipClick" LeadingIcon="{m3:Symbol Check}" TrailingIcon="{m3:Symbol Close}" Margin="0,0,12,0" />
                    <m3:FilterChip Width="180" Content="Centered" HorizontalArrangement="Center" Click="OnChipClick" LeadingIcon="{m3:Symbol Check}" TrailingIcon="{m3:Symbol Close}" Margin="0,0,12,0" />
                    <m3:FilterChip Width="180" Content="End" HorizontalArrangement="End" Click="OnChipClick" LeadingIcon="{m3:Symbol Check}" TrailingIcon="{m3:Symbol Close}" Margin="0,0,12,0" />
                    <m3:InputChip Width="180" Content="Space between" HorizontalArrangement="SpaceBetween" Click="OnChipClick" LeadingIcon="{m3:Symbol Person}" TrailingIcon="{m3:Symbol Close}" Margin="0,0,12,0" />
                    <m3:InputChip Width="180" Content="Space around" HorizontalArrangement="SpaceAround" Click="OnChipClick" LeadingIcon="{m3:Symbol Person}" TrailingIcon="{m3:Symbol Close}" Margin="0,0,12,0" />
                    <m3:InputChip Width="180" Content="Space evenly" HorizontalArrangement="SpaceEvenly" Click="OnChipClick" LeadingIcon="{m3:Symbol Person}" TrailingIcon="{m3:Symbol Close}" Margin="0,0,12,0" />
                    <m3:FilterChip Width="220" Content="Spaced at end" LeadingIcon="{m3:Symbol Check}" TrailingIcon="{m3:Symbol Close}" Click="OnChipClick" Margin="0,0,12,0">
                        <m3:FilterChip.HorizontalArrangement><m3:SpacedHorizontalArrangement Space="12" Alignment="Right" /></m3:FilterChip.HorizontalArrangement>
                    </m3:FilterChip>
                    <m3:InputChip Width="220" Content="Physical order in RTL" FlowDirection="RightToLeft" HorizontalArrangement="Absolute.SpaceEvenly"
                                  LeadingIcon="{m3:Symbol Person}" TrailingIcon="{m3:Symbol Close}" Click="OnChipClick" />
                </WrapPanel>
                <TextBlock Text="Icon button widths" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <m3:IconButton Symbol="Remove" WidthOption="Narrow" Theme="{StaticResource MaterialFilledIconButtonTheme}" AutomationProperties.Name="Narrow" />
                    <m3:IconButton Symbol="Home" Theme="{StaticResource MaterialFilledIconButtonTheme}" AutomationProperties.Name="Uniform" />
                    <m3:IconButton Symbol="Add" WidthOption="Wide" Theme="{StaticResource MaterialFilledIconButtonTheme}" AutomationProperties.Name="Wide" />
                    <m3:IconButton AutomationProperties.Name="Notifications with unread indicator">
                        <Grid Width="24" Height="24">
                            <m3:MaterialSymbol Symbol="Notifications" />
                            <Ellipse Width="6" Height="6" Fill="Red" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>
                    </m3:IconButton>
                    <m3:IconButton Symbol="Favorite" WidthOption="Wide" Classes="medium" Theme="{StaticResource MaterialTonalIconButtonTheme}" AutomationProperties.Name="Medium wide" />
                </StackPanel>
                <TextBlock Text="Cut icon button morphs" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <m3:IconButton Symbol="Add" Width="64" Height="56" Theme="{StaticResource MaterialOutlinedIconButtonTheme}" AutomationProperties.Name="Cut corner add">
                        <m3:MaterialButton.Shape><m3:CutCornerShape TopStart="20" BottomEnd="20" /></m3:MaterialButton.Shape>
                        <m3:MaterialButton.PressedShape><m3:CutCornerShape TopStart="8" TopEnd="8" BottomEnd="8" BottomStart="8" /></m3:MaterialButton.PressedShape>
                    </m3:IconButton>
                    <m3:IconToggleButton Symbol="Favorite" Width="64" Height="56" Theme="{StaticResource MaterialFilledIconToggleButtonTheme}" CheckedChangeRequested="OnIconCheckedChange" AutomationProperties.Name="Cut corner favorite">
                        <m3:MaterialButton.Shape><m3:CutCornerShape TopStart="24" BottomEnd="24" /></m3:MaterialButton.Shape>
                        <m3:IconToggleButton.CheckedShape><m3:CutCornerShape TopStart="25%" TopEnd="25%" BottomEnd="25%" BottomStart="25%" /></m3:IconToggleButton.CheckedShape>
                        <m3:MaterialButton.PressedShape><m3:CutCornerShape TopStart="4" TopEnd="4" BottomEnd="4" BottomStart="4" /></m3:MaterialButton.PressedShape>
                    </m3:IconToggleButton>
                </StackPanel>
                <TextBlock Text="Ambient and vibrant icon colors" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <StackPanel Orientation="Horizontal" Spacing="12" TextElement.Foreground="#245A80">
                    <m3:IconButton Symbol="Home" AutomationProperties.Name="Ambient standard" />
                    <m3:IconButton Symbol="Home" Theme="{StaticResource MaterialVibrantIconButtonTheme}" AutomationProperties.Name="Vibrant standard" />
                    <m3:IconButton Symbol="Home" Theme="{StaticResource MaterialOutlinedIconButtonTheme}" AutomationProperties.Name="Ambient outlined" />
                    <m3:IconButton Symbol="Home" Theme="{StaticResource MaterialOutlinedVibrantIconButtonTheme}" AutomationProperties.Name="Vibrant outlined" />
                </StackPanel>
                <TextBlock Text="Custom content and feedback colors" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <StackPanel Orientation="Horizontal" Spacing="12" TextElement.Foreground="#245A80">
                    <m3:IconButton Symbol="Home" Foreground="#A02070" Theme="{StaticResource MaterialVibrantIconButtonTheme}" AutomationProperties.Name="Pink icon, blue ambient feedback" />
                    <m3:IconButton Symbol="Home" Foreground="#A02070" Theme="{StaticResource MaterialOutlinedVibrantIconButtonTheme}" AutomationProperties.Name="Pink outlined icon and feedback" />
                    <m3:IconButton Symbol="Favorite" Foreground="#A02070" Theme="{StaticResource MaterialTonalIconButtonTheme}" AutomationProperties.Name="Pink tonal icon and feedback" />
                </StackPanel>
                <TextBlock Text="Controlled icon toggles" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <m3:IconToggleButton Symbol="Favorite" CheckedChangeRequested="OnIconCheckedChange" AutomationProperties.Name="Favorite" />
                    <m3:IconToggleButton Symbol="Favorite" Theme="{StaticResource MaterialFilledIconToggleButtonTheme}" CheckedChangeRequested="OnIconCheckedChange" AutomationProperties.Name="Filled favorite" />
                    <m3:IconToggleButton Symbol="Favorite" Theme="{StaticResource MaterialVibrantIconToggleButtonTheme}" CheckedChangeRequested="OnIconCheckedChange" AutomationProperties.Name="Vibrant favorite" />
                    <m3:IconToggleButton Symbol="Favorite" Theme="{StaticResource MaterialOutlinedVibrantIconToggleButtonTheme}" Classes="morph" CheckedChangeRequested="OnIconCheckedChange" AutomationProperties.Name="Vibrant outlined favorite" />
                    <m3:IconToggleButton Symbol="Favorite" Theme="{StaticResource MaterialOutlinedIconToggleButtonTheme}" Classes="morph" CheckedChangeRequested="OnIconCheckedChange" AutomationProperties.Name="Outlined favorite" />
                    <m3:IconToggleButton Symbol="Favorite" Theme="{StaticResource MaterialTonalIconToggleButtonTheme}" IsChecked="True" CheckedChangeRequested="OnIconCheckedChange" AutomationProperties.Name="Tonal favorite" />
                    <m3:IconToggleButton Symbol="Favorite" Theme="{StaticResource MaterialFilledIconToggleButtonTheme}" WidthOption="Wide" CheckedCornerRadius="12" m3:MaterialButton.PressedCornerRadius="8" CheckedChangeRequested="OnIconCheckedChange" AutomationProperties.Name="Shape-changing favorite" />
                    <m3:IconToggleButton Symbol="Favorite" Theme="{StaticResource MaterialTonalIconToggleButtonTheme}" IsChecked="True" IsEnabled="False" AutomationProperties.Name="Disabled favorite" />
                </StackPanel>
                <TextBlock Text="Size-aware shape presets" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <m3:IconButton Symbol="Add" Classes="square morph" Theme="{StaticResource MaterialFilledIconButtonTheme}" AutomationProperties.Name="Square morph" />
                    <m3:IconToggleButton Symbol="Favorite" Classes="medium morph" Theme="{StaticResource MaterialFilledIconToggleButtonTheme}" CheckedChangeRequested="OnIconCheckedChange" AutomationProperties.Name="Round morph favorite" />
                    <m3:IconToggleButton Symbol="Favorite" Classes="medium square morph" Theme="{StaticResource MaterialTonalIconToggleButtonTheme}" CheckedChangeRequested="OnIconCheckedChange" AutomationProperties.Name="Square morph favorite" />
                  </StackPanel>
                <TextBlock Text="ToggleButton" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ToggleButton Content="Filled" />
                    <ToggleButton Content="Tonal" IsChecked="True" Theme="{StaticResource MaterialTonalToggleButtonTheme}" />
                    <ToggleButton Content="Elevated" Theme="{StaticResource MaterialElevatedToggleButtonTheme}" />
                    <ToggleButton Content="Outlined" Theme="{StaticResource MaterialOutlinedToggleButtonTheme}" />
                    <ToggleButton Content="Disabled" IsChecked="True" IsEnabled="False" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ToggleButton Content="XS" Classes="xsmall" />
                    <ToggleButton Content="Small" IsChecked="True" />
                    <ToggleButton Content="Medium" Classes="medium" />
                    <ToggleButton Content="Large" Classes="large" />
                    <ToggleButton Content="XL" Classes="xlarge" />
                </StackPanel>
                <Button Content="Send" HorizontalAlignment="Left" m3:MaterialButton.Icon="{m3:Symbol Send}" />
                <ToggleButton Content="Favorite" HorizontalAlignment="Left" m3:MaterialButton.Icon="{m3:Symbol Favorite}" />
                <TextBlock Text="SplitButton" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <m3:SplitButton>
                        <m3:SplitButton.LeadingButton><Button Content="Save" Theme="{StaticResource MaterialFilledSplitButtonLeadingTheme}" /></m3:SplitButton.LeadingButton>
                        <m3:SplitButton.TrailingButton>
                            <ToggleButton Theme="{StaticResource MaterialFilledSplitButtonTrailingTheme}" m3:MaterialButton.Icon="{m3:Symbol KeyboardArrowDown}" />
                        </m3:SplitButton.TrailingButton>
                    </m3:SplitButton>
                    <m3:SplitButton>
                        <m3:SplitButton.LeadingButton><Button Content="Save" Theme="{StaticResource MaterialTonalSplitButtonLeadingTheme}" /></m3:SplitButton.LeadingButton>
                        <m3:SplitButton.TrailingButton><ToggleButton Content="…" IsChecked="True" Theme="{StaticResource MaterialTonalSplitButtonTrailingTheme}" /></m3:SplitButton.TrailingButton>
                    </m3:SplitButton>
                    <m3:SplitButton>
                        <m3:SplitButton.LeadingButton><Button Content="Save" Theme="{StaticResource MaterialElevatedSplitButtonLeadingTheme}" /></m3:SplitButton.LeadingButton>
                        <m3:SplitButton.TrailingButton><Button Content="…" Theme="{StaticResource MaterialElevatedSplitButtonTrailingTheme}" /></m3:SplitButton.TrailingButton>
                    </m3:SplitButton>
                    <m3:SplitButton>
                        <m3:SplitButton.LeadingButton><Button Content="Save" Theme="{StaticResource MaterialOutlinedSplitButtonLeadingTheme}" /></m3:SplitButton.LeadingButton>
                        <m3:SplitButton.TrailingButton><ToggleButton Content="…" Theme="{StaticResource MaterialOutlinedSplitButtonTrailingTheme}" /></m3:SplitButton.TrailingButton>
                    </m3:SplitButton>
                </StackPanel>
                <m3:SplitButton HorizontalAlignment="Left">
                    <m3:SplitButton.LeadingButton>
                        <Button Content="Save with cut corners" Theme="{StaticResource MaterialTonalSplitButtonLeadingTheme}">
                            <m3:MaterialButton.Shape><m3:CutCornerShape TopStart="18" BottomStart="18" TopEnd="4" BottomEnd="4" /></m3:MaterialButton.Shape>
                            <m3:MaterialButton.PressedShape><m3:CutCornerShape TopStart="8" BottomStart="8" TopEnd="2" BottomEnd="2" /></m3:MaterialButton.PressedShape>
                        </Button>
                    </m3:SplitButton.LeadingButton>
                    <m3:SplitButton.TrailingButton>
                        <ToggleButton Theme="{StaticResource MaterialTonalSplitButtonTrailingTheme}" m3:MaterialButton.Icon="{m3:Symbol KeyboardArrowDown}" AutomationProperties.Name="Save options">
                            <m3:MaterialButton.Shape><m3:CutCornerShape TopStart="4" BottomStart="4" TopEnd="18" BottomEnd="18" /></m3:MaterialButton.Shape>
                            <m3:MaterialButton.PressedShape><m3:CutCornerShape TopStart="2" BottomStart="2" TopEnd="8" BottomEnd="8" /></m3:MaterialButton.PressedShape>
                            <m3:ToggleButtonAppearance.CheckedShape><m3:RoundedCornerShape TopStart="50%" BottomStart="50%" TopEnd="50%" BottomEnd="50%" /></m3:ToggleButtonAppearance.CheckedShape>
                        </ToggleButton>
                    </m3:SplitButton.TrailingButton>
                </m3:SplitButton>
                <TextBlock Text="RadioButton" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <RadioButton GroupName="CatalogRadio" Content="First" IsChecked="True" />
                    <RadioButton GroupName="CatalogRadio" Content="Second" />
                    <RadioButton GroupName="CatalogDisabledRadio" Content="Disabled selected" IsChecked="True" IsEnabled="False" />
                    <RadioButton GroupName="CatalogDisabledRadio" Content="Disabled unselected" IsEnabled="False" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16" FlowDirection="RightToLeft">
                    <RadioButton GroupName="CatalogRadioRtl" Content="RTL first" IsChecked="True" />
                    <RadioButton GroupName="CatalogRadioRtl" Content="RTL second" />
                    <RadioButton GroupName="CatalogCustomRadio" Content="Custom color" IsChecked="True">
                        <RadioButton.Resources>
                            <Color x:Key="{x:Static m3:MaterialTokens+Comp+RadioButton.SelectedColor}">#008080</Color>
                        </RadioButton.Resources>
                    </RadioButton>
                </StackPanel>
                <TextBlock Text="CheckBox" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <Button Content="路径效果示例" Click="OnCheckBoxStrokeDemo" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <CheckBox Content="Option" />
                    <CheckBox Content="Selected" IsChecked="True" />
                    <CheckBox Content="Disabled" IsChecked="True" IsEnabled="False" />
                    <CheckBox Content="Three states" IsThreeState="True" IsChecked="{x:Null}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <CheckBox Content="Rounded strokes" IsChecked="True">
                        <m3:CheckBoxAppearance.CheckmarkStroke>
                            <m3:CheckBoxStroke Width="3" Cap="Round" Join="Round" />
                        </m3:CheckBoxAppearance.CheckmarkStroke>
                        <m3:CheckBoxAppearance.OutlineStroke>
                            <m3:CheckBoxStroke Width="3" />
                        </m3:CheckBoxAppearance.OutlineStroke>
                    </CheckBox>
                    <CheckBox x:Name="GroupCheckBox" Content="Select group" IsThreeState="True"
                              IsChecked="{x:Null}" Click="OnGroupCheckBoxClick" />
                    <CheckBox x:Name="GroupFirst" Content="First" IsChecked="True" Click="OnGroupChildClick" />
                    <CheckBox x:Name="GroupSecond" Content="Second" Click="OnGroupChildClick" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <CheckBox Content="Shared feedback" m3:CheckBoxAppearance.InteractionSource="{StaticResource SelectionPreviewSource}" />
                    <RadioButton Content="Independent selection" GroupName="SourcePreview"
                                 m3:RadioButtonAppearance.InteractionSource="{StaticResource SelectionPreviewSource}" />
                    <Button Content="Toggle hover preview" Click="OnSelectionHoverPreview" />
                </StackPanel>
                <TextBlock Text="Selection owned by the row" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <m3:ToggleableSurface x:Name="DisplaySelectionRow" CheckedChangeRequested="OnDisplaySelectionChanged" Padding="16" CornerRadius="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <m3:CheckBoxDisplay IsChecked="{Binding IsChecked, ElementName=DisplaySelectionRow}" />
                            <TextBlock Text="Select this row" VerticalAlignment="Center" />
                        </StackPanel>
                    </m3:ToggleableSurface>
                    <m3:ToggleableSurface x:Name="DisplayRadioRow" CheckedChangeRequested="OnDisplaySelectionChanged" Padding="16" CornerRadius="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <m3:RadioButtonDisplay IsChecked="{Binding IsChecked, ElementName=DisplayRadioRow}" />
                            <TextBlock Text="Application selection" VerticalAlignment="Center" />
                        </StackPanel>
                    </m3:ToggleableSurface>
                    <m3:ToggleableSurface x:Name="DisplaySwitchRow" CheckedChangeRequested="OnDisplaySelectionChanged" Padding="16" CornerRadius="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <m3:SwitchDisplay IsChecked="{Binding IsChecked, ElementName=DisplaySwitchRow}" />
                            <TextBlock Text="Enable this option" VerticalAlignment="Center" />
                        </StackPanel>
                    </m3:ToggleableSurface>
                    <m3:CheckBoxDisplay IsChecked="{x:Null}" />
                    <m3:CheckBoxDisplay IsChecked="True" IsEnabled="False" />
                </StackPanel>
                <TextBlock Text="Scaffold" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <WrapPanel>
                    <Button Content="Start" Tag="Start" Click="OnScaffoldPositionClick" />
                    <Button Content="Center" Tag="Center" Click="OnScaffoldPositionClick" />
                    <Button Content="End" Tag="End" Click="OnScaffoldPositionClick" />
                    <Button Content="End overlay" Tag="EndOverlay" Click="OnScaffoldPositionClick" />
                    <Button Content="Bars" Click="OnScaffoldBarsClick" />
                    <Button Content="Show snackbar" Click="OnScaffoldSnackbarClick" />
                    <Button Content="RTL" Click="OnScaffoldDirectionClick" />
                </WrapPanel>
                <m3:Scaffold x:Name="DemoScaffold" Height="320" ContentWindowInsets="8,0,12,8">
                    <m3:Scaffold.TopBar>
                        <m3:TopAppBar Title="Screen title" />
                    </m3:Scaffold.TopBar>
                    <m3:Scaffold.BottomBar>
                        <m3:NavigationBar>
                            <m3:NavigationBarItem Label="Home" IsSelected="True" Click="OnBarDestinationClick" Icon="{m3:Symbol HomeAndGarden}" />
                            <m3:NavigationBarItem Label="Search" Click="OnBarDestinationClick" Icon="{m3:Symbol Search}" />
                            <m3:NavigationBarItem Label="Settings" Click="OnBarDestinationClick" Icon="{m3:Symbol Settings}" />
                        </m3:NavigationBar>
                    </m3:Scaffold.BottomBar>
                    <m3:Scaffold.FloatingActionButton>
                        <m3:FloatingActionButton Click="OnScaffoldSnackbarClick" AutomationProperties.Name="Create item" Icon="{m3:Symbol Add}" />
                    </m3:Scaffold.FloatingActionButton>
                    <m3:Scaffold.SnackbarHost>
                        <m3:SnackbarHost x:Name="DemoScaffoldSnackbar" />
                    </m3:Scaffold.SnackbarHost>
                    <ScrollViewer>
                        <!-- Apply/consume padding inside the scroller, as in Compose's sample. -->
                        <Border Padding="{Binding ContentPadding, ElementName=DemoScaffold}"
                                m3:MaterialWindowInsets.ConsumePadding="{Binding ContentPadding, ElementName=DemoScaffold}">
                            <StackPanel Spacing="12" Margin="16">
                                <TextBlock Text="Scaffold content" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                                <TextBlock Text="{Binding ContentPadding, ElementName=DemoScaffold}" />
                                <Border Height="64" Background="#E8DEF8" />
                                <Border Height="64" Background="#D0BCFF" />
                                <Border Height="64" Background="#E8DEF8" />
                                <Border Height="64" Background="#D0BCFF" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </m3:Scaffold>
                <TextBlock Text="嵌套窗口 Insets" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <Button Content="切换外层 Insets" Click="OnWindowInsetsClick" HorizontalAlignment="Left" />
                <Border Height="180" Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainerHighest}}">
                    <m3:MaterialWindowInsetsPadding x:Name="DemoInsetsPadding" Insets="12,24,20,16">
                        <m3:MaterialWindowInsetsPadding Insets="20,32,28,24">
                            <m3:Scaffold x:Name="DemoInsetsScaffold" ContentWindowInsets="20,32,28,24">
                                <StackPanel Spacing="12" Margin="12">
                                    <TextBlock Text="两层 Insets 按边取最大值，不重复留白。" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ContentPadding, ElementName=DemoInsetsScaffold}" />
                                </StackPanel>
                            </m3:Scaffold>
                        </m3:MaterialWindowInsetsPadding>
                    </m3:MaterialWindowInsetsPadding>
                </Border>
                <TextBlock Text="导航容器消费 Insets" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <m3:MaterialWindowInsetsPadding Insets="{Binding Insets, ElementName=DemoInsetsPadding}">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Height="240">
                        <m3:NavigationRail Grid.RowSpan="2" WindowInsets="20,32,28,24">
                            <m3:NavigationRailItem Label="主页" IsSelected="True">
                                <m3:NavigationRailItem.Icon><m3:MaterialSymbol Symbol="HomeAndGarden" Width="24" Height="24" /></m3:NavigationRailItem.Icon>
                            </m3:NavigationRailItem>
                        </m3:NavigationRail>
                        <m3:ShortNavigationBar Grid.Column="1" WindowInsets="20,32,28,24">
                            <m3:ShortNavigationBarItem Label="搜索" IsSelected="True">
                                <m3:ShortNavigationBarItem.Icon><m3:MaterialSymbol Symbol="Search" Width="24" Height="24" /></m3:ShortNavigationBarItem.Icon>
                            </m3:ShortNavigationBarItem>
                        </m3:ShortNavigationBar>
                        <m3:NavigationBar Grid.Column="1" Grid.Row="1" WindowInsets="20,32,28,24">
                            <m3:NavigationBarItem Label="收藏" IsSelected="True">
                                <m3:NavigationBarItem.Icon><m3:MaterialSymbol Symbol="Favorite" Width="24" Height="24" /></m3:NavigationBarItem.Icon>
                            </m3:NavigationBarItem>
                        </m3:NavigationBar>
                    </Grid>
                </m3:MaterialWindowInsetsPadding>
                <m3:MaterialWindowInsetsPadding Insets="{Binding Insets, ElementName=DemoInsetsPadding}" Height="240">
                    <m3:WideNavigationRail x:Name="DemoInsetsWideRail" WindowInsets="20,32,28,24">
                        <m3:WideNavigationRail.Header>
                            <Button Content="展开 / 收起" Click="OnInsetsWideRailClick" />
                        </m3:WideNavigationRail.Header>
                        <m3:WideNavigationRailItem Label="主页" IsSelected="True">
                            <m3:WideNavigationRailItem.Icon>
                                <m3:MaterialWindowInsetsPadding Insets="20,32,28,24">
                                    <m3:MaterialSymbol Symbol="HomeAndGarden" Width="24" Height="24" />
                                </m3:MaterialWindowInsetsPadding>
                            </m3:WideNavigationRailItem.Icon>
                        </m3:WideNavigationRailItem>
                    </m3:WideNavigationRail>
                </m3:MaterialWindowInsetsPadding>
                <TextBlock Text="Divider" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <Separator />
                <Separator Margin="16,0" m3:MaterialDivider.Thickness="2" m3:MaterialDivider.Color="#6750A4" />
                <Grid Height="48" ColumnDefinitions="*,Auto,*">
                    <Border Grid.Column="0" Background="#E8DEF8" Margin="0,0,16,0" />
                    <Separator Grid.Column="1" m3:MaterialDivider.Orientation="Vertical" />
                    <Border Grid.Column="2" Background="#D0BCFF" Margin="16,0,0,0" />
                </Grid>
                <TextBlock Text="Badges" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                    <m3:BadgedBox Content="{m3:Symbol Favorite}">
                        <m3:BadgedBox.Badge><m3:Badge /></m3:BadgedBox.Badge>
                    </m3:BadgedBox>
                    <m3:BadgedBox Content="{m3:Symbol Search}">
                        <m3:BadgedBox.Badge><m3:Badge x:Name="DemoBadge" Content="8" AutomationProperties.Name="8 notifications" /></m3:BadgedBox.Badge>
                    </m3:BadgedBox>
                    <m3:BadgedBox Content="{m3:Symbol Settings}">
                        <m3:BadgedBox.Badge><m3:Badge Content="999+" /></m3:BadgedBox.Badge>
                    </m3:BadgedBox>
                    <Button Content="Change badge" Click="OnChangeBadge" />
                </StackPanel>
                <TextBlock Text="NavigationBar" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <m3:NavigationBar x:Name="DemoNavigationBar">
                    <m3:NavigationBarItem Label="Home" IsSelected="True" Click="OnBarDestinationClick" Icon="{m3:Symbol HomeAndGarden}" />
                    <m3:NavigationBarItem Label="Search" Click="OnBarDestinationClick">
                        <m3:NavigationBarItem.Icon>
                            <m3:BadgedBox Content="{m3:Symbol Search}">
                                <m3:BadgedBox.Badge><m3:Badge Content="99+" /></m3:BadgedBox.Badge>
                            </m3:BadgedBox>
                        </m3:NavigationBarItem.Icon>
                    </m3:NavigationBarItem>
                    <m3:NavigationBarItem Label="Settings" Click="OnBarDestinationClick" Icon="{m3:Symbol Settings}" />
                </m3:NavigationBar>
                <TextBlock Text="Selected labels" m3:MaterialText.Style="{m3:Typography TitleSmall}" />
                <m3:NavigationBar>
                    <m3:NavigationBarItem Label="Home" AlwaysShowLabel="False" IsSelected="True" Click="OnBarDestinationClick" Icon="{m3:Symbol HomeAndGarden}" />
                    <m3:NavigationBarItem Label="Search" AlwaysShowLabel="False" Click="OnBarDestinationClick" Icon="{m3:Symbol Search}" />
                    <m3:NavigationBarItem Label="Settings" AlwaysShowLabel="False" Click="OnBarDestinationClick" Icon="{m3:Symbol Settings}" />
                    <m3:NavigationBarItem Label="Disabled" AlwaysShowLabel="False" IsEnabled="False" Icon="{m3:Symbol Favorite}" />
                </m3:NavigationBar>
                <TextBlock Text="ShortNavigationBar — Top / EqualWeight" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <m3:ShortNavigationBar x:Name="DemoShortNavigationBar">
                    <m3:ShortNavigationBarItem Label="Home" IsSelected="True" Click="OnShortBarDestinationClick" Icon="{m3:Symbol HomeAndGarden}" />
                    <m3:ShortNavigationBarItem Label="Search" IsSelected="False" Click="OnShortBarDestinationClick" Icon="{m3:Symbol Search}" />
                    <m3:ShortNavigationBarItem Label="Settings" IsSelected="False" Click="OnShortBarDestinationClick" Icon="{m3:Symbol Settings}" />
                </m3:ShortNavigationBar>
                <TextBlock Text="ShortNavigationBar — Start / Centered" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <m3:ShortNavigationBar Arrangement="Centered">
                    <m3:ShortNavigationBarItem Label="Home" IconPosition="Start" IsSelected="True" IsEnabled="True" Click="OnShortBarDestinationClick" Icon="{m3:Symbol HomeAndGarden}" />
                    <m3:ShortNavigationBarItem Label="Search" IconPosition="Start" IsSelected="False" IsEnabled="True" Click="OnShortBarDestinationClick" Icon="{m3:Symbol Search}" />
                    <m3:ShortNavigationBarItem Label="Settings" IconPosition="Start" IsSelected="False" IsEnabled="True" Click="OnShortBarDestinationClick" Icon="{m3:Symbol Settings}" />
                    <m3:ShortNavigationBarItem Label="Disabled" IconPosition="Start" IsSelected="False" IsEnabled="False" Click="OnShortBarDestinationClick" Icon="{m3:Symbol Favorite}" />
                </m3:ShortNavigationBar>
                <TextBlock Text="Switches" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <ToggleSwitch Content="Notifications" />
                    <ToggleSwitch Content="Thumb icon" IsChecked="True" m3:SwitchAppearance.ThumbIcon="{m3:Symbol Check}" />
                    <ToggleSwitch Content="Disabled" IsChecked="True" IsEnabled="False" />
                    <ToggleSwitch Content="State label" OnContent="On" OffContent="Off" />
                </StackPanel>
                <TextBlock Text="Sliders" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <Grid ColumnDefinitions="*,Auto">
                    <Slider x:Name="VolumeSlider" Value="35" />
                    <TextBlock Grid.Column="1" Margin="16,0,0,0" MinWidth="72" VerticalAlignment="Center"
                               Text="{Binding #VolumeSlider.Value, StringFormat='Value: {0:F0}'}"
                               m3:MaterialText.Style="{m3:Typography BodyMedium}" />
                </Grid>
                <Slider Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" SmallChange="10" LargeChange="10" Value="50" />
                <Slider Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Value="0.5" IsEnabled="False" />
                <Slider Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Value="0.35"
                        m3:SliderAppearance.IsCentered="True" m3:SliderAppearance.EnableCornerShrinking="True" />
                <m3:RangeSlider Minimum="0" Maximum="100" Steps="9" RangeStart="20" RangeEnd="80" />
                <TextBlock Text="连续圆头轨道 · 无拇指间隙与终点标记" />
                <Slider Theme="{StaticResource MaterialLegacySliderTheme}" Minimum="0" Maximum="1"
                        Value="0.25" TickFrequency="0.25" IsSnapToTickEnabled="True" SmallChange="0.25" />
                <m3:RangeSlider RangeStart="0.25" RangeEnd="0.75" Steps="3">
                    <m3:RangeSlider.TrackTemplate>
                        <DataTemplate x:DataType="m3:RangeSliderState"><m3:LegacySliderTrack State="{Binding}" /></DataTemplate>
                    </m3:RangeSlider.TrackTemplate>
                </m3:RangeSlider>
                <TextBlock Text="Inset focus ring · 按 Tab 在拇指之间切换" />
                <StackPanel Spacing="12" m3:MaterialInteraction.FocusFeedback="InsetRing">
                    <Slider Minimum="0" Maximum="1" Value="0.4" />
                    <m3:RangeSlider RangeStart="0.25" RangeEnd="0.75" />
                    <Slider Orientation="Vertical" IsDirectionReversed="True" Height="160" HorizontalAlignment="Left" Minimum="0" Maximum="1" Value="0.6" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <Slider Orientation="Vertical" IsDirectionReversed="True" Height="180" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Value="0.35" />
                    <Slider Orientation="Vertical" Height="180" Minimum="0" Maximum="1" TickFrequency="0.25" IsSnapToTickEnabled="True" SmallChange="0.25" LargeChange="0.25" Value="0.5" />
                </StackPanel>
                <Grid ColumnDefinitions="Auto,*" Height="360">
                    <m3:WideNavigationRail x:Name="DemoWideNavigationRail">
                        <m3:WideNavigationRail.Shape><m3:CutCornerShape TopStart="24" BottomEnd="12" /></m3:WideNavigationRail.Shape>
                        <m3:WideNavigationRail.Header>
                            <m3:IconButton Symbol="Menu" Click="OnToggleWideRail" />
                        </m3:WideNavigationRail.Header>
                        <m3:WideNavigationRailItem Label="Home" IsSelected="True" Click="OnWideDestinationClick" Icon="{m3:Symbol HomeAndGarden}" />
                        <m3:WideNavigationRailItem Label="Search" Click="OnWideDestinationClick" Icon="{m3:Symbol Search}" />
                        <m3:WideNavigationRailItem Label="Settings" Click="OnWideDestinationClick" Icon="{m3:Symbol Settings}" />
                    </m3:WideNavigationRail>
                    <Border Grid.Column="1"
                            Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainerLow}}"
                            Padding="16">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Wide NavigationRail" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                            <Button Content="自定义目的地排列" Click="OnCustomRailArrangement" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                            <TextBlock Text="在默认排列与末项靠底之间切换；下方模态栏使用同一排列。" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid ColumnDefinitions="Auto,*" Height="360" m3:MaterialWindowInsets.ConsumeInsets="40">
                    <StackPanel Grid.Column="1" Margin="16" Spacing="12">
                        <TextBlock Text="Modal Wide NavigationRail" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                        <Button Content="Toggle modal rail" Click="OnToggleModalRail"
                                Theme="{StaticResource MaterialTonalButtonTheme}" />
                        <TextBlock Text="页面祖先已消费 40；独立模态窗口仍应用自己的 13,7,5,11。图标再次请求相同 Insets 不重复留白。" TextWrapping="Wrap" />
                        <Button Content="切换模态栏自身消费 Insets" Click="OnModalRailInsets" />
                        <Button Content="Open hidden modal rail" Tag="hidden" Click="OnToggleModalRail"
                                Theme="{StaticResource MaterialTonalButtonTheme}" />
                    </StackPanel>
                    <m3:ModalWideNavigationRail x:Name="DemoHiddenModalRail" HideOnCollapse="True" WindowInsets="13,7,5,11">
                        <m3:ModalWideNavigationRail.ExpandedShape><m3:CutCornerShape TopEnd="32" BottomEnd="16" /></m3:ModalWideNavigationRail.ExpandedShape>
                        <m3:ModalWideNavigationRail.ExpandedHeader>
                            <m3:IconButton Symbol="MenuOpen" Tag="hidden" Click="OnToggleModalRail" />
                        </m3:ModalWideNavigationRail.ExpandedHeader>
                        <m3:WideNavigationRailItem Label="Home" IsSelected="True" Click="OnModalDestinationClick">
                            <m3:WideNavigationRailItem.Icon>
                                <m3:MaterialWindowInsetsPadding Insets="13,7,5,11">
                                    <m3:MaterialSymbol Symbol="HomeAndGarden" />
                                </m3:MaterialWindowInsetsPadding>
                            </m3:WideNavigationRailItem.Icon>
                        </m3:WideNavigationRailItem>
                        <m3:WideNavigationRailItem Label="Search" Click="OnModalDestinationClick" Icon="{m3:Symbol Search}" />
                    </m3:ModalWideNavigationRail>
                </Grid>
                <Button Content="Open Dialog" Click="OnOpenDialog" Theme="{StaticResource MaterialTonalButtonTheme}" />
                <m3:Dialog x:Name="DemoDialog" Width="360" DismissRequested="OnDialogDismissRequested">
                    <m3:MaterialSurface Padding="24" CornerRadius="28"
                                        Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainerHigh}}">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Dialog" m3:MaterialText.Style="{m3:Typography HeadlineSmall}" />
                            <TextBox PlaceholderText="Type here" Text="Editable content">
                                <TextBox.ContextMenu>
                                    <ContextMenu><MenuItem Header="Example action" /></ContextMenu>
                                </TextBox.ContextMenu>
                            </TextBox>
                            <ComboBox SelectedIndex="0">
                                <ComboBoxItem>First option</ComboBoxItem>
                                <ComboBoxItem>Second option</ComboBoxItem>
                            </ComboBox>
                            <Button Content="Open another dialog" Click="OnOpenNestedDialog" />
                            <Button Content="Close" Click="OnCloseDialog" Theme="{StaticResource MaterialTextButtonTheme}" />
                            <m3:Dialog x:Name="DemoNestedDialog" Width="280" DismissRequested="OnDialogDismissRequested">
                                <m3:MaterialSurface Padding="24" CornerRadius="28"
                                                    Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainerHigh}}">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="Another dialog" m3:MaterialText.Style="{m3:Typography TitleLarge}" />
                                        <Button Content="Back" Click="OnCloseNestedDialog" />
                                    </StackPanel>
                                </m3:MaterialSurface>
                            </m3:Dialog>
                        </StackPanel>
                    </m3:MaterialSurface>
                </m3:Dialog>
                <Button Theme="{StaticResource MaterialFilledButtonTheme}" HorizontalAlignment="Center">Welcome to Avalonia!</Button>
                <Button Theme="{StaticResource MaterialElevatedButtonTheme}" HorizontalAlignment="Center">Welcome to Avalonia!</Button>
                <Button Theme="{StaticResource MaterialTonalButtonTheme}" HorizontalAlignment="Center">Welcome to Avalonia!</Button>
                <Button Theme="{StaticResource MaterialOutlinedButtonTheme}" HorizontalAlignment="Center">Welcome to Avalonia!</Button>
                <Button Theme="{StaticResource MaterialTextButtonTheme}" HorizontalAlignment="Center">Welcome to Avalonia!</Button>

                <TextBlock Text="Custom content and feedback color" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
                <TextBlock Text="Hover, focus or press: feedback follows the current Foreground, including a custom disabled style." TextWrapping="Wrap" />
                <WrapPanel ItemSpacing="16" LineSpacing="12">
                    <Button Content="Morph and reverse" Background="#F0E8FF" Foreground="#503080" CornerRadius="20" m3:MaterialButton.PressedCornerRadius="4" />
                    <Button Content="Blue ink" Theme="{StaticResource MaterialElevatedButtonTheme}" Foreground="#205080" />
                    <Button Content="Outlined ink" Theme="{StaticResource MaterialOutlinedButtonTheme}" Foreground="#805020" />
                </WrapPanel>

                <m3:IconButton Theme="{StaticResource MaterialFilledIconButtonTheme}" Symbol="HomeAndGarden"
                               Classes="medium">
                </m3:IconButton>

                <m3:MaterialSurface Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.Surface}}"
                                    Padding="40" Margin="16"
                                    TonalElevation="{m3:Token {x:Static m3:MaterialTokens+Sys+Elevation.Level1}}"
                                    CornerRadius="{m3:Token {x:Static m3:MaterialTokens+Sys+Shape.Large}}">
                    <StackPanel Spacing="16">
                        <m3:MaterialSurface Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.Surface}}"
                                            Width="200" Height="200"
                                            CornerRadius="{m3:Token {x:Static m3:MaterialTokens+Sys+Shape.Small}}"
                                            ShadowElevation="{Binding #ShadowElevationSlider.Value}"
                                            TonalElevation="{Binding #ShadowElevationSlider.Value}"
                                            m3:MaterialInteraction.IsInteractive="True">
                        </m3:MaterialSurface>

                        <StackPanel>
                            <Label Content="ShadowElevation" />

                            <Grid ColumnDefinitions="*,50">

                                <Slider x:Name="ShadowElevationSlider" Minimum="0" Maximum="50"></Slider>

                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           Text="{Binding #ShadowElevationSlider.Value  ,StringFormat='{}{0:F2}'}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </m3:MaterialSurface>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
