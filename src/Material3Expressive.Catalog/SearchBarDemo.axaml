<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
        x:Class="Material3Expressive.Catalog.SearchBarDemo" Title="Docked search" Width="620" Height="640">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock Text="DockedSearchBar" m3:MaterialText.Style="{m3:Typography HeadlineSmall}" />
    <TextBlock Text="输入后筛选结果；Escape 收起。快速切换可观察动画反向，缩小窗口可观察结果高度限制。"
               TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="展开 / 收起" Click="ToggleExpanded" />
      <Button Content="明 / 暗" Click="ToggleTheme" />
      <Button Content="LTR / RTL" Click="ToggleDirection" />
    </StackPanel>
    <m3:DockedSearchBar x:Name="Search" CollapseRequested="CollapseSearch">
      <m3:DockedSearchBar.InputField>
        <m3:SearchBarInputField x:Name="Query" PlaceholderText="搜索组件" TextChanged="QueryChanged"
                               AutomationProperties.Name="搜索组件" IsExpanded="{Binding IsExpanded, ElementName=Search}"
                               ExpansionRequested="OpenSearch" SearchRequested="SearchSubmitted" />
      </m3:DockedSearchBar.InputField>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Results" Margin="8" Spacing="4" />
      </ScrollViewer>
    </m3:DockedSearchBar>
    <TextBlock x:Name="Status" Text="尚未选择结果" />
    <TextBlock Text="输入字段请求展开和搜索；应用管理查询与展开状态。收起 100ms 后清除输入焦点，重新展开会取消清焦。"
               TextWrapping="Wrap" m3:MaterialText.Style="{m3:Typography BodySmall}" />
  </StackPanel>
</Window>
