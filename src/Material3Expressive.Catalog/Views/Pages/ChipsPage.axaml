<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
             xmlns:mcu="https://github.com/Shirasagi0012/MaterialColorUtilities.Avalonia"
             xmlns:ms="using:MaterialSymbols.Avalonia"
             x:Class="Material3Expressive.Catalog.Views.Pages.ChipsPage">

    <ScrollViewer Padding="40,28,40,48">
        <StackPanel Spacing="28" MaxWidth="1160" HorizontalAlignment="Center">

            <m3:MaterialTabs x:Name="Tabs" Variant="Secondary" SelectedIndex="0"
                             MaxWidth="720" HorizontalAlignment="Center">
                <m3:MaterialTab Content="Variants" />
                <m3:MaterialTab Content="States &amp; icons" />
            </m3:MaterialTabs>

            <StackPanel Spacing="8">
                <TextBlock Classes="display-small" Text="Chip" />
                <TextBlock Classes="body-large" MaxWidth="760" HorizontalAlignment="Left" TextWrapping="Wrap"
                           Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                           Text="Chips help people enter information, make selections, filter content, or trigger actions. Four kinds differ in what they mean rather than how they behave." />
            </StackPanel>

            <!-- Variants -->
            <StackPanel x:Name="PanelVariants" Spacing="24">
                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="Four kinds" />
                    <TextBlock Classes="body-medium" MaxWidth="720" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                               Text="Assist chips are smart actions; filter chips refine a set; input chips represent a chosen entity; suggestion chips offer generated responses." />
                    <Border Classes="demo-canvas">
                        <WrapPanel ItemSpacing="12" LineSpacing="12" VerticalAlignment="Center">
                            <m3:MaterialChip Variant="Assist" Content="Assist" />
                            <m3:MaterialChip Variant="Filter" Content="Filter" />
                            <m3:MaterialChip Variant="Input" Content="Input" />
                            <m3:MaterialChip Variant="Suggestion" Content="Suggestion" />
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- States & icons -->
            <StackPanel x:Name="PanelStates" IsVisible="False" Spacing="24">
                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="Leading and trailing icons" />
                    <Border Classes="demo-canvas">
                        <WrapPanel ItemSpacing="12" LineSpacing="12" VerticalAlignment="Center">
                            <m3:MaterialChip Variant="Assist" Content="Assist">
                                <m3:MaterialChip.LeadingIcon>
                                    <ms:MaterialSymbol Symbol="Star" />
                                </m3:MaterialChip.LeadingIcon>
                            </m3:MaterialChip>
                            <m3:MaterialChip Variant="Input" Content="Input">
                                <m3:MaterialChip.TrailingIcon>
                                    <ms:MaterialSymbol Symbol="Close" />
                                </m3:MaterialChip.TrailingIcon>
                            </m3:MaterialChip>
                        </WrapPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="Selected, and disabled" />
                    <TextBlock Classes="body-medium" MaxWidth="720" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                               Text="Selecting a filter chip fills it, drops its outline and rounds it fully — the same spring morph the buttons use." />
                    <Border Classes="demo-canvas">
                        <WrapPanel ItemSpacing="12" LineSpacing="12" VerticalAlignment="Center">
                            <m3:MaterialChip Variant="Filter" Content="Selected" IsChecked="True" />
                            <m3:MaterialChip Variant="Filter" Content="Unselected" />
                            <m3:MaterialChip Variant="Assist" Content="Disabled" IsEnabled="False" />
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
