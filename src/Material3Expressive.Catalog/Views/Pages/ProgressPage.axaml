<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
             xmlns:mcu="https://github.com/Shirasagi0012/MaterialColorUtilities.Avalonia"
             x:Class="Material3Expressive.Catalog.Views.Pages.ProgressPage">

    <ScrollViewer Padding="40,28,40,48">
        <StackPanel Spacing="28" MaxWidth="1160" HorizontalAlignment="Center">

            <m3:MaterialTabs x:Name="Tabs" Variant="Secondary" SelectedIndex="0"
                             MaxWidth="720" HorizontalAlignment="Center">
                <m3:MaterialTab Content="Linear" />
                <m3:MaterialTab Content="Circular" />
            </m3:MaterialTabs>

            <StackPanel Spacing="8">
                <TextBlock Classes="display-small" Text="Progress indicators" />
                <TextBlock Classes="body-large" MaxWidth="760" HorizontalAlignment="Left" TextWrapping="Wrap"
                           Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                           Text="Progress indicators show the status of a process in real time. Expressive separates the active indicator from the track and marks the far end with a stop dot." />
            </StackPanel>

            <!-- Linear -->
            <StackPanel x:Name="PanelLinear" Spacing="24">
                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="Determinate" />
                    <TextBlock Classes="body-medium" MaxWidth="720" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                               Text="The wavy form is the same indicator drawn along a travelling sine." />
                    <Border Classes="demo-canvas">
                        <StackPanel Spacing="24" MaxWidth="520">
                            <m3:MaterialLinearProgressIndicator Value="0.35" />
                            <m3:MaterialLinearProgressIndicator Value="0.7" IsWavy="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="Indeterminate" />
                    <Border Classes="demo-canvas">
                        <StackPanel Spacing="24" MaxWidth="520">
                            <m3:MaterialLinearProgressIndicator IsIndeterminate="True" />
                            <m3:MaterialLinearProgressIndicator IsIndeterminate="True" IsWavy="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Circular -->
            <StackPanel x:Name="PanelCircular" IsVisible="False" Spacing="24">
                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="Circular" />
                    <Border Classes="demo-canvas">
                        <WrapPanel ItemSpacing="28" LineSpacing="28" VerticalAlignment="Center">
                            <m3:MaterialCircularProgressIndicator Value="0.35" />
                            <m3:MaterialCircularProgressIndicator Value="0.75" />
                            <m3:MaterialCircularProgressIndicator IsIndeterminate="True" />
                            <m3:MaterialCircularProgressIndicator Value="0.5" IsWavy="True" />
                            <m3:MaterialCircularProgressIndicator IsIndeterminate="True" IsWavy="True" />
                        </WrapPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="Loading indicator" />
                    <TextBlock Classes="body-medium" MaxWidth="720" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                               Text="The one component that genuinely morphs polygons, cycling the Material shape catalog while it turns." />
                    <Border Classes="demo-canvas">
                        <WrapPanel ItemSpacing="28" LineSpacing="28" VerticalAlignment="Center">
                            <m3:MaterialLoadingIndicator />
                            <m3:MaterialLoadingIndicator Variant="Contained" />
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
