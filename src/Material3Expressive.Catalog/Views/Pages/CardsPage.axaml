<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
             xmlns:mcu="https://github.com/Shirasagi0012/MaterialColorUtilities.Avalonia"
             xmlns:ms="using:MaterialSymbols.Avalonia"
             x:Class="Material3Expressive.Catalog.Views.Pages.CardsPage">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7655C7" Offset="0" />
            <GradientStop Color="#A68BE0" Offset="0.52" />
            <GradientStop Color="#E9DDFF" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <ScrollViewer Padding="40,0">
        <StackPanel Margin="0,28,0,48" Spacing="28" MaxWidth="1160" HorizontalAlignment="Center">

            <m3:MaterialTabs x:Name="Tabs" Variant="Secondary" SelectedIndex="0"
                             MaxWidth="720" HorizontalAlignment="Center">
                <m3:MaterialTab Content="Variants" />
                <m3:MaterialTab Content="Compositions" />
            </m3:MaterialTabs>

            <StackPanel Spacing="8">
                <TextBlock Classes="display-small" Text="Card" />
                <TextBlock Classes="body-large" MaxWidth="760" HorizontalAlignment="Left" TextWrapping="Wrap"
                           Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                           Text="Cards display content and actions about a single subject. A card is inert until it is told it is clickable — Material only gives it a state layer when it is genuinely actionable." />
            </StackPanel>

            <!-- Variants -->
            <StackPanel x:Name="PanelVariants" Spacing="24">
                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="Three elevations" />
                    <Border Classes="demo-canvas">
                        <WrapPanel ItemSpacing="20" LineSpacing="20">
                            <m3:MaterialCard Variant="Elevated" Width="220" Height="132">
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Classes="title-medium" Text="Elevated" />
                                    <TextBlock Classes="body-small" TextWrapping="Wrap"
                                               Text="Surface container low, at elevation level 1." />
                                </StackPanel>
                            </m3:MaterialCard>
                            <m3:MaterialCard Variant="Filled" Width="220" Height="132">
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Classes="title-medium" Text="Filled" />
                                    <TextBlock Classes="body-small" TextWrapping="Wrap"
                                               Text="Surface container highest, flat." />
                                </StackPanel>
                            </m3:MaterialCard>
                            <m3:MaterialCard Variant="Outlined" Width="220" Height="132">
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Classes="title-medium" Text="Outlined" />
                                    <TextBlock Classes="body-small" TextWrapping="Wrap"
                                               Text="Surface behind a hairline." />
                                </StackPanel>
                            </m3:MaterialCard>
                        </WrapPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="Clickable" />
                    <TextBlock Classes="body-medium" MaxWidth="720" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                               Text="Hover and press it: the state layer appears because the card opted in." />
                    <Border Classes="demo-canvas">
                        <m3:MaterialCard Variant="Elevated" IsClickable="True" Width="220" Height="132"
                                         HorizontalAlignment="Left">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Classes="title-medium" Text="Clickable" />
                                <TextBlock Classes="body-small" TextWrapping="Wrap"
                                           Text="Hover and press me." />
                            </StackPanel>
                        </m3:MaterialCard>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Compositions -->
            <StackPanel x:Name="PanelCompositions" IsVisible="False" Spacing="24">
                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="Now playing" />
                    <TextBlock Classes="body-medium" MaxWidth="720" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                               Text="A card is a container, not a prescription — this one composes icon buttons and a wavy progress indicator into a mini player." />
                    <Border Classes="demo-canvas">
                        <m3:MaterialCard Variant="Elevated" Padding="0" Width="340" HorizontalAlignment="Left">
                            <Grid RowDefinitions="120,Auto">
                                <Border Grid.Row="0" CornerRadius="24,24,0,0" Background="{StaticResource HeroGradient}">
                                    <Grid Margin="20">
                                        <TextBlock Classes="label-large" Text="NOW PLAYING" Foreground="#FFFFFF"
                                                   VerticalAlignment="Top" />
                                        <ms:MaterialSymbol Width="64" Height="64" Symbol="Orbit" Opacity="0.34"
                                                           Foreground="#FFFFFF"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1" Margin="20" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"
                                      ColumnSpacing="16">
                                    <TextBlock Classes="title-large" Text="Orbiting" />
                                    <TextBlock Grid.Row="1" Classes="body-medium"
                                               Foreground="{mcu:MdSysColor OnSurfaceVariant}" Text="Hana Vu · Halo" />
                                    <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <Button Theme="{StaticResource MaterialStandardIconButtonTheme}">
                                            <ms:MaterialSymbol Symbol="Favorite" />
                                        </Button>
                                        <Button Theme="{StaticResource MaterialFilledIconButtonTheme}">
                                            <ms:MaterialSymbol Symbol="PlayArrow" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,16,0,0" Spacing="8">
                                        <m3:MaterialLinearProgressIndicator Value="0.62" IsWavy="True" />
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Classes="label-small" Text="1:42" />
                                            <TextBlock Grid.Column="2" Classes="label-small" Text="3:12" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </m3:MaterialCard>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="A task summary" />
                    <Border Classes="demo-canvas">
                        <m3:MaterialCard Variant="Filled" Padding="20" Width="340" HorizontalAlignment="Left">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="title-large" Text="Today's focus" />
                                        <TextBlock Classes="body-small" Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                                                   Text="3 of 5 tasks complete" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{mcu:MdSysColor PrimaryContainer}"
                                            CornerRadius="14" Padding="10,6" VerticalAlignment="Top">
                                        <TextBlock Classes="label-large" Text="60%" />
                                    </Border>
                                </Grid>
                                <Border Background="{mcu:MdSysColor SurfaceContainerLowest}" CornerRadius="14" Padding="12">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <m3:MaterialCheckbox IsChecked="True" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="title-small" VerticalAlignment="Center"
                                                   Text="Refine expressive motion" />
                                        <TextBlock Grid.Column="2" Classes="label-medium" VerticalAlignment="Center"
                                                   Foreground="{mcu:MdSysColor Primary}" Text="Today" />
                                    </Grid>
                                </Border>
                                <Border Background="{mcu:MdSysColor SurfaceContainerLowest}" CornerRadius="14" Padding="12">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <m3:MaterialCheckbox VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="title-small" VerticalAlignment="Center"
                                                   Text="Review component states" />
                                        <TextBlock Grid.Column="2" Classes="label-medium" VerticalAlignment="Center"
                                                   Foreground="{mcu:MdSysColor OnSurfaceVariant}" Text="Tomorrow" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </m3:MaterialCard>
                    </Border>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
