<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
             xmlns:mcu="https://github.com/Shirasagi0012/MaterialColorUtilities.Avalonia"
             x:Class="Material3Expressive.Catalog.Views.Pages.SelectionPage">

    <ScrollViewer Padding="40,0">
        <StackPanel Margin="0,28,0,48" Spacing="28" MaxWidth="1160" HorizontalAlignment="Center">

            <m3:MaterialTabs x:Name="Tabs" Variant="Secondary" SelectedIndex="0"
                             MaxWidth="720" HorizontalAlignment="Center">
                <m3:MaterialTab Content="Controls" />
                <m3:MaterialTab Content="Slider" />
            </m3:MaterialTabs>

            <StackPanel Spacing="8">
                <TextBlock Classes="display-small" Text="Selection controls" />
                <TextBlock Classes="body-large" MaxWidth="760" HorizontalAlignment="Left" TextWrapping="Wrap"
                           Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                           Text="Checkboxes, radio buttons, switches and sliders let users make selections. Every state change is sprung, so interrupting one mid-flight reverses rather than snapping." />
            </StackPanel>

            <!-- Controls -->
            <StackPanel x:Name="PanelControls" Spacing="24">
                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="Checkbox, radio and switch" />
                    <TextBlock Classes="body-medium" MaxWidth="720" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                               Text="The switch runs two springs: the handle slides along the track, and its size changes separately — 16dp off, 24dp on, 28dp while held. Press and hold one to see them come apart." />
                    <Border Classes="demo-canvas">
                        <WrapPanel ItemSpacing="48" LineSpacing="24">
                            <StackPanel Spacing="8">
                                <m3:MaterialCheckbox Content="Unchecked" />
                                <m3:MaterialCheckbox Content="Checked" IsChecked="True" />
                                <m3:MaterialCheckbox Content="Indeterminate" IsThreeState="True" IsChecked="{x:Null}" />
                                <m3:MaterialCheckbox Content="Error" IsError="True" />
                                <m3:MaterialCheckbox Content="Disabled" IsChecked="True" IsEnabled="False" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <m3:MaterialRadioButton GroupName="catalog" Content="First" IsChecked="True" />
                                <m3:MaterialRadioButton GroupName="catalog" Content="Second" />
                                <m3:MaterialRadioButton GroupName="catalog" Content="Third" />
                                <m3:MaterialRadioButton Content="Disabled" IsEnabled="False" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <m3:MaterialSwitch Content="Off" />
                                <m3:MaterialSwitch Content="On" IsChecked="True" />
                                <m3:MaterialSwitch Content="Disabled, off" IsEnabled="False" />
                                <m3:MaterialSwitch Content="Disabled, on" IsChecked="True" IsEnabled="False" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="Segmented buttons" />
                    <TextBlock Classes="body-medium" MaxWidth="720" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                               Text="Single mode coordinates one checked item and supports arrow, Home and End navigation. Multiple mode leaves each segment independently toggleable." />
                    <Border Classes="demo-canvas">
                        <StackPanel Spacing="20" MaxWidth="520">
                            <m3:MaterialSegmentedButtonRow Width="360">
                                <m3:MaterialSegmentedButton Content="Day" />
                                <m3:MaterialSegmentedButton Content="Month" IsChecked="True" />
                                <m3:MaterialSegmentedButton Content="Week" />
                            </m3:MaterialSegmentedButtonRow>
                            <m3:MaterialSegmentedButtonRow Width="360"
                                                           SelectionMode="Multiple">
                                <m3:MaterialSegmentedButton Content="Email" IsChecked="True" />
                                <m3:MaterialSegmentedButton Content="Calendar" />
                                <m3:MaterialSegmentedButton Content="Tasks" IsChecked="True" />
                            </m3:MaterialSegmentedButtonRow>
                            <m3:MaterialSegmentedButtonRow Width="360"
                                                           IsEnabled="False">
                                <m3:MaterialSegmentedButton Content="Compact" />
                                <m3:MaterialSegmentedButton Content="Comfortable" IsChecked="True" />
                            </m3:MaterialSegmentedButtonRow>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Slider -->
            <StackPanel x:Name="PanelSlider" IsVisible="False" Spacing="24">
                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="Slider" />
                    <TextBlock Classes="body-medium" MaxWidth="720" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                               Text="Expressive replaced the round thumb with a tall bar and thickened the track to 16dp. Vertical sliders use top-to-bottom values; range sliders expose two bindable values that cannot cross. Drag one: the handle narrows to 2dp while held, so the value under it stays visible." />
                    <Border Classes="demo-canvas">
                        <StackPanel Spacing="20" MaxWidth="480">
                            <m3:MaterialSlider Value="0.3" />
                            <m3:MaterialSlider Value="0.75" />
                            <m3:MaterialRangeSlider Minimum="0" Maximum="100" StartValue="25" EndValue="75" />
                            <m3:MaterialSlider Value="0.5" IsEnabled="False" />
                            <m3:MaterialSlider Orientation="Vertical" Height="180" Width="48" Minimum="0" Maximum="100" Value="65" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
