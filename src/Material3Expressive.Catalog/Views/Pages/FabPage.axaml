<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
             xmlns:mcu="https://github.com/Shirasagi0012/MaterialColorUtilities.Avalonia"
             xmlns:ms="using:MaterialSymbols.Avalonia"
             x:Class="Material3Expressive.Catalog.Views.Pages.FabPage">

    <ScrollViewer Padding="40,0">
        <StackPanel Margin="0,28,0,48" Spacing="28" MaxWidth="1160" HorizontalAlignment="Center">

            <m3:MaterialTabs x:Name="Tabs" Variant="Secondary" SelectedIndex="0"
                             MaxWidth="720" HorizontalAlignment="Center">
                <m3:MaterialTab Content="FAB" />
                <m3:MaterialTab Content="FAB menu" />
                <m3:MaterialTab Content="Floating toolbar" />
            </m3:MaterialTabs>

            <StackPanel Spacing="8">
                <TextBlock Classes="display-small" Text="Floating action button" />
                <TextBlock Classes="body-large" MaxWidth="760" HorizontalAlignment="Left" TextWrapping="Wrap"
                           Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                           Text="The FAB is the primary action on a screen. Extended and unextended are one control: setting a label extends it." />
            </StackPanel>

            <!-- FAB -->
            <StackPanel x:Name="PanelFab" Spacing="24">
                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="Variants" />
                    <Border Classes="demo-canvas">
                        <WrapPanel ItemSpacing="20" LineSpacing="20" VerticalAlignment="Center">
                            <m3:MaterialFab Size="Medium">
                                <ms:MaterialSymbol Symbol="Add" />
                            </m3:MaterialFab>
                            <m3:MaterialFab Size="Medium" Variant="Secondary">
                                <ms:MaterialSymbol Symbol="Add" />
                            </m3:MaterialFab>
                            <m3:MaterialFab Size="Medium" Variant="Tertiary">
                                <ms:MaterialSymbol Symbol="Add" />
                            </m3:MaterialFab>
                            <m3:MaterialFab Size="Medium" Variant="Surface">
                                <ms:MaterialSymbol Symbol="Add" />
                            </m3:MaterialFab>
                        </WrapPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="Sizes" />
                    <Border Classes="demo-canvas">
                        <WrapPanel ItemSpacing="20" LineSpacing="20" VerticalAlignment="Center">
                            <m3:MaterialFab>
                                <ms:MaterialSymbol Symbol="Add" />
                            </m3:MaterialFab>
                            <m3:MaterialFab Size="Medium">
                                <ms:MaterialSymbol Symbol="Add" />
                            </m3:MaterialFab>
                            <m3:MaterialFab Size="Large">
                                <ms:MaterialSymbol Symbol="Add" />
                            </m3:MaterialFab>
                        </WrapPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="Extended, and lowered" />
                    <TextBlock Classes="body-medium" MaxWidth="720" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                               Text="A lowered FAB sits closer to the content, for layouts where it would otherwise float above the fold." />
                    <Border Classes="demo-canvas">
                        <WrapPanel ItemSpacing="20" LineSpacing="20" VerticalAlignment="Center">
                            <m3:MaterialFab Label="Compose">
                                <ms:MaterialSymbol Symbol="Edit" />
                            </m3:MaterialFab>
                            <m3:MaterialFab Variant="Secondary" Label="Create">
                                <ms:MaterialSymbol Symbol="Add" />
                            </m3:MaterialFab>
                            <m3:MaterialFab Variant="Surface" Label="Lowered" IsLowered="True">
                                <ms:MaterialSymbol Symbol="Edit" />
                            </m3:MaterialFab>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- FAB menu -->
            <StackPanel x:Name="PanelMenu" IsVisible="False" Spacing="24">
                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="FAB menu" />
                    <TextBlock Classes="body-medium" MaxWidth="720" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                               Text="Items arrive in sequence rather than together, read off one spring at staggered offsets — so closing halfway through opening unwinds in the right order. Press the FAB to open the menu." />
                    <Border Classes="demo-canvas" Height="360">
                        <m3:MaterialFabMenu HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <m3:MaterialFabMenu.Icon>
                                <ms:MaterialSymbol Symbol="Add" />
                            </m3:MaterialFabMenu.Icon>
                            <m3:MaterialFab Label="Reply">
                                <ms:MaterialSymbol Symbol="Reply" />
                            </m3:MaterialFab>
                            <m3:MaterialFab Label="Star">
                                <ms:MaterialSymbol Symbol="Star" />
                            </m3:MaterialFab>
                            <m3:MaterialFab Label="Dismiss">
                                <ms:MaterialSymbol Symbol="Close" />
                            </m3:MaterialFab>
                        </m3:MaterialFabMenu>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Floating toolbar -->
            <StackPanel x:Name="PanelToolbar" IsVisible="False" Spacing="24">
                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="Floating toolbar" />
                    <TextBlock Classes="body-medium" MaxWidth="760" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                               Text="Horizontal, vertical, and aspect-adaptive layouts share one action collection. Leading and trailing slots retract around the main actions; an adjacent FAB instead retracts the complete toolbar and grows from 56dp to 80dp." />
                    <m3:MaterialButton HorizontalAlignment="Left"
                                       Variant="Tonal"
                                       Content="Expand / collapse"
                                       Click="OnToggleToolbars" />
                    <Border Classes="demo-canvas">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="48">
                            <StackPanel Spacing="28" VerticalAlignment="Center">
                                <m3:MaterialFloatingToolbar x:Name="HorizontalToolbar"
                                                            HorizontalAlignment="Left">
                                    <m3:MaterialFloatingToolbar.LeadingContent>
                                        <m3:MaterialIconButton Variant="Tonal">
                                            <ms:MaterialSymbol Symbol="Create" />
                                        </m3:MaterialIconButton>
                                    </m3:MaterialFloatingToolbar.LeadingContent>
                                    <m3:MaterialIconButton>
                                        <ms:MaterialSymbol Symbol="Check" />
                                    </m3:MaterialIconButton>
                                    <m3:MaterialIconButton Variant="Filled">
                                        <ms:MaterialSymbol Symbol="Favorite" />
                                    </m3:MaterialIconButton>
                                    <m3:MaterialIconButton>
                                        <ms:MaterialSymbol Symbol="Edit" />
                                    </m3:MaterialIconButton>
                                    <m3:MaterialFloatingToolbar.TrailingContent>
                                        <m3:MaterialIconButton Variant="Tonal">
                                            <ms:MaterialSymbol Symbol="Delete" />
                                        </m3:MaterialIconButton>
                                    </m3:MaterialFloatingToolbar.TrailingContent>
                                </m3:MaterialFloatingToolbar>

                                <m3:MaterialFloatingToolbar FloatingActionButtonPosition="End"
                                                            HorizontalAlignment="Left">
                                    <m3:MaterialFloatingToolbar.FloatingActionButton>
                                        <m3:MaterialFab>
                                            <ms:MaterialSymbol Symbol="Add" />
                                        </m3:MaterialFab>
                                    </m3:MaterialFloatingToolbar.FloatingActionButton>
                                    <m3:MaterialIconButton>
                                        <ms:MaterialSymbol Symbol="Check" />
                                    </m3:MaterialIconButton>
                                    <m3:MaterialIconButton>
                                        <ms:MaterialSymbol Symbol="Edit" />
                                    </m3:MaterialIconButton>
                                    <m3:MaterialIconButton>
                                        <ms:MaterialSymbol Symbol="Favorite" />
                                    </m3:MaterialIconButton>
                                </m3:MaterialFloatingToolbar>
                            </StackPanel>

                            <m3:MaterialFloatingToolbar x:Name="VerticalToolbar"
                                                        Grid.Column="1"
                                                        Orientation="Vertical"
                                                        Variant="Vibrant"
                                                        VerticalAlignment="Top">
                                <m3:MaterialIconButton>
                                    <ms:MaterialSymbol Symbol="Check" />
                                </m3:MaterialIconButton>
                                <m3:MaterialIconButton Variant="Filled">
                                    <ms:MaterialSymbol Symbol="Favorite" />
                                </m3:MaterialIconButton>
                                <m3:MaterialIconButton>
                                    <ms:MaterialSymbol Symbol="Edit" />
                                </m3:MaterialIconButton>
                            </m3:MaterialFloatingToolbar>
                        </Grid>
                    </Border>
                    <TextBlock Classes="body-small" MaxWidth="760" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                               Text="Use Orientation=Auto inside a constrained host to select horizontal for wide regions and vertical for tall regions. Screen-edge anchoring remains the host layout's responsibility; use the 16dp Material screen offset." />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
