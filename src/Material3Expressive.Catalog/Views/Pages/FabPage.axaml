<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
             xmlns:mcu="https://github.com/Shirasagi0012/MaterialColorUtilities.Avalonia"
             xmlns:ms="using:MaterialSymbols.Avalonia"
             x:Class="Material3Expressive.Catalog.Views.Pages.FabPage">

    <ScrollViewer Padding="40,28,40,48">
        <StackPanel Spacing="28" MaxWidth="1160" HorizontalAlignment="Center">

            <m3:MaterialTabs x:Name="Tabs" Variant="Secondary" SelectedIndex="0"
                             MaxWidth="720" HorizontalAlignment="Center">
                <m3:MaterialTab Content="FAB" />
                <m3:MaterialTab Content="FAB menu" />
            </m3:MaterialTabs>

            <StackPanel Spacing="8">
                <TextBlock Classes="display-small" Text="Floating action button" />
                <TextBlock Classes="body-large" MaxWidth="760" HorizontalAlignment="Left" TextWrapping="Wrap"
                           Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                           Text="The FAB is the primary action on a screen. Extended and unextended are one control: setting a label extends it." />
            </StackPanel>

            <!-- FAB -->
            <StackPanel x:Name="PanelFab" Spacing="24">
                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="Variants" />
                    <Border Classes="demo-canvas">
                        <WrapPanel ItemSpacing="20" LineSpacing="20" VerticalAlignment="Center">
                            <m3:MaterialFab Size="Medium">
                                <ms:MaterialSymbol Symbol="Add" />
                            </m3:MaterialFab>
                            <m3:MaterialFab Size="Medium" Variant="Secondary">
                                <ms:MaterialSymbol Symbol="Add" />
                            </m3:MaterialFab>
                            <m3:MaterialFab Size="Medium" Variant="Tertiary">
                                <ms:MaterialSymbol Symbol="Add" />
                            </m3:MaterialFab>
                            <m3:MaterialFab Size="Medium" Variant="Surface">
                                <ms:MaterialSymbol Symbol="Add" />
                            </m3:MaterialFab>
                        </WrapPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="Sizes" />
                    <Border Classes="demo-canvas">
                        <WrapPanel ItemSpacing="20" LineSpacing="20" VerticalAlignment="Center">
                            <m3:MaterialFab>
                                <ms:MaterialSymbol Symbol="Add" />
                            </m3:MaterialFab>
                            <m3:MaterialFab Size="Medium">
                                <ms:MaterialSymbol Symbol="Add" />
                            </m3:MaterialFab>
                            <m3:MaterialFab Size="Large">
                                <ms:MaterialSymbol Symbol="Add" />
                            </m3:MaterialFab>
                        </WrapPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="Extended, and lowered" />
                    <TextBlock Classes="body-medium" MaxWidth="720" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                               Text="A lowered FAB sits closer to the content, for layouts where it would otherwise float above the fold." />
                    <Border Classes="demo-canvas">
                        <WrapPanel ItemSpacing="20" LineSpacing="20" VerticalAlignment="Center">
                            <m3:MaterialFab Label="Compose">
                                <ms:MaterialSymbol Symbol="Edit" />
                            </m3:MaterialFab>
                            <m3:MaterialFab Variant="Secondary" Label="Create">
                                <ms:MaterialSymbol Symbol="Add" />
                            </m3:MaterialFab>
                            <m3:MaterialFab Variant="Surface" Label="Lowered" IsLowered="True">
                                <ms:MaterialSymbol Symbol="Edit" />
                            </m3:MaterialFab>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- FAB menu -->
            <StackPanel x:Name="PanelMenu" IsVisible="False" Spacing="24">
                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="FAB menu" />
                    <TextBlock Classes="body-medium" MaxWidth="720" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                               Text="Items arrive in sequence rather than together, read off one spring at staggered offsets — so closing halfway through opening unwinds in the right order. Press the FAB to open the menu." />
                    <Border Classes="demo-canvas" Height="360">
                        <m3:MaterialFabMenu HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <m3:MaterialFabMenu.Icon>
                                <ms:MaterialSymbol Symbol="Add" />
                            </m3:MaterialFabMenu.Icon>
                            <m3:MaterialFab Label="Reply">
                                <ms:MaterialSymbol Symbol="Reply" />
                            </m3:MaterialFab>
                            <m3:MaterialFab Label="Star">
                                <ms:MaterialSymbol Symbol="Star" />
                            </m3:MaterialFab>
                            <m3:MaterialFab Label="Dismiss">
                                <ms:MaterialSymbol Symbol="Close" />
                            </m3:MaterialFab>
                        </m3:MaterialFabMenu>
                    </Border>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
