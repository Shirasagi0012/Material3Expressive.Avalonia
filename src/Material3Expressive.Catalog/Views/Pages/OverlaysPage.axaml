<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
             xmlns:mcu="https://github.com/Shirasagi0012/MaterialColorUtilities.Avalonia"
             xmlns:ms="using:MaterialSymbols.Avalonia"
             x:Class="Material3Expressive.Catalog.Views.Pages.OverlaysPage">

    <Panel>
        <m3:MaterialScaffold>
            <m3:MaterialScaffold.SnackbarHost>
                <m3:MaterialSnackbarHost x:Name="SnackbarHost"
                                         Margin="0,0,0,24" />
            </m3:MaterialScaffold.SnackbarHost>

            <ScrollViewer Padding="40,28,40,48">
                <StackPanel Spacing="28" MaxWidth="1160" HorizontalAlignment="Center">

                    <m3:MaterialTabs x:Name="Tabs" Variant="Secondary" SelectedIndex="0"
                                     MaxWidth="720" HorizontalAlignment="Center">
                        <m3:MaterialTab Content="Overlays" />
                        <m3:MaterialTab Content="Badges" />
                        <m3:MaterialTab Content="Pickers" />
                        <m3:MaterialTab Content="Carousel" />
                        <m3:MaterialTab Content="Tooltip &amp; menu" />
                    </m3:MaterialTabs>

                    <StackPanel Spacing="8">
                        <TextBlock Classes="display-small" Text="Overlays &amp; feedback" />
                        <TextBlock Classes="body-large" MaxWidth="760" HorizontalAlignment="Left" TextWrapping="Wrap"
                                   Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                                   Text="Dialogs, sheets and snackbars live in the tree rather than in windows of their own, so they share a layout with the content they cover and stay inside whatever theme scope they were declared in." />
                    </StackPanel>

                <!-- Overlays -->
                <StackPanel x:Name="PanelOverlays" Spacing="24">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="title-large" Text="Dialog, sheet and snackbar" />
                        <TextBlock Classes="body-medium" MaxWidth="720" HorizontalAlignment="Left" TextWrapping="Wrap"
                                   Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                                   Text="The dialog scales up from 90% as its scrim fades in, from one spring. The sheet can be dragged by its handle — let go past 40% and it keeps going." />
                        <Border Classes="demo-canvas">
                            <WrapPanel ItemSpacing="16" LineSpacing="16">
                                <m3:MaterialButton Variant="Filled" Content="Show dialog" Click="OnShowDialog" />
                                <m3:MaterialButton Variant="Tonal" Content="Show sheet" Click="OnShowSheet" />
                                <m3:MaterialButton Variant="Outlined" Content="Show snackbar" Click="OnShowSnackbar" />
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Spacing="10">
                        <TextBlock Classes="title-large" Text="Swipe to dismiss" />
                        <TextBlock Classes="body-medium"
                                   MaxWidth="720"
                                   HorizontalAlignment="Left"
                                   TextWrapping="Wrap"
                                   Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                                   Text="Drag past 56dp or fling past 125dp/s. Delete dismisses toward the reading start, Shift+Delete toward the reading end, and Escape resets the focused row." />
                        <Border Classes="demo-canvas">
                            <m3:MaterialSwipeToDismissBox Width="420"
                                                          Height="72"
                                                          HorizontalAlignment="Left">
                                <m3:MaterialSwipeToDismissBox.BackgroundContent>
                                    <Border Background="{mcu:MdSysColor ErrorContainer}"
                                            Padding="16,0">
                                        <TextBlock Classes="label-large"
                                                   Text="Delete"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="{mcu:MdSysColor OnErrorContainer}" />
                                    </Border>
                                </m3:MaterialSwipeToDismissBox.BackgroundContent>
                                <m3:MaterialListItem Content="Archived message"
                                                     SupportingContent="Swipe horizontally or use the keyboard."
                                                     InteractionMode="None"
                                                     Background="{mcu:MdSysColor SurfaceContainer}" />
                            </m3:MaterialSwipeToDismissBox>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Badges -->
                <StackPanel x:Name="PanelBadges" IsVisible="False" Spacing="24">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="title-large" Text="Badges" />
                        <TextBlock Classes="body-medium" MaxWidth="720" HorizontalAlignment="Left" TextWrapping="Wrap"
                                   Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                                   Text="A small badge says only that something happened; a large one says how much." />
                        <Border Classes="demo-canvas">
                            <WrapPanel ItemSpacing="28" LineSpacing="28" VerticalAlignment="Center">
                                <m3:MaterialBadge Variant="Small" />
                                <m3:MaterialBadge Count="3" />
                                <m3:MaterialBadge Count="128" />
                                <m3:MaterialBadge Count="999+" />
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Pickers -->
                <StackPanel x:Name="PanelPickers" IsVisible="False" Spacing="24">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="title-large" Text="Date and time pickers" />
                        <TextBlock Classes="body-medium" MaxWidth="720" HorizontalAlignment="Left" TextWrapping="Wrap"
                                   Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                                   Text="Calendar and clock surfaces can share their non-null state with typed date, date-range, and time inputs. Typed drafts use the current culture, commit on Enter or focus loss, and cancel with Escape." />
                        <Border Classes="demo-canvas">
                            <WrapPanel ItemSpacing="28" LineSpacing="28">
                                <m3:MaterialDatePicker />
                                <m3:MaterialTimePicker />
                                <StackPanel Spacing="16">
                                    <m3:MaterialDateInput Width="240" />
                                    <m3:MaterialDateRangeInput />
                                    <m3:MaterialTimeInput />
                                    <m3:MaterialTimeInput Use24HourClock="False" />
                                </StackPanel>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Carousel -->
                <StackPanel x:Name="PanelCarousel" IsVisible="False" Spacing="24">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="title-large" Text="Carousel" />
                        <TextBlock Classes="body-medium" MaxWidth="720" HorizontalAlignment="Left" TextWrapping="Wrap"
                                   Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                                   Text="Items at the edges are squeezed rather than clipped, so the row always ends on a whole item. Scroll it with the wheel." />
                        <Border Classes="demo-canvas" Padding="0">
                            <m3:MaterialCarousel Height="160" ClipToBounds="True">
                                <Border Background="{mcu:MdSysColor PrimaryContainer}" CornerRadius="28" />
                                <Border Background="{mcu:MdSysColor SecondaryContainer}" CornerRadius="28" />
                                <Border Background="{mcu:MdSysColor TertiaryContainer}" CornerRadius="28" />
                                <Border Background="{mcu:MdSysColor PrimaryContainer}" CornerRadius="28" />
                                <Border Background="{mcu:MdSysColor SecondaryContainer}" CornerRadius="28" />
                            </m3:MaterialCarousel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Tooltip & menu -->
                <StackPanel x:Name="PanelTooltipMenu" IsVisible="False" Spacing="24">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="title-large" Text="Tooltips and menus" />
                        <TextBlock Classes="body-medium" MaxWidth="720" HorizontalAlignment="Left" TextWrapping="Wrap"
                                   Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                                   Text="The tooltip attaches to a control rather than wrapping it, so it does not change the layout. Stock menus retain Avalonia's submenu behavior; exposed dropdowns coordinate a Material text-field anchor, selection, editable input, popup placement, and focus." />
                        <Border Classes="demo-canvas">
                            <WrapPanel ItemSpacing="16" LineSpacing="16">
                                <m3:MaterialExposedDropdownMenu Width="240"
                                                                Label="Color"
                                                                PlaceholderText="Choose a color"
                                                                SelectedIndex="1">
                                    <x:String>Red</x:String>
                                    <x:String>Green</x:String>
                                    <x:String>Blue</x:String>
                                </m3:MaterialExposedDropdownMenu>
                                <m3:MaterialExposedDropdownMenu Width="240"
                                                                Label="Editable color"
                                                                Variant="Outlined"
                                                                IsEditable="True"
                                                                Text="Violet">
                                    <x:String>Violet</x:String>
                                    <x:String>Indigo</x:String>
                                    <x:String>Blue</x:String>
                                </m3:MaterialExposedDropdownMenu>
                                <m3:MaterialButton Variant="Tonal" Content="Hover me"
                                                   m3:MaterialTooltip.Tip="Archives the conversation" />
                                <m3:MaterialButton Variant="Tonal" Content="Rich tooltip"
                                                   m3:MaterialTooltip.Variant="Rich"
                                                   m3:MaterialTooltip.Tip="Moves this to the archive, where it stays searchable." />
                                <Button Content="Open menu">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Cut" />
                                            <MenuItem Header="Copy" />
                                            <Separator />
                                            <MenuItem Header="Paste" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Classes="title-large" Text="Bottom sheet scaffold" />
                    <TextBlock Classes="body-medium"
                               MaxWidth="720"
                               TextWrapping="Wrap"
                               Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                               Text="The standard scaffold keeps the body interactive while a persistent sheet settles between its 56dp peek and expanded anchors." />
                    <Border Classes="demo-canvas" Padding="16">
                        <m3:MaterialBottomSheetScaffold Height="280"
                                                        SheetPeekHeight="56">
                            <m3:MaterialBottomSheetScaffold.TopBar>
                                <TextBlock Classes="title-medium" Text="Inbox" />
                            </m3:MaterialBottomSheetScaffold.TopBar>
                            <m3:MaterialBottomSheetScaffold.Content>
                                <TextBlock Classes="body-large"
                                           Margin="0,20,0,0"
                                           Text="Body content remains available above the sheet." />
                            </m3:MaterialBottomSheetScaffold.Content>
                            <m3:MaterialBottomSheetScaffold.SheetContent>
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="title-medium" Text="Filters" />
                                    <TextBlock Classes="body-medium"
                                               Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                                               Text="Drag the handle to expand or return to the peek anchor." />
                                </StackPanel>
                            </m3:MaterialBottomSheetScaffold.SheetContent>
                        </m3:MaterialBottomSheetScaffold>
                    </Border>
                </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </m3:MaterialScaffold>

        <!-- Modal overlays remain above the scaffold and its external snackbar-host slot. -->
        <m3:MaterialBottomSheet x:Name="Sheet">
            <StackPanel Margin="24,0,24,32" Spacing="8">
                <TextBlock Classes="title-large" Text="Share" />
                <TextBlock Classes="body-medium"
                           Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                           Text="Drag the handle at the top of this sheet, or tap outside it." />
            </StackPanel>
        </m3:MaterialBottomSheet>

        <m3:MaterialDialog x:Name="Dialog">
            <StackPanel Spacing="16">
                <TextBlock Classes="headline-small" Text="Delete this draft?" />
                <TextBlock Classes="body-medium" TextWrapping="Wrap"
                           Text="The draft and everything in it will be removed. This cannot be undone." />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <m3:MaterialButton Variant="Text" Content="Cancel" Click="OnCloseDialog" />
                    <m3:MaterialButton Variant="Filled" Content="Delete" Click="OnCloseDialog" />
                </StackPanel>
            </StackPanel>
        </m3:MaterialDialog>
    </Panel>
</UserControl>
