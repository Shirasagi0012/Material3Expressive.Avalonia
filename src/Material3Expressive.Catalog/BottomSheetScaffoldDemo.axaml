<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
        x:Class="Material3Expressive.Catalog.BottomSheetScaffoldDemo" Title="Persistent bottom sheet" Width="840" Height="720">
  <m3:BottomSheetScaffold x:Name="Scaffold" ClipToBounds="True">
    <m3:BottomSheetScaffold.SheetShape><m3:CutCornerShape TopStart="36" TopEnd="12" /></m3:BottomSheetScaffold.SheetShape>
    <m3:BottomSheetScaffold.TopBar>
      <Border Padding="24,16" Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainer}}">
        <TextBlock Text="Persistent bottom sheet" m3:MaterialText.Style="{m3:Typography TitleLarge}" />
      </Border>
    </m3:BottomSheetScaffold.TopBar>
    <m3:BottomSheetScaffold.SheetContent>
      <Border Height="400" Padding="24,8,24,24">
        <StackPanel Spacing="16">
          <TextBlock Text="Saved places" m3:MaterialText.Style="{m3:Typography TitleLarge}" />
          <TextBlock Text="Drag down or click the handle to return to the peek height. This sheet cannot be hidden by default." TextWrapping="Wrap" />
          <Button Content="Collapse" Click="OnCollapse" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
    </m3:BottomSheetScaffold.SheetContent>
    <Border Padding="{Binding ContentPadding, ElementName=Scaffold}" m3:MaterialWindowInsets.ConsumePadding="{Binding ContentPadding, ElementName=Scaffold}">
      <StackPanel Margin="24" Spacing="16">
        <TextBlock Text="The page avoids the top bar and reserves the sheet's peek height." TextWrapping="Wrap" />
        <Button Content="Expand sheet" Click="OnExpand" HorizontalAlignment="Left" />
        <Button Content="Show snackbar" Click="OnSnackbar" HorizontalAlignment="Left" />
        <CheckBox Content="Larger peek height" IsCheckedChanged="OnPeekChanged" />
      </StackPanel>
    </Border>
  </m3:BottomSheetScaffold>
</Window>
