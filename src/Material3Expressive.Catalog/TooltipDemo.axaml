<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
        x:Class="Material3Expressive.Catalog.TooltipDemo" Width="640" Height="900" Title="Tooltips">
  <ScrollViewer>
  <StackPanel Margin="40" Spacing="24">
    <TextBlock Text="ToolTip.Tip" m3:MaterialText.Style="{m3:Typography HeadlineSmall}" />
    <StackPanel Orientation="Horizontal" Spacing="24">
      <Button x:Name="NativeTipAnchor" Content="Save" ToolTip.Tip="Save changes" />
      <Button x:Name="NativeMultilineAnchor" Content="Sync">
        <ToolTip.Tip>
          <TextBlock TextWrapping="Wrap">
            <Run Text="Sync this project" FontWeight="SemiBold" /><LineBreak />
            <Run Text="Includes local changes that have not been uploaded." />
          </TextBlock>
        </ToolTip.Tip>
      </Button>
      <Button Content="Below" ToolTip.Tip="Custom placement" ToolTip.Placement="Bottom" ToolTip.VerticalOffset="4" />
    </StackPanel>
    <TextBlock Text="TooltipBox + PlainTooltip" m3:MaterialText.Style="{m3:Typography HeadlineSmall}" />
    <TextBlock Text="Hover or focus an anchor. Escape dismisses its tooltip." TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="32">
      <m3:TooltipBox AnchorPosition="Above">
        <m3:TooltipBox.Tooltip><m3:PlainTooltip Content="Add to your collection" /></m3:TooltipBox.Tooltip>
        <m3:IconButton Symbol="Add" />
      </m3:TooltipBox>
      <m3:TooltipBox AnchorPosition="Below">
        <m3:TooltipBox.Tooltip><m3:PlainTooltip Content="Save changes" /></m3:TooltipBox.Tooltip>
        <Button Content="Save" />
      </m3:TooltipBox>
      <m3:TooltipBox AnchorPosition="End">
        <m3:TooltipBox.Tooltip><m3:PlainTooltip Content="Settings" /></m3:TooltipBox.Tooltip>
        <m3:IconButton Symbol="Settings" />
      </m3:TooltipBox>
    </StackPanel>
    <CheckBox Content="Enable hover and long-press input" IsChecked="{Binding #HoldArea.EnableUserInput, Mode=TwoWay}" />
    <m3:TooltipBox x:Name="HoldArea" HorizontalAlignment="Left" LongPressDuration="0:0:0.75">
      <m3:TooltipBox.Tooltip><m3:PlainTooltip Content="Shown after a 750 ms touch or pen hold" /></m3:TooltipBox.Tooltip>
      <Border Padding="16" Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainer}}" CornerRadius="12">
        <TextBlock Text="Touch or pen: hold here for 750 ms" />
      </Border>
    </m3:TooltipBox>
    <m3:TooltipBox x:Name="Programmatic" EnableUserInput="False">
      <m3:TooltipBox.Tooltip><m3:PlainTooltip Content="This tooltip was shown from code" /></m3:TooltipBox.Tooltip>
      <Button Content="Show tooltip" Click="OnShow" />
    </m3:TooltipBox>
    <TextBlock Text="RichTooltip" m3:MaterialText.Style="{m3:Typography HeadlineSmall}" />
    <m3:TooltipBox x:Name="RichHelp" AnchorPosition="Above" HasAction="True" EnableUserInput="False">
      <m3:TooltipBox.Tooltip>
        <m3:RichTooltip Title="Collections" Content="Save related items together so you can find them again.">
          <m3:RichTooltip.Action>
            <Button Content="Got it" Theme="{StaticResource MaterialTextButtonTheme}" Click="OnDismissRich" />
          </m3:RichTooltip.Action>
        </m3:RichTooltip>
      </m3:TooltipBox.Tooltip>
      <Button Content="About collections" Click="OnShowRich" />
    </m3:TooltipBox>
    <TextBlock Text="TooltipLabel" m3:MaterialText.Style="{m3:Typography HeadlineSmall}" />
    <TextBlock Text="Range values" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
    <m3:RangeSlider x:Name="LabelRange" Width="320" HorizontalAlignment="Left" RangeStart="0.25" RangeEnd="0.75" Margin="0,32,0,0">
      <m3:RangeSlider.StartThumb>
        <m3:TooltipLabel x:Name="RangeStartLabel">
          <m3:TooltipLabel.Label><m3:PlainTooltip Content="{Binding RangeStart, ElementName=LabelRange, StringFormat={}{0:P0}}" /></m3:TooltipLabel.Label>
          <m3:SliderThumb x:Name="LabelRangeStartThumb" Width="{m3:Token {x:Static m3:MaterialTokens+Comp+Slider.HandleWidth}}"
                          Height="{m3:Token {x:Static m3:MaterialTokens+Comp+Slider.HandleHeight}}" />
        </m3:TooltipLabel>
      </m3:RangeSlider.StartThumb>
      <m3:RangeSlider.EndThumb>
        <m3:TooltipLabel x:Name="RangeEndLabel">
          <m3:TooltipLabel.Label><m3:PlainTooltip Content="{Binding RangeEnd, ElementName=LabelRange, StringFormat={}{0:P0}}" /></m3:TooltipLabel.Label>
          <m3:SliderThumb x:Name="LabelRangeEndThumb" Width="{m3:Token {x:Static m3:MaterialTokens+Comp+Slider.HandleWidth}}"
                          Height="{m3:Token {x:Static m3:MaterialTokens+Comp+Slider.HandleHeight}}" />
        </m3:TooltipLabel>
      </m3:RangeSlider.EndThumb>
    </m3:RangeSlider>
    <TextBlock Text="Position follows layout and parent transforms" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
    <StackPanel Orientation="Horizontal" Spacing="16">
      <Button Content="Transform anchor" Click="OnTransformAnchor" />
      <Button Content="Transform parent" Click="OnTransformParent" />
    </StackPanel>
    <Border x:Name="TransformedLabelParent" HorizontalAlignment="Left" Margin="24,32,0,0">
      <m3:TooltipLabel x:Name="TransformedLabel" IsPersistent="True">
        <m3:TooltipLabel.Label><m3:PlainTooltip Content="Layout anchor" /></m3:TooltipLabel.Label>
        <m3:AssistChip Content="Anchor" />
      </m3:TooltipLabel>
    </Border>
    <TextBlock Text="The label shares the chip's hover/press stream; focus alone does not show it." TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="48" Margin="0,24,0,0">
      <m3:TooltipLabel x:Name="InteractionLabel">
        <m3:TooltipLabel.Label><m3:PlainTooltip Content="Save to collection" /></m3:TooltipLabel.Label>
        <m3:AssistChip x:Name="LabelChip" Content="Save" />
      </m3:TooltipLabel>
      <m3:TooltipLabel IsPersistent="True">
        <m3:TooltipLabel.Label><m3:PlainTooltip Content="Always visible" /></m3:TooltipLabel.Label>
        <m3:AssistChip Content="Pinned label" />
      </m3:TooltipLabel>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="32" Margin="0,24,0,0">
      <m3:TooltipLabel x:Name="IconLabel">
        <m3:TooltipLabel.Label><m3:PlainTooltip Content="Add an item" /></m3:TooltipLabel.Label>
        <m3:IconButton x:Name="LabelIcon" Symbol="Add" AutomationProperties.Name="Add an item"
                       m3:MaterialButton.PressedCornerRadius="8" />
      </m3:TooltipLabel>
      <m3:TooltipLabel x:Name="SegmentLabel">
        <m3:TooltipLabel.Label><m3:PlainTooltip Content="Select a period" /></m3:TooltipLabel.Label>
        <m3:SingleChoiceSegmentedButtonRow>
          <m3:SegmentedButton x:Name="LabelDay" Content="Day" IsSelected="True" Click="OnChoosePeriod" />
          <m3:SegmentedButton x:Name="LabelWeek" Content="Week" Click="OnChoosePeriod" />
        </m3:SingleChoiceSegmentedButtonRow>
      </m3:TooltipLabel>
      <m3:TooltipLabel x:Name="SwitchLabel">
        <m3:TooltipLabel.Label><m3:PlainTooltip Content="Enable sync" /></m3:TooltipLabel.Label>
        <ToggleSwitch x:Name="LabelSwitch" AutomationProperties.Name="Enable sync" />
      </m3:TooltipLabel>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="32" Margin="0,24,0,0">
      <m3:TooltipLabel x:Name="ButtonLabel">
        <m3:TooltipLabel.Label><m3:PlainTooltip Content="Save changes" /></m3:TooltipLabel.Label>
        <Button x:Name="LabelButton" Content="Save" m3:MaterialButton.PressedCornerRadius="8" />
      </m3:TooltipLabel>
      <m3:TooltipLabel x:Name="ToggleLabel">
        <m3:TooltipLabel.Label><m3:PlainTooltip Content="Pin this item" /></m3:TooltipLabel.Label>
        <ToggleButton x:Name="LabelToggle" Content="Pin" />
      </m3:TooltipLabel>
      <m3:TooltipLabel x:Name="SplitLabel">
        <m3:TooltipLabel.Label><m3:PlainTooltip Content="Create an item or choose an option" /></m3:TooltipLabel.Label>
        <m3:SplitButton>
          <m3:SplitButton.LeadingButton>
            <Button x:Name="LabelSplitLeading" Content="Create" Theme="{StaticResource MaterialFilledSplitButtonLeadingTheme}" />
          </m3:SplitButton.LeadingButton>
          <m3:SplitButton.TrailingButton>
            <ToggleButton x:Name="LabelSplitTrailing" Content="{m3:Symbol ArrowDropDown}" Theme="{StaticResource MaterialFilledSplitButtonTrailingTheme}" AutomationProperties.Name="Options" />
          </m3:SplitButton.TrailingButton>
        </m3:SplitButton>
      </m3:TooltipLabel>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,24,0,0">
      <m3:TooltipLabel x:Name="BarLabel">
        <m3:TooltipLabel.Label><m3:PlainTooltip Content="Open library" /></m3:TooltipLabel.Label>
        <m3:NavigationBarItem x:Name="LabelBarItem" Width="120" Icon="{m3:Symbol Book}" Label="Library" />
      </m3:TooltipLabel>
      <m3:TooltipLabel x:Name="RailLabel">
        <m3:TooltipLabel.Label><m3:PlainTooltip Content="Open favorites" /></m3:TooltipLabel.Label>
        <m3:NavigationRailItem x:Name="LabelRailItem" Icon="{m3:Symbol Favorite}" Label="Favorites" />
      </m3:TooltipLabel>
      <m3:TooltipLabel x:Name="ShortBarLabel">
        <m3:TooltipLabel.Label><m3:PlainTooltip Content="Open settings" /></m3:TooltipLabel.Label>
        <m3:ShortNavigationBarItem x:Name="LabelShortBarItem" Width="144" Icon="{m3:Symbol Settings}" Label="Settings" IconPosition="Start" />
      </m3:TooltipLabel>
    </StackPanel>
    <m3:TooltipLabel x:Name="FabLabel" Margin="0,24,0,0">
      <m3:TooltipLabel.Label><m3:PlainTooltip Content="Create a new document" /></m3:TooltipLabel.Label>
      <m3:ExtendedFloatingActionButton x:Name="LabelFab" Icon="{m3:Symbol Add}" Content="New document" />
    </m3:TooltipLabel>
    <m3:TooltipLabel x:Name="DrawerLabel" Margin="0,24,0,0">
      <m3:TooltipLabel.Label><m3:PlainTooltip Content="Open inbox" /></m3:TooltipLabel.Label>
      <m3:NavigationDrawerItem x:Name="LabelDrawerItem" Width="240" Content="Inbox" Icon="{m3:Symbol Inbox}" />
    </m3:TooltipLabel>
    <m3:TooltipLabel x:Name="TabLabel" Margin="0,24,0,0">
      <m3:TooltipLabel.Label><m3:PlainTooltip Content="Open saved documents" /></m3:TooltipLabel.Label>
      <m3:Tab x:Name="LabelTab" Width="160" Content="Saved" Icon="{m3:Symbol Book}" />
    </m3:TooltipLabel>
  </StackPanel>
  </ScrollViewer>
</Window>
