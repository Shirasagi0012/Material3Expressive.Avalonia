<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
        x:Class="Material3Expressive.Catalog.SwipeToDismissDemo" Title="Swipe to dismiss" Width="680" Height="460">
  <StackPanel Margin="32" Spacing="20">
    <TextBlock Text="Swipe to dismiss" m3:MaterialText.Style="{m3:Typography HeadlineSmall}" />
    <TextBlock Text="Drag the card in either direction. Completion reports a request; the application decides whether to remove or restore it."
               TextWrapping="Wrap" />
    <Border ClipToBounds="True">
      <m3:SwipeToDismissBox x:Name="Swipe" Height="112" Dismissed="OnDismissed">
        <m3:SwipeToDismissBox.BackgroundContent>
          <Border Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SecondaryContainer}}" Padding="24" CornerRadius="16">
            <Grid ColumnDefinitions="*,*">
              <TextBlock Text="Archive" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Remove" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
          </Border>
        </m3:SwipeToDismissBox.BackgroundContent>
        <m3:Card Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <StackPanel Spacing="8">
            <TextBlock Text="Project update" m3:MaterialText.Style="{m3:Typography TitleMedium}" />
            <TextBlock Text="Drag horizontally, or use the actions below." />
          </StackPanel>
        </m3:Card>
      </m3:SwipeToDismissBox>
    </Border>
    <WrapPanel Orientation="Horizontal">
      <Button Content="Dismiss start to end" Click="OnDismissStart" Margin="0,0,8,8" />
      <Button Content="Dismiss end to start" Click="OnDismissEnd" Margin="0,0,8,8" />
      <Button Content="Reset" Click="OnReset" Margin="0,0,8,8" />
    </WrapPanel>
    <StackPanel Orientation="Horizontal" Spacing="20">
      <CheckBox Content="Gestures" IsChecked="{Binding GesturesEnabled, ElementName=Swipe, Mode=TwoWay}" />
      <CheckBox Content="Start to end" IsChecked="{Binding EnableDismissFromStartToEnd, ElementName=Swipe, Mode=TwoWay}" />
      <CheckBox Content="End to start" IsChecked="{Binding EnableDismissFromEndToStart, ElementName=Swipe, Mode=TwoWay}" />
      <CheckBox Content="RTL" IsCheckedChanged="OnDirectionChanged" />
    </StackPanel>
    <TextBlock x:Name="Status" Text="Ready" TextWrapping="Wrap" />
  </StackPanel>
</Window>
