    <StyleInclude Source="/Components/Switch/Switch.axaml" />
    <StyleInclude Source="/Components/Badge/Badge.axaml" />
    <StyleInclude Source="/Components/Tooltip/Tooltip.axaml" />
    <StyleInclude Source="/Components/Snackbar/Snackbar.axaml" />
    <StyleInclude Source="/Components/FloatingActionButton/FloatingActionButton.axaml" />
    <StyleInclude Source="/Components/FloatingToolbar/FloatingToolbar.axaml" />
    <StyleInclude Source="/Components/TextField/TextField.axaml" />
    <StyleInclude Source="/Components/SecureTextField/SecureTextField.axaml" />
    <StyleInclude Source="/Components/NumericUpDown/NumericUpDown.axaml" />
    <StyleInclude Source="/Components/NumericUpDown/ButtonSpinner.axaml" />
    <StyleInclude Source="/Components/Chip/Chip.axaml" />
    <StyleInclude Source="/Components/TabRow/TabRow.axaml" />
    <StyleInclude Source="/Components/Card/Card.axaml" />
    <StyleInclude Source="/Components/SegmentedButton/SegmentedButton.axaml" />
    <StyleInclude Source="/Components/ProgressIndicator/ProgressIndicator.axaml" />
