<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
        xmlns:baseline="clr-namespace:Material3Expressive.Baseline"
        x:Class="Material3Expressive.Styles.MaterialTheme">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <m3:MaterialResource>
                    <baseline:ColorScheme />
                    <baseline:StateTokenSource />
                    <baseline:ShapeTokenSource />
                    <baseline:TypographyTokenSource />
                    <baseline:ElevationTokenSource />
                    <baseline:MotionTokenSource />

                    <m3:ButtonSizesTokenSource />
                    <m3:FilledButtonTokenSource />
                    <m3:ElevatedButtonTokenSource />
                    <m3:TonalButtonTokenSource />
                    <m3:OutlinedButtonTokenSource />
                    <m3:TextButtonTokenSource />

                    <m3:IconButtonSizesTokenSource />
                    <m3:StandardIconButtonTokenSource />
                    <m3:FilledIconButtonTokenSource />
                    <m3:TonalIconButtonTokenSource />
                    <m3:OutlinedIconButtonTokenSource />
                    <m3:NavigationRailTokenSource />
                    <m3:NavigationBarTokenSource />
                    <m3:ShortNavigationBarTokenSource />
                    <m3:WideNavigationRailTokenSource />
                    <m3:SliderTokenSource />
                    <m3:ScrollBarTokenSource />
                    <m3:CheckBoxTokenSource />
                    <m3:DividerTokenSource />
                    <m3:RadioButtonTokenSource />
                    <m3:SwitchTokenSource />
                    <m3:BadgeTokenSource />
                    <m3:FloatingActionButtonTokenSource />
                    <m3:TextFieldTokenSource />
                    <m3:ChipTokenSource />
                </m3:MaterialResource>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    
    <StyleInclude Source="/Components/Surface/Surface.axaml" />
    <StyleInclude Source="/Foundation/Typography/Typography.axaml" />
    <StyleInclude Source="/Foundation/Overlays/Dialog.axaml" />
    <StyleInclude Source="/Components/Button/Button.axaml" />
    <StyleInclude Source="/Components/IconButton/IconButton.axaml" />
    <StyleInclude Source="/Components/NavigationRail/NavigationRail.axaml" />
    <StyleInclude Source="/Components/NavigationBar/NavigationBar.axaml" />
    <StyleInclude Source="/Components/ShortNavigationBar/ShortNavigationBar.axaml" />
    <StyleInclude Source="/Components/WideNavigationRail/WideNavigationRail.axaml" />
    <StyleInclude Source="/Components/WideNavigationRail/ModalWideNavigationRail.axaml" />
    <StyleInclude Source="/Components/Slider/Slider.axaml" />
    <StyleInclude Source="/Components/ScrollBar/ScrollBar.axaml" />
    <StyleInclude Source="/Components/CheckBox/CheckBox.axaml" />
    <StyleInclude Source="/Components/Divider/Divider.axaml" />
    <StyleInclude Source="/Components/RadioButton/RadioButton.axaml" />
    <StyleInclude Source="/Components/Switch/Switch.axaml" />
    <StyleInclude Source="/Components/Badge/Badge.axaml" />
    <StyleInclude Source="/Components/FloatingActionButton/FloatingActionButton.axaml" />
    <StyleInclude Source="/Components/TextField/TextField.axaml" />
    <StyleInclude Source="/Components/SecureTextField/SecureTextField.axaml" />
    <StyleInclude Source="/Components/Chip/Chip.axaml" />
</Styles>
