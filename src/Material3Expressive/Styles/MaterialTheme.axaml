<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
        xmlns:controls="clr-namespace:Material3Expressive.Controls"
        xmlns:baseline="clr-namespace:Material3Expressive.Baseline"
        x:Class="Material3Expressive.Styles.MaterialTheme">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <m3:MaterialResource>
                    <baseline:ColorScheme />
                    <baseline:StateTokenSource />
                    <baseline:ShapeTokenSource />
                    <baseline:TypographyTokenSource />
                    <baseline:ElevationTokenSource />
                    <baseline:MotionTokenSource />

                    <controls:ButtonSizesTokenSource />
                    <controls:FilledButtonTokenSource />
                    <controls:ElevatedButtonTokenSource />
                    <controls:TonalButtonTokenSource />
                    <controls:OutlinedButtonTokenSource />
                    <controls:TextButtonTokenSource />

                    <controls:IconButtonSizesTokenSource />
                    <controls:StandardIconButtonTokenSource />
                    <controls:FilledIconButtonTokenSource />
                    <controls:TonalIconButtonTokenSource />
                    <controls:OutlinedIconButtonTokenSource />
                </m3:MaterialResource>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    
    <StyleInclude Source="Surface.axaml" />
    <StyleInclude Source="Button.axaml" />
    <StyleInclude Source="IconButton.axaml" />
</Styles>
