    </Styles.Resources>
    <!-- Control-level typography for templated controls -->
    <Style Selector=":is(StyledElement)[(m3|TypographyScheme.TextStyle)=DisplayLarge]">
        <Setter Property="TextElement.FontFamily" Value="{m3:MdTypeFamily Brand}" />
        <Setter Property="TextElement.FontWeight" Value="{m3:MdTypeWeight Regular}" />
        <Setter Property="TextElement.FontSize" Value="{m3:MdTypeSize DisplayLarge}" />
        <Style Selector="^ /template/ ContentPresenter TextBlock">
            <Setter Property="LineHeight" Value="{m3:MdTypeLineHeight DisplayLarge}" />
            <Setter Property="LetterSpacing" Value="{m3:MdTypeTracking DisplayLarge}" />
        </Style>
        <Style Selector="^ /template/ TextPresenter">
            <Setter Property="LineHeight" Value="{m3:MdTypeLineHeight DisplayLarge}" />
            <Setter Property="LetterSpacing" Value="{m3:MdTypeTracking DisplayLarge}" />
        </Style>
    </Style>

    <Style Selector=":is(StyledElement)[(m3|TypographyScheme.TextStyle)=DisplayMedium]">
        <Setter Property="TextElement.FontFamily" Value="{m3:MdTypeFamily Brand}" />
        <Setter Property="TextElement.FontWeight" Value="{m3:MdTypeWeight Regular}" />
        <Setter Property="TextElement.FontSize" Value="{m3:MdTypeSize DisplayMedium}" />
        <Style Selector="^ /template/ ContentPresenter TextBlock">
            <Setter Property="LineHeight" Value="{m3:MdTypeLineHeight DisplayMedium}" />
