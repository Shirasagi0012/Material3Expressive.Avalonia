                <Setter Property="LetterSpacing" Value="{m3:MdTypeTracking HeadlineSmall}" />
            </Style>
            <Style Selector="^[(m3|TypographyScheme.TextStyle)=TitleLarge]">
                <Setter Property="LineHeight" Value="{m3:MdTypeLineHeight TitleLarge}" />
                <Setter Property="LetterSpacing" Value="{m3:MdTypeTracking TitleLarge}" />
            </Style>
            <Style Selector="^[(m3|TypographyScheme.TextStyle)=TitleMedium]">
                <Setter Property="LineHeight" Value="{m3:MdTypeLineHeight TitleMedium}" />
                <Setter Property="LetterSpacing" Value="{m3:MdTypeTracking TitleMedium}" />
            </Style>
            <Style Selector="^[(m3|TypographyScheme.TextStyle)=TitleSmall]">
                <Setter Property="LineHeight" Value="{m3:MdTypeLineHeight TitleSmall}" />
                <Setter Property="LetterSpacing" Value="{m3:MdTypeTracking TitleSmall}" />
