                <Setter Property="LetterSpacing" Value="{m3:MdTypeTracking DisplayLarge}" />
            </Style>
            <Style Selector="^[(m3|TypographyScheme.TextStyle)=DisplayMedium]">
                <Setter Property="LineHeight" Value="{m3:MdTypeLineHeight DisplayMedium}" />
