            </Style>
            <Style Selector="^.headline-large">
                <Setter Property="m3:TypographyScheme.TextStyle" Value="HeadlineLarge" />
            </Style>
            <Style Selector="^.headline-medium">
                <Setter Property="m3:TypographyScheme.TextStyle" Value="HeadlineMedium" />
            </Style>
            <Style Selector="^.headline-small">
