<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
        x:Class="Material3Expressive.Styles.MaterialStyles">
    <!-- Hands the application-level theme to every TopLevel; must come first so that anything
         below it resolves against a theme. -->
    <m3:MaterialThemeStyles />
    <StyleInclude Source="avares://Material3Expressive/Styles/Foundation/Typography.axaml" />
    <StyleInclude Source="avares://Material3Expressive/Styles/Foundation/MaterialSymbols.axaml" />
    <StyleInclude Source="avares://Material3Expressive/Styles/Components/Button.axaml" />
    <StyleInclude Source="avares://Material3Expressive/Styles/Components/IconButton.axaml" />
    <StyleInclude Source="avares://Material3Expressive/Styles/Components/Card.axaml" />
    <StyleInclude Source="avares://Material3Expressive/Styles/Components/Fab.axaml" />
    <StyleInclude Source="avares://Material3Expressive/Styles/Components/Selection.axaml" />
    <StyleInclude Source="avares://Material3Expressive/Styles/Components/Progress.axaml" />
    <StyleInclude Source="avares://Material3Expressive/Styles/Components/Chip.axaml" />
    <StyleInclude Source="avares://Material3Expressive/Styles/Components/ButtonGroup.axaml" />
    <StyleInclude Source="avares://Material3Expressive/Styles/Components/SegmentedButton.axaml" />
    <StyleInclude Source="avares://Material3Expressive/Styles/Components/TextField.axaml" />
    <StyleInclude Source="avares://Material3Expressive/Styles/Components/FabMenu.axaml" />
    <StyleInclude Source="avares://Material3Expressive/Styles/Components/Navigation.axaml" />
    <StyleInclude Source="avares://Material3Expressive/Styles/Components/Tabs.axaml" />
    <StyleInclude Source="avares://Material3Expressive/Styles/Components/AppBar.axaml" />
    <StyleInclude Source="avares://Material3Expressive/Styles/Components/Overlays.axaml" />
    <StyleInclude Source="avares://Material3Expressive/Styles/Components/Menu.axaml" />
    <StyleInclude Source="avares://Material3Expressive/Styles/Components/SearchBar.axaml" />
    <StyleInclude Source="avares://Material3Expressive/Styles/Components/Pickers.axaml" />
    <StyleInclude Source="avares://Material3Expressive/Styles/Components/SurfaceList.axaml" />
    <StyleInclude Source="avares://Material3Expressive/Styles/Components/Scaffold.axaml" />
    <StyleInclude Source="avares://Material3Expressive/Styles/Components/BottomSheetScaffold.axaml" />
</Styles>
