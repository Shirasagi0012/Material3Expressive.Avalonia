<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
    <Design.PreviewWith>
        <Border Padding="20">
            <StackPanel Spacing="8">
                <m3:MaterialCheckbox Content="Checkbox" IsChecked="True" />
                <m3:MaterialRadioButton Content="Radio" IsChecked="True" />
                <m3:MaterialSwitch Content="Switch" IsChecked="True" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <!-- Each of these paints its own glyph, state layer and ripple in Render. The template is
             the label, offset by the padding the control sets from its own tokens so the glyph has
             room. -->
        <ControlTheme x:Key="{x:Type m3:MaterialCheckbox}" TargetType="m3:MaterialCheckbox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- These are typed resource endpoints; the control only consumes the resulting
                 renderer profiles and never resolves raw tokens itself. -->
            <Setter Property="GeometryProfile"
                    Value="{DynamicResource {x:Static m3:CheckboxValueKeys.GeometryProfile}}" />
            <Setter Property="VisualColors"
                    Value="{DynamicResource {x:Static m3:CheckboxValueKeys.VisualColors}}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static m3:CheckboxValueKeys.LabelBrush}}" />
            <!-- Keep this as a base theme setter so application styles and local values retain
                 their normal Avalonia precedence. -->
            <Setter Property="Padding" Value="48,0,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="m3:TypographyScheme.TextStyle" Value="BodyMedium" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type m3:MaterialRadioButton}" TargetType="m3:MaterialRadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- The renderer consumes only these typed profiles; state selection and dot motion
                 remain control policy. -->
            <Setter Property="GeometryProfile"
                    Value="{DynamicResource {x:Static m3:RadioButtonValueKeys.GeometryProfile}}" />
            <Setter Property="VisualColors"
                    Value="{DynamicResource {x:Static m3:RadioButtonValueKeys.VisualColors}}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static m3:RadioButtonValueKeys.LabelBrush}}" />
            <!-- Keep these as low-specificity defaults so application styles and local values
                 retain normal Avalonia precedence. -->
            <Setter Property="Padding" Value="40,0,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="m3:TypographyScheme.TextStyle" Value="BodyMedium" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type m3:MaterialSwitch}" TargetType="m3:MaterialSwitch">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- The renderer consumes only these typed profiles; checked/enabled and interaction
                 state remain switch policy rather than requester-dependent value plans. -->
            <Setter Property="GeometryProfile"
                    Value="{DynamicResource {x:Static m3:SwitchValueKeys.GeometryProfile}}" />
            <Setter Property="VisualColors"
                    Value="{DynamicResource {x:Static m3:SwitchValueKeys.VisualColors}}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static m3:SwitchValueKeys.LabelBrush}}" />
            <!-- TrackWidth (52dp) plus the 12dp label gap. Keep it a base theme setter so
                 application styles and local values retain normal Avalonia precedence. -->
            <Setter Property="Padding" Value="64,0,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="m3:TypographyScheme.TextStyle" Value="BodyMedium" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
        <!-- The slider draws itself entirely; typed profiles carry the raw-derived renderer inputs
             while value state, interaction and motion remain in the control. -->
        <ControlTheme x:Key="{x:Type m3:MaterialSlider}" TargetType="m3:MaterialSlider">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GeometryProfile"
                    Value="{DynamicResource {x:Static m3:SliderValueKeys.GeometryProfile}}" />
            <Setter Property="VisualColors"
                    Value="{DynamicResource {x:Static m3:SliderValueKeys.VisualColors}}" />
            <!-- A Material slider has a fixed height; stretching it would only inflate the hit
                 area, since the track and handle stay centred either way. -->
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="SmallChange" Value="0.05" />
            <Setter Property="LargeChange" Value="0.2" />
        </ControlTheme>

        <ControlTheme x:Key="{x:Type m3:MaterialRangeSlider}" TargetType="m3:MaterialRangeSlider">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GeometryProfile"
                    Value="{DynamicResource {x:Static m3:SliderValueKeys.GeometryProfile}}" />
            <Setter Property="VisualColors"
                    Value="{DynamicResource {x:Static m3:SliderValueKeys.VisualColors}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </ControlTheme>
    </Styles.Resources>
</Styles>
