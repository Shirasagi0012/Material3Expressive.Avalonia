<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
    <Design.PreviewWith>
        <Border Padding="24" Height="320">
            <m3:MaterialFabMenu Icon="+" IsExpanded="True" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <m3:MaterialFab Label="Reply" Content="&#x21A9;" />
                <m3:MaterialFab Label="Forward" Content="&#x21AA;" />
                <m3:MaterialFab Label="Archive" Content="&#x25A4;" />
            </m3:MaterialFabMenu>
        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <ControlTheme x:Key="{x:Type m3:MaterialFabMenu}" TargetType="m3:MaterialFabMenu">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- Bottom-aligned so the toggle stays put and the items grow upwards away
                         from it, which is the direction the reveal runs. -->
                    <StackPanel HorizontalAlignment="Right" Spacing="{TemplateBinding CloseButtonSpacing}">
                        <ItemsControl HorizontalAlignment="Right"
                                      ItemsSource="{Binding $parent[m3:MaterialFabMenu].Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel HorizontalAlignment="Right"
                                                Spacing="{Binding $parent[m3:MaterialFabMenu].ItemSpacing}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <m3:MaterialToggleIconButton x:Name="PART_Toggle"
                                                     HorizontalAlignment="Right"
                                                     Variant="Filled"
                                                     Size="Medium"
                                                     Content="{TemplateBinding Icon}"
                                                     IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>
</Styles>
