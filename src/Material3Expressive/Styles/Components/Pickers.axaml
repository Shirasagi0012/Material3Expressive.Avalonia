<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
    <Design.PreviewWith>
        <Border Padding="24">
            <StackPanel Orientation="Horizontal" Spacing="24">
                <m3:MaterialDatePicker />
                <m3:MaterialTimePicker />
                <StackPanel Spacing="16">
                    <m3:MaterialDateInput Width="240" />
                    <m3:MaterialTimeInput />
                    <m3:MaterialDateRangeInput />
                </StackPanel>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <!-- Both pickers draw themselves entirely, so their themes carry only the sizing rules
             that stop them stretching to fill whatever they are dropped into. -->
        <ControlTheme x:Key="{x:Type m3:MaterialDatePicker}" TargetType="m3:MaterialDatePicker">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </ControlTheme>

        <ControlTheme x:Key="{x:Type m3:MaterialTimePicker}" TargetType="m3:MaterialTimePicker">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </ControlTheme>

        <ControlTheme x:Key="{x:Type m3:MaterialDateInput}"
                      TargetType="m3:MaterialDateInput"
                      BasedOn="{StaticResource {x:Type m3:MaterialTextField}}" />

        <ControlTheme x:Key="{x:Type m3:MaterialTimeInput}" TargetType="m3:MaterialTimeInput">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <m3:MaterialTextField x:Name="PART_Hour"
                                              Width="96"
                                              Label="Hour"
                                              Variant="Outlined"
                                              Text="{TemplateBinding HourText, Mode=TwoWay}" />
                        <TextBlock Width="16"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Classes="headline-large"
                                   Text=":" />
                        <m3:MaterialTextField x:Name="PART_Minute"
                                              Width="96"
                                              Label="Minute"
                                              Variant="Outlined"
                                              Text="{TemplateBinding MinuteText, Mode=TwoWay}" />
                        <m3:MaterialSegmentedButtonRow
                            Margin="8,8,0,0"
                            VerticalAlignment="Top"
                            SelectionMode="Single"
                            IsVisible="{Binding !Use24HourClock, RelativeSource={RelativeSource TemplatedParent}}">
                            <m3:MaterialSegmentedButton x:Name="PART_Am"
                                                        MinWidth="56"
                                                        Content="AM" />
                            <m3:MaterialSegmentedButton x:Name="PART_Pm"
                                                        MinWidth="56"
                                                        Content="PM" />
                        </m3:MaterialSegmentedButtonRow>
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type m3:MaterialDateRangeInput}"
                      TargetType="m3:MaterialDateRangeInput">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <m3:MaterialDateInput x:Name="PART_Start"
                                              Width="200"
                                              Label="Start date"
                                              Culture="{TemplateBinding Culture}"
                                              DateFormat="{TemplateBinding DateFormat}"
                                              MinimumDate="{TemplateBinding MinimumDate}"
                                              MaximumDate="{TemplateBinding MaximumDate}"
                                              Text="{TemplateBinding StartText, Mode=TwoWay}" />
                        <m3:MaterialDateInput x:Name="PART_End"
                                              Width="200"
                                              Label="End date"
                                              Culture="{TemplateBinding Culture}"
                                              DateFormat="{TemplateBinding DateFormat}"
                                              MinimumDate="{TemplateBinding MinimumDate}"
                                              MaximumDate="{TemplateBinding MaximumDate}"
                                              Text="{TemplateBinding EndText, Mode=TwoWay}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>
</Styles>
