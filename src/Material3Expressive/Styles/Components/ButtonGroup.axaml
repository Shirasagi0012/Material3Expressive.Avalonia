<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
    <Design.PreviewWith>
        <Border Padding="20">
            <StackPanel Spacing="16">
                <m3:MaterialButtonGroup Variant="Connected">
                    <ToggleButton m3:M3Button.Variant="Tonal" Content="Day" IsChecked="True" />
                    <ToggleButton m3:M3Button.Variant="Tonal" Content="Week" />
                    <ToggleButton m3:M3Button.Variant="Tonal" Content="Month" />
                </m3:MaterialButtonGroup>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <!-- The selected endpoint is a style fallback. Keep it separate from GeometryProfile so an
         application style/local value on the public-facing transport retains ordinary precedence. -->
    <Style Selector="m3|MaterialButtonGroup">
        <Setter Property="MaterialGeometryProfile"
                Value="{DynamicResource {x:Static m3:ButtonGroupValueKeys.StandardProfile}}" />
    </Style>
    <Style Selector="m3|MaterialButtonGroup[Variant=Connected]">
        <Setter Property="MaterialGeometryProfile"
                Value="{DynamicResource {x:Static m3:ButtonGroupValueKeys.ConnectedProfile}}" />
    </Style>

    <Styles.Resources>
        <ControlTheme x:Key="{x:Type m3:MaterialButtonGroup}" TargetType="m3:MaterialButtonGroup">
        </ControlTheme>
    </Styles.Resources>
</Styles>
