<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
    <Design.PreviewWith>
        <Border Padding="24">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <m3:MaterialFab Content="+" />
                <m3:MaterialFab Content="+" Label="Compose" />
                <m3:MaterialFab Content="+" Size="Large" Variant="Tertiary" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <ControlTheme x:Key="{x:Type m3:MaterialFab}" TargetType="m3:MaterialFab">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Orientation="Horizontal"
                                Margin="{TemplateBinding Padding}"
                                Spacing="{TemplateBinding IconLabelSpace}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Viewbox Width="{TemplateBinding IconSize}"
                                 Height="{TemplateBinding IconSize}"
                                 VerticalAlignment="Center"
                                 Stretch="Uniform">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Viewbox>
                        <ContentPresenter x:Name="LabelPresenter"
                                          VerticalAlignment="Center"
                                          IsVisible="{TemplateBinding IsExtended}"
                                          Content="{TemplateBinding Label}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>
</Styles>
