<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
    <Design.PreviewWith>
        <Border Padding="20">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <m3:MaterialChip Variant="Assist" Content="Assist" />
                <m3:MaterialChip Variant="Filter" Content="Filter" IsChecked="True" />
                <m3:MaterialChip Variant="Input" Content="Input" />
                <m3:MaterialChip Variant="Suggestion" Content="Suggestion" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <ControlTheme x:Key="{x:Type m3:MaterialChip}" TargetType="m3:MaterialChip">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- Variant selectors below choose the immutable MaterialValue profiles.  These
                 bindings keep ordinary public properties at theme priority, so an application
                 style or a local value can still override Foreground, Padding and MinHeight. -->
            <Setter Property="GeometryProfile"
                    Value="{DynamicResource {x:Static m3:ChipValueKeys.GeometryProfile}}" />
            <Setter Property="Padding"
                    Value="{Binding GeometryProfile.ContentPadding, RelativeSource={RelativeSource Self}}" />
            <Setter Property="MinHeight"
                    Value="{Binding GeometryProfile.ContainerHeight, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Foreground"
                    Value="{Binding LabelBrush, RelativeSource={RelativeSource Self}}" />
            <Setter Property="m3:TypographyScheme.TextStyle"
                    Value="{DynamicResource {x:Static m3:ChipValueKeys.AssistLabelTextStyle}}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Orientation="Horizontal"
                                Margin="{TemplateBinding Padding}"
                                Spacing="{TemplateBinding IconLabelSpace}"
                                VerticalAlignment="Center">
                        <ContentPresenter Width="{TemplateBinding IconSize}"
                                          Height="{TemplateBinding IconSize}"
                                          VerticalAlignment="Center"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch"
                                          IsVisible="{TemplateBinding LeadingIcon, Converter={x:Static ObjectConverters.IsNotNull}}"
                                          Content="{TemplateBinding LeadingIcon}"
                                          TextElement.Foreground="{TemplateBinding IconBrush}" />
                        <ContentPresenter VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}" />
                        <ContentPresenter Width="{TemplateBinding IconSize}"
                                          Height="{TemplateBinding IconSize}"
                                          VerticalAlignment="Center"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch"
                                          IsVisible="{TemplateBinding TrailingIcon, Converter={x:Static ObjectConverters.IsNotNull}}"
                                          Content="{TemplateBinding TrailingIcon}"
                                          TextElement.Foreground="{TemplateBinding IconBrush}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>

            <Style Selector="^[Variant=Assist]">
                <Setter Property="VisualColors"
                        Value="{DynamicResource {x:Static m3:ChipValueKeys.AssistVisualColors}}" />
                <Setter Property="m3:TypographyScheme.TextStyle"
                        Value="{DynamicResource {x:Static m3:ChipValueKeys.AssistLabelTextStyle}}" />
            </Style>
            <Style Selector="^[Variant=Filter]">
                <Setter Property="VisualColors"
                        Value="{DynamicResource {x:Static m3:ChipValueKeys.FilterVisualColors}}" />
                <Setter Property="m3:TypographyScheme.TextStyle"
                        Value="{DynamicResource {x:Static m3:ChipValueKeys.FilterLabelTextStyle}}" />
            </Style>
            <Style Selector="^[Variant=Input]">
                <Setter Property="VisualColors"
                        Value="{DynamicResource {x:Static m3:ChipValueKeys.InputVisualColors}}" />
                <Setter Property="m3:TypographyScheme.TextStyle"
                        Value="{DynamicResource {x:Static m3:ChipValueKeys.InputLabelTextStyle}}" />
            </Style>
            <Style Selector="^[Variant=Suggestion]">
                <Setter Property="VisualColors"
                        Value="{DynamicResource {x:Static m3:ChipValueKeys.SuggestionVisualColors}}" />
                <Setter Property="m3:TypographyScheme.TextStyle"
                        Value="{DynamicResource {x:Static m3:ChipValueKeys.SuggestionLabelTextStyle}}" />
            </Style>
        </ControlTheme>
    </Styles.Resources>
</Styles>
