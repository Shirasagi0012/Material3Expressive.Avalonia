<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
    <Design.PreviewWith>
        <Border Width="420">
            <m3:MaterialTabs SelectedIndex="1">
                <m3:MaterialTab Content="Overview" />
                <m3:MaterialTab Content="Specifications" />
                <m3:MaterialTab Content="Reviews" />
            </m3:MaterialTabs>
        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <ControlTheme x:Key="{x:Type m3:MaterialTab}" TargetType="m3:MaterialTab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- Tab.kt centres TabBaselineLayout in the full tab using a physical-pixel
                         rounded intrinsic offset. The custom panel owns that placement. -->
                    <m3:MaterialTabContentPanel Spacing="2">
                        <ContentPresenter Width="{TemplateBinding IconSize}"
                                          Height="{TemplateBinding IconSize}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          VerticalContentAlignment="Stretch"
                                          IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                                          Content="{TemplateBinding Icon}"
                                          TextElement.Foreground="{TemplateBinding IconBrush}" />
                        <ContentPresenter HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Padding="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}" />
                    </m3:MaterialTabContentPanel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type m3:MaterialTabs}" TargetType="m3:MaterialTabs">
            <Setter Property="Template">
                <ControlTemplate>
                    <ItemsControl ItemsSource="{Binding $parent[m3:MaterialTabs].Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- TabRow.kt uses integral physical tab widths, leaving any
                                     remainder at the trailing edge rather than retaining
                                     fractional logical columns. -->
                                <m3:MaterialTabItemsPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>
</Styles>
