<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
    <Design.PreviewWith>
        <Border Width="420">
            <m3:MaterialTabs SelectedIndex="1">
                <m3:MaterialTab Content="Overview" />
                <m3:MaterialTab Content="Specifications" />
                <m3:MaterialTab Content="Reviews" />
            </m3:MaterialTabs>
        </Border>
    </Design.PreviewWith>

    <!-- Keep the public padding slot at ordinary style priority so application styles and local
         values retain Avalonia's normal precedence over the library fallback. -->
    <Style Selector="m3|MaterialTab">
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Styles.Resources>
        <ControlTheme x:Key="{x:Type m3:MaterialTab}" TargetType="m3:MaterialTab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <!-- Variant selects explicit MaterialValue endpoints. The item consumes only the
                 resulting geometry/brush profiles; checked and enabled state stay selectors. -->
            <Setter Property="GeometryProfile"
                    Value="{DynamicResource {x:Static m3:TabValueKeys.PrimaryItemGeometry}}" />
            <Setter Property="VisualColors"
                    Value="{DynamicResource {x:Static m3:TabValueKeys.PrimaryItemVisualColors}}" />
            <Setter Property="m3:TypographyScheme.TextStyle"
                    Value="{Binding GeometryProfile.LabelTextStyle, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- Tab.kt centres TabBaselineLayout in the full tab using a physical-pixel
                         rounded intrinsic offset. The custom panel owns that placement. -->
                    <m3:MaterialTabContentPanel Spacing="2">
                        <ContentPresenter Width="{TemplateBinding IconSize}"
                                          Height="{TemplateBinding IconSize}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          VerticalContentAlignment="Stretch"
                                          IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                                          Content="{TemplateBinding Icon}"
                                          TextElement.Foreground="{TemplateBinding IconBrush}" />
                        <ContentPresenter HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Padding="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          TextElement.Foreground="{TemplateBinding EffectiveForeground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}" />
                    </m3:MaterialTabContentPanel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^[Variant=Primary]">
                <Setter Property="GeometryProfile"
                        Value="{DynamicResource {x:Static m3:TabValueKeys.PrimaryItemGeometry}}" />
                <Setter Property="VisualColors"
                        Value="{DynamicResource {x:Static m3:TabValueKeys.PrimaryItemVisualColors}}" />
            </Style>
            <Style Selector="^[Variant=Secondary]">
                <Setter Property="GeometryProfile"
                        Value="{DynamicResource {x:Static m3:TabValueKeys.SecondaryItemGeometry}}" />
                <Setter Property="VisualColors"
                        Value="{DynamicResource {x:Static m3:TabValueKeys.SecondaryItemVisualColors}}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type m3:MaterialTabs}" TargetType="m3:MaterialTabs">
            <!-- The row is a self-rendering consumer of two typed profiles. -->
            <Setter Property="GeometryProfile"
                    Value="{DynamicResource {x:Static m3:TabValueKeys.PrimaryRowGeometry}}" />
            <Setter Property="VisualColors"
                    Value="{DynamicResource {x:Static m3:TabValueKeys.PrimaryRowVisualColors}}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ItemsControl ItemsSource="{Binding $parent[m3:MaterialTabs].Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- TabRow.kt uses integral physical tab widths, leaving any
                                     remainder at the trailing edge rather than retaining
                                     fractional logical columns. -->
                                <m3:MaterialTabItemsPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:scrollable">
                <Setter Property="Template">
                    <ControlTemplate>
                        <ScrollViewer x:Name="PART_ScrollViewer"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding $parent[m3:MaterialTabs].Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <m3:MaterialScrollableTabItemsPanel
                                            EdgePadding="{Binding $parent[m3:MaterialTabs].ScrollableEdgePadding}"
                                            MinimumTabWidth="{Binding $parent[m3:MaterialTabs].ScrollableMinimumTabWidth}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter>
            </Style>
            <Style Selector="^[Variant=Primary]">
                <Setter Property="GeometryProfile"
                        Value="{DynamicResource {x:Static m3:TabValueKeys.PrimaryRowGeometry}}" />
                <Setter Property="VisualColors"
                        Value="{DynamicResource {x:Static m3:TabValueKeys.PrimaryRowVisualColors}}" />
            </Style>
            <Style Selector="^[Variant=Secondary]">
                <Setter Property="GeometryProfile"
                        Value="{DynamicResource {x:Static m3:TabValueKeys.SecondaryRowGeometry}}" />
                <Setter Property="VisualColors"
                        Value="{DynamicResource {x:Static m3:TabValueKeys.SecondaryRowVisualColors}}" />
            </Style>
        </ControlTheme>
    </Styles.Resources>
</Styles>
