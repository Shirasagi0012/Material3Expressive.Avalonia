<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
    <Design.PreviewWith>
        <Border Padding="20">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <m3:MaterialCard Variant="Elevated" Width="140" Height="90" Content="Elevated" />
                <m3:MaterialCard Variant="Filled" Width="140" Height="90" Content="Filled" />
                <m3:MaterialCard Variant="Outlined" Width="140" Height="90" Content="Outlined" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <!-- Like the native Button theme, the card paints its own surface, border and shadow in Render, so
             the template is only the content. -->
        <ControlTheme x:Key="{x:Type m3:MaterialCard}" TargetType="m3:MaterialCard">
            <Setter Property="Padding" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <!-- Variant selectors choose typed MaterialValue profiles. The public visual
                 properties remain ordinary base-theme setters so application styles and local
                 values keep their normal Avalonia precedence. -->
            <Setter Property="Background"
                    Value="{Binding ResolvedVisualColors.ContainerColor, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderBrush"
                    Value="{Binding ResolvedVisualColors.OutlineColor, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderThickness"
                    Value="{Binding ResolvedGeometry.BorderThickness, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter>

            <Style Selector="^[Variant=Elevated]">
                <Setter Property="ResolvedVisualColors"
                        Value="{DynamicResource {x:Static m3:CardValueKeys.ElevatedVisualColors}}" />
                <Setter Property="ResolvedGeometry"
                        Value="{DynamicResource {x:Static m3:CardValueKeys.ElevatedGeometry}}" />
                <Setter Property="ResolvedElevation"
                        Value="{DynamicResource {x:Static m3:CardValueKeys.ElevatedElevation}}" />
            </Style>
            <Style Selector="^[Variant=Filled]">
                <Setter Property="ResolvedVisualColors"
                        Value="{DynamicResource {x:Static m3:CardValueKeys.FilledVisualColors}}" />
                <Setter Property="ResolvedGeometry"
                        Value="{DynamicResource {x:Static m3:CardValueKeys.FilledGeometry}}" />
                <Setter Property="ResolvedElevation"
                        Value="{DynamicResource {x:Static m3:CardValueKeys.FilledElevation}}" />
            </Style>
            <Style Selector="^[Variant=Outlined]">
                <Setter Property="ResolvedVisualColors"
                        Value="{DynamicResource {x:Static m3:CardValueKeys.OutlinedVisualColors}}" />
                <Setter Property="ResolvedGeometry"
                        Value="{DynamicResource {x:Static m3:CardValueKeys.OutlinedGeometry}}" />
                <Setter Property="ResolvedElevation"
                        Value="{DynamicResource {x:Static m3:CardValueKeys.OutlinedElevation}}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Background"
                        Value="{Binding ResolvedVisualColors.DisabledContainerColor, RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderBrush"
                        Value="{Binding ResolvedVisualColors.DisabledOutlineColor, RelativeSource={RelativeSource Self}}" />
            </Style>

            <Style Selector="^[IsClickable=True]">
                <Setter Property="Cursor" Value="Hand" />
            </Style>
        </ControlTheme>
    </Styles.Resources>
</Styles>
