<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
    <Design.PreviewWith>
        <Border Padding="20">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Theme="{StaticResource MaterialStandardIconButtonTheme}" Content="A" />
                <Button Theme="{StaticResource MaterialFilledIconButtonTheme}" Content="B" />
                <Button Theme="{StaticResource MaterialTonalIconButtonTheme}" Content="C" />
                <Button Theme="{StaticResource MaterialOutlinedIconButtonTheme}" Content="D" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <ControlTheme x:Key="MaterialIconButtonCoreTheme" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ClipToBounds" Value="False" />
            <!-- All component values are typed MaterialValue endpoints. The ordinary Avalonia
                 presentation properties remain theme-priority setters so app styles and locals
                 retain their normal precedence. -->
            <Setter Property="Background"
                    Value="{Binding Path=(m3:M3IconButton.VisualColors).ContainerColor, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Foreground"
                    Value="{Binding Path=(m3:M3IconButton.VisualColors).IconColor, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderBrush"
                    Value="{Binding Path=(m3:M3IconButton.VisualColors).OutlineColor, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"
                    Value="{Binding Path=(m3:M3IconButton.GeometryProfile).ContentPadding, RelativeSource={RelativeSource Self}}" />
            <!-- Fixed rather than minimum size: this is Compose's Modifier.size contract. -->
            <Setter Property="Height"
                    Value="{Binding Path=(m3:M3IconButton.GeometryProfile).ContainerHeight, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Width"
                    Value="{Binding Path=(m3:M3IconButton.GeometryProfile).ContainerWidth, RelativeSource={RelativeSource Self}}" />
            <Setter Property="m3:M3IconButton.IconSize"
                    Value="{Binding Path=(m3:M3IconButton.GeometryProfile).IconSize, RelativeSource={RelativeSource Self}}" />
            <Setter Property="m3:M3IconButton.IsIconButton" Value="True" />
            <Setter Property="m3:M3IconButton.StateLayerBrush"
                    Value="{Binding Path=(m3:M3IconButton.VisualColors).StateLayerColor, RelativeSource={RelativeSource Self}}" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="Transparent">
                        <m3:MaterialIconButtonContainerPresenter x:Name="PART_Container"
                            GeometryProfile="{Binding Path=(m3:M3IconButton.GeometryProfile), RelativeSource={RelativeSource TemplatedParent}}" />
                        <!-- MaterialSymbol reads its arranged bounds to resolve the opsz axis. -->
                        <ContentPresenter Width="{Binding Path=(m3:M3IconButton.IconSize), RelativeSource={RelativeSource TemplatedParent}}"
                                          Height="{Binding Path=(m3:M3IconButton.IconSize), RelativeSource={RelativeSource TemplatedParent}}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                        <m3:MaterialRipplePresenter
                            StateLayerBrush="{Binding Path=(m3:M3IconButton.StateLayerBrush), RelativeSource={RelativeSource TemplatedParent}}"
                            CornerRadius="{Binding CurrentCornerRadius, ElementName=PART_Container}" />
                    </Grid>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:disabled">
                <Setter Property="Background"
                        Value="{Binding Path=(m3:M3IconButton.VisualColors).DisabledContainerColor, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Foreground"
                        Value="{Binding Path=(m3:M3IconButton.VisualColors).DisabledIconColor, RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderBrush"
                        Value="{Binding Path=(m3:M3IconButton.VisualColors).DisabledOutlineColor, RelativeSource={RelativeSource Self}}" />
            </Style>

            <!-- Variant policy chooses the visual endpoint; the plans themselves are requester
                 independent and only read their declared Raw component dependencies. -->
            <Style Selector="^[(m3|M3IconButton.Variant)=Standard]">
                <Setter Property="m3:M3IconButton.VisualColors"
                        Value="{DynamicResource {x:Static m3:IconButtonValueKeys.StandardVisualColors}}" />
            </Style>
            <Style Selector="^[(m3|M3IconButton.Variant)=Filled]">
                <Setter Property="m3:M3IconButton.VisualColors"
                        Value="{DynamicResource {x:Static m3:IconButtonValueKeys.FilledVisualColors}}" />
            </Style>
            <Style Selector="^[(m3|M3IconButton.Variant)=Tonal]">
                <Setter Property="m3:M3IconButton.VisualColors"
                        Value="{DynamicResource {x:Static m3:IconButtonValueKeys.TonalVisualColors}}" />
            </Style>
            <Style Selector="^[(m3|M3IconButton.Variant)=Outlined]">
                <Setter Property="m3:M3IconButton.VisualColors"
                        Value="{DynamicResource {x:Static m3:IconButtonValueKeys.OutlinedVisualColors}}" />
                <Setter Property="BorderThickness"
                        Value="{Binding Path=(m3:M3IconButton.GeometryProfile).OutlineWidth, RelativeSource={RelativeSource Self}}" />
            </Style>

            <!-- Size and width selectors choose one explicit profile endpoint. -->
            <Style Selector="^[(m3|M3IconButton.Size)=ExtraSmall]">
                <Style Selector="^[(m3|M3IconButton.ButtonWidth)=Narrow]">
                    <Setter Property="m3:M3IconButton.GeometryProfile"
                            Value="{DynamicResource {x:Static m3:IconButtonValueKeys.ExtraSmallNarrowGeometry}}" />
                </Style>
                <Style Selector="^[(m3|M3IconButton.ButtonWidth)=Default]">
                    <Setter Property="m3:M3IconButton.GeometryProfile"
                            Value="{DynamicResource {x:Static m3:IconButtonValueKeys.ExtraSmallDefaultGeometry}}" />
                </Style>
                <Style Selector="^[(m3|M3IconButton.ButtonWidth)=Wide]">
                    <Setter Property="m3:M3IconButton.GeometryProfile"
                            Value="{DynamicResource {x:Static m3:IconButtonValueKeys.ExtraSmallWideGeometry}}" />
                </Style>
            </Style>
            <Style Selector="^[(m3|M3IconButton.Size)=Small]">
                <Style Selector="^[(m3|M3IconButton.ButtonWidth)=Narrow]">
                    <Setter Property="m3:M3IconButton.GeometryProfile"
                            Value="{DynamicResource {x:Static m3:IconButtonValueKeys.SmallNarrowGeometry}}" />
                </Style>
                <Style Selector="^[(m3|M3IconButton.ButtonWidth)=Default]">
                    <Setter Property="m3:M3IconButton.GeometryProfile"
                            Value="{DynamicResource {x:Static m3:IconButtonValueKeys.SmallDefaultGeometry}}" />
                </Style>
                <Style Selector="^[(m3|M3IconButton.ButtonWidth)=Wide]">
                    <Setter Property="m3:M3IconButton.GeometryProfile"
                            Value="{DynamicResource {x:Static m3:IconButtonValueKeys.SmallWideGeometry}}" />
                </Style>
            </Style>
            <Style Selector="^[(m3|M3IconButton.Size)=Medium]">
                <Style Selector="^[(m3|M3IconButton.ButtonWidth)=Narrow]">
                    <Setter Property="m3:M3IconButton.GeometryProfile"
                            Value="{DynamicResource {x:Static m3:IconButtonValueKeys.MediumNarrowGeometry}}" />
                </Style>
                <Style Selector="^[(m3|M3IconButton.ButtonWidth)=Default]">
                    <Setter Property="m3:M3IconButton.GeometryProfile"
                            Value="{DynamicResource {x:Static m3:IconButtonValueKeys.MediumDefaultGeometry}}" />
                </Style>
                <Style Selector="^[(m3|M3IconButton.ButtonWidth)=Wide]">
                    <Setter Property="m3:M3IconButton.GeometryProfile"
                            Value="{DynamicResource {x:Static m3:IconButtonValueKeys.MediumWideGeometry}}" />
                </Style>
            </Style>
            <Style Selector="^[(m3|M3IconButton.Size)=Large]">
                <Style Selector="^[(m3|M3IconButton.ButtonWidth)=Narrow]">
                    <Setter Property="m3:M3IconButton.GeometryProfile"
                            Value="{DynamicResource {x:Static m3:IconButtonValueKeys.LargeNarrowGeometry}}" />
                </Style>
                <Style Selector="^[(m3|M3IconButton.ButtonWidth)=Default]">
                    <Setter Property="m3:M3IconButton.GeometryProfile"
                            Value="{DynamicResource {x:Static m3:IconButtonValueKeys.LargeDefaultGeometry}}" />
                </Style>
                <Style Selector="^[(m3|M3IconButton.ButtonWidth)=Wide]">
                    <Setter Property="m3:M3IconButton.GeometryProfile"
                            Value="{DynamicResource {x:Static m3:IconButtonValueKeys.LargeWideGeometry}}" />
                </Style>
            </Style>
            <Style Selector="^[(m3|M3IconButton.Size)=ExtraLarge]">
                <Style Selector="^[(m3|M3IconButton.ButtonWidth)=Narrow]">
                    <Setter Property="m3:M3IconButton.GeometryProfile"
                            Value="{DynamicResource {x:Static m3:IconButtonValueKeys.ExtraLargeNarrowGeometry}}" />
                </Style>
                <Style Selector="^[(m3|M3IconButton.ButtonWidth)=Default]">
                    <Setter Property="m3:M3IconButton.GeometryProfile"
                            Value="{DynamicResource {x:Static m3:IconButtonValueKeys.ExtraLargeDefaultGeometry}}" />
                </Style>
                <Style Selector="^[(m3|M3IconButton.ButtonWidth)=Wide]">
                    <Setter Property="m3:M3IconButton.GeometryProfile"
                            Value="{DynamicResource {x:Static m3:IconButtonValueKeys.ExtraLargeWideGeometry}}" />
                </Style>
            </Style>
        </ControlTheme>

        <!-- Public named themes are only defaults for the canonical Variant attached property. -->
        <ControlTheme x:Key="MaterialStandardIconButtonTheme"
                      TargetType="Button"
                      BasedOn="{StaticResource MaterialIconButtonCoreTheme}">
            <Setter Property="m3:M3IconButton.Variant" Value="Standard" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialFilledIconButtonTheme"
                      TargetType="Button"
                      BasedOn="{StaticResource MaterialIconButtonCoreTheme}">
            <Setter Property="m3:M3IconButton.Variant" Value="Filled" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialTonalIconButtonTheme"
                      TargetType="Button"
                      BasedOn="{StaticResource MaterialIconButtonCoreTheme}">
            <Setter Property="m3:M3IconButton.Variant" Value="Tonal" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialOutlinedIconButtonTheme"
                      TargetType="Button"
                      BasedOn="{StaticResource MaterialIconButtonCoreTheme}">
            <Setter Property="m3:M3IconButton.Variant" Value="Outlined" />
        </ControlTheme>

        <ControlTheme x:Key="MaterialToggleIconButtonCoreTheme"
                      TargetType="ToggleButton"
                      BasedOn="{StaticResource MaterialIconButtonCoreTheme}">
            <!-- Toggle colours keep their checked/unchecked contract separate from ordinary
                 icon buttons. Geometry and size selectors are shared through M3IconButton. -->
            <Setter Property="Background"
                    Value="{Binding Path=(m3:M3ToggleIconButton.VisualColors).UncheckedContainerColor, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Foreground"
                    Value="{Binding Path=(m3:M3ToggleIconButton.VisualColors).UncheckedIconColor, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderBrush"
                    Value="{Binding Path=(m3:M3ToggleIconButton.VisualColors).UncheckedOutlineColor, RelativeSource={RelativeSource Self}}" />
            <Setter Property="m3:M3ToggleIconButton.StateLayerBrush"
                    Value="{Binding Path=(m3:M3ToggleIconButton.VisualColors).UncheckedStateLayerColor, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="Transparent">
                        <m3:MaterialIconButtonContainerPresenter x:Name="PART_Container"
                            GeometryProfile="{Binding Path=(m3:M3IconButton.GeometryProfile), RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Width="{Binding Path=(m3:M3IconButton.IconSize), RelativeSource={RelativeSource TemplatedParent}}"
                                          Height="{Binding Path=(m3:M3IconButton.IconSize), RelativeSource={RelativeSource TemplatedParent}}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                        <m3:MaterialRipplePresenter
                            StateLayerBrush="{Binding Path=(m3:M3ToggleIconButton.StateLayerBrush), RelativeSource={RelativeSource TemplatedParent}}"
                            CornerRadius="{Binding CurrentCornerRadius, ElementName=PART_Container}" />
                    </Grid>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:checked">
                <Setter Property="Background"
                        Value="{Binding Path=(m3:M3ToggleIconButton.VisualColors).CheckedContainerColor, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Foreground"
                        Value="{Binding Path=(m3:M3ToggleIconButton.VisualColors).CheckedIconColor, RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderBrush"
                        Value="{Binding Path=(m3:M3ToggleIconButton.VisualColors).CheckedOutlineColor, RelativeSource={RelativeSource Self}}" />
                <Setter Property="m3:M3ToggleIconButton.StateLayerBrush"
                        Value="{Binding Path=(m3:M3ToggleIconButton.VisualColors).CheckedStateLayerColor, RelativeSource={RelativeSource Self}}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Background"
                        Value="{Binding Path=(m3:M3ToggleIconButton.VisualColors).DisabledContainerColor, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Foreground"
                        Value="{Binding Path=(m3:M3ToggleIconButton.VisualColors).DisabledIconColor, RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderBrush"
                        Value="{Binding Path=(m3:M3ToggleIconButton.VisualColors).DisabledOutlineColor, RelativeSource={RelativeSource Self}}" />
            </Style>

            <Style Selector="^[(m3|M3IconButton.Variant)=Standard]">
                <Setter Property="m3:M3ToggleIconButton.VisualColors"
                        Value="{DynamicResource {x:Static m3:IconButtonValueKeys.StandardToggleVisualColors}}" />
            </Style>
            <Style Selector="^[(m3|M3IconButton.Variant)=Filled]">
                <Setter Property="m3:M3ToggleIconButton.VisualColors"
                        Value="{DynamicResource {x:Static m3:IconButtonValueKeys.FilledToggleVisualColors}}" />
            </Style>
            <Style Selector="^[(m3|M3IconButton.Variant)=Tonal]">
                <Setter Property="m3:M3ToggleIconButton.VisualColors"
                        Value="{DynamicResource {x:Static m3:IconButtonValueKeys.TonalToggleVisualColors}}" />
            </Style>
            <Style Selector="^[(m3|M3IconButton.Variant)=Outlined]">
                <Setter Property="m3:M3ToggleIconButton.VisualColors"
                        Value="{DynamicResource {x:Static m3:IconButtonValueKeys.OutlinedToggleVisualColors}}" />
                <Setter Property="BorderThickness"
                        Value="{Binding Path=(m3:M3IconButton.GeometryProfile).OutlineWidth, RelativeSource={RelativeSource Self}}" />
            </Style>
            <Style Selector="^[(m3|M3IconButton.Variant)=Outlined]:checked">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="MaterialStandardToggleIconButtonTheme"
                      TargetType="ToggleButton"
                      BasedOn="{StaticResource MaterialToggleIconButtonCoreTheme}">
            <Setter Property="m3:M3IconButton.Variant" Value="Standard" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialFilledToggleIconButtonTheme"
                      TargetType="ToggleButton"
                      BasedOn="{StaticResource MaterialToggleIconButtonCoreTheme}">
            <Setter Property="m3:M3IconButton.Variant" Value="Filled" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialTonalToggleIconButtonTheme"
                      TargetType="ToggleButton"
                      BasedOn="{StaticResource MaterialToggleIconButtonCoreTheme}">
            <Setter Property="m3:M3IconButton.Variant" Value="Tonal" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialOutlinedToggleIconButtonTheme"
                      TargetType="ToggleButton"
                      BasedOn="{StaticResource MaterialToggleIconButtonCoreTheme}">
            <Setter Property="m3:M3IconButton.Variant" Value="Outlined" />
        </ControlTheme>
    </Styles.Resources>
</Styles>
