<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
    <Design.PreviewWith>
        <Border Padding="20">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <m3:MaterialIconButton Variant="Standard" Content="A" />
                <m3:MaterialIconButton Variant="Filled" Content="B" />
                <m3:MaterialIconButton Variant="Tonal" Content="C" />
                <m3:MaterialIconButton Variant="Outlined" Content="D" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <ControlTheme x:Key="{x:Type m3:MaterialIconButton}" TargetType="m3:MaterialIconButton">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- The icon is sized by the token rather than by the content, so a symbol,
                         a path and a glyph all land at the same size. -->
                    <Viewbox Width="{TemplateBinding IconSize}"
                             Height="{TemplateBinding IconSize}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Stretch="Uniform">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Viewbox>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type m3:MaterialToggleIconButton}" TargetType="m3:MaterialToggleIconButton">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Viewbox Width="{TemplateBinding IconSize}"
                             Height="{TemplateBinding IconSize}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Stretch="Uniform">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Viewbox>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>
</Styles>
