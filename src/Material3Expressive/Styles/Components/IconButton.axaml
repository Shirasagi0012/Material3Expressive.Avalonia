<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
    <Design.PreviewWith>
        <Border Padding="20">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Theme="{StaticResource MaterialStandardIconButtonTheme}" Content="A" />
                <Button Theme="{StaticResource MaterialFilledIconButtonTheme}" Content="B" />
                <Button Theme="{StaticResource MaterialTonalIconButtonTheme}" Content="C" />
                <Button Theme="{StaticResource MaterialOutlinedIconButtonTheme}" Content="D" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <ControlTheme x:Key="MaterialIconButtonCoreTheme" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Background" Value="{m3:MdIconButtonToken ContainerColor}" />
            <Setter Property="Foreground" Value="{m3:MdIconButtonToken IconColor}" />
            <Setter Property="BorderBrush" Value="{m3:MdIconButtonToken OutlineColor}" />
            <Setter Property="BorderThickness" Value="{m3:MdIconButtonToken ContainerOutlineThickness}" />
            <Setter Property="Padding" Value="{m3:MdIconButtonToken ContentPadding}" />
            <!-- Fixed rather than minimum size: like androidx's Modifier.size, the container must
                 keep its token metrics even when a parent panel stretches its children. -->
            <Setter Property="Height" Value="{m3:MdIconButtonToken ContainerHeight}" />
            <Setter Property="Width" Value="{m3:MdIconButtonToken ContainerWidth}" />
            <Setter Property="m3:IconButtonAssist.IconSize" Value="{m3:MdIconButtonToken IconSize}" />
            <Setter Property="m3:IconButtonAssist.IsIconButton" Value="True" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="Transparent">
                        <m3:MaterialIconButtonContainerPresenter x:Name="PART_Container" />
                        <!-- MaterialSymbol reads its arranged bounds to resolve the opsz axis. -->
                        <ContentPresenter Width="{m3:MdIconButtonToken IconSize}"
                                          Height="{m3:MdIconButtonToken IconSize}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                        <m3:MaterialRipplePresenter
                            StateLayerBrush="{m3:MdIconButtonToken StateLayerColor}"
                            CornerRadius="{Binding CurrentCornerRadius, ElementName=PART_Container}" />
                    </Grid>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:disabled">
                <Setter Property="Background" Value="{m3:MdIconButtonToken DisabledContainerColor}" />
                <Setter Property="Foreground" Value="{m3:MdIconButtonToken DisabledIconColor}" />
                <Setter Property="BorderBrush" Value="{m3:MdIconButtonToken DisabledOutlineColor}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="MaterialStandardIconButtonTheme"
                      TargetType="Button"
                      BasedOn="{StaticResource MaterialIconButtonCoreTheme}">
            <Setter Property="m3:IconButtonAssist.Variant" Value="Standard" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialFilledIconButtonTheme"
                      TargetType="Button"
                      BasedOn="{StaticResource MaterialIconButtonCoreTheme}">
            <Setter Property="m3:IconButtonAssist.Variant" Value="Filled" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialTonalIconButtonTheme"
                      TargetType="Button"
                      BasedOn="{StaticResource MaterialIconButtonCoreTheme}">
            <Setter Property="m3:IconButtonAssist.Variant" Value="Tonal" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialOutlinedIconButtonTheme"
                      TargetType="Button"
                      BasedOn="{StaticResource MaterialIconButtonCoreTheme}">
            <Setter Property="m3:IconButtonAssist.Variant" Value="Outlined" />
        </ControlTheme>

        <ControlTheme x:Key="MaterialToggleIconButtonCoreTheme"
                      TargetType="ToggleButton"
                      BasedOn="{StaticResource MaterialIconButtonCoreTheme}">
            <Setter Property="Background" Value="{m3:MdIconButtonToken UnselectedContainerColor}" />
            <Setter Property="Foreground" Value="{m3:MdIconButtonToken UnselectedIconColor}" />
            <Setter Property="BorderBrush" Value="{m3:MdIconButtonToken UnselectedOutlineColor}" />

            <Style Selector="^:checked">
                <Setter Property="Background" Value="{m3:MdIconButtonToken SelectedContainerColor}" />
                <Setter Property="Foreground" Value="{m3:MdIconButtonToken SelectedIconColor}" />
                <Setter Property="BorderBrush" Value="{m3:MdIconButtonToken OutlineColor}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Background" Value="{m3:MdIconButtonToken DisabledContainerColor}" />
                <Setter Property="Foreground" Value="{m3:MdIconButtonToken DisabledIconColor}" />
                <Setter Property="BorderBrush" Value="{m3:MdIconButtonToken DisabledOutlineColor}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="MaterialStandardToggleIconButtonTheme"
                      TargetType="ToggleButton"
                      BasedOn="{StaticResource MaterialToggleIconButtonCoreTheme}">
            <Setter Property="m3:IconButtonAssist.Variant" Value="Standard" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialFilledToggleIconButtonTheme"
                      TargetType="ToggleButton"
                      BasedOn="{StaticResource MaterialToggleIconButtonCoreTheme}">
            <Setter Property="m3:IconButtonAssist.Variant" Value="Filled" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialTonalToggleIconButtonTheme"
                      TargetType="ToggleButton"
                      BasedOn="{StaticResource MaterialToggleIconButtonCoreTheme}">
            <Setter Property="m3:IconButtonAssist.Variant" Value="Tonal" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialOutlinedToggleIconButtonTheme"
                      TargetType="ToggleButton"
                      BasedOn="{StaticResource MaterialToggleIconButtonCoreTheme}">
            <Setter Property="m3:IconButtonAssist.Variant" Value="Outlined" />
        </ControlTheme>

        <ControlTheme x:Key="{x:Type m3:MaterialIconButton}"
                      TargetType="m3:MaterialIconButton"
                      BasedOn="{StaticResource MaterialStandardIconButtonTheme}" />
        <ControlTheme x:Key="{x:Type m3:MaterialToggleIconButton}"
                      TargetType="m3:MaterialToggleIconButton"
                      BasedOn="{StaticResource MaterialStandardToggleIconButtonTheme}" />
    </Styles.Resources>
</Styles>
