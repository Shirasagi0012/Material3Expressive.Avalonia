<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
    <Design.PreviewWith>
        <Border Padding="24">
            <StackPanel Spacing="16" Width="240">
                <m3:MaterialLinearProgressIndicator Value="0.6" />
                <m3:MaterialLinearProgressIndicator Value="0.6" IsWavy="True" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <m3:MaterialCircularProgressIndicator Value="0.6" />
                    <m3:MaterialLoadingIndicator />
                </StackPanel>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <!-- The linear indicator takes whatever width it is given but has a fixed height; the
             other two are fixed in both directions. Left to stretch they would only inflate their
             bounds, since all three draw centred. -->
        <ControlTheme x:Key="{x:Type m3:MaterialLinearProgressIndicator}"
                      TargetType="m3:MaterialLinearProgressIndicator">
            <Setter Property="VerticalAlignment" Value="Center" />
        </ControlTheme>

        <ControlTheme x:Key="{x:Type m3:MaterialCircularProgressIndicator}"
                      TargetType="m3:MaterialCircularProgressIndicator">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </ControlTheme>

        <ControlTheme x:Key="{x:Type m3:MaterialLoadingIndicator}" TargetType="m3:MaterialLoadingIndicator">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </ControlTheme>
    </Styles.Resources>
</Styles>
