<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
    <Styles.Resources>
        <ControlTheme x:Key="{x:Type m3:MaterialSurface}" TargetType="m3:MaterialSurface">
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
        <ControlTheme x:Key="{x:Type m3:MaterialListItem}" TargetType="m3:MaterialListItem">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" Margin="{TemplateBinding Padding}">
                        <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                          Content="{TemplateBinding LeadingContent}"
                                          TextElement.Foreground="{TemplateBinding LeadingBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <ContentPresenter Content="{TemplateBinding OverlineContent}"
                                              IsVisible="{TemplateBinding OverlineContent, Converter={x:Static ObjectConverters.IsNotNull}}"
                                              TextElement.Foreground="{TemplateBinding SupportingBrush}" />
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter Content="{TemplateBinding SupportingContent}"
                                              IsVisible="{TemplateBinding SupportingContent, Converter={x:Static ObjectConverters.IsNotNull}}"
                                              TextElement.Foreground="{TemplateBinding SupportingBrush}" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="2" VerticalAlignment="Center"
                                          Content="{TemplateBinding TrailingContent}"
                                          TextElement.Foreground="{TemplateBinding TrailingBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>
</Styles>
