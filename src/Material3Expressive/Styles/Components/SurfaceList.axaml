<!-- Upstream source: AndroidX ff0a0a99 / Material3 1.5.0-alpha25,
     compose/material3/material3/src/commonMain/kotlin/androidx/compose/material3/ListItem.kt:1568-1604
     and ListItemDefaults.kt:750-835, 1135-1159. The executable Compose Multiplatform Material3
     1.12.0-alpha03 / Jetpack Material3 1.5.0-alpha22 reference supports the interactive states
     below but not alpha25's non-interactive overload or line-aware height policy. The private
     PART_ContentClip is Avalonia template plumbing, deliberately not a public ListItem API. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
    <Styles.Resources>
        <ControlTheme x:Key="{x:Type m3:MaterialListItem}" TargetType="m3:MaterialListItem">
            <!-- Geometry and visual profiles are the only Material default inputs. Padding remains
                 public and can still be replaced by an application style or local value. -->
            <Setter Property="ResolvedGeometry"
                    Value="{DynamicResource {x:Static m3:ListItemValueKeys.GeometryProfile}}" />
            <Setter Property="ResolvedVisualColors"
                    Value="{DynamicResource {x:Static m3:ListItemValueKeys.VisualColors}}" />
            <Setter Property="Padding"
                    Value="{Binding ResolvedGeometry.ContentPadding, RelativeSource={RelativeSource Self}}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- ListItem.kt:1580-1604 gives the elevated shadow an unclipped outer
                         layer, then clips its background, slots, and ripple to the same animated
                         shape. MaterialListItem itself remains unclipped; this private template
                         host provides the inner clip without truncating the shadow. -->
                    <Border x:Name="PART_ContentClip"
                            ClipToBounds="True">
                        <m3:MaterialListItemPanel ContentPadding="{TemplateBinding Padding}"
                                                  BetweenSpace="{Binding ResolvedGeometry.BetweenSpace, RelativeSource={RelativeSource TemplatedParent}}"
                                                  OneLineMinimumHeight="{Binding ResolvedGeometry.OneLineContainerHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                                  TwoLineMinimumHeight="{Binding ResolvedGeometry.TwoLineContainerHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ThreeLineMinimumHeight="{Binding ResolvedGeometry.ThreeLineContainerHeight, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter x:Name="PART_Leading"
                                              Content="{TemplateBinding LeadingContent}"
                                              IsVisible="{TemplateBinding LeadingContent, Converter={x:Static ObjectConverters.IsNotNull}}"
                                              m3:MaterialListItemPanel.Slot="Leading"
                                              m3:TypographyScheme.TextStyle="{Binding ResolvedGeometry.LeadingTextStyle, RelativeSource={RelativeSource TemplatedParent}}"
                                              TextElement.Foreground="{TemplateBinding LeadingBrush}" />
                            <ContentPresenter x:Name="PART_Trailing"
                                              Content="{TemplateBinding TrailingContent}"
                                              IsVisible="{TemplateBinding TrailingContent, Converter={x:Static ObjectConverters.IsNotNull}}"
                                              m3:MaterialListItemPanel.Slot="Trailing"
                                              m3:TypographyScheme.TextStyle="{Binding ResolvedGeometry.TrailingTextStyle, RelativeSource={RelativeSource TemplatedParent}}"
                                              TextElement.Foreground="{TemplateBinding TrailingBrush}" />
                            <ContentPresenter x:Name="PART_Overline"
                                              Content="{TemplateBinding OverlineContent}"
                                              IsVisible="{TemplateBinding OverlineContent, Converter={x:Static ObjectConverters.IsNotNull}}"
                                              m3:MaterialListItemPanel.Slot="Overline"
                                              m3:TypographyScheme.TextStyle="{Binding ResolvedGeometry.OverlineTextStyle, RelativeSource={RelativeSource TemplatedParent}}"
                                              TextElement.Foreground="{TemplateBinding OverlineBrush}" />
                            <ContentPresenter x:Name="PART_Headline"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              m3:MaterialListItemPanel.Slot="Headline"
                                              m3:TypographyScheme.TextStyle="{Binding ResolvedGeometry.ContentTextStyle, RelativeSource={RelativeSource TemplatedParent}}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter x:Name="PART_Supporting"
                                              Content="{TemplateBinding SupportingContent}"
                                              IsVisible="{TemplateBinding SupportingContent, Converter={x:Static ObjectConverters.IsNotNull}}"
                                              m3:MaterialListItemPanel.Slot="Supporting"
                                              m3:TypographyScheme.TextStyle="{Binding ResolvedGeometry.SupportingTextStyle, RelativeSource={RelativeSource TemplatedParent}}"
                                              TextElement.Foreground="{TemplateBinding SupportingBrush}" />
                        </m3:MaterialListItemPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
        <ControlTheme x:Key="{x:Type m3:MaterialSegmentedList}" TargetType="m3:MaterialSegmentedList">
            <Setter Property="ResolvedGeometry"
                    Value="{DynamicResource {x:Static m3:ListItemValueKeys.GeometryProfile}}" />
            <Setter Property="Spacing"
                    Value="{Binding ResolvedGeometry.SegmentedGap, RelativeSource={RelativeSource Self}}" />
        </ControlTheme>
    </Styles.Resources>
</Styles>
