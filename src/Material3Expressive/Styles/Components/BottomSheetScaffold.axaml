<!-- Upstream source: AndroidX ff0a0a99 / Material3 1.5.0-alpha25,
     compose/material3/material3/src/commonMain/kotlin/androidx/compose/material3/BottomSheetScaffold.kt:116-340.
     The panel preserves alpha25 slot order and the standard sheet's 56dp partial anchor. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
    <Styles.Resources>
        <ControlTheme x:Key="{x:Type m3:MaterialBottomSheetScaffold}"
                      TargetType="m3:MaterialBottomSheetScaffold">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            ClipToBounds="True">
                        <m3:MaterialBottomSheetScaffoldPanel>
                            <ContentPresenter x:Name="PART_TopBar"
                                              ZIndex="1"
                                              Content="{TemplateBinding TopBar}"
                                              IsVisible="{TemplateBinding TopBar, Converter={x:Static ObjectConverters.IsNotNull}}"
                                              HorizontalContentAlignment="Stretch" />
                            <ContentPresenter x:Name="PART_Content"
                                              ZIndex="0"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <ContentPresenter x:Name="PART_SnackbarHost"
                                              ZIndex="2"
                                              Content="{TemplateBinding SnackbarHost}"
                                              IsVisible="{TemplateBinding SnackbarHost, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <m3:MaterialBottomSheetScaffoldSheet
                                x:Name="PART_Sheet"
                                ZIndex="3"
                                IsVisible="{TemplateBinding SheetContent, Converter={x:Static ObjectConverters.IsNotNull}}"
                                PeekHeight="{TemplateBinding SheetPeekHeight}"
                                SwipeEnabled="{TemplateBinding SheetSwipeEnabled}"
                                State="{TemplateBinding State}"
                                Content="{TemplateBinding SheetContent}" />
                        </m3:MaterialBottomSheetScaffoldPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>
</Styles>
