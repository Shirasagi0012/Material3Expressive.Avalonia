<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
        xmlns:mcu="https://github.com/Shirasagi0012/MaterialColorUtilities.Avalonia"
        xmlns:ms="using:MaterialSymbols.Avalonia">
    <Design.PreviewWith>
        <Border Padding="0" Width="420">
            <m3:MaterialNavigationBar SelectedIndex="0">
                <m3:MaterialNavigationItem Content="Home">
                    <m3:MaterialNavigationItem.Icon>
                        <ms:MaterialSymbol Symbol="Home" />
                    </m3:MaterialNavigationItem.Icon>
                </m3:MaterialNavigationItem>
                <m3:MaterialNavigationItem Content="Saved">
                    <m3:MaterialNavigationItem.Icon>
                        <ms:MaterialSymbol Symbol="Star" />
                    </m3:MaterialNavigationItem.Icon>
                </m3:MaterialNavigationItem>
                <m3:MaterialNavigationItem Content="Inbox">
                    <m3:MaterialNavigationItem.Icon>
                        <ms:MaterialSymbol Symbol="Mail" />
                    </m3:MaterialNavigationItem.Icon>
                </m3:MaterialNavigationItem>
            </m3:MaterialNavigationBar>
        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <ControlTheme x:Key="{x:Type m3:MaterialNavigationItem}" TargetType="m3:MaterialNavigationItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- The indicator is painted behind this by the control, so the template only
                         has to stack the icon over the label and centre the pair. -->
                    <!-- NavigationBarItemLayout / NavigationRailItemLayout centre integral
                         Compose placeables, rather than fractional logical bounds. The custom
                         panel mirrors that calculation before it arranges these two slots. -->
                    <m3:MaterialNavigationItemContentPanel x:Name="PART_ContentPanel"
                                                           IconPosition="{TemplateBinding IconPosition}"
                                                           Spacing="{TemplateBinding IconLabelSpace}"
                                                           TopVerticalPadding="{TemplateBinding TopItemVerticalPadding}"
                                                           TopIndicatorVerticalPadding="{TemplateBinding TopIndicatorVerticalPadding}"
                                                           AnchorTop="{TemplateBinding AnchorTopIcon}"
                                                           AlignStart="{TemplateBinding IsWideNavigationExpandedItem}"
                                                           StartHorizontalPadding="{TemplateBinding StartIndicatorHorizontalPadding}"
                                                           StartVerticalPadding="{TemplateBinding StartIndicatorVerticalPadding}">
                        <ContentPresenter Width="{TemplateBinding IconSize}"
                                          Height="{TemplateBinding IconSize}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          VerticalContentAlignment="Stretch"
                                          Content="{TemplateBinding Icon}"
                                          TextElement.Foreground="{TemplateBinding IconBrush}" />
                        <ContentPresenter x:Name="PART_LabelPresenter"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                          LineHeight="{TemplateBinding LabelLineHeight}"
                                          LetterSpacing="{TemplateBinding LabelLetterSpacing}" />
                    </m3:MaterialNavigationItemContentPanel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type m3:MaterialNavigationBar}" TargetType="m3:MaterialNavigationBar">
            <Setter Property="Template">
                <ControlTemplate>
                    <ItemsControl ItemsSource="{Binding $parent[m3:MaterialNavigationBar].Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <m3:MaterialNavigationItemsPanel
                                    IsVertical="{Binding $parent[m3:MaterialNavigationBar].IsVertical}"
                                    ItemSpacing="{Binding $parent[m3:MaterialNavigationBar].ItemSpacing}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type m3:MaterialShortNavigationBar}" TargetType="m3:MaterialShortNavigationBar">
            <Setter Property="Template">
                <ControlTemplate>
                    <ItemsControl ItemsSource="{Binding $parent[m3:MaterialShortNavigationBar].Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <m3:MaterialShortNavigationItemsPanel
                                    Arrangement="{Binding $parent[m3:MaterialShortNavigationBar].ResolvedArrangement}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type m3:MaterialWideNavigationRail}" TargetType="m3:MaterialWideNavigationRail">
            <Setter Property="Template">
                <ControlTemplate>
                    <m3:MaterialWideNavigationRailLayoutPanel>
                        <ContentPresenter Content="{TemplateBinding Header}" />
                        <ItemsControl ItemsSource="{Binding $parent[m3:MaterialWideNavigationRail].Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <m3:MaterialWideNavigationRailItemsPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </m3:MaterialWideNavigationRailLayoutPanel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type m3:MaterialNavigationSuiteScaffold}" TargetType="m3:MaterialNavigationSuiteScaffold">
            <Setter Property="Background" Value="{mcu:MdSysColor Background}" />
            <Setter Property="Foreground" Value="{mcu:MdSysColor OnBackground}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            ClipToBounds="True">
                        <m3:MaterialNavigationSuitePanel>
                            <ContentPresenter x:Name="PART_Navigation"
                                              ZIndex="1" />
                            <ContentPresenter x:Name="PART_PrimaryAction"
                                              ZIndex="2" />
                            <ContentPresenter x:Name="PART_Content"
                                              ZIndex="0"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </m3:MaterialNavigationSuitePanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>
</Styles>
