<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
    <Design.PreviewWith>
        <Border Padding="20">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <m3:MaterialButton Variant="Filled">Filled</m3:MaterialButton>
                <m3:MaterialButton Variant="Outlined">Outlined</m3:MaterialButton>
                <Button>Stock</Button>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <!-- MaterialButton paints its own container in Render, because the corner radius changes
             every frame during a press and has to resolve against the measured size. The template
             is therefore only the content. -->
        <ControlTheme x:Key="{x:Type m3:MaterialButton}" TargetType="m3:MaterialButton">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                      TextElement.FontSize="{TemplateBinding FontSize}"
                                      TextElement.FontFamily="{TemplateBinding FontFamily}"
                                      TextElement.FontWeight="{TemplateBinding FontWeight}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
            <Setter Property="Background" Value="{m3:MdButtonToken ContainerColor}" />
            <Setter Property="Foreground" Value="{m3:MdButtonToken LabelTextColor}" />
            <Setter Property="Padding" Value="{m3:MdButtonToken ContentPadding}" />
            <Setter Property="MinHeight" Value="{m3:MdButtonToken ContainerHeight}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="m3:TypographyScheme.TextStyle" Value="LabelLarge" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{m3:MdButtonToken ContainerCornerRadius}">
                        <Grid ClipToBounds="True">
                            <Border x:Name="StateLayer"
                                    Background="{m3:MdButtonToken StateLayerColor}"
                                    CornerRadius="{m3:MdButtonToken ContainerCornerRadius}"
                                    Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              Content="{TemplateBinding Content}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:pointerover /template/ Border#StateLayer">
                <Setter Property="Opacity" Value="{m3:MdButtonToken HoverStateLayerOpacity}" />
            </Style>
            <Style Selector="^:focus-visible /template/ Border#StateLayer">
                <Setter Property="Opacity" Value="{m3:MdButtonToken FocusStateLayerOpacity}" />
            </Style>
            <Style Selector="^:pressed /template/ Border#StateLayer">
                <Setter Property="Opacity" Value="{m3:MdButtonToken PressedStateLayerOpacity}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Background" Value="{m3:MdButtonToken DisabledContainerColor}" />
                <Setter Property="Foreground" Value="{m3:MdButtonToken DisabledLabelTextColor}" />
            </Style>
            <Style Selector="^:disabled /template/ Border#StateLayer">
                <Setter Property="Opacity" Value="0" />
            </Style>
        </ControlTheme>

        <!-- The toggle shares the button's template; only its colours and resting shape differ. -->
        <ControlTheme x:Key="{x:Type m3:MaterialToggleButton}" TargetType="m3:MaterialToggleButton">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                      TextElement.FontSize="{TemplateBinding FontSize}"
                                      TextElement.FontFamily="{TemplateBinding FontFamily}"
                                      TextElement.FontWeight="{TemplateBinding FontWeight}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>
</Styles>
