<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
    <Design.PreviewWith>
        <Border Padding="20">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button>Native filled</Button>
                <Button Theme="{StaticResource MaterialOutlinedButtonTheme}">Native outlined</Button>
                <Button m3:M3Button.Variant="Tonal">Native tonal</Button>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <!-- Canonical implementation targets Avalonia's native Button. -->
        <ControlTheme x:Key="MaterialButtonCoreTheme" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ClipToBounds" Value="False" />
            <!-- Buttons keep their token height: unlike panel stretch, the container is never
                 deformed by a taller sibling. Matches androidx's min-height semantics. -->
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="m3:M3Button.ResolvedShapeMotion"
                    Value="{DynamicResource {x:Static m3:ButtonValueKeys.ShapeMotion}}" />
            <Setter Property="m3:M3Button.ResolvedOutlineThickness"
                    Value="{DynamicResource {x:Static m3:ButtonValueKeys.NoOutlineThickness}}" />
            <Setter Property="Background"
                    Value="{Binding Path=(m3:M3Button.ResolvedContainerBrush), RelativeSource={RelativeSource Self}}" />
            <Setter Property="MinHeight"
                    Value="{Binding Path=(m3:M3Button.ResolvedContainerHeight), RelativeSource={RelativeSource Self}}" />
            <Setter Property="Padding"
                    Value="{Binding Path=(m3:M3Button.ResolvedContentPadding), RelativeSource={RelativeSource Self}}" />
            <Setter Property="m3:TypographyScheme.TextStyle"
                    Value="{Binding Path=(m3:M3Button.ResolvedTextStyle), RelativeSource={RelativeSource Self}}" />
            <Setter Property="Foreground"
                    Value="{Binding Path=(m3:M3Button.ResolvedVisualColors).Content, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderBrush"
                    Value="{Binding Path=(m3:M3Button.ResolvedVisualColors).Outline, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderThickness"
                    Value="{Binding Path=(m3:M3Button.ResolvedOutlineThickness), RelativeSource={RelativeSource Self}}" />
            <Setter Property="m3:M3Button.StateLayerBrush"
                    Value="{Binding Path=(m3:M3Button.ResolvedVisualColors).StateLayer, RelativeSource={RelativeSource Self}}" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- A transparent panel is the native Button's full hit-test surface. The
                         drawing presenters are deliberately input-transparent. -->
                    <Grid Background="Transparent">
                        <m3:MaterialButtonContainerPresenter x:Name="PART_Container" />
                        <ContentPresenter Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}" />
                        <m3:MaterialRipplePresenter
                            StateLayerBrush="{Binding Path=(m3:M3Button.StateLayerBrush), RelativeSource={RelativeSource TemplatedParent}}"
                            CornerRadius="{Binding CurrentCornerRadius, ElementName=PART_Container}" />
                    </Grid>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:disabled">
                <Setter Property="Foreground"
                        Value="{Binding Path=(m3:M3Button.ResolvedVisualColors).DisabledContent, RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderBrush"
                        Value="{Binding Path=(m3:M3Button.ResolvedVisualColors).DisabledOutline, RelativeSource={RelativeSource Self}}" />
            </Style>

            <!-- Variant selection belongs to the ControlTheme. Every Background state is owned
                 here, so the legacy defaults record no longer writes this consumption slot. -->
            <Style Selector="^[Variant=Filled]">
                <Setter Property="m3:M3Button.ResolvedVisualColors"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.FilledVisualColors}}" />
                <Setter Property="m3:M3Button.ResolvedElevation"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.FilledElevation}}" />
                <Setter Property="m3:M3Button.ResolvedContainerBrush"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.FilledContainerBrush}}" />
            </Style>
            <Style Selector="^[Variant=Filled]:disabled">
                <Setter Property="m3:M3Button.ResolvedContainerBrush"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.FilledDisabledContainerBrush}}" />
            </Style>
            <Style Selector="^[Variant=Tonal]">
                <Setter Property="m3:M3Button.ResolvedVisualColors"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.TonalVisualColors}}" />
                <Setter Property="m3:M3Button.ResolvedElevation"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.TonalElevation}}" />
                <Setter Property="m3:M3Button.ResolvedContainerBrush"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.TonalContainerBrush}}" />
            </Style>
            <Style Selector="^[Variant=Tonal]:disabled">
                <Setter Property="m3:M3Button.ResolvedContainerBrush"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.TonalDisabledContainerBrush}}" />
            </Style>
            <Style Selector="^[Variant=Elevated]">
                <Setter Property="m3:M3Button.ResolvedVisualColors"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.ElevatedVisualColors}}" />
                <Setter Property="m3:M3Button.ResolvedElevation"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.ElevatedElevation}}" />
                <Setter Property="m3:M3Button.ResolvedContainerBrush"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.ElevatedContainerBrush}}" />
            </Style>
            <Style Selector="^[Variant=Elevated]:disabled">
                <Setter Property="m3:M3Button.ResolvedContainerBrush"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.ElevatedDisabledContainerBrush}}" />
            </Style>
            <Style Selector="^[Variant=Outlined]">
                <Setter Property="m3:M3Button.ResolvedVisualColors"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.OutlinedVisualColors}}" />
                <Setter Property="m3:M3Button.ResolvedElevation"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.OutlinedElevation}}" />
                <Setter Property="m3:M3Button.ResolvedContainerBrush"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.OutlinedContainerBrush}}" />
            </Style>
            <Style Selector="^[Variant=Outlined]:disabled">
                <Setter Property="m3:M3Button.ResolvedContainerBrush"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.OutlinedDisabledContainerBrush}}" />
            </Style>
            <Style Selector="^[Variant=Text]">
                <Setter Property="m3:M3Button.ResolvedVisualColors"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.TextVisualColors}}" />
                <Setter Property="m3:M3Button.ResolvedElevation"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.TextElevation}}" />
                <Setter Property="m3:M3Button.ResolvedContainerBrush"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.TextContainerBrush}}" />
            </Style>
            <Style Selector="^[Variant=Text]:disabled">
                <Setter Property="m3:M3Button.ResolvedContainerBrush"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.TextDisabledContainerBrush}}" />
            </Style>

            <!-- Size policy chooses explicit value endpoints; the provider never inspects the
                 requesting Button. -->
            <Style Selector="^[Size=ExtraSmall]">
                <Setter Property="m3:M3Button.ResolvedContainerHeight"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.ExtraSmallContainerHeight}}" />
                <Setter Property="m3:M3Button.ResolvedContentPadding"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.ExtraSmallContentPadding}}" />
                <Setter Property="m3:M3Button.ResolvedTextStyle"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.ExtraSmallTextStyle}}" />
            </Style>
            <Style Selector="^[Size=Small]">
                <Setter Property="m3:M3Button.ResolvedContainerHeight"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.SmallContainerHeight}}" />
                <Setter Property="m3:M3Button.ResolvedContentPadding"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.SmallContentPadding}}" />
                <Setter Property="m3:M3Button.ResolvedTextStyle"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.SmallTextStyle}}" />
            </Style>
            <Style Selector="^[Size=Medium]">
                <Setter Property="m3:M3Button.ResolvedContainerHeight"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.MediumContainerHeight}}" />
                <Setter Property="m3:M3Button.ResolvedContentPadding"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.MediumContentPadding}}" />
                <Setter Property="m3:M3Button.ResolvedTextStyle"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.MediumTextStyle}}" />
            </Style>
            <Style Selector="^[Size=Large]">
                <Setter Property="m3:M3Button.ResolvedContainerHeight"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.LargeContainerHeight}}" />
                <Setter Property="m3:M3Button.ResolvedContentPadding"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.LargeContentPadding}}" />
                <Setter Property="m3:M3Button.ResolvedTextStyle"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.LargeTextStyle}}" />
            </Style>
            <Style Selector="^[Size=ExtraLarge]">
                <Setter Property="m3:M3Button.ResolvedContainerHeight"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.ExtraLargeContainerHeight}}" />
                <Setter Property="m3:M3Button.ResolvedContentPadding"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.ExtraLargeContentPadding}}" />
                <Setter Property="m3:M3Button.ResolvedTextStyle"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.ExtraLargeTextStyle}}" />
            </Style>

            <Style Selector="^[Variant=Outlined][Size=ExtraSmall]">
                <Setter Property="m3:M3Button.ResolvedOutlineThickness"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.ExtraSmallOutlineThickness}}" />
            </Style>
            <Style Selector="^[Variant=Outlined][Size=Small]">
                <Setter Property="m3:M3Button.ResolvedOutlineThickness"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.SmallOutlineThickness}}" />
            </Style>
            <Style Selector="^[Variant=Outlined][Size=Medium]">
                <Setter Property="m3:M3Button.ResolvedOutlineThickness"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.MediumOutlineThickness}}" />
            </Style>
            <Style Selector="^[Variant=Outlined][Size=Large]">
                <Setter Property="m3:M3Button.ResolvedOutlineThickness"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.LargeOutlineThickness}}" />
            </Style>
            <Style Selector="^[Variant=Outlined][Size=ExtraLarge]">
                <Setter Property="m3:M3Button.ResolvedOutlineThickness"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.ExtraLargeOutlineThickness}}" />
            </Style>

            <Style Selector="^[Size=ExtraSmall] /template/ m3|MaterialButtonContainerPresenter#PART_Container">
                <Setter Property="ShapeProfile"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.ExtraSmallShapeProfile}}" />
            </Style>
            <Style Selector="^[Size=Small] /template/ m3|MaterialButtonContainerPresenter#PART_Container">
                <Setter Property="ShapeProfile"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.SmallShapeProfile}}" />
            </Style>
            <Style Selector="^[Size=Medium] /template/ m3|MaterialButtonContainerPresenter#PART_Container">
                <Setter Property="ShapeProfile"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.MediumShapeProfile}}" />
            </Style>
            <Style Selector="^[Size=Large] /template/ m3|MaterialButtonContainerPresenter#PART_Container">
                <Setter Property="ShapeProfile"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.LargeShapeProfile}}" />
            </Style>
            <Style Selector="^[Size=ExtraLarge] /template/ m3|MaterialButtonContainerPresenter#PART_Container">
                <Setter Property="ShapeProfile"
                        Value="{DynamicResource {x:Static m3:ButtonValueKeys.ExtraLargeShapeProfile}}" />
            </Style>
        </ControlTheme>

        <!-- Public named themes are only defaults for the canonical Variant attached property. -->
        <ControlTheme x:Key="MaterialFilledButtonTheme"
                      TargetType="Button"
                      BasedOn="{StaticResource MaterialButtonCoreTheme}">
            <Setter Property="m3:M3Button.Variant" Value="Filled" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialTonalButtonTheme"
                      TargetType="Button"
                      BasedOn="{StaticResource MaterialButtonCoreTheme}">
            <Setter Property="m3:M3Button.Variant" Value="Tonal" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialElevatedButtonTheme"
                      TargetType="Button"
                      BasedOn="{StaticResource MaterialButtonCoreTheme}">
            <Setter Property="m3:M3Button.Variant" Value="Elevated" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialOutlinedButtonTheme"
                      TargetType="Button"
                      BasedOn="{StaticResource MaterialButtonCoreTheme}">
            <Setter Property="m3:M3Button.Variant" Value="Outlined" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialTextButtonTheme"
                      TargetType="Button"
                      BasedOn="{StaticResource MaterialButtonCoreTheme}">
            <Setter Property="m3:M3Button.Variant" Value="Text" />
        </ControlTheme>

        <!-- Native Button is the only public control surface. -->
        <ControlTheme x:Key="{x:Type Button}"
                      TargetType="Button"
                      BasedOn="{StaticResource MaterialFilledButtonTheme}" />

        <ControlTheme x:Key="MaterialToggleButtonCoreTheme" TargetType="ToggleButton">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="m3:M3ToggleButton.ResolvedVisualColors"
                    Value="{DynamicResource {x:Static m3:ToggleButtonValueKeys.FilledVisualColors}}" />
            <Setter Property="m3:M3ToggleButton.ResolvedGeometry"
                    Value="{DynamicResource {x:Static m3:ToggleButtonValueKeys.SmallGeometry}}" />
            <Setter Property="Background"
                    Value="{Binding Path=(m3:M3ToggleButton.ResolvedVisualColors).UncheckedContainer, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Foreground"
                    Value="{Binding Path=(m3:M3ToggleButton.ResolvedVisualColors).UncheckedContent, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderBrush"
                    Value="{Binding Path=(m3:M3ToggleButton.ResolvedVisualColors).Outline, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"
                    Value="{Binding Path=(m3:M3ToggleButton.ResolvedGeometry).ContentPadding, RelativeSource={RelativeSource Self}}" />
            <Setter Property="MinHeight"
                    Value="{Binding Path=(m3:M3ToggleButton.ResolvedGeometry).ToggleContainerHeight, RelativeSource={RelativeSource Self}}" />
            <Setter Property="m3:TypographyScheme.TextStyle"
                    Value="{Binding Path=(m3:M3ToggleButton.ResolvedGeometry).LabelTextStyle, RelativeSource={RelativeSource Self}}" />
            <Setter Property="m3:M3ToggleButton.StateLayerBrush"
                    Value="{Binding Path=(m3:M3ToggleButton.ResolvedVisualColors).UncheckedContent, RelativeSource={RelativeSource Self}}" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="Transparent">
                        <Grid Height="{Binding Path=(m3:M3ToggleButton.ResolvedGeometry).ContainerHeight, RelativeSource={RelativeSource TemplatedParent}}"
                              VerticalAlignment="Center">
                            <m3:MaterialToggleButtonContainerPresenter
                                x:Name="PART_Container"
                                GeometryProfile="{Binding Path=(m3:M3ToggleButton.ResolvedGeometry), RelativeSource={RelativeSource TemplatedParent}}"
                                ShapeMotion="{DynamicResource {x:Static m3:ToggleButtonValueKeys.ShapeMotion}}" />
                            <ContentPresenter Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}" />
                            <m3:MaterialRipplePresenter
                                StateLayerBrush="{Binding Path=(m3:M3ToggleButton.StateLayerBrush), RelativeSource={RelativeSource TemplatedParent}}"
                                CornerRadius="{Binding CurrentCornerRadius, ElementName=PART_Container}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:checked">
                <Setter Property="Background"
                        Value="{Binding Path=(m3:M3ToggleButton.ResolvedVisualColors).CheckedContainer, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Foreground"
                        Value="{Binding Path=(m3:M3ToggleButton.ResolvedVisualColors).CheckedContent, RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="m3:M3ToggleButton.StateLayerBrush"
                        Value="{Binding Path=(m3:M3ToggleButton.ResolvedVisualColors).CheckedContent, RelativeSource={RelativeSource Self}}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Background"
                        Value="{Binding Path=(m3:M3ToggleButton.ResolvedVisualColors).DisabledContainer, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Foreground"
                        Value="{Binding Path=(m3:M3ToggleButton.ResolvedVisualColors).DisabledContent, RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderBrush"
                        Value="{Binding Path=(m3:M3ToggleButton.ResolvedVisualColors).DisabledOutline, RelativeSource={RelativeSource Self}}" />
            </Style>

            <Style Selector="^[Variant=Filled]">
                <Setter Property="m3:M3ToggleButton.ResolvedVisualColors"
                        Value="{DynamicResource {x:Static m3:ToggleButtonValueKeys.FilledVisualColors}}" />
            </Style>
            <Style Selector="^[Variant=Tonal]">
                <Setter Property="m3:M3ToggleButton.ResolvedVisualColors"
                        Value="{DynamicResource {x:Static m3:ToggleButtonValueKeys.TonalVisualColors}}" />
            </Style>
            <Style Selector="^[Variant=Elevated]">
                <Setter Property="m3:M3ToggleButton.ResolvedVisualColors"
                        Value="{DynamicResource {x:Static m3:ToggleButtonValueKeys.ElevatedVisualColors}}" />
            </Style>
            <Style Selector="^[Variant=Outlined]">
                <Setter Property="m3:M3ToggleButton.ResolvedVisualColors"
                        Value="{DynamicResource {x:Static m3:ToggleButtonValueKeys.OutlinedVisualColors}}" />
                <Setter Property="BorderThickness"
                        Value="{Binding Path=(m3:M3ToggleButton.ResolvedGeometry).OutlineThickness, RelativeSource={RelativeSource Self}}" />
            </Style>
            <Style Selector="^[Variant=Text]">
                <Setter Property="m3:M3ToggleButton.ResolvedVisualColors"
                        Value="{DynamicResource {x:Static m3:ToggleButtonValueKeys.TextVisualColors}}" />
            </Style>

            <Style Selector="^[Size=ExtraSmall]">
                <Setter Property="m3:M3ToggleButton.ResolvedGeometry"
                        Value="{DynamicResource {x:Static m3:ToggleButtonValueKeys.ExtraSmallGeometry}}" />
            </Style>
            <Style Selector="^[Size=Small]">
                <Setter Property="m3:M3ToggleButton.ResolvedGeometry"
                        Value="{DynamicResource {x:Static m3:ToggleButtonValueKeys.SmallGeometry}}" />
            </Style>
            <Style Selector="^[Size=Medium]">
                <Setter Property="m3:M3ToggleButton.ResolvedGeometry"
                        Value="{DynamicResource {x:Static m3:ToggleButtonValueKeys.MediumGeometry}}" />
            </Style>
            <Style Selector="^[Size=Large]">
                <Setter Property="m3:M3ToggleButton.ResolvedGeometry"
                        Value="{DynamicResource {x:Static m3:ToggleButtonValueKeys.LargeGeometry}}" />
            </Style>
            <Style Selector="^[Size=ExtraLarge]">
                <Setter Property="m3:M3ToggleButton.ResolvedGeometry"
                        Value="{DynamicResource {x:Static m3:ToggleButtonValueKeys.ExtraLargeGeometry}}" />
            </Style>

            <!-- Checked outlined buttons no longer expose an outline. Keep this after the variant
                 selector so the late checked policy wins without entering the value resolver. -->
            <Style Selector="^[Variant=Outlined]:checked">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="MaterialFilledToggleButtonTheme"
                      TargetType="ToggleButton"
                      BasedOn="{StaticResource MaterialToggleButtonCoreTheme}">
            <Setter Property="m3:M3Button.Variant" Value="Filled" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialTonalToggleButtonTheme"
                      TargetType="ToggleButton"
                      BasedOn="{StaticResource MaterialToggleButtonCoreTheme}">
            <Setter Property="m3:M3Button.Variant" Value="Tonal" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialElevatedToggleButtonTheme"
                      TargetType="ToggleButton"
                      BasedOn="{StaticResource MaterialToggleButtonCoreTheme}">
            <Setter Property="m3:M3Button.Variant" Value="Elevated" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialOutlinedToggleButtonTheme"
                      TargetType="ToggleButton"
                      BasedOn="{StaticResource MaterialToggleButtonCoreTheme}">
            <Setter Property="m3:M3Button.Variant" Value="Outlined" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialTextToggleButtonTheme"
                      TargetType="ToggleButton"
                      BasedOn="{StaticResource MaterialToggleButtonCoreTheme}">
            <Setter Property="m3:M3Button.Variant" Value="Text" />
        </ControlTheme>

        <ControlTheme x:Key="{x:Type ToggleButton}"
                      TargetType="ToggleButton"
                      BasedOn="{StaticResource MaterialFilledToggleButtonTheme}" />
    </Styles.Resources>
</Styles>
