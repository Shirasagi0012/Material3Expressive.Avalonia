<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
    <Design.PreviewWith>
        <Border Padding="20">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button>Native filled</Button>
                <Button Theme="{StaticResource MaterialOutlinedButtonTheme}">Native outlined</Button>
                <m3:MaterialButton Variant="Tonal">Facade tonal</m3:MaterialButton>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <!-- Canonical implementation. It targets Avalonia's native Button and contains no
             facade-specific selectors or behavior. -->
        <ControlTheme x:Key="MaterialButtonCoreTheme" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ClipToBounds" Value="False" />
            <!-- Activates the owner-local defaults adapter. The adapter publishes only internal
                 semantic fallbacks; the bindings below remain normal theme-priority setters. -->
            <Setter Property="m3:ButtonAssist.UseMaterialDefaults" Value="True" />
            <!-- Buttons keep their token height: unlike panel stretch, the container is never
                 deformed by a taller sibling. Matches androidx's min-height semantics. -->
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background"
                    Value="{Binding Path=(m3:ButtonAssist.DefaultColors).Container, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Foreground"
                    Value="{Binding Path=(m3:ButtonAssist.DefaultColors).Content, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderBrush"
                    Value="{Binding Path=(m3:ButtonAssist.DefaultColors).Outline, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderThickness"
                    Value="{Binding Path=(m3:ButtonAssist.DefaultOutlineThickness), RelativeSource={RelativeSource Self}}" />
            <Setter Property="Padding"
                    Value="{Binding Path=(m3:ButtonAssist.DefaultMetrics).ContentPadding, RelativeSource={RelativeSource Self}}" />
            <Setter Property="MinHeight"
                    Value="{Binding Path=(m3:ButtonAssist.DefaultMetrics).ContainerHeight, RelativeSource={RelativeSource Self}}" />
            <Setter Property="m3:TypographyScheme.TextStyle"
                    Value="{Binding Path=(m3:ButtonAssist.DefaultMetrics).LabelTextStyle, RelativeSource={RelativeSource Self}}" />
            <Setter Property="m3:ButtonAssist.StateLayerBrush"
                    Value="{Binding Path=(m3:ButtonAssist.DefaultColors).StateLayer, RelativeSource={RelativeSource Self}}" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- A transparent panel is the native Button's full hit-test surface. The
                         drawing presenters are deliberately input-transparent. -->
                    <Grid Background="Transparent">
                        <m3:MaterialButtonContainerPresenter x:Name="PART_Container" />
                        <ContentPresenter Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}" />
                        <m3:MaterialRipplePresenter
                            StateLayerBrush="{Binding Path=(m3:ButtonAssist.StateLayerBrush), RelativeSource={RelativeSource TemplatedParent}}"
                            CornerRadius="{Binding CurrentCornerRadius, ElementName=PART_Container}" />
                    </Grid>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:disabled">
                <Setter Property="Background"
                        Value="{Binding Path=(m3:ButtonAssist.DefaultColors).DisabledContainer, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Foreground"
                        Value="{Binding Path=(m3:ButtonAssist.DefaultColors).DisabledContent, RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderBrush"
                        Value="{Binding Path=(m3:ButtonAssist.DefaultColors).DisabledOutline, RelativeSource={RelativeSource Self}}" />
            </Style>
        </ControlTheme>

        <!-- Public named themes are only defaults for the canonical Variant attached property. -->
        <ControlTheme x:Key="MaterialFilledButtonTheme"
                      TargetType="Button"
                      BasedOn="{StaticResource MaterialButtonCoreTheme}">
            <Setter Property="m3:ButtonAssist.Variant" Value="Filled" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialTonalButtonTheme"
                      TargetType="Button"
                      BasedOn="{StaticResource MaterialButtonCoreTheme}">
            <Setter Property="m3:ButtonAssist.Variant" Value="Tonal" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialElevatedButtonTheme"
                      TargetType="Button"
                      BasedOn="{StaticResource MaterialButtonCoreTheme}">
            <Setter Property="m3:ButtonAssist.Variant" Value="Elevated" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialOutlinedButtonTheme"
                      TargetType="Button"
                      BasedOn="{StaticResource MaterialButtonCoreTheme}">
            <Setter Property="m3:ButtonAssist.Variant" Value="Outlined" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialTextButtonTheme"
                      TargetType="Button"
                      BasedOn="{StaticResource MaterialButtonCoreTheme}">
            <Setter Property="m3:ButtonAssist.Variant" Value="Text" />
        </ControlTheme>

        <!-- Native-first default and optional ergonomic facade both enter the same core theme. -->
        <ControlTheme x:Key="{x:Type Button}"
                      TargetType="Button"
                      BasedOn="{StaticResource MaterialFilledButtonTheme}" />
        <ControlTheme x:Key="{x:Type m3:MaterialButton}"
                      TargetType="m3:MaterialButton"
                      BasedOn="{StaticResource MaterialFilledButtonTheme}" />

        <ControlTheme x:Key="MaterialToggleButtonCoreTheme" TargetType="ToggleButton">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="m3:ToggleButtonAssist.UseMaterialDefaults" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background"
                    Value="{Binding Path=(m3:ToggleButtonAssist.DefaultColors).UncheckedContainer, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Foreground"
                    Value="{Binding Path=(m3:ToggleButtonAssist.DefaultColors).UncheckedContent, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderBrush"
                    Value="{Binding Path=(m3:ToggleButtonAssist.DefaultColors).Outline, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderThickness"
                    Value="{Binding Path=(m3:ToggleButtonAssist.DefaultOutlineThickness), RelativeSource={RelativeSource Self}}" />
            <Setter Property="Padding"
                    Value="{Binding Path=(m3:ToggleButtonAssist.DefaultMetrics).ContentPadding, RelativeSource={RelativeSource Self}}" />
            <Setter Property="MinHeight"
                    Value="{Binding Path=(m3:ToggleButtonAssist.DefaultMetrics).ToggleContainerHeight, RelativeSource={RelativeSource Self}}" />
            <Setter Property="m3:TypographyScheme.TextStyle"
                    Value="{Binding Path=(m3:ToggleButtonAssist.DefaultMetrics).LabelTextStyle, RelativeSource={RelativeSource Self}}" />
            <Setter Property="m3:ToggleButtonAssist.StateLayerBrush"
                    Value="{Binding Path=(m3:ToggleButtonAssist.DefaultStateLayerBrush), RelativeSource={RelativeSource Self}}" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="Transparent">
                        <Grid Height="{Binding Path=(m3:ToggleButtonAssist.DefaultMetrics).ContainerHeight, RelativeSource={RelativeSource TemplatedParent}}"
                              VerticalAlignment="Center">
                            <m3:MaterialToggleButtonContainerPresenter x:Name="PART_Container" />
                            <ContentPresenter Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}" />
                            <m3:MaterialRipplePresenter
                                StateLayerBrush="{Binding Path=(m3:ToggleButtonAssist.StateLayerBrush), RelativeSource={RelativeSource TemplatedParent}}"
                                CornerRadius="{Binding CurrentCornerRadius, ElementName=PART_Container}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:checked">
                <Setter Property="Background"
                        Value="{Binding Path=(m3:ToggleButtonAssist.DefaultColors).CheckedContainer, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Foreground"
                        Value="{Binding Path=(m3:ToggleButtonAssist.DefaultColors).CheckedContent, RelativeSource={RelativeSource Self}}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Background"
                        Value="{Binding Path=(m3:ToggleButtonAssist.DefaultColors).DisabledContainer, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Foreground"
                        Value="{Binding Path=(m3:ToggleButtonAssist.DefaultColors).DisabledContent, RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderBrush"
                        Value="{Binding Path=(m3:ToggleButtonAssist.DefaultColors).DisabledOutline, RelativeSource={RelativeSource Self}}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="MaterialFilledToggleButtonTheme"
                      TargetType="ToggleButton"
                      BasedOn="{StaticResource MaterialToggleButtonCoreTheme}">
            <Setter Property="m3:ButtonAssist.Variant" Value="Filled" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialTonalToggleButtonTheme"
                      TargetType="ToggleButton"
                      BasedOn="{StaticResource MaterialToggleButtonCoreTheme}">
            <Setter Property="m3:ButtonAssist.Variant" Value="Tonal" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialElevatedToggleButtonTheme"
                      TargetType="ToggleButton"
                      BasedOn="{StaticResource MaterialToggleButtonCoreTheme}">
            <Setter Property="m3:ButtonAssist.Variant" Value="Elevated" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialOutlinedToggleButtonTheme"
                      TargetType="ToggleButton"
                      BasedOn="{StaticResource MaterialToggleButtonCoreTheme}">
            <Setter Property="m3:ButtonAssist.Variant" Value="Outlined" />
        </ControlTheme>
        <ControlTheme x:Key="MaterialTextToggleButtonTheme"
                      TargetType="ToggleButton"
                      BasedOn="{StaticResource MaterialToggleButtonCoreTheme}">
            <Setter Property="m3:ButtonAssist.Variant" Value="Text" />
        </ControlTheme>

        <ControlTheme x:Key="{x:Type ToggleButton}"
                      TargetType="ToggleButton"
                      BasedOn="{StaticResource MaterialFilledToggleButtonTheme}" />
        <ControlTheme x:Key="{x:Type m3:MaterialToggleButton}"
                      TargetType="m3:MaterialToggleButton"
                      BasedOn="{StaticResource MaterialFilledToggleButtonTheme}" />
    </Styles.Resources>
</Styles>
