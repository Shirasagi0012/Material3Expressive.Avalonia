<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
    <Design.PreviewWith>
        <Border Padding="24">
            <StackPanel Spacing="16" Width="260">
                <m3:MaterialTextField Label="Name" />
                <m3:MaterialTextField Label="Email" Variant="Outlined" Text="a@b.c" />
                <m3:MaterialTextField Label="Password" Variant="Outlined" IsError="True"
                                      SupportingText="Too short" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <ControlTheme x:Key="{x:Type m3:MaterialTextField}" TargetType="m3:MaterialTextField">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid RowDefinitions="*,Auto">
                        <!-- The field's own box. The control paints the container, indicator or
                             border, and the floating label; the TextBox owns the editing. -->
                        <Panel Grid.Row="0">
                            <TextBox x:Name="PART_TextBox"
                                     Margin="{TemplateBinding Padding}"
                                     VerticalAlignment="Bottom"
                                     VerticalContentAlignment="Center"
                                     Height="34"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FocusAdorner="{x:Null}"
                                     CornerRadius="0"
                                     Padding="0"
                                     Text="{TemplateBinding Text, Mode=TwoWay}"
                                     PlaceholderText="{TemplateBinding Placeholder}"
                                     PlaceholderForeground="{Binding $parent[m3:MaterialTextField].PlaceholderBrush}"
                                     Foreground="{TemplateBinding Foreground}"
                                     FontSize="{TemplateBinding FontSize}"
                                     FontFamily="{TemplateBinding FontFamily}"
                                     FontWeight="{TemplateBinding FontWeight}">
                                <!-- The editor keeps Avalonia's caret, selection, IME and undo
                                     implementation, but its Fluent focus frame must not sit
                                     inside Material's own outlined/filled chrome. -->
                                <TextBox.Resources>
                                    <!-- Fluent supplies a disabled TextBox fill through these
                                         resources. MaterialTextField paints its own disabled
                                         container, so the editor must remain transparent in
                                         every pseudo-class. -->
                                    <SolidColorBrush x:Key="TextControlBackground"
                                                     Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver"
                                                     Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused"
                                                     Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundDisabled"
                                                     Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrush"
                                                     Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"
                                                     Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused"
                                                     Color="Transparent" />
                                </TextBox.Resources>
                            </TextBox>
                        </Panel>
                        <TextBlock x:Name="PART_Supporting"
                                   Grid.Row="1"
                                   Margin="16,4,16,0"
                                   HorizontalAlignment="Left"
                                   Classes="body-small"
                                   Text="{TemplateBinding SupportingText}"
                                   IsVisible="{TemplateBinding SupportingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </Grid>
                </ControlTemplate>
            </Setter>

            <!-- Supporting text carries the error colour; the input itself stays readable. -->
            <Style Selector="^ /template/ TextBlock#PART_Supporting">
                <Setter Property="Foreground" Value="{Binding $parent[m3:MaterialTextField].SupportingBrush}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type m3:MaterialSecureTextField}"
                      TargetType="m3:MaterialSecureTextField"
                      BasedOn="{StaticResource {x:Type m3:MaterialTextField}}" />
    </Styles.Resources>
</Styles>
