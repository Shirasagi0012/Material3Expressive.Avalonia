<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
        xmlns:ms="using:MaterialSymbols.Avalonia">
    <Design.PreviewWith>
        <StackPanel Width="420">
            <m3:MaterialAppBar Title="Inbox">
                <m3:MaterialAppBar.NavigationIcon>
                    <ms:MaterialSymbol Symbol="Menu" />
                </m3:MaterialAppBar.NavigationIcon>
                <m3:MaterialAppBar.Actions>
                    <ms:MaterialSymbol Symbol="MoreVert" />
                </m3:MaterialAppBar.Actions>
            </m3:MaterialAppBar>
            <m3:MaterialAppBar Size="Large" Title="Settings" Subtitle="Account">
                <m3:MaterialAppBar.NavigationIcon>
                    <ms:MaterialSymbol Symbol="ArrowBack" />
                </m3:MaterialAppBar.NavigationIcon>
            </m3:MaterialAppBar>
        </StackPanel>
    </Design.PreviewWith>

    <!-- Padding is a presentation slot, not a theme-owned semantic value. Keep the token
         fallback at ordinary style priority so application styles and local values can override
         it; the control also preserves the selected profile when no override is present. -->
    <Style Selector="m3|MaterialAppBar">
        <Setter Property="Padding"
                Value="{Binding GeometryProfile.HorizontalSpace, RelativeSource={RelativeSource Self}}" />
    </Style>

    <Styles.Resources>
        <ControlTheme x:Key="{x:Type m3:MaterialAppBar}" TargetType="m3:MaterialAppBar">
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- The small bar puts the title between the navigation icon and the actions;
                         the taller two drop it onto its own line underneath. -->
                    <Grid RowDefinitions="64,*"
                          Margin="{TemplateBinding Padding}"
                          ClipToBounds="True">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Height="64">
                            <ContentPresenter Grid.Column="0"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding NavigationIcon}"
                                              TextElement.Foreground="{TemplateBinding IconBrush}" />
                            <StackPanel x:Name="PART_InlineTitle"
                                        Grid.Column="1"
                                        Margin="16,0"
                                        VerticalAlignment="Center"
                                        Opacity="{TemplateBinding InlineTitleOpacity}">
                                <ContentPresenter x:Name="PART_InlineTitlePresenter"
                                                  Content="{TemplateBinding InlineTitleContent}"
                                                  TextElement.Foreground="{TemplateBinding TitleBrush}" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="2"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Actions}"
                                              TextElement.Foreground="{TemplateBinding IconBrush}" />
                        </Grid>

                        <StackPanel x:Name="PART_StackedTitle"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Margin="{TemplateBinding StackedTitleMargin}"
                                    VerticalAlignment="Bottom"
                                    IsVisible="{TemplateBinding IsStacked}"
                                    Opacity="{TemplateBinding StackedTitleOpacity}">
                            <ContentPresenter x:Name="PART_StackedTitlePresenter"
                                              Content="{TemplateBinding StackedTitleContent}"
                                              TextElement.Foreground="{TemplateBinding TitleBrush}"
                                              />
                            <ContentPresenter x:Name="PART_SubtitlePresenter"
                                              Content="{TemplateBinding Subtitle}"
                                              IsVisible="{TemplateBinding Subtitle, Converter={x:Static ObjectConverters.IsNotNull}}"
                                              TextElement.Foreground="{TemplateBinding SubtitleBrush}" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <!-- Typed profiles are ordinary theme setters: an application style or local value
                 can still replace the public layout properties. Size and variant are control
                 policy; the endpoints only carry the selected Raw facts. -->
            <Setter Property="GeometryProfile"
                    Value="{DynamicResource {x:Static m3:AppBarValueKeys.SmallGeometry}}" />
            <Setter Property="TypographyProfile"
                    Value="{DynamicResource {x:Static m3:AppBarValueKeys.SmallTypography}}" />
            <Setter Property="VisualColors"
                    Value="{DynamicResource {x:Static m3:AppBarValueKeys.VisualColors}}" />
            <Style Selector="^[Size=Small]">
                <Setter Property="GeometryProfile"
                        Value="{DynamicResource {x:Static m3:AppBarValueKeys.SmallGeometry}}" />
                <Setter Property="TypographyProfile"
                        Value="{DynamicResource {x:Static m3:AppBarValueKeys.SmallTypography}}" />
            </Style>
            <Style Selector="^[Size=Medium]">
                <Setter Property="GeometryProfile"
                        Value="{DynamicResource {x:Static m3:AppBarValueKeys.MediumGeometry}}" />
                <Setter Property="TypographyProfile"
                        Value="{DynamicResource {x:Static m3:AppBarValueKeys.MediumTypography}}" />
            </Style>
            <Style Selector="^[Size=Large]">
                <Setter Property="GeometryProfile"
                        Value="{DynamicResource {x:Static m3:AppBarValueKeys.LargeGeometry}}" />
                <Setter Property="TypographyProfile"
                        Value="{DynamicResource {x:Static m3:AppBarValueKeys.LargeTypography}}" />
            </Style>
        </ControlTheme>
    </Styles.Resources>
</Styles>
