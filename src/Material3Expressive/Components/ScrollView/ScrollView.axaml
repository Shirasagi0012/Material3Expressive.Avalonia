<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:smooth="using:SmoothScroll.Avalonia.Controls">
  <Styles.Resources>
    <ControlTemplate x:Key="MaterialScrollViewTemplate" TargetType="smooth:ScrollView">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
        <smooth:ScrollPresenter Name="PART_ContentPresenter"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Padding="{TemplateBinding Padding}"
            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
            Background="{TemplateBinding Background}"
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}"
            GestureBindings="{TemplateBinding GestureBindings}"
            HorizontalAnchorRatio="{TemplateBinding HorizontalAnchorRatio}"
            HorizontalScrollMode="{TemplateBinding HorizontalScrollMode}"
            HorizontalSnapPointsAlignment="{TemplateBinding HorizontalSnapPointsAlignment}"
            HorizontalSnapPointsType="{TemplateBinding HorizontalSnapPointsType}"
            IsHorizontalMeasureInfinite="{TemplateBinding IsHorizontalMeasureInfinite}"
            IsScrollChainingEnabled="{TemplateBinding IsScrollChainingEnabled}"
            IsVerticalMeasureInfinite="{TemplateBinding IsVerticalMeasureInfinite}"
            IsZoomEnabled="{TemplateBinding IsZoomEnabled}"
            MaxZoomFactor="{TemplateBinding MaxZoomFactor}"
            MinZoomFactor="{TemplateBinding MinZoomFactor}"
            OverscrollBounceRate="{TemplateBinding OverscrollBounceRate}"
            OverscrollElasticity="{TemplateBinding OverscrollElasticity}"
            ScrollInertiaDecayRate="{TemplateBinding ScrollInertiaDecayRate}"
            ScrollInputMultiplier="{TemplateBinding ScrollInputMultiplier}"
            ScrollViewer.IsScrollInertiaEnabled="{TemplateBinding IsScrollInertiaEnabled}"
            VerticalAnchorRatio="{TemplateBinding VerticalAnchorRatio}"
            VerticalScrollMode="{TemplateBinding VerticalScrollMode}"
            VerticalSnapPointsAlignment="{TemplateBinding VerticalSnapPointsAlignment}"
            VerticalSnapPointsType="{TemplateBinding VerticalSnapPointsType}"
            ZoomInertiaDecayRate="{TemplateBinding ZoomInertiaDecayRate}"
            ZoomInputMultiplier="{TemplateBinding ZoomInputMultiplier}" />
        <!-- Overlay scrollbars do not shrink the photo/canvas viewport when zooming past 1x;
             the Auto track cells keep the bottom-right corner clear when both axes are visible. -->
        <ScrollBar Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" ZIndex="1" />
        <ScrollBar Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" ZIndex="1" />
      </Grid>
    </ControlTemplate>
    <ControlTheme x:Key="MaterialScrollViewTheme" TargetType="smooth:ScrollView">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template" Value="{StaticResource MaterialScrollViewTemplate}" />
    </ControlTheme>
    <ControlTheme x:Key="{x:Type smooth:ScrollView}" TargetType="smooth:ScrollView"
                  BasedOn="{StaticResource MaterialScrollViewTheme}" />
  </Styles.Resources>
</Styles>
