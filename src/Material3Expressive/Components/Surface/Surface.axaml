<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
  <!--
    Implicit theme for a standalone MaterialSurface: the M3 baseline surface and content
    colors, resolved through {m3:Token} from the sys.color slots so the surface tracks the
    active ColorScheme and theme variant. Component template bindings override background
    and content defaults; shared paint/motion configuration still comes through this theme.

    MaterialSurface is a lookless part — it builds its chrome and overlay visuals itself — so
    this theme carries property setters only, no Template. TextElement.Foreground is the
    inherited content color: child text and MaterialSymbol icons pick it up by inheritance.
  -->
  <Styles.Resources>
    <ControlTheme x:Key="{x:Type m3:ClickableSurface}" TargetType="m3:ClickableSurface">
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.Surface}}" />
      <Setter Property="Foreground" Value="{m3:ContentColorFor}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="m3:MaterialInteraction.IsInteractive" Value="True" />
      <Setter Property="Template">
        <ControlTemplate>
          <m3:ButtonLayout Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                           MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}"
                           HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}"
                           ContainerMinWidth="0" ContainerMinHeight="0" MinimumInteractiveSize="48">
            <m3:MaterialSurface x:Name="PART_Container" Background="{TemplateBinding Background}"
                                Shape="{TemplateBinding Shape}" CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" StateLayerBrush="{TemplateBinding Foreground}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TonalElevation="{TemplateBinding TonalElevation}" ShadowElevation="{TemplateBinding ShadowElevation}">
              <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </m3:MaterialSurface>
          </m3:ButtonLayout>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:SelectableSurface}" TargetType="m3:SelectableSurface"
                  BasedOn="{StaticResource {x:Type m3:ClickableSurface}}" />
    <ControlTheme x:Key="{x:Type m3:ToggleableSurface}" TargetType="m3:ToggleableSurface"
                  BasedOn="{StaticResource {x:Type m3:ClickableSurface}}" />
    <ControlTheme x:Key="{x:Type m3:InsetFocusRingPresenter}" TargetType="m3:InsetFocusRingPresenter">
      <Setter Property="DefaultOuterColor" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.Secondary}}" />
      <Setter Property="DefaultInnerColor" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.OnSecondary}}" />
      <Setter Property="FocusingAnimation" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+Motion+Spring.SpatialFast}}" />
      <Setter Property="UnfocusingAnimation" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+Motion+Spring.EffectsFast}}" />
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:MaterialSurface}" TargetType="m3:MaterialSurface">
      <Setter Property="DefaultShadowColor" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.Shadow}}" />
      <Setter Property="TonalSurfaceColor" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.Surface}}" />
      <Setter Property="TonalSurfaceTintColor" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceTint}}" />
      <Setter Property="ShapeAnimation" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+Motion+Spring.EffectsDefault}}" />
      <Setter Property="HoverStateLayerOpacity" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+State.HoverStateLayerOpacity}}" />
      <Setter Property="FocusStateLayerOpacity" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+State.FocusStateLayerOpacity}}" />
      <Setter Property="PressedStateLayerOpacity" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+State.PressedStateLayerOpacity}}" />
      <Setter Property="DraggedStateLayerOpacity" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+State.DraggedStateLayerOpacity}}" />
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.Surface}}" />
      <Setter Property="TextElement.Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.OnSurface}}" />
    </ControlTheme>
  </Styles.Resources>
</Styles>
