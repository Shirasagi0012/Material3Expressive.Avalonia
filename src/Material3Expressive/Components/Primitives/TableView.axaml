<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
    <!--
        Default theme for a table cell. Carried over from Avalonia.Themes.Fluent; the cell has no
        template of its own. Its component padding token defaults to Fluent's 6,0 inset, preserving
        the existing TableViewRow layout.
    -->
    <Styles.Resources>
        <ControlTheme x:Key="{x:Type TableViewCell}" TargetType="TableViewCell">
            <Setter Property="Padding" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TableViewCell.ContentPadding}}" />
        </ControlTheme>
    </Styles.Resources>
</Styles>
