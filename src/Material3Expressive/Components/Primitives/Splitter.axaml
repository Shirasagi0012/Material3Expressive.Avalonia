<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">

    <Styles.Resources>
        <ControlTheme x:Key="{x:Type GridSplitter}" TargetType="GridSplitter">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="MinWidth" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+GridSplitter.MinimumWidth}}" />
            <Setter Property="MinHeight" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+GridSplitter.MinimumHeight}}" />
            <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.OutlineVariant}}" />
            <Setter Property="PreviewContent">
                <Template>
                    <Rectangle Fill="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.Primary}}" />
                </Template>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>
</Styles>
