<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
    <!--
        Default theme for the standard desktop Window. The template is carried over from
        Avalonia.Themes.Fluent verbatim; Fluent's System* brushes resolve through Material sys.color
        tokens. FontFamily/FontSize are not carried over so the Material typography baseline keeps
        applying.

        The VisualLayerManager part is what Foundation/Overlays relies on: a Window applying this
        template has an internal PopupOverlayLayer, which is the documented host requirement for
        Dialog and ModalWideNavigationRail. A custom Window template must keep a VisualLayerManager
        named PART_VisualLayerManager for the same reason.
    -->
    <Styles.Resources>
        <ControlTheme x:Key="{x:Type Window}" TargetType="Window">
            <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.Surface}}" />
            <Setter Property="Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.OnSurface}}" />
            <Setter Property="TransparencyBackgroundFallback" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainer}}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
                        <Border Background="{TemplateBinding Background}" IsHitTestVisible="False" />
                        <Panel Background="Transparent" Margin="{TemplateBinding WindowDecorationMargin}" />
                        <VisualLayerManager Name="PART_VisualLayerManager">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </VisualLayerManager>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>
</Styles>
