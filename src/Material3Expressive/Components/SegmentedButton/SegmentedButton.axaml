<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
  <Styles.Resources>
    <ControlTheme x:Key="MaterialSegmentedButtonRowTheme" TargetType="m3:SegmentedButtonRow">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Space" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.OutlineWidth}}" />
      <Setter Property="BaseShape" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.Shape}}" />
      <Setter Property="ItemsPanel"><ItemsPanelTemplate><m3:SegmentedButtonItemsPanel ContainerMinHeight="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.ContainerHeight}}" /></ItemsPanelTemplate></Setter>
      <Setter Property="ItemContainerTheme"><ControlTheme TargetType="ContentPresenter">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </ControlTheme></Setter>
      <Setter Property="Template"><ControlTemplate><ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" ClipToBounds="False" /></ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:SingleChoiceSegmentedButtonRow}" TargetType="m3:SingleChoiceSegmentedButtonRow" BasedOn="{StaticResource MaterialSegmentedButtonRowTheme}" />
    <ControlTheme x:Key="{x:Type m3:MultiChoiceSegmentedButtonRow}" TargetType="m3:MultiChoiceSegmentedButtonRow" BasedOn="{StaticResource MaterialSegmentedButtonRowTheme}" />
    <ControlTheme x:Key="{x:Type m3:SegmentedButton}" TargetType="m3:SegmentedButton">
      <Setter Property="m3:MaterialInteraction.IsInteractive" Value="True" />
      <Setter Property="CornerRadius" Value="{Binding RowCornerRadius, RelativeSource={RelativeSource Self}}" />
      <Setter Property="Background" Value="{Binding Path=(m3:ButtonThemeProperties.Background), RelativeSource={RelativeSource Self}}" />
      <Setter Property="Foreground" Value="{Binding Path=(m3:ButtonThemeProperties.Foreground), RelativeSource={RelativeSource Self}}" />
      <Setter Property="BorderBrush" Value="{Binding Path=(m3:ButtonThemeProperties.BorderBrush), RelativeSource={RelativeSource Self}}" />
      <Setter Property="BorderThickness">
        <MultiBinding Converter="{x:Static m3:SegmentedButtonThemeConverters.OutlineThickness}">
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+SegmentedButton.OutlineWidth}" />
        </MultiBinding>
      </Setter>
      <!-- SegmentedButton uses the legacy ButtonDefaults.ContentPadding (8dp vertical),
           not expressive contentPaddingFor(SmallContainerHeight). -->
      <Setter Property="Padding" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.ContentPadding}}" />
      <Setter Property="m3:MaterialText.DefaultStyle" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.LabelTextStyle}}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="m3:ButtonThemeProperties.Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.InactiveContainerColor}}" />
      <Setter Property="m3:ButtonThemeProperties.Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.InactiveContentColor}}" />
      <Setter Property="m3:ButtonThemeProperties.BorderBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.InactiveBorderColor}}" />
      <Setter Property="Template"><ControlTemplate>
        <m3:ButtonLayout Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}"
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}"
                        ContainerMinHeight="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.ContainerHeight}}">
          <m3:MaterialSurface x:Name="PART_Container" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                              FlowDirection="LeftToRight"
                              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                              TextElement.Foreground="{TemplateBinding Foreground}" StateLayerBrush="{TemplateBinding Foreground}">
            <Border Padding="{TemplateBinding Padding}">
              <!-- Upstream uses physical place(), not placeRelative(), for both slots. -->
              <m3:SegmentedButtonContentLayout IconSize="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.IconSize}}" IconSpacing="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.IconSpacing}}" ContentMinWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+Button.MinWidth}}" MinimumInteractiveSize="{m3:Token {x:Static m3:MaterialTokens+Comp+Button.MinimumInteractiveSize}}" OffsetAnimation="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.LabelOffsetAnimation}}" x:Name="PART_Layout" HorizontalAlignment="Stretch" VerticalAlignment="Center" FlowDirection="LeftToRight">
                <m3:SegmentedButtonIconSlot x:Name="PART_Icon"
                    IconSize="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.IconSize}}"
                    EffectsAnimation="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.IconEffectsAnimation}}"
                    SpatialAnimation="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.IconSpatialAnimation}}" />
                <m3:ButtonContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          TextWrapping="Wrap" FlowDirection="{TemplateBinding FlowDirection}" m3:TextStyleHost.IsEnabled="True" />
              </m3:SegmentedButtonContentLayout>
            </Border>
          </m3:MaterialSurface>
        </m3:ButtonLayout>
      </ControlTemplate></Setter>
      <Style Selector="^:selected">
        <Setter Property="m3:ButtonThemeProperties.Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.ActiveContainerColor}}" />
        <Setter Property="m3:ButtonThemeProperties.Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.ActiveContentColor}}" />
        <Setter Property="m3:ButtonThemeProperties.BorderBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.ActiveBorderColor}}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="m3:ButtonThemeProperties.Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.DisabledInactiveContainerColor}}" />
        <Setter Property="m3:ButtonThemeProperties.Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.DisabledInactiveContentColor}}" />
        <Setter Property="m3:ButtonThemeProperties.BorderBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.DisabledInactiveBorderColor}}" />
      </Style>
      <Style Selector="^:disabled:selected">
        <Setter Property="m3:ButtonThemeProperties.Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.DisabledActiveContainerColor}}" />
        <Setter Property="m3:ButtonThemeProperties.Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.DisabledActiveContentColor}}" />
        <Setter Property="m3:ButtonThemeProperties.BorderBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SegmentedButton.DisabledActiveBorderColor}}" />
      </Style>
    </ControlTheme>
  </Styles.Resources>
</Styles>
