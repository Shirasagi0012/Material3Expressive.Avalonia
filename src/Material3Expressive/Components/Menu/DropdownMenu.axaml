<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
  <Styles.Resources>
    <ControlTheme x:Key="{x:Type m3:DropdownMenuItemTrailingLabel}" TargetType="m3:DropdownMenuItemTrailingLabel">
      <Setter Property="m3:MaterialText.Style" Value="{m3:Typography LabelLarge}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Padding">
        <MultiBinding Converter="{x:Static m3:MenuPrecisionDefaults.Value}">
          <Binding Path="(m3:MaterialPrecisionPointer.IsEnabled)" RelativeSource="{RelativeSource Self}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.TrailingLabelPadding}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.PrecisionTrailingLabelPadding}" />
        </MultiBinding>
      </Setter>
      <Setter Property="Template"><ControlTemplate>
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:DropdownMenuGroupLabel}" TargetType="m3:DropdownMenuGroupLabel">
      <Setter Property="m3:MaterialText.Style" Value="{m3:Typography LabelLarge}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="DefaultMinWidth" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.MinItemWidth}}" />
      <Setter Property="DefaultMaxWidth" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.MaxItemWidth}}" />
      <Setter Property="DefaultMinHeight" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.GroupLabelMinHeight}}" />
      <Setter Property="Padding" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.GroupLabelPadding}}" />
      <Setter Property="Template"><ControlTemplate>
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate></Setter>
    </ControlTheme>
    <m3:MenuColorConverter x:Key="DropdownColorConverter" />
    <m3:MenuShapeConverter x:Key="DropdownShapeConverter" />
    <ControlTheme x:Key="{x:Type m3:DropdownMenuPopup}" TargetType="m3:DropdownMenuPopup">
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="ScaleAnimation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.ShapeAnimation}}" />
      <Setter Property="AlphaAnimation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.ColorAnimation}}" />
      <Setter Property="Template"><ControlTemplate>
        <Grid x:Name="PART_Root" ClipToBounds="False">
          <m3:DropdownMenuPresenter x:Name="PART_Presentation" ClipToBounds="False" FocusAdorner="{x:Null}">
            <Border x:Name="PART_MenuLayer" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" MinWidth="{TemplateBinding MinWidth}" MaxWidth="{TemplateBinding MaxWidth}" MinHeight="{TemplateBinding MinHeight}" MaxHeight="{TemplateBinding MaxHeight}" ClipToBounds="False">
              <m3:MenuIntrinsicWidth>
                <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </m3:MenuIntrinsicWidth>
            </Border>
          </m3:DropdownMenuPresenter>
        </Grid>
      </ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:DropdownMenu}" TargetType="m3:DropdownMenu">
      <Setter Property="Foreground" Value="{m3:ContentColorFor}" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="ScaleAnimation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.ShapeAnimation}}" />
      <Setter Property="AlphaAnimation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.ColorAnimation}}" />
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineContainer}}" />
      <Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineShape}}" />
      <Setter Property="ShadowElevation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.ShadowElevation}}" />
      <Setter Property="Padding" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselinePadding}}" />
      <Setter Property="Template"><ControlTemplate>
        <Grid x:Name="PART_Root" ClipToBounds="False">
          <m3:DropdownMenuPresenter x:Name="PART_Presentation" ClipToBounds="False" FocusAdorner="{x:Null}">
            <m3:MaterialSurface x:Name="PART_MenuLayer" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" MinWidth="{TemplateBinding MinWidth}" MaxWidth="{TemplateBinding MaxWidth}" MinHeight="{TemplateBinding MinHeight}" MaxHeight="{TemplateBinding MaxHeight}"
                TextElement.Foreground="{TemplateBinding Foreground}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Shape="{TemplateBinding Shape}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                ShadowElevation="{TemplateBinding ShadowElevation}" TonalElevation="{TemplateBinding TonalElevation}" Padding="{TemplateBinding Padding}">
              <m3:MenuIntrinsicWidth>
                <ScrollViewer x:Name="PART_ScrollViewer" Offset="{TemplateBinding ScrollOffset, Mode=TwoWay}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" HorizontalContentAlignment="Stretch">
                  <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </m3:MenuIntrinsicWidth>
            </m3:MaterialSurface>
          </m3:DropdownMenuPresenter>
        </Grid>
      </ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:DropdownMenuGroup}" TargetType="m3:DropdownMenuGroup">
      <Setter Property="Foreground" Value="{m3:ContentColorFor}" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Padding" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.VerticalPadding}}" />
      <Setter Property="ShadowElevation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.ShadowElevation}}" />
      <Setter Property="ShapeAnimation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.ShapeAnimation}}" />
      <Setter Property="CornerRadius"><Setter.Value><MultiBinding Converter="{StaticResource DropdownShapeConverter}" ConverterParameter="Shape">
        <Binding Path="Shapes" RelativeSource="{RelativeSource Self}" /><m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VerticalShape}" /><m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.InactiveGroupShape}" />
      </MultiBinding></Setter.Value></Setter>
      <Setter Property="InactiveCornerRadius"><Setter.Value><MultiBinding Converter="{StaticResource DropdownShapeConverter}" ConverterParameter="Inactive">
        <Binding Path="Shapes" RelativeSource="{RelativeSource Self}" /><m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.InactiveGroupShape}" />
      </MultiBinding></Setter.Value></Setter>
      <Setter Property="Background"><Setter.Value><MultiBinding Converter="{StaticResource DropdownColorConverter}">
        <Binding Path="(m3:MenuAppearance.ColorStyle)" RelativeSource="{RelativeSource Self}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardContainer}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantContainer}" />
      </MultiBinding></Setter.Value></Setter>
      <Setter Property="Template"><ControlTemplate>
        <m3:MaterialSurface x:Name="PART_GroupSurface" TextElement.Foreground="{TemplateBinding Foreground}" Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
            ShadowElevation="{TemplateBinding ShadowElevation}" TonalElevation="{TemplateBinding TonalElevation}" Padding="{TemplateBinding Padding}">
          <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
        </m3:MaterialSurface>
      </ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:DropdownMenuItem}" TargetType="m3:DropdownMenuItem">
      <Setter Property="ShapeAnimation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.ShapeAnimation}}" />
      <Setter Property="m3:MaterialInteraction.IsInteractive" Value="True" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="m3:MaterialText.Style" Value="{m3:Typography LabelLarge}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="IsExpressive" Value="False" />
      <Setter Property="Padding" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineItemPadding}}" />
      <Setter Property="LeadingSpacing" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineContentSpacing}}" />
      <Setter Property="TrailingSpacing" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineContentSpacing}}" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground"><Setter.Value><MultiBinding Converter="{StaticResource DropdownColorConverter}">
        <Binding Path="(m3:MenuAppearance.ColorStyle)" RelativeSource="{RelativeSource Self}" />
        <Binding Path="IsEffectivelyEnabled" RelativeSource="{RelativeSource Self}" />
        <Binding Path="Selected" RelativeSource="{RelativeSource Self}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.Text}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.Text}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.DisabledText}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.Text}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.Text}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.DisabledText}" />
      </MultiBinding></Setter.Value></Setter>
      <Setter Property="LeadingIconColor"><Setter.Value><MultiBinding Converter="{StaticResource DropdownColorConverter}">
        <Binding Path="(m3:MenuAppearance.ColorStyle)" RelativeSource="{RelativeSource Self}" />
        <Binding Path="IsEffectivelyEnabled" RelativeSource="{RelativeSource Self}" />
        <Binding Path="Selected" RelativeSource="{RelativeSource Self}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.LeadingIcon}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.LeadingIcon}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.DisabledIcon}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.LeadingIcon}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.LeadingIcon}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.DisabledIcon}" />
      </MultiBinding></Setter.Value></Setter>
      <Setter Property="TrailingContentColor"><Setter.Value><MultiBinding Converter="{StaticResource DropdownColorConverter}">
        <Binding Path="(m3:MenuAppearance.ColorStyle)" RelativeSource="{RelativeSource Self}" />
        <Binding Path="IsEffectivelyEnabled" RelativeSource="{RelativeSource Self}" />
        <Binding Path="Selected" RelativeSource="{RelativeSource Self}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.TrailingIcon}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.TrailingIcon}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.DisabledIcon}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.TrailingIcon}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.TrailingIcon}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.DisabledIcon}" />
      </MultiBinding></Setter.Value></Setter>
      <Setter Property="Template"><ControlTemplate>
        <m3:MenuItemChrome x:Name="PART_ItemChrome" Margin="0" MinimumContainerWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.MinItemWidth}}" MaximumIntrinsicWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.MaxItemWidth}}"
            MinimumContainerHeight="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineItemHeight}}" MinimumInteractiveHeight="0" TargetBrush="{TemplateBinding Background}" ColorAnimation="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.ColorAnimation}}">
          <m3:MaterialSurface x:Name="PART_ItemSurface" Background="{Binding PaintedBrush, RelativeSource={RelativeSource AncestorType=m3:MenuItemChrome}}"
              CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" StateLayerBrush="{Binding Parent.(TextElement.Foreground), RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type m3:DropdownMenuItem}}}"
              ShadowElevation="0" TonalElevation="0" ResetIndicationOnShapeChange="False">
            <m3:DropdownMenuItemLayout x:Name="PART_Layout">
              <m3:DropdownMenuLeadingIcon x:Name="PART_Leading" ClipToBounds="True" SizeAnimation="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.ShapeAnimation}}" AlphaAnimation="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.ColorAnimation}}">
                <m3:DropdownMenuSlotPresenter x:Name="PART_LeadingPresenter" HorizontalContentAlignment="Left" MinWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineIconSize}}" Foreground="{TemplateBinding LeadingIconColor}" m3:MaterialSymbol.DefaultSize="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineIconSize}}" />
              </m3:DropdownMenuLeadingIcon>
              <StackPanel>
                <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                    Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Left" />
              </StackPanel>
              <m3:DropdownMenuSlotPresenter x:Name="PART_Trailing" HorizontalContentAlignment="Left" Content="{TemplateBinding TrailingContent}" ContentTemplate="{TemplateBinding TrailingContentTemplate}"
                  MinWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineIconSize}}" Foreground="{TemplateBinding TrailingContentColor}" m3:MaterialSymbol.DefaultSize="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineIconSize}}" />
            </m3:DropdownMenuItemLayout>
          </m3:MaterialSurface>
        </m3:MenuItemChrome>
      </ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="MaterialExpressiveDropdownMenuItemTheme" TargetType="m3:DropdownMenuItem">
      <Setter Property="ShapeAnimation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.ShapeAnimation}}" />
      <Setter Property="SelectedCornerRadius"><Setter.Value><MultiBinding Converter="{StaticResource DropdownShapeConverter}" ConverterParameter="Selected">
        <Binding Path="Shapes" RelativeSource="{RelativeSource Self}" /><m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.SelectedItemShape}" />
      </MultiBinding></Setter.Value></Setter>
      <Setter Property="m3:MaterialInteraction.IsInteractive" Value="True" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="m3:MaterialText.Style" Value="{m3:Typography LabelLarge}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="IsExpressive" Value="True" />
      <Setter Property="Padding">
        <MultiBinding Converter="{x:Static m3:MenuPrecisionDefaults.Value}">
          <Binding Path="(m3:MaterialPrecisionPointer.IsEnabled)" RelativeSource="{RelativeSource Self}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VerticalItemPadding}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.PrecisionItemPadding}" />
        </MultiBinding>
      </Setter>
      <Setter Property="LeadingSpacing">
        <MultiBinding Converter="{x:Static m3:MenuPrecisionDefaults.Value}">
          <Binding Path="(m3:MaterialPrecisionPointer.IsEnabled)" RelativeSource="{RelativeSource Self}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VerticalContentSpacing}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.PrecisionContentSpacing}" />
        </MultiBinding>
      </Setter>
      <Setter Property="TrailingSpacing">
        <MultiBinding Converter="{x:Static m3:MenuPrecisionDefaults.Value}">
          <Binding Path="(m3:MaterialPrecisionPointer.IsEnabled)" RelativeSource="{RelativeSource Self}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VerticalContentSpacing}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.PrecisionContentSpacing}" />
        </MultiBinding>
      </Setter>
      <Setter Property="CornerRadius"><Setter.Value><MultiBinding Converter="{StaticResource DropdownShapeConverter}" ConverterParameter="Shape">
        <Binding Path="Shapes" RelativeSource="{RelativeSource Self}" /><m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.ItemShape}" />
      </MultiBinding></Setter.Value></Setter>
      <Setter Property="Background"><Setter.Value><MultiBinding Converter="{StaticResource DropdownColorConverter}">
        <Binding Path="(m3:MenuAppearance.ColorStyle)" RelativeSource="{RelativeSource Self}" />
        <Binding Path="IsEffectivelyEnabled" RelativeSource="{RelativeSource Self}" />
        <Binding Path="Selected" RelativeSource="{RelativeSource Self}" />
        <Binding Source="{x:Static Brushes.Transparent}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardSelectedContainer}" />
        <Binding Source="{x:Static Brushes.Transparent}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantContainer}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantSelectedContainer}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantContainer}" />
      </MultiBinding></Setter.Value></Setter>
      <Setter Property="Foreground"><Setter.Value><MultiBinding Converter="{StaticResource DropdownColorConverter}">
        <Binding Path="(m3:MenuAppearance.ColorStyle)" RelativeSource="{RelativeSource Self}" />
        <Binding Path="IsEffectivelyEnabled" RelativeSource="{RelativeSource Self}" />
        <Binding Path="Selected" RelativeSource="{RelativeSource Self}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.Text}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardSelectedContent}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.DisabledText}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantText}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantSelectedContent}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantDisabledContent}" />
      </MultiBinding></Setter.Value></Setter>
      <Setter Property="LeadingIconColor"><Setter.Value><MultiBinding Converter="{StaticResource DropdownColorConverter}">
        <Binding Path="(m3:MenuAppearance.ColorStyle)" RelativeSource="{RelativeSource Self}" />
        <Binding Path="IsEffectivelyEnabled" RelativeSource="{RelativeSource Self}" />
        <Binding Path="Selected" RelativeSource="{RelativeSource Self}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.LeadingIcon}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardSelectedContent}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.DisabledIcon}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantText}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantSelectedContent}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantDisabledContent}" />
      </MultiBinding></Setter.Value></Setter>
      <Setter Property="TrailingContentColor"><Setter.Value><MultiBinding Converter="{StaticResource DropdownColorConverter}">
        <Binding Path="(m3:MenuAppearance.ColorStyle)" RelativeSource="{RelativeSource Self}" />
        <Binding Path="IsEffectivelyEnabled" RelativeSource="{RelativeSource Self}" />
        <Binding Path="Selected" RelativeSource="{RelativeSource Self}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.TrailingIcon}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardSelectedContent}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.DisabledIcon}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantText}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantSelectedContent}" />
        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantDisabledContent}" />
      </MultiBinding></Setter.Value></Setter>
      <Setter Property="Template"><ControlTemplate>
        <m3:MenuItemChrome x:Name="PART_ItemChrome" Margin="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.ItemMargin}}" MinimumContainerWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.MinItemWidth}}" MaximumIntrinsicWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.MaxItemWidth}}"
            MinimumContainerHeight="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.VerticalItemHeight}}" MinimumInteractiveHeight="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.MinimumInteractiveSize}}" TargetBrush="{TemplateBinding Background}" ColorAnimation="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.ColorAnimation}}">
          <m3:MaterialSurface x:Name="PART_ItemSurface" Background="{Binding PaintedBrush, RelativeSource={RelativeSource AncestorType=m3:MenuItemChrome}}"
              CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" StateLayerBrush="{m3:ContentColorFor AmbientContentColor={Binding Parent.(TextElement.Foreground), RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type m3:DropdownMenuItem}}}}"
              ShadowElevation="0" TonalElevation="0" ResetIndicationOnShapeChange="False">
            <m3:DropdownMenuItemLayout x:Name="PART_Layout">
              <m3:DropdownMenuLeadingIcon x:Name="PART_Leading" ClipToBounds="True" SizeAnimation="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.ShapeAnimation}}" AlphaAnimation="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.ColorAnimation}}">
                <m3:DropdownMenuSlotPresenter x:Name="PART_LeadingPresenter" HorizontalContentAlignment="Left" MinWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.LeadingIconSize}}" Foreground="{TemplateBinding LeadingIconColor}" m3:MaterialSymbol.DefaultSize="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.LeadingIconSize}}" />
              </m3:DropdownMenuLeadingIcon>
              <StackPanel>
                <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                    Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Left" />
                <ContentPresenter x:Name="PART_Supporting" HorizontalContentAlignment="Left" Content="{TemplateBinding SupportingText}" ContentTemplate="{TemplateBinding SupportingTextTemplate}"
                    Foreground="{TemplateBinding Foreground}" IsVisible="False" m3:MaterialText.Style="{m3:Typography BodyMedium}" />
              </StackPanel>
              <m3:DropdownMenuSlotPresenter x:Name="PART_Trailing" HorizontalContentAlignment="Center" Content="{TemplateBinding TrailingContent}" ContentTemplate="{TemplateBinding TrailingContentTemplate}"
                  MinWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.LeadingIconSize}}" Foreground="{TemplateBinding TrailingContentColor}" m3:MaterialSymbol.DefaultSize="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.LeadingIconSize}}" />
            </m3:DropdownMenuItemLayout>
          </m3:MaterialSurface>
        </m3:MenuItemChrome>
      </ControlTemplate></Setter>
      <Style Selector="^:supporting /template/ ContentPresenter#PART_Supporting"><Setter Property="IsVisible" Value="True" /></Style>
      <Style Selector="^:supporting /template/ m3|MenuItemChrome#PART_ItemChrome"><Setter Property="Margin" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.SupportingItemMargin}}" /></Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:CheckableDropdownMenuItem}" TargetType="m3:CheckableDropdownMenuItem" BasedOn="{StaticResource MaterialExpressiveDropdownMenuItemTheme}">
      <Setter Property="Background">
        <Setter.Value>
          <MultiBinding Converter="{StaticResource DropdownColorConverter}">
            <Binding Path="(m3:MenuAppearance.ColorStyle)" RelativeSource="{RelativeSource Self}" />
            <Binding Path="IsEffectivelyEnabled" RelativeSource="{RelativeSource Self}" />
            <Binding Path="Selected" RelativeSource="{RelativeSource Self}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardContainer}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardSelectedContainer}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardContainer}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantContainer}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantSelectedContainer}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantContainer}" />
          </MultiBinding>
        </Setter.Value>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:SelectableDropdownMenuItem}" TargetType="m3:SelectableDropdownMenuItem" BasedOn="{StaticResource MaterialExpressiveDropdownMenuItemTheme}">
      <Setter Property="Background">
        <Setter.Value>
          <MultiBinding Converter="{StaticResource DropdownColorConverter}">
            <Binding Path="(m3:MenuAppearance.ColorStyle)" RelativeSource="{RelativeSource Self}" />
            <Binding Path="IsEffectivelyEnabled" RelativeSource="{RelativeSource Self}" />
            <Binding Path="Selected" RelativeSource="{RelativeSource Self}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardContainer}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardSelectedContainer}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardContainer}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantContainer}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantSelectedContainer}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantContainer}" />
          </MultiBinding>
        </Setter.Value>
      </Setter>
    </ControlTheme>
    <!-- ExposedDropdownMenuDefaults colors share TextField defaults except these slots.
         Filled disabledLabelColor intentionally has no alpha in the fixed source. -->
    <ControlTheme x:Key="MaterialFilledExposedDropdownTextFieldTheme" TargetType="TextBox" BasedOn="{StaticResource MaterialFilledTextFieldTheme}">
      <Style Selector="^:disabled /template/ m3|TextFieldLayout"><Setter Property="LabelBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.OnSurface}}" /></Style>
      <Style Selector="^:disabled /template/ ContentPresenter#Prefix, ^:disabled /template/ ContentPresenter#Suffix"><Setter Property="Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledTextField.DisabledSupportingColor}}" /></Style>
    </ControlTheme>
    <ControlTheme x:Key="MaterialOutlinedExposedDropdownTextFieldTheme" TargetType="TextBox" BasedOn="{StaticResource MaterialOutlinedTextFieldTheme}">
      <Style Selector="^:disabled /template/ ContentPresenter#Prefix, ^:disabled /template/ ContentPresenter#Suffix"><Setter Property="Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+OutlinedTextField.DisabledSupportingColor}}" /></Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:ExposedDropdownMenuBox}" TargetType="m3:ExposedDropdownMenuBox">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template"><ControlTemplate>
        <Grid>
          <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          <ContentPresenter x:Name="PART_MenuPresenter" Content="{TemplateBinding Menu}" />
        </Grid>
      </ControlTemplate></Setter>
    </ControlTheme>
  </Styles.Resources>
  <Style Selector=":is(m3|DropdownMenuPopup) Separator">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
</Styles>
