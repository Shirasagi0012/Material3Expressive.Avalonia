<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia" xmlns:conv="using:Avalonia.Controls.Converters">
  <Styles.Resources>
    <m3:MenuColorConverter x:Key="MenuColorConverter" />
    <conv:PlatformKeyGestureConverter x:Key="MenuGestureConverter" />
    <ControlTheme x:Key="MaterialBaselineMenuItemTheme" TargetType="MenuItem">
      <Setter Property="m3:MaterialInteraction.IsInteractive" Value="True" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="m3:MaterialText.Style" Value="{m3:Typography LabelLarge}" />
      <Setter Property="Padding" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineItemPadding}}" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="#00000000" />
      <Setter Property="Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.Text}}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <m3:MenuItemChrome MinimumContainerWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.MinItemWidth}}" MaximumIntrinsicWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.MaxItemWidth}}" MinimumContainerHeight="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineItemHeight}}" TargetBrush="{TemplateBinding Background}" ColorAnimation="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.ColorAnimation}}">
              <m3:MaterialSurface x:Name="PART_ItemSurface" Background="{Binding PaintedBrush, RelativeSource={RelativeSource AncestorType=m3:MenuItemChrome}}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" StateLayerBrush="{TemplateBinding Foreground}" ShadowElevation="0" TonalElevation="0">
                <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">
                  <Grid Name="PART_LeadingIcon" MinWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineIconSize}}" VerticalAlignment="Center" IsVisible="False" m3:MaterialSymbol.DefaultSize="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineIconSize}}">
                    <Grid.Margin>
                      <MultiBinding Converter="{x:Static m3:MenuSpacingConverters.LeadingMargin}" Priority="Template">
                        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.BaselineContentSpacing}" />
                      </MultiBinding>
                    </Grid.Margin>
                    <ContentPresenter Name="PART_IconPresenter" Content="{TemplateBinding Icon}">
                      <ContentPresenter.Foreground>
                        <MultiBinding Converter="{StaticResource MenuColorConverter}" Priority="Template">
                          <Binding Path="(m3:MenuAppearance.ColorStyle)" RelativeSource="{RelativeSource TemplatedParent}" />
                          <Binding Path="IsEffectivelyEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                          <Binding Path="IsChecked" RelativeSource="{RelativeSource TemplatedParent}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.LeadingIcon}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.LeadingIcon}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.DisabledIcon}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.LeadingIcon}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.LeadingIcon}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.DisabledIcon}" />
                        </MultiBinding>
                      </ContentPresenter.Foreground>
                    </ContentPresenter>
                    <Viewbox Name="PART_Check" FlowDirection="LeftToRight" IsVisible="False" Width="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineIconSize}}" Height="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineIconSize}}" Stretch="Uniform">
                      <Canvas Width="24" Height="24">
                        <Path Data="M 9,16.17 L 4.83,12 3.41,13.41 9,19 21,7 19.59,5.59 Z">
                          <Path.Fill>
                            <MultiBinding Converter="{StaticResource MenuColorConverter}" Priority="Template">
                              <Binding Path="(m3:MenuAppearance.ColorStyle)" RelativeSource="{RelativeSource TemplatedParent}" />
                              <Binding Path="IsEffectivelyEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                              <Binding Path="IsChecked" RelativeSource="{RelativeSource TemplatedParent}" />
                              <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.LeadingIcon}" />
                              <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.LeadingIcon}" />
                              <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.DisabledIcon}" />
                              <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.LeadingIcon}" />
                              <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.LeadingIcon}" />
                              <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.DisabledIcon}" />
                            </MultiBinding>
                          </Path.Fill>
                        </Path>
                      </Canvas>
                    </Viewbox>
                  </Grid>
                  <ContentPresenter Name="PART_HeaderPresenter" Grid.Column="1" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" RecognizesAccessKey="True" />
                  <StackPanel Name="PART_Trailing" Grid.Column="2" Orientation="Horizontal" Spacing="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineContentSpacing}}" VerticalAlignment="Center" IsVisible="{TemplateBinding InputGesture, Converter={x:Static ObjectConverters.IsNotNull}}" m3:MaterialSymbol.DefaultSize="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineIconSize}}">
                    <StackPanel.Margin>
                      <MultiBinding Converter="{x:Static m3:MenuSpacingConverters.TrailingMargin}" Priority="Template">
                        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.BaselineContentSpacing}" />
                      </MultiBinding>
                    </StackPanel.Margin>
                    <TextBlock Text="{TemplateBinding InputGesture, Converter={StaticResource MenuGestureConverter}}" VerticalAlignment="Center">
                      <TextBlock.Foreground>
                        <MultiBinding Converter="{StaticResource MenuColorConverter}" Priority="Template">
                          <Binding Path="(m3:MenuAppearance.ColorStyle)" RelativeSource="{RelativeSource TemplatedParent}" />
                          <Binding Path="IsEffectivelyEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                          <Binding Path="IsChecked" RelativeSource="{RelativeSource TemplatedParent}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.TrailingIcon}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.TrailingIcon}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.DisabledIcon}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.TrailingIcon}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.TrailingIcon}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.DisabledIcon}" />
                        </MultiBinding>
                      </TextBlock.Foreground>
                    </TextBlock>
                    <Viewbox Name="PART_Chevron" Width="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineIconSize}}" Height="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineIconSize}}" Stretch="Uniform">
                      <Canvas Width="24" Height="24">
                        <Path Data="M 9,6 L 15,12 9,18 7.6,16.6 12.2,12 7.6,7.4 Z">
                          <Path.Fill>
                            <MultiBinding Converter="{StaticResource MenuColorConverter}" Priority="Template">
                              <Binding Path="(m3:MenuAppearance.ColorStyle)" RelativeSource="{RelativeSource TemplatedParent}" />
                              <Binding Path="IsEffectivelyEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                              <Binding Path="IsChecked" RelativeSource="{RelativeSource TemplatedParent}" />
                              <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.TrailingIcon}" />
                              <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.TrailingIcon}" />
                              <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.DisabledIcon}" />
                              <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.TrailingIcon}" />
                              <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.TrailingIcon}" />
                              <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.DisabledIcon}" />
                            </MultiBinding>
                          </Path.Fill>
                        </Path>
                      </Canvas>
                    </Viewbox>
                  </StackPanel>
                </Grid>
              </m3:MaterialSurface>
            </m3:MenuItemChrome>
            <Popup Name="PART_Popup" WindowManagerAddShadowHint="False" Placement="RightEdgeAlignedTop" IsLightDismissEnabled="False" IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}">
              <m3:MaterialSurface Background="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineContainer}}" BorderBrush="{x:Null}" BorderThickness="0" CornerRadius="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineShape}}" ShadowElevation="0" TonalElevation="0" Padding="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselinePadding}}">
                <m3:MenuIntrinsicWidth>
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                  </ScrollViewer>
                </m3:MenuIntrinsicWidth>
              </m3:MaterialSurface>
            </Popup>
          </Panel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:icon /template/ Grid#PART_LeadingIcon">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:checked:toggle /template/ Grid#PART_LeadingIcon">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:checked:radio /template/ Grid#PART_LeadingIcon">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:checked:toggle /template/ Viewbox#PART_Check">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:checked:radio /template/ Viewbox#PART_Check">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:checked:toggle /template/ ContentPresenter#PART_IconPresenter">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^:checked:radio /template/ ContentPresenter#PART_IconPresenter">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^:not(:empty) /template/ StackPanel#PART_Trailing">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:empty /template/ Viewbox#PART_Chevron">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^:separator">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
          <ControlTemplate>
            <Separator />
          </ControlTemplate>
        </Setter>
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.DisabledText}}" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="MaterialBaselineMenuTheme" TargetType="MenuFlyoutPresenter">
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="m3:MenuThemeProperties.ItemTheme" Value="{StaticResource MaterialBaselineMenuItemTheme}" />
      <Setter Property="Padding" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselinePadding}}" />
      <Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineShape}}" />
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.BaselineContainer}}" />
      <Setter Property="Template">
        <ControlTemplate>
          <m3:MaterialSurface x:Name="PART_MenuSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" ShadowElevation="0" TonalElevation="0" Padding="{TemplateBinding Padding}">
            <m3:MenuIntrinsicWidth>
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
            </m3:MenuIntrinsicWidth>
          </m3:MaterialSurface>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="MaterialVerticalMenuItemTheme" TargetType="MenuItem">
      <Setter Property="m3:MaterialInteraction.IsInteractive" Value="True" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="m3:MaterialText.Style" Value="{m3:Typography LabelLarge}" />
      <Setter Property="Padding">
        <MultiBinding Converter="{x:Static m3:MenuPrecisionDefaults.Value}">
          <Binding Path="(m3:MaterialPrecisionPointer.IsEnabled)" RelativeSource="{RelativeSource Self}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VerticalItemPadding}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.PrecisionItemPadding}" />
        </MultiBinding>
      </Setter>
      <Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.ItemShape}}" />
      <Setter Property="Margin">
        <MultiBinding Converter="{x:Static m3:MenuSpacingConverters.SupportingMargin}">
          <Binding Path="(m3:MenuAppearance.SupportingText)" RelativeSource="{RelativeSource Self}" />
          <Binding Path="(m3:MenuAppearance.SupportingTextTemplate)" RelativeSource="{RelativeSource Self}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.ItemMargin}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.SupportingItemMargin}" />
        </MultiBinding>
      </Setter>
      <Setter Property="Background">
        <Setter.Value>
          <MultiBinding Converter="{StaticResource MenuColorConverter}">
            <Binding Path="(m3:MenuAppearance.ColorStyle)" RelativeSource="{RelativeSource Self}" />
            <Binding Path="IsEffectivelyEnabled" RelativeSource="{RelativeSource Self}" />
            <Binding Path="IsChecked" RelativeSource="{RelativeSource Self}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardContainer}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardSelectedContainer}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardContainer}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantContainer}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantSelectedContainer}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantContainer}" />
          </MultiBinding>
        </Setter.Value>
      </Setter>
      <Setter Property="Foreground">
        <Setter.Value>
          <MultiBinding Converter="{StaticResource MenuColorConverter}">
            <Binding Path="(m3:MenuAppearance.ColorStyle)" RelativeSource="{RelativeSource Self}" />
            <Binding Path="IsEffectivelyEnabled" RelativeSource="{RelativeSource Self}" />
            <Binding Path="IsChecked" RelativeSource="{RelativeSource Self}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.Text}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardSelectedContent}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.DisabledText}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantText}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantSelectedContent}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantDisabledContent}" />
          </MultiBinding>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <m3:MenuItemChrome ShapeAnimation="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.ShapeAnimation}}" SelectedCornerRadius="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.SelectedItemShape}}" MinimumContainerWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.MinItemWidth}}" MaximumIntrinsicWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.MaxItemWidth}}" MinimumContainerHeight="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.VerticalItemHeight}}" MinimumInteractiveHeight="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.MinimumInteractiveSize}}" TargetBrush="{TemplateBinding Background}" ColorAnimation="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.ColorAnimation}}">
              <m3:MaterialSurface x:Name="PART_ItemSurface" Background="{Binding PaintedBrush, RelativeSource={RelativeSource AncestorType=m3:MenuItemChrome}}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" StateLayerBrush="{TemplateBinding Foreground}" ShadowElevation="0" TonalElevation="0">
                <m3:NativeMenuRow HorizontalArrangement="{TemplateBinding m3:MenuAppearance.HorizontalArrangement}" AlignLastToEnd="True" Background="Transparent">
                  <m3:NativeMenuRow.Spacing>
                    <MultiBinding Converter="{x:Static m3:MenuPrecisionDefaults.Value}" Priority="Template">
                      <Binding Path="(m3:MaterialPrecisionPointer.IsEnabled)" RelativeSource="{RelativeSource TemplatedParent}" />
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VerticalContentSpacing}" />
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.PrecisionContentSpacing}" />
                    </MultiBinding>
                  </m3:NativeMenuRow.Spacing>
                  <m3:DropdownMenuLeadingIcon Name="PART_LeadingIcon" VerticalAlignment="Center" ClipToBounds="True"
                      SizeAnimation="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.ShapeAnimation}}"
                      AlphaAnimation="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.ColorAnimation}}">
                    <m3:DropdownMenuLeadingIcon.NativeSelectedIconTemplate>
                      <DataTemplate>
                        <Viewbox Name="PART_Check" FlowDirection="LeftToRight" Width="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.LeadingIconSize}}" Height="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.LeadingIconSize}}" Stretch="Uniform">
                          <Canvas Width="24" Height="24">
                            <Path Data="M 9,16.17 L 4.83,12 3.41,13.41 9,19 21,7 19.59,5.59 Z" Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
                          </Canvas>
                        </Viewbox>
                      </DataTemplate>
                    </m3:DropdownMenuLeadingIcon.NativeSelectedIconTemplate>
                    <m3:DropdownMenuSlotPresenter Name="PART_IconPresenter" HorizontalContentAlignment="Left"
                        PreferredMinWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.LeadingIconSize}}"
                        m3:MaterialSymbol.DefaultSize="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.LeadingIconSize}}">
                      <m3:DropdownMenuSlotPresenter.Foreground>
                        <MultiBinding Converter="{StaticResource MenuColorConverter}" Priority="Template">
                          <Binding Path="(m3:MenuAppearance.ColorStyle)" RelativeSource="{RelativeSource TemplatedParent}" />
                          <Binding Path="IsEffectivelyEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                          <Binding Path="IsChecked" RelativeSource="{RelativeSource TemplatedParent}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.LeadingIcon}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardSelectedContent}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.DisabledIcon}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantText}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantSelectedContent}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantDisabledContent}" />
                        </MultiBinding>
                      </m3:DropdownMenuSlotPresenter.Foreground>
                    </m3:DropdownMenuSlotPresenter>
                  </m3:DropdownMenuLeadingIcon>
                  <StackPanel VerticalAlignment="Center">
                    <ContentPresenter Name="PART_HeaderPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" RecognizesAccessKey="True" />
                    <ContentPresenter Name="PART_SupportingPresenter" Content="{TemplateBinding m3:MenuAppearance.SupportingText}" ContentTemplate="{TemplateBinding m3:MenuAppearance.SupportingTextTemplate}"
                                      Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Left" m3:MaterialText.Style="{m3:Typography BodyMedium}">
                      <ContentPresenter.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                          <Binding Path="(m3:MenuAppearance.SupportingText)" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static ObjectConverters.IsNotNull}" />
                          <Binding Path="(m3:MenuAppearance.SupportingTextTemplate)" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static ObjectConverters.IsNotNull}" />
                        </MultiBinding>
                      </ContentPresenter.IsVisible>
                    </ContentPresenter>
                  </StackPanel>
                  <m3:NativeMenuRow Name="PART_Trailing" VerticalAlignment="Center">
                    <m3:NativeMenuRow.Spacing>
                      <MultiBinding Converter="{x:Static m3:MenuPrecisionDefaults.Value}" Priority="Template">
                        <Binding Path="(m3:MaterialPrecisionPointer.IsEnabled)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VerticalContentSpacing}" />
                        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.PrecisionContentSpacing}" />
                      </MultiBinding>
                    </m3:NativeMenuRow.Spacing>
                    <m3:MaterialSymbol.DefaultSize>
                      <MultiBinding Converter="{x:Static m3:MenuPrecisionDefaults.Value}" Priority="Template">
                        <Binding Path="(m3:MaterialPrecisionPointer.IsEnabled)" RelativeSource="{RelativeSource TemplatedParent}" />
                        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.TrailingIconSize}" />
                        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.PrecisionTrailingIconSize}" />
                      </MultiBinding>
                    </m3:MaterialSymbol.DefaultSize>
                    <m3:NativeMenuRow.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.Or}" Priority="Template">
                        <Binding Path="InputGesture" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static ObjectConverters.IsNotNull}" />
                        <Binding Path="(m3:MenuAppearance.TrailingContent)" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static ObjectConverters.IsNotNull}" />
                        <Binding Path="(m3:MenuAppearance.TrailingContentTemplate)" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static ObjectConverters.IsNotNull}" />
                      </MultiBinding>
                    </m3:NativeMenuRow.IsVisible>
                    <m3:DropdownMenuSlotPresenter Name="PART_TrailingContentPresenter" Content="{TemplateBinding m3:MenuAppearance.TrailingContent}" ContentTemplate="{TemplateBinding m3:MenuAppearance.TrailingContentTemplate}"
                        HorizontalContentAlignment="Center" VerticalAlignment="Center" PreferredMinWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.TrailingIconSize}}">
                      <m3:DropdownMenuSlotPresenter.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                          <Binding Path="(m3:MenuAppearance.TrailingContent)" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static ObjectConverters.IsNotNull}" />
                          <Binding Path="(m3:MenuAppearance.TrailingContentTemplate)" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static ObjectConverters.IsNotNull}" />
                        </MultiBinding>
                      </m3:DropdownMenuSlotPresenter.IsVisible>
                      <m3:DropdownMenuSlotPresenter.Foreground>
                        <MultiBinding Converter="{StaticResource MenuColorConverter}" Priority="Template">
                          <Binding Path="(m3:MenuAppearance.ColorStyle)" RelativeSource="{RelativeSource TemplatedParent}" />
                          <Binding Path="IsEffectivelyEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                          <Binding Path="IsChecked" RelativeSource="{RelativeSource TemplatedParent}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.TrailingIcon}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardSelectedContent}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.DisabledIcon}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantText}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantSelectedContent}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantDisabledContent}" />
                        </MultiBinding>
                      </m3:DropdownMenuSlotPresenter.Foreground>
                    </m3:DropdownMenuSlotPresenter>
                    <TextBlock Text="{TemplateBinding InputGesture, Converter={StaticResource MenuGestureConverter}}" VerticalAlignment="Center" IsVisible="{TemplateBinding InputGesture, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <TextBlock.Foreground>
                        <MultiBinding Converter="{StaticResource MenuColorConverter}" Priority="Template">
                          <Binding Path="(m3:MenuAppearance.ColorStyle)" RelativeSource="{RelativeSource TemplatedParent}" />
                          <Binding Path="IsEffectivelyEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                          <Binding Path="IsChecked" RelativeSource="{RelativeSource TemplatedParent}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.TrailingIcon}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardSelectedContent}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.DisabledIcon}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantText}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantSelectedContent}" />
                          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantDisabledContent}" />
                        </MultiBinding>
                      </TextBlock.Foreground>
                    </TextBlock>
                    <Viewbox Name="PART_Chevron" Width="{Binding (m3:MaterialSymbol.DefaultSize), RelativeSource={RelativeSource Self}}" Height="{Binding (m3:MaterialSymbol.DefaultSize), RelativeSource={RelativeSource Self}}" Stretch="Uniform">
                      <Canvas Width="24" Height="24">
                        <Path Data="M 9,6 L 15,12 9,18 7.6,16.6 12.2,12 7.6,7.4 Z">
                          <Path.Fill>
                            <MultiBinding Converter="{StaticResource MenuColorConverter}" Priority="Template">
                              <Binding Path="(m3:MenuAppearance.ColorStyle)" RelativeSource="{RelativeSource TemplatedParent}" />
                              <Binding Path="IsEffectivelyEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                              <Binding Path="IsChecked" RelativeSource="{RelativeSource TemplatedParent}" />
                              <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.TrailingIcon}" />
                              <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardSelectedContent}" />
                              <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.DisabledIcon}" />
                              <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantText}" />
                              <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantSelectedContent}" />
                              <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantDisabledContent}" />
                            </MultiBinding>
                          </Path.Fill>
                        </Path>
                      </Canvas>
                    </Viewbox>
                  </m3:NativeMenuRow>
                </m3:NativeMenuRow>
              </m3:MaterialSurface>
            </m3:MenuItemChrome>
            <Popup Name="PART_Popup" WindowManagerAddShadowHint="False" Placement="RightEdgeAlignedTop" IsLightDismissEnabled="False" IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}">
              <m3:MaterialSurface BorderBrush="{x:Null}" BorderThickness="0" CornerRadius="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.VerticalShape}}" ShadowElevation="0" TonalElevation="0" Padding="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.VerticalPadding}}">
                <m3:MaterialSurface.Background>
                  <MultiBinding Converter="{StaticResource MenuColorConverter}" Priority="Template">
                    <Binding Path="(m3:MenuAppearance.ColorStyle)" RelativeSource="{RelativeSource TemplatedParent}" />
                    <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardContainer}" />
                    <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantContainer}" />
                  </MultiBinding>
                </m3:MaterialSurface.Background>
                <m3:MenuIntrinsicWidth>
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                  </ScrollViewer>
                </m3:MenuIntrinsicWidth>
              </m3:MaterialSurface>
            </Popup>
          </Panel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:not(:empty) /template/ m3|NativeMenuRow#PART_Trailing">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:empty /template/ Viewbox#PART_Chevron">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^:selected:not(:focus):not(:pointerover)">
        <Setter Property="Background">
          <MultiBinding Converter="{x:Static m3:MenuSelectionHighlight.Converter}">
            <Binding Path="(m3:MenuAppearance.ColorStyle)" RelativeSource="{RelativeSource Self}" />
            <Binding Path="IsEffectivelyEnabled" RelativeSource="{RelativeSource Self}" />
            <Binding Path="IsChecked" RelativeSource="{RelativeSource Self}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardContainer}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardSelectedContainer}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardContainer}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantContainer}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantSelectedContainer}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantContainer}" />
            <Binding Path="Foreground" RelativeSource="{RelativeSource Self}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Sys+State.HoverStateLayerOpacity}" />
          </MultiBinding>
        </Setter>
      </Style>
      <Style Selector="^:separator">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
          <ControlTemplate>
            <Separator />
          </ControlTemplate>
        </Setter>
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="MaterialVerticalMenuTheme" TargetType="MenuFlyoutPresenter">
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="m3:MenuThemeProperties.ItemTheme" Value="{StaticResource MaterialVerticalMenuItemTheme}" />
      <Setter Property="Padding" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.VerticalPadding}}" />
      <Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.VerticalShape}}" />
      <Setter Property="Background">
        <Setter.Value>
          <MultiBinding Converter="{StaticResource MenuColorConverter}">
            <Binding Path="(m3:MenuAppearance.ColorStyle)" RelativeSource="{RelativeSource Self}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.StandardContainer}" />
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Menu.VibrantContainer}" />
          </MultiBinding>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <m3:MaterialSurface x:Name="PART_MenuSurface" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" ShadowElevation="0" TonalElevation="0" Padding="{TemplateBinding Padding}">
            <m3:MaterialSurface.Background>
              <TemplateBinding Property="Background" />
            </m3:MaterialSurface.Background>
            <m3:MenuIntrinsicWidth>
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
            </m3:MenuIntrinsicWidth>
          </m3:MaterialSurface>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}" TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource MaterialVerticalMenuTheme}" />
  </Styles.Resources>
  <Style Selector="MenuFlyoutPresenter Separator">
    <Setter Property="Margin" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Menu.SeparatorMargin}}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
</Styles>
