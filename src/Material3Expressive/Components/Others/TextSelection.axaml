<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
    <!--
        Default theme for the selectable text primitive. The structure is carried over from
        Avalonia.Themes.Fluent; the selection brush resolves through the Material text-selection
        color, and the copy flyout uses the same literal "Copy" label convention as the TextField
        context menu instead of Fluent's localized resource.
    -->
    <Styles.Resources>
        <MenuFlyout x:Key="SelectableTextBlockContextFlyout" Placement="Bottom">
            <MenuItem Header="Copy"
                      Command="{ReflectionBinding $parent[SelectableTextBlock].Copy}"
                      IsEnabled="{ReflectionBinding $parent[SelectableTextBlock].CanCopy}"
                      InputGesture="{x:Static TextBox.CopyGesture}" />
        </MenuFlyout>

        <ControlTheme x:Key="{x:Type SelectableTextBlock}" TargetType="SelectableTextBlock">
            <Setter Property="SelectionBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledTextField.SelectionColor}}" />
            <Style Selector="^[IsEnabled=True]">
                <Setter Property="Cursor" Value="IBeam" />
                <Setter Property="ContextFlyout" Value="{StaticResource SelectableTextBlockContextFlyout}" />
            </Style>
        </ControlTheme>
    </Styles.Resources>
</Styles>
