<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
        xmlns:ca="https://github.com/Shirasagi0012/ComposeAnimation" xmlns:input="using:Avalonia.Input.TextInput">
  <Styles.Resources>
    <ControlTheme x:Key="{x:Type m3:SearchBar}" TargetType="m3:SearchBar">
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.ContainerColor}}" />
      <Setter Property="Foreground" Value="{m3:ContentColorFor}" />
      <Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.InputContainerShape}}" />
      <Setter Property="TonalElevation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.TonalElevation}}" />
      <Setter Property="ShadowElevation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.ShadowElevation}}" />
      <Setter Property="ContainedAnimation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.ContainedAnimation}}" />
      <Setter Property="ExpandAnimation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.ExpandAnimation}}" />
      <Setter Property="CollapseAnimation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.CollapseAnimation}}" />
      <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Template"><ControlTemplate>
        <m3:MaterialSurface Name="PART_Surface" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                            TextElement.Foreground="{TemplateBinding Foreground}" TonalElevation="{TemplateBinding TonalElevation}" ShadowElevation="{TemplateBinding ShadowElevation}">
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </m3:MaterialSurface>
      </ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:ExpandedDockedSearchBar}" TargetType="m3:ExpandedDockedSearchBar">
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.ContainerColor}}" />
      <Setter Property="Foreground" Value="{m3:ContentColorFor}" />
      <Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.DockedContainerShape}}" />
      <Setter Property="DividerColor" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.DividerColor}}" />
      <Setter Property="TonalElevation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.TonalElevation}}" />
      <Setter Property="ShadowElevation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.ShadowElevation}}" />
      <Setter Property="ContainedAnimation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.ContainedAnimation}}" />
      <Setter Property="ExpandAnimation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.ExpandAnimation}}" />
      <Setter Property="CollapseAnimation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.CollapseAnimation}}" />
      <Setter Property="Template"><ControlTemplate>
        <Grid Name="PART_Root">
          <m3:SearchBarPopupPresenter Name="PART_Presentation" IsVisible="False">
            <m3:MaterialSurface Name="PART_Surface" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                                TextElement.Foreground="{TemplateBinding Foreground}" TonalElevation="{TemplateBinding TonalElevation}" ShadowElevation="{TemplateBinding ShadowElevation}"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}"
                                MaxWidth="{TemplateBinding MaxWidth}" MaxHeight="{TemplateBinding MaxHeight}">
              <m3:ExpandedSearchBarLayout Name="PART_Layout"
                  MinimumResultsHeight="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.MinimumResultsHeight}}"
                  MaximumWindowHeightFraction="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.MaximumWindowHeightFraction}}">
                <ContentPresenter Name="PART_InputField"
                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" >
                  <ContentPresenter.Content><MultiBinding Priority="Template" Converter="{x:Static m3:SearchBarMotion.Present}">
                    <Binding Path="IsPresented" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="InputField" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding></ContentPresenter.Content>
                  <ContentPresenter.ContentTemplate><MultiBinding Priority="Template" Converter="{x:Static m3:SearchBarMotion.Present}">
                    <Binding Path="IsPresented" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="InputFieldTemplate" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding></ContentPresenter.ContentTemplate>
                </ContentPresenter>
                <m3:SearchResultsColumn>
                  <Separator Name="PART_Divider" HorizontalAlignment="Stretch" m3:MaterialDivider.Color="{TemplateBinding DividerColor}" />
                  <ContentPresenter Name="PART_ContentPresenter"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Top" >
                  <ContentPresenter.Content><MultiBinding Priority="Template" Converter="{x:Static m3:SearchBarMotion.Present}">
                    <Binding Path="IsPresented" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="Content" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding></ContentPresenter.Content>
                  <ContentPresenter.ContentTemplate><MultiBinding Priority="Template" Converter="{x:Static m3:SearchBarMotion.Present}">
                    <Binding Path="IsPresented" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="ContentTemplate" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding></ContentPresenter.ContentTemplate>
                </ContentPresenter>
                </m3:SearchResultsColumn>
              </m3:ExpandedSearchBarLayout>
            </m3:MaterialSurface>
          </m3:SearchBarPopupPresenter>
        </Grid>
      </ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:ExpandedDockedSearchBarWithGap}" TargetType="m3:ExpandedDockedSearchBarWithGap" BasedOn="{StaticResource {x:Type m3:ExpandedDockedSearchBar}}">
      <Setter Property="DropdownCornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.DropdownContainerShape}}" />
      <Setter Property="DropdownGapSize" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.DropdownGapSize}}" />
      <Setter Property="DropdownScrimColor" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.DropdownScrimColor}}" />
      <Setter Property="Template"><ControlTemplate>
        <Grid Name="PART_Root">
          <m3:SearchBarPopupPresenter Name="PART_Presentation" IsVisible="False">
            <m3:SearchBarScrimButton Name="PART_Scrim" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" FocusAdorner="{x:Null}" m3:MaterialInteraction.IsInteractive="True">
              <m3:SearchBarScrimButton.Theme><ControlTheme TargetType="m3:SearchBarScrimButton">
                <Setter Property="Template"><ControlTemplate>
                  <m3:MaterialSurface Background="{TemplateBinding Background}">
                    <m3:MaterialSurface.StateLayerBrush><MultiBinding Converter="{x:Static m3:SearchBarMotion.Present}">
                      <Binding Path="HasScrim" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Path="Foreground" RelativeSource="{RelativeSource TemplatedParent}" />
                    </MultiBinding></m3:MaterialSurface.StateLayerBrush>
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                  </m3:MaterialSurface>
                </ControlTemplate></Setter>
              </ControlTheme></m3:SearchBarScrimButton.Theme>
            <m3:SearchBarPopupPositioner Name="PART_Positioner">
            <m3:MaterialSurface Name="PART_Surface" Background="Transparent" CornerRadius="0"
                                TextElement.Foreground="{TemplateBinding Foreground}" TonalElevation="{TemplateBinding TonalElevation}" ShadowElevation="{TemplateBinding ShadowElevation}"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}"
                                MaxWidth="{TemplateBinding MaxWidth}" MaxHeight="{TemplateBinding MaxHeight}">
              <m3:ExpandedSearchBarLayout Name="PART_Layout"
                  MinimumResultsHeight="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.MinimumResultsHeight}}"
                  MaximumWindowHeightFraction="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.DropdownMaximumWindowHeightFraction}}">
                <m3:MaterialSurface Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" ApplyTonalElevation="False">
                <ContentPresenter Name="PART_InputField"
                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" >
                  <ContentPresenter.Content><MultiBinding Priority="Template" Converter="{x:Static m3:SearchBarMotion.Present}">
                    <Binding Path="IsPresented" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="InputField" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding></ContentPresenter.Content>
                  <ContentPresenter.ContentTemplate><MultiBinding Priority="Template" Converter="{x:Static m3:SearchBarMotion.Present}">
                    <Binding Path="IsPresented" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="InputFieldTemplate" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding></ContentPresenter.ContentTemplate>
                </ContentPresenter>
                </m3:MaterialSurface>
                <Border Padding="{TemplateBinding DropdownGapSize, Converter={x:Static m3:SearchBarMotion.GapPadding}}">
                  <m3:MaterialSurface Name="PART_Dropdown" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding DropdownCornerRadius}" ApplyTonalElevation="False">
                    <ca:AnimatedVisibility Name="PART_Results">
                      <ca:AnimatedVisibility.Visible><MultiBinding Priority="Template" Converter="{x:Static m3:SearchBarMotion.ResultsVisible}">
                        <Binding Path="State.Progress" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="State.TargetValue" RelativeSource="{RelativeSource TemplatedParent}" />
                      </MultiBinding></ca:AnimatedVisibility.Visible>
                  <ContentPresenter Name="PART_ContentPresenter"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Top" >
                  <ContentPresenter.Content><MultiBinding Priority="Template" Converter="{x:Static m3:SearchBarMotion.Present}">
                    <Binding Path="IsPresented" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="Content" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding></ContentPresenter.Content>
                  <ContentPresenter.ContentTemplate><MultiBinding Priority="Template" Converter="{x:Static m3:SearchBarMotion.Present}">
                    <Binding Path="IsPresented" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="ContentTemplate" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding></ContentPresenter.ContentTemplate>
                </ContentPresenter>
                    </ca:AnimatedVisibility>
                  </m3:MaterialSurface>
                </Border>
              </m3:ExpandedSearchBarLayout>
            </m3:MaterialSurface>
            </m3:SearchBarPopupPositioner>
            </m3:SearchBarScrimButton>
          </m3:SearchBarPopupPresenter>
        </Grid>
      </ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:ExpandedFullScreenSearchBar}" TargetType="m3:ExpandedFullScreenSearchBar" BasedOn="{StaticResource {x:Type m3:ExpandedDockedSearchBar}}">
      <Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.InputContainerShape}}" />
      <Setter Property="WindowInsets" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.FullScreenWindowInsets}}" />
      <Setter Property="Template"><ControlTemplate>
        <Grid Name="PART_Root">
          <m3:SearchBarPopupPresenter Name="PART_Presentation" IsVisible="False">
            <m3:FullScreenSearchBarLayout Name="PART_Layout"
                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}"
                MaxWidth="{TemplateBinding MaxWidth}" MaxHeight="{TemplateBinding MaxHeight}"
                DefaultInputWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.DefaultWidth}}"
                DefaultInputHeight="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.InputHeight}}"
                VerticalPadding="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.FullScreenVerticalPadding}}"
                InputTopPadding="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.FullScreenVerticalPadding}}">
              <m3:MaterialSurface Name="PART_Surface" Background="{TemplateBinding Background}"
                                  TonalElevation="{TemplateBinding TonalElevation}" ShadowElevation="{TemplateBinding ShadowElevation}" />
              <Border>
              <m3:MaterialSurface Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" TextElement.Foreground="{TemplateBinding Foreground}" ApplyTonalElevation="False">
                <ContentPresenter Name="PART_InputField"
                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" >
                  <ContentPresenter.Content><MultiBinding Priority="Template" Converter="{x:Static m3:SearchBarMotion.Present}">
                    <Binding Path="IsPresented" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="InputField" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding></ContentPresenter.Content>
                  <ContentPresenter.ContentTemplate><MultiBinding Priority="Template" Converter="{x:Static m3:SearchBarMotion.Present}">
                    <Binding Path="IsPresented" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="InputFieldTemplate" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding></ContentPresenter.ContentTemplate>
                </ContentPresenter>
              </m3:MaterialSurface>
              </Border>
              <Border TextElement.Foreground="{TemplateBinding Foreground}">
                <m3:SearchResultsColumn>
                  <Separator Name="PART_Divider" HorizontalAlignment="Stretch" m3:MaterialDivider.Color="{TemplateBinding DividerColor}" />
                  <ContentPresenter Name="PART_ContentPresenter"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Top" >
                  <ContentPresenter.Content><MultiBinding Priority="Template" Converter="{x:Static m3:SearchBarMotion.Present}">
                    <Binding Path="IsPresented" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="Content" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding></ContentPresenter.Content>
                  <ContentPresenter.ContentTemplate><MultiBinding Priority="Template" Converter="{x:Static m3:SearchBarMotion.Present}">
                    <Binding Path="IsPresented" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="ContentTemplate" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding></ContentPresenter.ContentTemplate>
                </ContentPresenter>
                </m3:SearchResultsColumn>
              </Border>
            </m3:FullScreenSearchBarLayout>
          </m3:SearchBarPopupPresenter>
        </Grid>
      </ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:ExpandedFullScreenContainedSearchBar}" TargetType="m3:ExpandedFullScreenContainedSearchBar" BasedOn="{StaticResource {x:Type m3:ExpandedFullScreenSearchBar}}">
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.ContainedContainerColor}}" />
      <Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.InputContainerShape}}" />
      <Setter Property="WindowInsets" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.FullScreenWindowInsets}}" />
      <Setter Property="Template"><ControlTemplate>
        <Grid Name="PART_Root">
          <m3:SearchBarPopupPresenter Name="PART_Presentation" IsVisible="False">
            <m3:FullScreenSearchBarLayout Name="PART_Layout"
                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}"
                MaxWidth="{TemplateBinding MaxWidth}" MaxHeight="{TemplateBinding MaxHeight}"
                DefaultInputWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.DefaultWidth}}"
                DefaultInputHeight="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.InputHeight}}"
                VerticalPadding="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.FullScreenVerticalPadding}}"
                InputTopPadding="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.ContainedInputTopPadding}}"
                InputHorizontalPadding="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.ContainedInputHorizontalPadding}}">
              <m3:MaterialSurface Name="PART_Surface" Background="{TemplateBinding Background}"
                                  TonalElevation="{TemplateBinding TonalElevation}" ShadowElevation="{TemplateBinding ShadowElevation}" />
              <Border>
              <m3:MaterialSurface Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" TextElement.Foreground="{TemplateBinding Foreground}" ApplyTonalElevation="False">
                <ContentPresenter Name="PART_InputField"
                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" >
                  <ContentPresenter.Content><MultiBinding Priority="Template" Converter="{x:Static m3:SearchBarMotion.Present}">
                    <Binding Path="IsPresented" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="InputField" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding></ContentPresenter.Content>
                  <ContentPresenter.ContentTemplate><MultiBinding Priority="Template" Converter="{x:Static m3:SearchBarMotion.Present}">
                    <Binding Path="IsPresented" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="InputFieldTemplate" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding></ContentPresenter.ContentTemplate>
                </ContentPresenter>
              </m3:MaterialSurface>
              </Border>
              <Border TextElement.Foreground="{TemplateBinding Foreground}">
                <m3:SearchResultsColumn>
                  <ContentPresenter Name="PART_ContentPresenter"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Top" >
                  <ContentPresenter.Content><MultiBinding Priority="Template" Converter="{x:Static m3:SearchBarMotion.Present}">
                    <Binding Path="IsPresented" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="Content" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding></ContentPresenter.Content>
                  <ContentPresenter.ContentTemplate><MultiBinding Priority="Template" Converter="{x:Static m3:SearchBarMotion.Present}">
                    <Binding Path="IsPresented" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="ContentTemplate" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding></ContentPresenter.ContentTemplate>
                </ContentPresenter>
                </m3:SearchResultsColumn>
              </Border>
            </m3:FullScreenSearchBarLayout>
          </m3:SearchBarPopupPresenter>
        </Grid>
      </ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:SearchBarInputField}" TargetType="m3:SearchBarInputField" BasedOn="{StaticResource MaterialTextFieldBaseTheme}">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="PreferredMinimumWidth" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.DefaultWidth}}" />
      <Setter Property="PreferredMaximumWidth" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.InputMaximumWidth}}" />
      <Setter Property="ClearFocusDelay" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.AnimationDelay}}" />
      <Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.InputContainerShape}}" />
      <Setter Property="input:TextInputOptions.ReturnKeyType" Value="Search" />
      <Setter Property="m3:TextFieldThemeDefaults.Background" Value="Transparent" />
      <Setter Property="m3:TextFieldThemeDefaults.BorderBrush" Value="Transparent" />
      <Setter Property="m3:TextFieldThemeDefaults.Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.InputTextColor}}" />
      <Setter Property="m3:TextFieldThemeDefaults.PlaceholderForeground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.SupportingTextColor}}" />
      <Setter Property="m3:TextFieldThemeDefaults.CaretBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledTextField.CursorColor}}" />
      <Setter Property="SelectionBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledTextField.SelectionColor}}" />
      <Style Selector="^ /template/ ContentPresenter#Leading">
        <Setter Property="Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.LeadingIconColor}}" />
        <Setter Property="RenderTransform"><TranslateTransform X="4" /></Setter>
      </Style>
      <Style Selector="^ /template/ ContentPresenter#Trailing">
        <Setter Property="Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.TrailingIconColor}}" />
        <Setter Property="RenderTransform"><TranslateTransform X="-4" /></Setter>
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="m3:TextFieldThemeDefaults.Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledTextField.DisabledInputColor}}" />
        <Setter Property="m3:TextFieldThemeDefaults.PlaceholderForeground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledTextField.DisabledPlaceholderColor}}" />
      </Style>
      <Style Selector="^:disabled /template/ ContentPresenter#Leading"><Setter Property="Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledTextField.DisabledLeadingIconColor}}" /></Style>
      <Style Selector="^:disabled /template/ ContentPresenter#Trailing"><Setter Property="Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledTextField.DisabledTrailingIconColor}}" /></Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:DockedSearchBar}" TargetType="m3:DockedSearchBar">
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.ContainerColor}}" />
      <Setter Property="Foreground" Value="{m3:ContentColorFor}" />
      <Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.DockedContainerShape}}" />
      <Setter Property="DividerColor" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.DividerColor}}" />
      <Setter Property="TonalElevation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.TonalElevation}}" />
      <Setter Property="ShadowElevation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.ShadowElevation}}" />
      <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="ZIndex" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <m3:MaterialSurface Name="PART_Surface" Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}" TextElement.Foreground="{TemplateBinding Foreground}"
                              TonalElevation="{TemplateBinding TonalElevation}" ShadowElevation="{TemplateBinding ShadowElevation}">
            <m3:DockedSearchBarLayout Width="{TemplateBinding Width}" MinWidth="{TemplateBinding MinWidth}"
                DefaultWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.DefaultWidth}}">
              <ContentPresenter Name="PART_InputField" Content="{TemplateBinding InputField}" ContentTemplate="{TemplateBinding InputFieldTemplate}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" />
              <ca:AnimatedVisibility Name="PART_Results" Visible="{TemplateBinding IsExpanded}">
                <ca:AnimatedVisibility.Enter>
                  <MultiBinding Priority="Template" Converter="{x:Static m3:SearchBarMotion.Enter}">
                    <m3:Token Key="{x:Static m3:MaterialTokens+Comp+SearchBar.EnterDuration}" />
                    <m3:Token Key="{x:Static m3:MaterialTokens+Comp+SearchBar.AnimationDelay}" />
                  </MultiBinding>
                </ca:AnimatedVisibility.Enter>
                <ca:AnimatedVisibility.Exit>
                  <MultiBinding Priority="Template" Converter="{x:Static m3:SearchBarMotion.Exit}">
                    <m3:Token Key="{x:Static m3:MaterialTokens+Comp+SearchBar.ExitDuration}" />
                    <m3:Token Key="{x:Static m3:MaterialTokens+Comp+SearchBar.AnimationDelay}" />
                  </MultiBinding>
                </ca:AnimatedVisibility.Exit>
                <m3:DockedSearchResultsLayout Name="PART_ResultsLayout"
                    MinimumResultsHeight="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.MinimumResultsHeight}}"
                    MaximumWindowHeightFraction="{m3:Token {x:Static m3:MaterialTokens+Comp+SearchBar.MaximumWindowHeightFraction}}">
                  <Separator Name="PART_Divider" HorizontalAlignment="Stretch" m3:MaterialDivider.Color="{TemplateBinding DividerColor}" />
                  <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="Top" />
                </m3:DockedSearchResultsLayout>
              </ca:AnimatedVisibility>
            </m3:DockedSearchBarLayout>
          </m3:MaterialSurface>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>
</Styles>
