<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
  <Styles.Resources>
    <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+PlainTooltip.ContainerColor}}" />
      <Setter Property="Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+PlainTooltip.SupportingTextColor}}" />
      <Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+PlainTooltip.ContainerShape}}" />
      <Setter Property="m3:MaterialText.DefaultStyle" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+PlainTooltip.SupportingTextFont}}" />
      <Setter Property="Padding" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+PlainTooltip.ContentPadding}}" />
      <Setter Property="MinWidth" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+PlainTooltip.MinWidth}}" />
      <Setter Property="MinHeight" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+PlainTooltip.MinHeight}}" />
      <Setter Property="MaxWidth" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+PlainTooltip.MaxWidth}}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="PART_LayoutRoot" Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:TooltipBox}" TargetType="m3:TooltipBox">
        <Setter Property="Spacing" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TooltipBox.Spacing}}" />
      <Setter Property="ScaleAnimation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TooltipBox.ScaleAnimation}}" />
      <Setter Property="OpacityAnimation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TooltipBox.OpacityAnimation}}" />

      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid x:Name="PART_Root" Background="Transparent">
            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:PlainTooltip}" TargetType="m3:PlainTooltip">
        <Setter Property="TooltipMaxWidth" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+PlainTooltip.MaxWidth}}" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+PlainTooltip.ContainerColor}}" />
      <Setter Property="Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+PlainTooltip.SupportingTextColor}}" />
      <Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+PlainTooltip.ContainerShape}}" />
      <Setter Property="m3:MaterialText.DefaultStyle" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+PlainTooltip.SupportingTextFont}}" />
      <Setter Property="Padding" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+PlainTooltip.ContentPadding}}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Template">
        <ControlTemplate>
          <m3:PlainTooltipLayout TooltipMaxWidth="{TemplateBinding TooltipMaxWidth}"
              DefaultMinWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+PlainTooltip.MinWidth}}"
              DefaultMinHeight="{m3:Token {x:Static m3:MaterialTokens+Comp+PlainTooltip.MinHeight}}"
              Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
              MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}"
              MaxWidth="{TemplateBinding MaxWidth}" MaxHeight="{TemplateBinding MaxHeight}">
            <m3:MaterialSurface x:Name="PART_Container" Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                TonalElevation="{TemplateBinding TonalElevation}" ShadowElevation="{TemplateBinding ShadowElevation}">
              <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                  Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap"
                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </m3:MaterialSurface>
          </m3:PlainTooltipLayout>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>
  <!-- ToolTip reads placement from its anchor, rather than its own ControlTheme. -->
  <Style Selector=":is(Control)">
    <Setter Property="ToolTip.Placement" Value="Top" />
    <Setter Property="ToolTip.VerticalOffset" Value="-4" />
    <Setter Property="ToolTip.ShouldUseOverlayLayer" Value="True" />
  </Style>
</Styles>
