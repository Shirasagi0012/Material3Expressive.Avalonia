<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
  <Styles.Resources>
    <ControlTheme x:Key="{x:Type m3:PullToRefreshIndicatorBox}" TargetType="m3:PullToRefreshIndicatorBox">
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="MaxDistance" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+PullToRefresh.MaxDistance}}" />
      <Setter Property="RefreshThreshold" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+PullToRefresh.RefreshThreshold}}" />
      <Setter Property="Elevation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+PullToRefresh.Elevation}}" />
      <Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+PullToRefresh.ContainerShape}}" />
      <Setter Property="ContainerWidth" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+PullToRefresh.ContainerSize}}" />
      <Setter Property="ContainerHeight" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+PullToRefresh.ContainerSize}}" />
      <Setter Property="Template">
        <ControlTemplate>
          <m3:PullToRefreshIndicatorLayout
              ContainerWidth="{TemplateBinding ContainerWidth}" ContainerHeight="{TemplateBinding ContainerHeight}">
            <m3:MaterialSurface Name="PART_Surface" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </m3:MaterialSurface>
          </m3:PullToRefreshIndicatorLayout>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:PullToRefreshIndicator}" TargetType="m3:PullToRefreshIndicator"
                  BasedOn="{StaticResource {x:Type m3:PullToRefreshIndicatorBox}}">
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+PullToRefresh.ContainerColor}}" />
      <Setter Property="Color" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+PullToRefresh.IndicatorColor}}" />
      <Setter Property="ContentTemplate">
        <DataTemplate>
          <m3:PullToRefreshIndicatorContent EffectsAnimation="{m3:Token {x:Static m3:MaterialTokens+Comp+PullToRefresh.EffectsAnimation}}" />
        </DataTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:PullToRefreshLoadingIndicator}" TargetType="m3:PullToRefreshLoadingIndicator"
                  BasedOn="{StaticResource {x:Type m3:PullToRefreshIndicator}}">
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+LoadingIndicator.ContainedContainerColor}}" />
      <Setter Property="Color" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+LoadingIndicator.ContainedActiveColor}}" />
      <Setter Property="Elevation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+PullToRefresh.LoadingElevation}}" />
      <Setter Property="ContainerWidth" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+LoadingIndicator.ContainerWidth}}" />
      <Setter Property="ContainerHeight" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+LoadingIndicator.ContainerHeight}}" />
    </ControlTheme>
  </Styles.Resources>
</Styles>
