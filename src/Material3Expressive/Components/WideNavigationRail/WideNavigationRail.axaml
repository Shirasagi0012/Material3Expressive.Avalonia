<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
  <Styles.Resources>
    <ControlTheme x:Key="{x:Type m3:WideNavigationRail}" TargetType="m3:WideNavigationRail">
      <Setter Property="StateAnimation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.StateAnimation}}" />
      <Setter Property="WindowInsets" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.WindowInsets}}" />
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.ContainerColor}}" />
      <Setter Property="Foreground" Value="{m3:ContentColorFor}" />
      <Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.ContainerShape}}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="ContentPadding">
        <Setter.Value>
          <MultiBinding Converter="{x:Static m3:WideNavigationRailPaddingConverter.Top}">
            <m3:TokenExtension Key="{x:Static m3:MaterialTokens+Comp+WideNavigationRail.TopSpace}" />
          </MultiBinding>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemsPanel"><ItemsPanelTemplate><m3:WideNavigationRailItemsPanel /></ItemsPanelTemplate></Setter>
      <Setter Property="ItemContainerTheme">
        <ControlTheme TargetType="ContentPresenter">
          <Setter Property="UseLayoutRounding" Value="False" />
          <Setter Property="HorizontalAlignment" Value="Left" />
          <Setter Property="VerticalAlignment" Value="Top" />
        </ControlTheme>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <m3:MaterialSurface Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                              TextElement.Foreground="{TemplateBinding Foreground}">
            <Border>
              <Border.Padding>
                <MultiBinding Converter="{x:Static m3:WindowInsetsConverter.Instance}">
                  <Binding Path="WindowInsets" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Path="FlowDirection" RelativeSource="{RelativeSource TemplatedParent}" />
                </MultiBinding>
              </Border.Padding>
              <Border Padding="{TemplateBinding ContentPadding}">
                <m3:WideNavigationRailLayout CollapsedContainerWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.CollapsedContainerWidth}}"
                      ExpandedContainerMinWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.ExpandedContainerMinWidth}}"
                      ExpandedContainerMaxWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.ExpandedContainerMaxWidth}}"
                      CollapsedItemVerticalSpace="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.CollapsedItemVerticalSpace}}"
                      CollapsedItemMinHeight="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.CollapsedItemMinHeight}}"
                      HeaderSpace="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.HeaderSpace}}"
                      ItemHorizontalPadding="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.ItemHorizontalPadding}}"
                      LayoutAnimation="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.LayoutAnimation}}"
                      ModalWidthAnimation="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.ModalWidthAnimation}}"
                      x:Name="PART_Layout" Expanded="{TemplateBinding LayoutExpanded}" Arrangement="{TemplateBinding Arrangement}" ContentPadding="{TemplateBinding ContentPadding}">
                  <ContentPresenter x:Name="PART_Header" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" />
                  <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" UseLayoutRounding="False" />
                </m3:WideNavigationRailLayout>
              </Border>
            </Border>
          </m3:MaterialSurface>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type m3:WideNavigationRailItem}" TargetType="m3:WideNavigationRailItem">
      <Setter Property="TopIconLabelTextStyle" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.TopIconLabelTextStyle}}" />
      <Setter Property="StartIconLabelTextStyle" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.StartIconLabelTextStyle}}" />
      <Setter Property="UseLayoutRounding" Value="False" />
      <Setter Property="m3:MaterialInteraction.IsInteractive" Value="True" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="CollapsedIndicatorPadding">
        <Setter.Value>
          <MultiBinding Converter="{x:Static m3:WideNavigationRailPaddingConverter.Collapsed}">
            <m3:TokenExtension Key="{x:Static m3:MaterialTokens+Comp+WideNavigationRail.ActiveIndicatorWidth}" />
            <m3:TokenExtension Key="{x:Static m3:MaterialTokens+Comp+WideNavigationRail.TopIconIndicatorHeight}" />
            <m3:TokenExtension Key="{x:Static m3:MaterialTokens+Comp+WideNavigationRail.IconSize}" />
          </MultiBinding>
        </Setter.Value>
      </Setter>
      <Setter Property="ExpandedIndicatorPadding">
        <Setter.Value>
          <MultiBinding Converter="{x:Static m3:WideNavigationRailPaddingConverter.Expanded}">
            <m3:TokenExtension Key="{x:Static m3:MaterialTokens+Comp+WideNavigationRail.StartIconIndicatorLeadingSpace}" />
            <m3:TokenExtension Key="{x:Static m3:MaterialTokens+Comp+WideNavigationRail.StartIconIndicatorHeight}" />
            <m3:TokenExtension Key="{x:Static m3:MaterialTokens+Comp+WideNavigationRail.IconSize}" />
          </MultiBinding>
        </Setter.Value>
      </Setter>
      <Setter Property="SelectedIconColor" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.SelectedIconColor}}" />
      <Setter Property="SelectedTextColorTopIconPosition" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.SelectedTextColorTopIconPosition}}" />
      <Setter Property="SelectedTextColorStartIconPosition" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.SelectedTextColorStartIconPosition}}" />
      <Setter Property="IndicatorColor" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.IndicatorColor}}" />
      <Setter Property="UnselectedIconColor" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.UnselectedIconColor}}" />
      <Setter Property="UnselectedTextColor" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.UnselectedTextColor}}" />
      <Setter Property="DisabledIconColor" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.DisabledIconColor}}" />
      <Setter Property="DisabledTextColor" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.DisabledTextColor}}" />
      <Setter Property="Template">
        <ControlTemplate>
          <!-- Compose selectable covers the whole item, including unpainted gaps. -->
          <m3:WideNavigationRailItemLayout ItemHorizontalPadding="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.ItemHorizontalPadding}}"
              ActiveIndicatorWidth="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.ActiveIndicatorWidth}}"
              IconSize="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.IconSize}}"
              StartIconLabelSpace="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.StartIconLabelSpace}}"
              TopIconLabelSpace="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.TopIconLabelSpace}}"
              SpatialAnimation="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.ItemSpatialAnimation}}" EffectsAnimation="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.ItemEffectsAnimation}}"
              x:Name="PART_Layout" Background="Transparent" m3:BadgeBounds.IsEnabled="True"
              IndicatorShape="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.ActiveIndicatorShape}}">
            <Border RenderOptions.RequiresFullOpacityHandling="True"><Border x:Name="PART_Indicator" /></Border>
            <Border>
              <ContentPresenter x:Name="PART_Icon" Content="{TemplateBinding Icon}" ContentTemplate="{TemplateBinding IconTemplate}"
                                m3:MaterialIcon.DefaultSize="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.IconSize}}"
                                UseLayoutRounding="True" />
            </Border>
            <Border RenderOptions.RequiresFullOpacityHandling="True">
              <ContentPresenter x:Name="PART_Label" Content="{TemplateBinding Label}" ContentTemplate="{TemplateBinding LabelTemplate}"
                                TextWrapping="Wrap" UseLayoutRounding="True" />
            </Border>
            <m3:MaterialSurface x:Name="PART_IndicatorRipple" Background="Transparent"
                TextElement.Foreground="{TemplateBinding Foreground}" StateLayerBrush="{TemplateBinding Foreground}"
                CornerRadius="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.ActiveIndicatorShape}}" />
          </m3:WideNavigationRailItemLayout>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>
</Styles>

