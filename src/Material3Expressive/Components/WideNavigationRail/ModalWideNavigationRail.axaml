<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
  <Styles.Resources>
    <ControlTheme x:Key="{x:Type m3:ModalWideNavigationRail}" TargetType="m3:ModalWideNavigationRail" BasedOn="{StaticResource {x:Type m3:WideNavigationRail}}">
      <Setter Property="ModalBackground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.ModalContainerColor}}" />
      <Setter Property="ModalForeground" Value="{m3:NavigationRailContentColor BackgroundProperty=ModalBackground}" />
      <Setter Property="ScrimBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.ModalScrimColor}}" />
      <Setter Property="CollapsedCornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.ContainerShape}}" />
      <Setter Property="ExpandedCornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+WideNavigationRail.ModalContainerShape}}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid x:Name="PART_Root">
            <m3:MaterialSurface x:Name="PART_Inline" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CollapsedCornerRadius}" TextElement.Foreground="{TemplateBinding Foreground}">
              <Border>
                <Border.Padding>
                  <MultiBinding Converter="{x:Static m3:NavigationRailInsetsConverter.Instance}">
                    <Binding Path="WindowInsets" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="FlowDirection" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding>
                </Border.Padding>
                <Border Padding="{TemplateBinding ContentPadding}">
                  <m3:WideNavigationRailLayout x:Name="PART_Layout" Expanded="False" Arrangement="{TemplateBinding Arrangement}" ContentPadding="{TemplateBinding ContentPadding}">
                    <ContentPresenter x:Name="PART_Header" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" UseLayoutRounding="False" />
                  </m3:WideNavigationRailLayout>
                </Border>
              </Border>
            </m3:MaterialSurface>
            <m3:ModalWideNavigationRailOverlay x:Name="PART_Overlay" IsVisible="False" Background="Transparent" ClipToBounds="True">
              <m3:ModalWideNavigationRailScrim x:Name="PART_Scrim" Background="{TemplateBinding ScrimBrush}" RenderOptions.RequiresFullOpacityHandling="True" />
              <m3:MaterialSurface x:Name="PART_ModalSurface" Width="{TemplateBinding Width}" MinWidth="{TemplateBinding MinWidth}" MaxWidth="360"
                                  Background="{TemplateBinding ModalBackground}" CornerRadius="{TemplateBinding ExpandedCornerRadius}" TextElement.Foreground="{TemplateBinding ModalForeground}">
                <m3:MaterialSurface Background="{TemplateBinding ModalBackground}" CornerRadius="{TemplateBinding ExpandedCornerRadius}" TextElement.Foreground="{TemplateBinding ModalForeground}">
                  <Border>
                    <Border.Padding>
                      <MultiBinding Converter="{x:Static m3:NavigationRailInsetsConverter.Instance}">
                        <Binding Path="WindowInsets" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="FlowDirection" RelativeSource="{RelativeSource TemplatedParent}" />
                      </MultiBinding>
                    </Border.Padding>
                    <Border Padding="{TemplateBinding ContentPadding}">
                      <m3:WideNavigationRailLayout x:Name="PART_ModalLayout" IsModal="True" Arrangement="{TemplateBinding Arrangement}" ContentPadding="{TemplateBinding ContentPadding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Top">
                          <Border x:Name="PART_ExpandedHeaderPadding">
                            <ContentPresenter x:Name="PART_ExpandedHeader" HorizontalAlignment="Left" VerticalAlignment="Top" />
                          </Border>
                        </ContentPresenter>
                        <Panel />
                      </m3:WideNavigationRailLayout>
                    </Border>
                  </Border>
                </m3:MaterialSurface>
              </m3:MaterialSurface>
            </m3:ModalWideNavigationRailOverlay>
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>
</Styles>
