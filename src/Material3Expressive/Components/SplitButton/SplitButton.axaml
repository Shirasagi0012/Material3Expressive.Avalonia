<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
  <Styles.Resources>
    <m3:SplitButtonMinimumHeightConverter x:Key="SplitMinimumHeightConverter" />
    <m3:SplitButtonCornerConverter x:Key="SplitLeadingCornerConverter" />
    <m3:SplitButtonCornerConverter x:Key="SplitTrailingCornerConverter" Trailing="True" />
    <ControlTheme x:Key="{x:Type m3:SplitButton}" TargetType="m3:SplitButton">
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Spacing" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SplitButton.Spacing}}" />
      <Setter Property="Template">
        <ControlTemplate>
          <m3:ButtonLayout Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}" HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}" ContainerMinWidth="0">
            <m3:SplitButtonLayout Spacing="{TemplateBinding Spacing}">
              <ContentPresenter Content="{TemplateBinding LeadingButton}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
              <ContentPresenter Content="{TemplateBinding TrailingButton}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </m3:SplitButtonLayout>
          </m3:ButtonLayout>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="MaterialSplitButtonLeadingBaseTheme" TargetType="Button">
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="m3:MaterialInteraction.IsInteractive" Value="True" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="m3:MaterialText.DefaultStyle" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+TypeScale+LabelLarge.Style}}" />
      <Setter Property="Padding" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+SplitButtonSmall.LeadingPadding}}" />
      <Setter Property="CornerRadius">
        <MultiBinding Converter="{StaticResource SplitLeadingCornerConverter}">
          <m3:Token Key="{x:Static m3:MaterialTokens+Sys+Shape.Full}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+SplitButtonSmall.InnerCornerRadius}" />
        </MultiBinding>
      </Setter>
      <Setter Property="m3:MaterialButton.PressedCornerRadius">
        <MultiBinding Converter="{StaticResource SplitLeadingCornerConverter}">
          <m3:Token Key="{x:Static m3:MaterialTokens+Sys+Shape.Full}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+SplitButtonSmall.PressedInnerCornerRadius}" />
        </MultiBinding>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <m3:ButtonLayout Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}" ContainerMinWidth="48" MinimumInteractiveSize="0" ContainerMinHeight="{m3:Token {x:Static m3:MaterialTokens+Comp+SplitButtonSmall.ContainerHeight}}">
            <m3:MaterialSurface x:Name="PART_Container" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" TextElement.Foreground="{TemplateBinding Foreground}" StateLayerBrush="{TemplateBinding Foreground}" CornerRadius="{TemplateBinding CornerRadius}" PressedCornerRadius="{TemplateBinding m3:MaterialButton.PressedCornerRadius}" m3:ButtonSurfaceState.ResetOnShapeChange="False" m3:ButtonSurfaceState.CheckedCornerRadius="{x:Null}" m3:ButtonSurfaceState.CheckedOverlayOpacity="0" m3:ButtonSurfaceState.IsChecked="False">
              <Decorator Padding="{TemplateBinding Padding}"><m3:ButtonContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" TextWrapping="Wrap" m3:TextStyleHost.IsEnabled="True" /></Decorator>
            </m3:MaterialSurface>
          </m3:ButtonLayout>
        </ControlTemplate>
      </Setter>
