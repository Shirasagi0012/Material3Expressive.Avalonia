<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
  <Styles.Resources>
    <ControlTheme x:Key="{x:Type m3:FloatingActionButtonMenu}" TargetType="m3:FloatingActionButtonMenu">
      <Setter Property="MenuAlignment" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMenu.MenuAlignment}}"/>
      <Setter Property="ClipToBounds" Value="False"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Spacing="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMenu.ItemSpacing}}"/>
        </ItemsPanelTemplate>
      </Setter>
      <Setter Property="ItemContainerTheme">
        <ControlTheme TargetType="ContentPresenter">
          <Setter Property="HorizontalAlignment" Value="Right"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </ControlTheme>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <m3:FabMenuLayout x:Name="PART_Layout" HorizontalPadding="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMenu.HorizontalPadding}}" ButtonBottomPadding="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMenu.ButtonBottomPadding}}" ButtonBetweenSpace="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMenu.ButtonBetweenSpace}}" StaggerMotion="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMenu.StaggerMotion}}">
            <m3:FabMenuViewport>
              <m3:FabMenuViewport.Content>
                <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
              </m3:FabMenuViewport.Content>
            </m3:FabMenuViewport>
            <ContentPresenter x:Name="PART_Button" Content="{TemplateBinding Button}" ContentTemplate="{TemplateBinding ButtonTemplate}" ClipToBounds="False"/>
          </m3:FabMenuLayout>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:FloatingActionButtonMenuItem}" TargetType="m3:FloatingActionButtonMenuItem">
      <Setter Property="m3:MaterialInteraction.IsInteractive" Value="True"/>
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMenu.ItemContainerColor}}"/>
      <Setter Property="Foreground" Value="{m3:ContentColorFor}"/>
      <Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMenu.ItemShape}}"/>
      <Setter Property="m3:MaterialText.DefaultStyle" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMenu.LabelTextStyle}}"/>
      <Setter Property="RevealWidthMotion" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMenu.ItemWidthMotion}}"/>
      <Setter Property="RevealAlphaMotion" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMenu.ItemAlphaMotion}}"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <m3:MaterialSurface x:Name="PART_Container" Background="{TemplateBinding Background}" TextElement.Foreground="{TemplateBinding Foreground}" StateLayerBrush="{TemplateBinding Foreground}" CornerRadius="{TemplateBinding CornerRadius}">
            <m3:FabMenuItemLayout x:Name="PART_ContentLayout" MinimumSize="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMenu.ItemHeight}}" ContentPadding="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMenu.ContentPadding}}" IconLabelSpace="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMenu.IconLabelSpace}}">
              <ContentPresenter x:Name="PART_Icon" Content="{TemplateBinding Icon}" ContentTemplate="{TemplateBinding IconTemplate}" m3:MaterialIcon.DefaultSize="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMenu.ItemIconSize}}"/>
              <m3:ButtonContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" m3:TextStyleHost.IsEnabled="True"/>
            </m3:FabMenuItemLayout>
          </m3:MaterialSurface>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:ToggleFloatingActionButton}" TargetType="m3:ToggleFloatingActionButton">
      <Setter Property="ContainerColor">
        <MultiBinding Converter="{x:Static m3:FabProgressFunctionConverter.Color}">
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ToggleFab.InitialContainerColor}"/>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ToggleFab.FinalContainerColor}"/>
        </MultiBinding>
      </Setter>
      <Setter Property="ContainerSize">
        <MultiBinding Converter="{x:Static m3:FabProgressFunctionConverter.Scalar}">
          <MultiBinding Converter="{x:Static m3:FabSizeDefaultConverter.Instance}">
            <ReflectionBinding Path="Size" RelativeSource="{RelativeSource Self}"/>
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabBaseline.ContainerHeight}"/>
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabBaseline.ContainerHeight}"/>
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabMedium.ContainerHeight}"/>
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabLarge.ContainerHeight}"/>
          </MultiBinding>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabMenu.CloseButtonSize}"/>
        </MultiBinding>
      </Setter>
      <Setter Property="ContainerCornerRadius">
        <MultiBinding Converter="{x:Static m3:FabProgressFunctionConverter.CornerRadius}">
          <MultiBinding Converter="{x:Static m3:FabSizeDefaultConverter.Instance}">
            <ReflectionBinding Path="Size" RelativeSource="{RelativeSource Self}"/>
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ToggleFab.InitialCornerRadius}"/>
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ToggleFab.InitialCornerRadius}"/>
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ToggleFab.MediumInitialCornerRadius}"/>
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ToggleFab.LargeInitialCornerRadius}"/>
          </MultiBinding>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabMenu.CloseButtonSize}"/>
        </MultiBinding>
      </Setter>
      <Setter Property="IconSizeFunction">
        <MultiBinding Converter="{x:Static m3:FabProgressFunctionConverter.Scalar}">
          <MultiBinding Converter="{x:Static m3:FabSizeDefaultConverter.Instance}">
            <ReflectionBinding Path="Size" RelativeSource="{RelativeSource Self}"/>
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabBaseline.IconSize}"/>
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabBaseline.IconSize}"/>
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabMedium.IconSize}"/>
            <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabLarge.ContentIconSize}"/>
          </MultiBinding>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabMenu.CloseIconSize}"/>
        </MultiBinding>
      </Setter>
      <Setter Property="IconColorFunction">
        <MultiBinding Converter="{x:Static m3:FabProgressFunctionConverter.Color}">
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ToggleFab.InitialIconColor}"/>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ToggleFab.FinalIconColor}"/>
        </MultiBinding>
      </Setter>
      <Setter Property="DefaultIconSize">
        <MultiBinding Converter="{x:Static m3:FabSizeDefaultConverter.Instance}">
          <ReflectionBinding Path="Size" RelativeSource="{RelativeSource Self}"/>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabBaseline.IconSize}"/>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabBaseline.IconSize}"/>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabMedium.IconSize}"/>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabLarge.ContentIconSize}"/>
        </MultiBinding>
      </Setter>
      <Setter Property="ShadowElevation" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FabPrimaryContainer.ContainerElevation}}"/>
      <Setter Property="CheckedMotion" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ToggleFab.CheckedMotion}}"/>
      <Setter Property="m3:MaterialInteraction.IsInteractive" Value="True"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Right"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="ClipToBounds" Value="False"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <m3:ToggleFabLayout x:Name="PART_Layout">
            <m3:MaterialSurface x:Name="PART_Container" TextElement.Foreground="{TemplateBinding Foreground}">
              <m3:ToggleFabContentLayout x:Name="PART_ContentLayout">
                <ContentPresenter x:Name="PART_IconPresenter" Content="{TemplateBinding Icon}" ContentTemplate="{TemplateBinding IconTemplate}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" m3:MaterialIcon.DefaultSize="{TemplateBinding DefaultIconSize}">
 </ContentPresenter>
                <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
              </m3:ToggleFabContentLayout>
            </m3:MaterialSurface>
          </m3:ToggleFabLayout>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:FloatingActionButton}" TargetType="m3:FloatingActionButton">
      <Setter Property="m3:MaterialInteraction.IsInteractive" Value="True"/>
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FabPrimaryContainer.ContainerColor}}"/>
      <Setter Property="Foreground" Value="{m3:ContentColorFor}"/>
      <Setter Property="CornerRadius">
        <MultiBinding Converter="{x:Static m3:FabSizeDefaultConverter.Instance}">
          <ReflectionBinding Path="Size" RelativeSource="{RelativeSource Self}"/>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabBaseline.ContainerShape}"/>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabSmall.ContainerShape}"/>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabMedium.ContainerShape}"/>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabLarge.ContainerShape}"/>
        </MultiBinding>
      </Setter>
      <Setter Property="m3:MaterialText.DefaultStyle" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ExtendedFabPrimary.LabelTextStyle}}"/>
      <Setter Property="HiddenScale" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Fab.HiddenScale}}"/>
      <Setter Property="VisibilityAlignment" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Fab.VisibilityAlignment}}"/>
      <Setter Property="VisibilityScaleSpec">
        <MultiBinding Converter="{x:Static m3:FabMotion.FromToken}">
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Fab.VisibilityScaleMotion}"/>
        </MultiBinding>
      </Setter>
      <Setter Property="VisibilityAlphaSpec">
        <MultiBinding Converter="{x:Static m3:FabMotion.FromToken}">
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+Fab.VisibilityAlphaMotion}"/>
        </MultiBinding>
      </Setter>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ClipToBounds" Value="False"/>
      <Setter Property="Elevation">
        <MultiBinding Converter="{x:Static m3:FloatingActionButtonElevation.FromValues}">
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabPrimaryContainer.ContainerElevation}"/>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabPrimaryContainer.PressedContainerElevation}"/>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabPrimaryContainer.FocusedContainerElevation}"/>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabPrimaryContainer.HoveredContainerElevation}"/>
        </MultiBinding>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <m3:FabVisibilityLayout>
            <m3:FabLayout Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}" HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}">
              <m3:FabLayout.ContainerMinSize>
                <MultiBinding Priority="Template" Converter="{x:Static m3:FabSizeDefaultConverter.Instance}">
                  <ReflectionBinding Path="Size" RelativeSource="{RelativeSource TemplatedParent}"/>
                  <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabBaseline.ContainerHeight}"/>
                  <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabSmall.ContainerHeight}"/>
                  <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabMedium.ContainerHeight}"/>
                  <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabLarge.ContainerHeight}"/>
                </MultiBinding>
              </m3:FabLayout.ContainerMinSize>
              <m3:MaterialSurface x:Name="PART_Container" Background="{TemplateBinding Background}" TextElement.Foreground="{TemplateBinding Foreground}" CornerRadius="{TemplateBinding CornerRadius}" StateLayerBrush="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" TonalElevation="{Binding Elevation.Default, RelativeSource={RelativeSource TemplatedParent}}">
                <m3:FabIconContentLayout x:Name="PART_IconContentLayout">
                  <ContentPresenter x:Name="PART_Icon" Content="{TemplateBinding Icon}" ContentTemplate="{TemplateBinding IconTemplate}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <m3:MaterialIcon.DefaultSize>
                      <MultiBinding Priority="Template" Converter="{x:Static m3:FabSizeDefaultConverter.Instance}">
                        <ReflectionBinding Path="Size" RelativeSource="{RelativeSource TemplatedParent}"/>
                        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabBaseline.IconSize}"/>
                        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabSmall.IconSize}"/>
                        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabMedium.IconSize}"/>
                        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabLarge.ContentIconSize}"/>
                      </MultiBinding>
                    </m3:MaterialIcon.DefaultSize>
                  </ContentPresenter>
                  <m3:ButtonContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" m3:TextStyleHost.IsEnabled="True"/>
                </m3:FabIconContentLayout>
              </m3:MaterialSurface>
            </m3:FabLayout>
          </m3:FabVisibilityLayout>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:ExtendedFloatingActionButton}" TargetType="m3:ExtendedFloatingActionButton" BasedOn="{StaticResource {x:Type m3:FloatingActionButton}}">
      <Setter Property="CornerRadius">
        <MultiBinding Converter="{x:Static m3:FabSizeDefaultConverter.Instance}">
          <ReflectionBinding Path="Size" RelativeSource="{RelativeSource Self}"/>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabPrimary.ContainerShape}"/>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabSmall.ContainerShape}"/>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabMedium.ContainerShape}"/>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabLarge.ContainerShape}"/>
        </MultiBinding>
      </Setter>
      <Setter Property="m3:MaterialText.DefaultStyle">
        <MultiBinding Converter="{x:Static m3:FabSizeDefaultConverter.Instance}">
          <ReflectionBinding Path="Size" RelativeSource="{RelativeSource Self}"/>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabPrimary.LabelTextStyle}"/>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabSmall.LabelTextStyle}"/>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabMedium.LabelTextStyle}"/>
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabLarge.LabelTextStyle}"/>
        </MultiBinding>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <m3:FabVisibilityLayout>
            <m3:FabLayout Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}" HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}" ContainerMinSize="0">
              <m3:MaterialSurface x:Name="PART_Container" Background="{TemplateBinding Background}" TextElement.Foreground="{TemplateBinding Foreground}" CornerRadius="{TemplateBinding CornerRadius}" StateLayerBrush="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" TonalElevation="{Binding Elevation.Default, RelativeSource={RelativeSource TemplatedParent}}">
                <m3:ExtendedFabLayout x:Name="PART_ContentLayout">
                  <m3:ExtendedFabLayout.MinimumSize>
                    <MultiBinding Priority="Template" Converter="{x:Static m3:FabSizeDefaultConverter.Instance}">
                      <ReflectionBinding Path="Size" RelativeSource="{RelativeSource TemplatedParent}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabPrimary.ContainerHeight}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabSmall.ContainerHeight}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabMedium.ContainerHeight}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabLarge.ContainerHeight}"/>
                    </MultiBinding>
                  </m3:ExtendedFabLayout.MinimumSize>
                  <m3:ExtendedFabLayout.MinimumWidth>
                    <MultiBinding Priority="Template" Converter="{x:Static m3:FabSizeDefaultConverter.Instance}">
                      <ReflectionBinding Path="Size" RelativeSource="{RelativeSource TemplatedParent}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabPrimary.MinimumWidth}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabSmall.ContainerHeight}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabMedium.ContainerHeight}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabLarge.ContainerHeight}"/>
                    </MultiBinding>
                  </m3:ExtendedFabLayout.MinimumWidth>
                  <m3:ExtendedFabLayout.CollapsedMinimumWidth>
                    <MultiBinding Priority="Template" Converter="{x:Static m3:FabSizeDefaultConverter.Instance}">
                      <ReflectionBinding Path="Size" RelativeSource="{RelativeSource TemplatedParent}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabBaseline.ContainerWidth}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabSmall.ContainerHeight}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabMedium.ContainerHeight}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabLarge.ContainerHeight}"/>
                    </MultiBinding>
                  </m3:ExtendedFabLayout.CollapsedMinimumWidth>
                  <m3:ExtendedFabLayout.LeadingSpace>
                    <MultiBinding Priority="Template" Converter="{x:Static m3:FabSizeDefaultConverter.Instance}">
                      <ReflectionBinding Path="Size" RelativeSource="{RelativeSource TemplatedParent}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabPrimary.LeadingSpace}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabSmall.LeadingSpace}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabMedium.LeadingSpace}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabLarge.LeadingSpace}"/>
                    </MultiBinding>
                  </m3:ExtendedFabLayout.LeadingSpace>
                  <m3:ExtendedFabLayout.TrailingSpace>
                    <MultiBinding Priority="Template" Converter="{x:Static m3:FabSizeDefaultConverter.Instance}">
                      <ReflectionBinding Path="Size" RelativeSource="{RelativeSource TemplatedParent}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabPrimary.TrailingSpace}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabSmall.TrailingSpace}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabMedium.TrailingSpace}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabLarge.TrailingSpace}"/>
                    </MultiBinding>
                  </m3:ExtendedFabLayout.TrailingSpace>
                  <m3:ExtendedFabLayout.IconLeadingSpace>
                    <MultiBinding Priority="Template" Converter="{x:Static m3:FabSizeDefaultConverter.Instance}">
                      <ReflectionBinding Path="Size" RelativeSource="{RelativeSource TemplatedParent}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabPrimary.IconLeadingSpace}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabSmall.LeadingSpace}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabMedium.LeadingSpace}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabLarge.LeadingSpace}"/>
                    </MultiBinding>
                  </m3:ExtendedFabLayout.IconLeadingSpace>
                  <m3:ExtendedFabLayout.IconLabelSpace>
                    <MultiBinding Priority="Template" Converter="{x:Static m3:FabSizeDefaultConverter.Instance}">
                      <ReflectionBinding Path="Size" RelativeSource="{RelativeSource TemplatedParent}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabPrimary.IconLabelSpace}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabSmall.IconLabelSpace}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabMedium.ContentIconLabelSpace}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabLarge.ContentIconLabelSpace}"/>
                    </MultiBinding>
                  </m3:ExtendedFabLayout.IconLabelSpace>
                  <m3:ExtendedFabLayout.ExpandWidthMotion>
                    <MultiBinding Priority="Template" Converter="{x:Static m3:FabSizeDefaultConverter.Instance}">
                      <ReflectionBinding Path="Size" RelativeSource="{RelativeSource TemplatedParent}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabPrimary.ExpandWidthMotion}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFab.WidthMotion}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFab.WidthMotion}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFab.WidthMotion}"/>
                    </MultiBinding>
                  </m3:ExtendedFabLayout.ExpandWidthMotion>
                  <m3:ExtendedFabLayout.CollapseWidthMotion>
                    <MultiBinding Priority="Template" Converter="{x:Static m3:FabSizeDefaultConverter.Instance}">
                      <ReflectionBinding Path="Size" RelativeSource="{RelativeSource TemplatedParent}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabPrimary.CollapseWidthMotion}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFab.WidthMotion}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFab.WidthMotion}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFab.WidthMotion}"/>
                    </MultiBinding>
                  </m3:ExtendedFabLayout.CollapseWidthMotion>
                  <m3:ExtendedFabLayout.ExpandAlphaMotion>
                    <MultiBinding Priority="Template" Converter="{x:Static m3:FabSizeDefaultConverter.Instance}">
                      <ReflectionBinding Path="Size" RelativeSource="{RelativeSource TemplatedParent}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabPrimary.ExpandAlphaMotion}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFab.AlphaMotion}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFab.AlphaMotion}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFab.AlphaMotion}"/>
                    </MultiBinding>
                  </m3:ExtendedFabLayout.ExpandAlphaMotion>
                  <m3:ExtendedFabLayout.CollapseAlphaMotion>
                    <MultiBinding Priority="Template" Converter="{x:Static m3:FabSizeDefaultConverter.Instance}">
                      <ReflectionBinding Path="Size" RelativeSource="{RelativeSource TemplatedParent}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFabPrimary.CollapseAlphaMotion}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFab.AlphaMotion}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFab.AlphaMotion}"/>
                      <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ExtendedFab.AlphaMotion}"/>
                    </MultiBinding>
                  </m3:ExtendedFabLayout.CollapseAlphaMotion>
                  <ContentPresenter x:Name="PART_Icon" Content="{TemplateBinding Icon}" ContentTemplate="{TemplateBinding IconTemplate}">
                    <m3:MaterialIcon.DefaultSize>
                      <MultiBinding Priority="Template" Converter="{x:Static m3:FabSizeDefaultConverter.Instance}">
                        <ReflectionBinding Path="Size" RelativeSource="{RelativeSource TemplatedParent}"/>
                        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabBaseline.IconSize}"/>
                        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabSmall.IconSize}"/>
                        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabMedium.IconSize}"/>
                        <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabLarge.ContentIconSize}"/>
                      </MultiBinding>
                    </m3:MaterialIcon.DefaultSize>
                  </ContentPresenter>
                  <m3:FabLabelClip>
                    <m3:ButtonContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" m3:TextStyleHost.IsEnabled="True"/>
                  </m3:FabLabelClip>
                </m3:ExtendedFabLayout>
              </m3:MaterialSurface>
            </m3:FabLayout>
          </m3:FabVisibilityLayout>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>
</Styles>
