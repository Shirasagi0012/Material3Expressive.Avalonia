<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
  <Styles.Resources>
    <ControlTheme x:Key="{x:Type m3:FloatingActionButtonMenu}" TargetType="m3:FloatingActionButtonMenu">
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel Spacing="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMenu.ItemSpacing}}" /></ItemsPanelTemplate></Setter>
      <Setter Property="ItemContainerTheme">
        <ControlTheme TargetType="ContentPresenter">
          <Setter Property="HorizontalAlignment" Value="Right" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </ControlTheme>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <m3:FabMenuLayout x:Name="PART_Layout" HorizontalPadding="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMenu.HorizontalPadding}}"
                            ButtonBottomPadding="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMenu.ButtonBottomPadding}}"
                            ButtonBetweenSpace="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMenu.ButtonBetweenSpace}}">
            <m3:FabMenuViewport>
              <m3:FabMenuViewport.Content>
              <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </m3:FabMenuViewport.Content>
            </m3:FabMenuViewport>
            <ContentPresenter x:Name="PART_Button" Content="{TemplateBinding Button}" ContentTemplate="{TemplateBinding ButtonTemplate}" ClipToBounds="False" />
          </m3:FabMenuLayout>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:FloatingActionButtonMenuItem}" TargetType="m3:FloatingActionButtonMenuItem">
      <Setter Property="m3:MaterialInteraction.IsInteractive" Value="True" />
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FabPrimaryContainer.ContainerColor}}" />
      <Setter Property="Foreground" Value="{m3:ContentColorFor}" />
      <Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMenu.ItemShape}}" />
      <Setter Property="m3:MaterialText.DefaultStyle" Value="{m3:Typography TitleMedium}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <m3:MaterialSurface x:Name="PART_Container" Background="{TemplateBinding Background}" TextElement.Foreground="{TemplateBinding Foreground}"
                              StateLayerBrush="{TemplateBinding Foreground}" CornerRadius="{TemplateBinding CornerRadius}">
            <m3:FabMenuItemLayout x:Name="PART_ContentLayout" MinimumSize="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMenu.ItemHeight}}"
                                  ContentPadding="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMenu.ContentPadding}}"
                                  IconLabelSpace="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMenu.IconLabelSpace}}">
              <ContentPresenter x:Name="PART_Icon" Content="{TemplateBinding Icon}" ContentTemplate="{TemplateBinding IconTemplate}"
                                m3:MaterialIcon.DefaultSize="24" />
              <m3:ButtonContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                  m3:TextStyleHost.IsEnabled="True" />
            </m3:FabMenuItemLayout>
          </m3:MaterialSurface>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:ToggleFloatingActionButton}" TargetType="m3:ToggleFloatingActionButton">
      <Setter Property="m3:MaterialInteraction.IsInteractive" Value="True" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <m3:ToggleFabLayout x:Name="PART_Layout">
            <m3:MaterialSurface x:Name="PART_Container" TextElement.Foreground="{TemplateBinding Foreground}">
              <m3:ToggleFabContentLayout x:Name="PART_ContentLayout">
                <ContentPresenter x:Name="PART_IconPresenter" Content="{TemplateBinding Icon}" ContentTemplate="{TemplateBinding IconTemplate}"
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                  m3:MaterialIcon.DefaultSize="{m3:Token {x:Static m3:MaterialTokens+Comp+FabBaseline.IconSize}}" />
                <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
              </m3:ToggleFabContentLayout>
            </m3:MaterialSurface>
          </m3:ToggleFabLayout>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:FloatingActionButton}" TargetType="m3:FloatingActionButton">
      <Setter Property="m3:MaterialInteraction.IsInteractive" Value="True" />
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FabPrimaryContainer.ContainerColor}}" />
      <Setter Property="Foreground" Value="{m3:ContentColorFor}" />
      <Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FabBaseline.ContainerShape}}" />
      <Setter Property="m3:MaterialText.DefaultStyle" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ExtendedFabPrimary.LabelTextStyle}}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Elevation">
        <MultiBinding Converter="{x:Static m3:FloatingActionButtonElevation.FromValues}">
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabPrimaryContainer.ContainerElevation}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabPrimaryContainer.PressedContainerElevation}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabPrimaryContainer.FocusedContainerElevation}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FabPrimaryContainer.HoveredContainerElevation}" />
        </MultiBinding>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <m3:FabVisibilityLayout>
            <m3:FabLayout Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}"
                          HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}"
                          ContainerMinSize="{m3:Token {x:Static m3:MaterialTokens+Comp+FabBaseline.ContainerHeight}}">
              <m3:MaterialSurface x:Name="PART_Container" Background="{TemplateBinding Background}" TextElement.Foreground="{TemplateBinding Foreground}"
                                  CornerRadius="{TemplateBinding CornerRadius}" StateLayerBrush="{TemplateBinding Foreground}"
                                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <m3:FabIconContentLayout x:Name="PART_IconContentLayout">
                  <ContentPresenter x:Name="PART_Icon" Content="{TemplateBinding Icon}" ContentTemplate="{TemplateBinding IconTemplate}"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    m3:MaterialIcon.DefaultSize="{m3:Token {x:Static m3:MaterialTokens+Comp+FabBaseline.IconSize}}" />
                  <m3:ButtonContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                      Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" m3:TextStyleHost.IsEnabled="True" />
                </m3:FabIconContentLayout>
              </m3:MaterialSurface>
            </m3:FabLayout>
          </m3:FabVisibilityLayout>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="TonalElevation" Value="{Binding Elevation.Default, RelativeSource={RelativeSource TemplatedParent}}" />
      </Style>
      <Style Selector="^:small"><Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FabSmall.ContainerShape}}" /></Style>
      <Style Selector="^:small /template/ m3|FabLayout"><Setter Property="ContainerMinSize" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FabSmall.ContainerHeight}}" /></Style>
      <Style Selector="^:small /template/ ContentPresenter#PART_Icon"><Setter Property="m3:MaterialIcon.DefaultSize" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FabSmall.IconSize}}" /></Style>
      <Style Selector="^:medium"><Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMedium.ContainerShape}}" /></Style>
      <Style Selector="^:medium /template/ m3|FabLayout"><Setter Property="ContainerMinSize" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMedium.ContainerHeight}}" /></Style>
      <Style Selector="^:medium /template/ ContentPresenter#PART_Icon"><Setter Property="m3:MaterialIcon.DefaultSize" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FabMedium.IconSize}}" /></Style>
      <Style Selector="^:large"><Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FabLarge.ContainerShape}}" /></Style>
      <Style Selector="^:large /template/ m3|FabLayout"><Setter Property="ContainerMinSize" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FabLarge.ContainerHeight}}" /></Style>
      <Style Selector="^:large /template/ ContentPresenter#PART_Icon"><Setter Property="m3:MaterialIcon.DefaultSize" Value="{x:Static m3:FloatingActionButtonDefaults.LargeIconSize}" /></Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:ExtendedFloatingActionButton}" TargetType="m3:ExtendedFloatingActionButton" BasedOn="{StaticResource {x:Type m3:FloatingActionButton}}">
      <Setter Property="Template">
        <ControlTemplate>
          <m3:FabVisibilityLayout>
            <m3:FabLayout Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}"
                          HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}"
                          ContainerMinSize="0">
              <m3:MaterialSurface x:Name="PART_Container" Background="{TemplateBinding Background}" TextElement.Foreground="{TemplateBinding Foreground}"
                                  CornerRadius="{TemplateBinding CornerRadius}" StateLayerBrush="{TemplateBinding Foreground}"
                                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <m3:ExtendedFabLayout x:Name="PART_ContentLayout" MinimumSize="{m3:Token {x:Static m3:MaterialTokens+Comp+ExtendedFabPrimary.ContainerHeight}}">
                  <ContentPresenter x:Name="PART_Icon" Content="{TemplateBinding Icon}" ContentTemplate="{TemplateBinding IconTemplate}"
                                    m3:MaterialIcon.DefaultSize="{m3:Token {x:Static m3:MaterialTokens+Comp+FabBaseline.IconSize}}" />
                  <m3:FabLabelClip>
                  <m3:ButtonContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" m3:TextStyleHost.IsEnabled="True" />
                  </m3:FabLabelClip>
                </m3:ExtendedFabLayout>
              </m3:MaterialSurface>
            </m3:FabLayout>
          </m3:FabVisibilityLayout>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:small">
        <Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ExtendedFabSmall.ContainerShape}}" />
        <Setter Property="m3:MaterialText.DefaultStyle" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ExtendedFabSmall.LabelTextStyle}}" />
      </Style>
      <Style Selector="^:small /template/ m3|FabLayout"><Setter Property="ContainerMinSize" Value="0" /></Style>
      <Style Selector="^:small /template/ m3|ExtendedFabLayout">
        <Setter Property="MinimumSize" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ExtendedFabSmall.ContainerHeight}}" />
        <Setter Property="LeadingSpace" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ExtendedFabSmall.LeadingSpace}}" />
        <Setter Property="TrailingSpace" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ExtendedFabSmall.TrailingSpace}}" />
        <Setter Property="IconLabelSpace" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ExtendedFabSmall.IconLabelSpace}}" />
      </Style>
      <Style Selector="^:medium"><Setter Property="m3:MaterialText.DefaultStyle" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ExtendedFabMedium.LabelTextStyle}}" /></Style>
      <Style Selector="^:medium /template/ m3|FabLayout"><Setter Property="ContainerMinSize" Value="0" /></Style>
      <Style Selector="^:medium /template/ m3|ExtendedFabLayout">
        <Setter Property="MinimumSize" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ExtendedFabMedium.ContainerHeight}}" />
        <Setter Property="LeadingSpace" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ExtendedFabMedium.LeadingSpace}}" />
        <Setter Property="TrailingSpace" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ExtendedFabMedium.TrailingSpace}}" />
        <Setter Property="IconLabelSpace" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ExtendedFabMedium.IconLabelSpace}}" />
      </Style>
      <Style Selector="^:large"><Setter Property="m3:MaterialText.DefaultStyle" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ExtendedFabLarge.LabelTextStyle}}" /></Style>
      <Style Selector="^:large /template/ m3|FabLayout"><Setter Property="ContainerMinSize" Value="0" /></Style>
      <Style Selector="^:large /template/ m3|ExtendedFabLayout">
        <Setter Property="MinimumSize" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ExtendedFabLarge.ContainerHeight}}" />
        <Setter Property="LeadingSpace" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ExtendedFabLarge.LeadingSpace}}" />
        <Setter Property="TrailingSpace" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ExtendedFabLarge.TrailingSpace}}" />
        <Setter Property="IconLabelSpace" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ExtendedFabLarge.IconLabelSpace}}" />
      </Style>
    </ControlTheme>
  </Styles.Resources>
</Styles>
