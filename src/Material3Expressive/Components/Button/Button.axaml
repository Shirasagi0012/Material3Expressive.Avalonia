<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
  <!--
    The Button family (design doc §7.5) on its two orthogonal upstream axes:

    - Style axis: one named ControlTheme per style. The filled theme carries the template and the
      full size-class machinery; the other four are BasedOn diffs over it (colors, state-layer
      tints, outline, elevation). The implicit {x:Type Button} theme IS filled (M3 baseline).
    - Size axis: the classes xsmall / medium / large / xlarge, nested in the filled theme and
      inherited through BasedOn. No class = small, the M3 default. Class selectors run through
      StyleClassActivator, so these styles apply at StyleTrigger priority and can re-point even
      the template's inline {m3:Token} bindings.

    Every consumed value is a comp slot (§7.1) resolved through {m3:Token}: colors/outline from
    the style table, metrics/shape/typography from the size tables, elevation as DIPs onto
    MaterialSurface.Elevation (rendered by MaterialSkiaShadow). Interactions follow the §7.4
    state-layer model with the motion slice landed: MaterialInteraction.IsInteractive opts the
    control in, and the owner's interaction controller drives the overlay — the pseudo-class
    styles here only switch StateLayerBrush (which doubles as the ripple ink color, matching
    upstream where both come from the content color), while opacity timing, press ripples and the
    press shape-morph are the controller's job. The focus ring is still deferred.
    Nested facade types are referenced with the XAML '+' syntax — '{x:Static}' splits the
    argument at the first dot, so 'MaterialTokens.Comp.FilledButton.X' would not resolve.
  -->
  <Styles.Resources>

    <ControlTheme x:Key="MaterialFilledButtonTheme" TargetType="Button">
      <Setter Property="m3:MaterialInteraction.IsInteractive" Value="True" />
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledButton.ContainerColor}}" />
      <Setter Property="Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledButton.ContentColor}}" />
      <Setter Property="Padding" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonSmall.ContentPadding}}" />
      <Setter Property="m3:MaterialText.DefaultStyle" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonSmall.LabelTextStyle}}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <m3:ButtonLayout Width="{TemplateBinding Width}"
                           Height="{TemplateBinding Height}"
                           MinWidth="{TemplateBinding MinWidth}"
                           MinHeight="{TemplateBinding MinHeight}"
                           HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                           VerticalAlignment="{TemplateBinding VerticalAlignment}"
                           ContainerMinHeight="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonSmall.ContainerHeight}}">
            <!-- TextElement.Foreground re-asserts the owner's content color onto the part:
                 a standalone MaterialSurface gets TextElement.Foreground from its implicit theme,
                 and any set value there would shadow the Button.Foreground inheritance. Template
                 priority beats the theme frame, so this mirrors Compose's "Button passes its
                 contentColor into Surface". -->
            <m3:MaterialSurface x:Name="PART_Container"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                CornerRadius="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonSmall.ContainerShapeRound}}"
                                PressedCornerRadius="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonSmall.PressedContainerShape}}">
              <m3:ButtonContentPresenter x:Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                TextWrapping="Wrap"
                                m3:TextStyleHost.IsEnabled="True" />
            </m3:MaterialSurface>
          </m3:ButtonLayout>
        </ControlTemplate>
      </Setter>

      <!-- §7.4 with the motion slice: the controller owns state-layer opacity and the press ripple,
           so pseudo-class styles only pick the layer's color. Later selectors win on ties, so the
           declaration order hover < focus < pressed is load-bearing: pressed must beat hover when
           both pseudo-classes are active, because its brush is the ripple ink. BasedOn variants
           re-declare the StateLayerBrush setters with their own slots. -->
      <Style Selector="^ /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledButton.StateLayerColor}}" />
      </Style>
      <Style Selector="^:pointerover /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledButton.HoverStateLayerColor}}" />
      </Style>
      <Style Selector="^:focus-visible /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledButton.FocusedStateLayerColor}}" />
      </Style>
      <Style Selector="^:pressed /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledButton.PressedStateLayerColor}}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledButton.DisabledContainerColor}}" />
        <Setter Property="Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledButton.DisabledContentColor}}" />
      </Style>

      <!-- Size axis. Each class re-points every metric slot at its own size table; the outline
           width is only consumed by the outlined theme, which carries its own per-size override. -->
      <Style Selector="^.xsmall">
        <Setter Property="Padding" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXSmall.ContentPadding}}" />
        <Setter Property="m3:MaterialText.DefaultStyle" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXSmall.LabelTextStyle}}" />
      </Style>
      <Style Selector="^.xsmall /template/ m3|ButtonLayout">
        <Setter Property="ContainerMinHeight" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXSmall.ContainerHeight}}" />
      </Style>
      <Style Selector="^.xsmall /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXSmall.ContainerShapeRound}}" />
        <Setter Property="PressedCornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXSmall.PressedContainerShape}}" />
      </Style>

      <Style Selector="^.medium">
        <Setter Property="Padding" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonMedium.ContentPadding}}" />
        <Setter Property="m3:MaterialText.DefaultStyle" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonMedium.LabelTextStyle}}" />
      </Style>
      <Style Selector="^.medium /template/ m3|ButtonLayout">
        <Setter Property="ContainerMinHeight" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonMedium.ContainerHeight}}" />
      </Style>
      <Style Selector="^.medium /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonMedium.ContainerShapeRound}}" />
        <Setter Property="PressedCornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonMedium.PressedContainerShape}}" />
      </Style>

      <Style Selector="^.large">
        <Setter Property="Padding" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonLarge.ContentPadding}}" />
        <Setter Property="m3:MaterialText.DefaultStyle" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonLarge.LabelTextStyle}}" />
      </Style>
      <Style Selector="^.large /template/ m3|ButtonLayout">
        <Setter Property="ContainerMinHeight" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonLarge.ContainerHeight}}" />
      </Style>
      <Style Selector="^.large /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonLarge.ContainerShapeRound}}" />
        <Setter Property="PressedCornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonLarge.PressedContainerShape}}" />
      </Style>

      <Style Selector="^.xlarge">
        <Setter Property="Padding" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXLarge.ContentPadding}}" />
        <Setter Property="m3:MaterialText.DefaultStyle" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXLarge.LabelTextStyle}}" />
      </Style>
      <Style Selector="^.xlarge /template/ m3|ButtonLayout">
        <Setter Property="ContainerMinHeight" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXLarge.ContainerHeight}}" />
      </Style>
      <Style Selector="^.xlarge /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXLarge.ContainerShapeRound}}" />
        <Setter Property="PressedCornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXLarge.PressedContainerShape}}" />
      </Style>
    </ControlTheme>

    <!-- Resolve the five heights at the button. Its controller animates the Surface's value. -->
    <ControlTheme x:Key="MaterialElevatedButtonTheme" TargetType="Button"
                  BasedOn="{StaticResource MaterialFilledButtonTheme}">
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ElevatedButton.ContainerColor}}" />
      <Setter Property="Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ElevatedButton.ContentColor}}" />
      <Setter Property="m3:MaterialButton.Elevation">
        <MultiBinding Converter="{x:Static m3:ButtonElevation.FromValues}">
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ElevatedButton.ContainerElevation}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ElevatedButton.PressedContainerElevation}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ElevatedButton.FocusedContainerElevation}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ElevatedButton.HoveredContainerElevation}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ElevatedButton.DisabledContainerElevation}" />
        </MultiBinding>
      </Setter>

      <Style Selector="^ /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ElevatedButton.StateLayerColor}}" />
      </Style>
      <Style Selector="^:pointerover /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ElevatedButton.HoverStateLayerColor}}" />
      </Style>
      <Style Selector="^:focus-visible /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ElevatedButton.FocusedStateLayerColor}}" />
      </Style>
      <Style Selector="^:pressed /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ElevatedButton.PressedStateLayerColor}}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ElevatedButton.DisabledContainerColor}}" />
        <Setter Property="Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ElevatedButton.DisabledContentColor}}" />
      </Style>
    </ControlTheme>

    <!-- Tonal: secondary container with on-secondary-container content. -->
    <ControlTheme x:Key="MaterialTonalButtonTheme" TargetType="Button"
                  BasedOn="{StaticResource MaterialFilledButtonTheme}">
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TonalButton.ContainerColor}}" />
      <Setter Property="Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TonalButton.ContentColor}}" />

      <Style Selector="^ /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TonalButton.StateLayerColor}}" />
      </Style>
      <Style Selector="^:pointerover /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TonalButton.HoverStateLayerColor}}" />
      </Style>
      <Style Selector="^:focus-visible /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TonalButton.FocusedStateLayerColor}}" />
      </Style>
      <Style Selector="^:pressed /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TonalButton.PressedStateLayerColor}}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TonalButton.DisabledContainerColor}}" />
        <Setter Property="Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TonalButton.DisabledContentColor}}" />
      </Style>
    </ControlTheme>

    <!-- Outlined: transparent container, outline-variant border whose width comes from the size
           table. The disabled border is the outline color at the disabled-container opacity
           (the upstream composable's derivation, not the raw DisabledOutlineColor token). -->
    <ControlTheme x:Key="MaterialOutlinedButtonTheme" TargetType="Button"
                  BasedOn="{StaticResource MaterialFilledButtonTheme}">
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+OutlinedButton.ContainerColor}}" />
      <Setter Property="Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+OutlinedButton.ContentColor}}" />
      <Setter Property="BorderBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+OutlinedButton.OutlineColor}}" />
      <Setter Property="BorderThickness" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonSmall.OutlinedOutlineWidth}}" />

      <Style Selector="^ /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+OutlinedButton.StateLayerColor}}" />
      </Style>
      <Style Selector="^:pointerover /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+OutlinedButton.HoverStateLayerColor}}" />
      </Style>
      <Style Selector="^:focus-visible /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+OutlinedButton.FocusedStateLayerColor}}" />
      </Style>
      <Style Selector="^:pressed /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+OutlinedButton.PressedStateLayerColor}}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+OutlinedButton.DisabledContainerColor}}" />
        <Setter Property="Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+OutlinedButton.DisabledContentColor}}" />
        <Setter Property="BorderBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+OutlinedButton.DisabledOutlineColor}}" />
      </Style>

      <!-- The outline width thickens at the two largest sizes. -->
      <Style Selector="^.xsmall">
        <Setter Property="BorderThickness" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXSmall.OutlinedOutlineWidth}}" />
      </Style>
      <Style Selector="^.medium">
        <Setter Property="BorderThickness" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonMedium.OutlinedOutlineWidth}}" />
      </Style>
      <Style Selector="^.large">
        <Setter Property="BorderThickness" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonLarge.OutlinedOutlineWidth}}" />
      </Style>
      <Style Selector="^.xlarge">
        <Setter Property="BorderThickness" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXLarge.OutlinedOutlineWidth}}" />
      </Style>
    </ControlTheme>

    <!-- Text: transparent container, primary content. ContentColor follows the upstream
         composable (Primary), which overrides its own buggy LabelColor token. -->
    <ControlTheme x:Key="MaterialTextButtonTheme" TargetType="Button"
                  BasedOn="{StaticResource MaterialFilledButtonTheme}">
      <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TextButton.ContainerColor}}" />
      <Setter Property="Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TextButton.ContentColor}}" />

      <Style Selector="^ /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TextButton.StateLayerColor}}" />
      </Style>
      <Style Selector="^:pointerover /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TextButton.HoverStateLayerColor}}" />
      </Style>
      <Style Selector="^:focus-visible /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TextButton.FocusedStateLayerColor}}" />
      </Style>
      <Style Selector="^:pressed /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TextButton.PressedStateLayerColor}}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TextButton.DisabledContainerColor}}" />
        <Setter Property="Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TextButton.DisabledContentColor}}" />
      </Style>
    </ControlTheme>

    <!-- The implicit Button theme IS filled (M3 baseline). BasedOn inherits the setters and
         nested styles (StyledElement.ApplyControlTheme recurses into BasedOn first), and a
         derived theme's own setters win over the inherited ones on ties. -->
    <ControlTheme x:Key="{x:Type Button}" TargetType="Button"
                  BasedOn="{StaticResource MaterialFilledButtonTheme}" />

  </Styles.Resources>
</Styles>
