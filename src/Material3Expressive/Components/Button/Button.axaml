<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
        xmlns:ca="https://github.com/Shirasagi0012/ComposeAnimation">
  <!--
    The Button family (design doc §7.5) on its two orthogonal upstream axes:

    - Style axis: one named ControlTheme per style. The filled theme carries the template and the
      full size-class machinery; the other four are BasedOn diffs over it (colors, state-layer
      tints, outline, elevation). The implicit {x:Type Button} theme IS filled (M3 baseline).
    - Size axis: the classes xsmall / medium / large / xlarge, nested in the filled theme and
      inherited through BasedOn. No class = small. CornerRadius is configured on the owner;
      explicit local values take precedence over size-class defaults.

    Every consumed value is a comp slot (§7.1) resolved through {m3:Token}: colors/outline from
    the style table, metrics/shape/typography from the size tables, elevation as DIPs onto
    MaterialSurface.Elevation (rendered by MaterialSkiaShadow). Interactions follow the §7.4
    state-layer model with the motion slice landed: MaterialInteraction.IsInteractive opts the
    control in, and the owner's interaction controller drives the overlay — the pseudo-class
    styles here only switch StateLayerBrush (which doubles as the ripple ink color, matching
    upstream where both come from the content color), while opacity timing, press ripples and the
    optional press shape-morph are the controller's job. The focus ring is still deferred.
    Nested facade types are referenced with the XAML '+' syntax — '{x:Static}' splits the
    argument at the first dot, so 'MaterialTokens.Comp.FilledButton.X' would not resolve.
  -->
  <Styles.Resources>
    <ControlTheme x:Key="{x:Type m3:ButtonLayout}" TargetType="m3:ButtonLayout">
      <Setter Property="ContainerMinWidth" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Button.MinWidth}}" />
      <Setter Property="MinimumInteractiveSize" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Button.MinimumInteractiveSize}}" />
    </ControlTheme>

    <ControlTheme x:Key="MaterialFilledButtonTheme" TargetType="Button">
      <Setter Property="m3:MaterialInteraction.IsInteractive" Value="True" />
      <Setter Property="CornerRadius" Value="{Binding Path=(m3:ButtonThemeProperties.CornerRadius), RelativeSource={RelativeSource Self}}" />
      <Setter Property="m3:ButtonThemeProperties.CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonSmall.ContainerShapeRound}}" />
      <Setter Property="Background" Value="{Binding Path=(m3:ButtonThemeProperties.Background), RelativeSource={RelativeSource Self}}" />
      <Setter Property="m3:ButtonThemeProperties.Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledButton.ContainerColor}}" />
      <Setter Property="Foreground" Value="{Binding Path=(m3:ButtonThemeProperties.Foreground), RelativeSource={RelativeSource Self}}" />
      <Setter Property="m3:ButtonThemeProperties.Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledButton.ContentColor}}" />
      <Setter Property="Padding" Value="{Binding Path=(m3:ButtonThemeProperties.Padding), RelativeSource={RelativeSource Self}}" />
      <Setter Property="m3:ButtonThemeProperties.Padding" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonSmall.ContentPadding}}" />
      <Setter Property="m3:MaterialText.Style" Value="{Binding Path=(m3:ButtonThemeProperties.TextStyle), RelativeSource={RelativeSource Self}}" />
      <Setter Property="m3:ButtonThemeProperties.TextStyle" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonSmall.LabelTextStyle}}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="m3:MaterialButton.Elevation">
        <MultiBinding Converter="{x:Static m3:ButtonElevation.FromValues}">
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FilledButton.ContainerElevation}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FilledButton.PressedContainerElevation}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FilledButton.FocusedContainerElevation}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FilledButton.HoveredContainerElevation}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+FilledButton.DisabledContainerElevation}" />
        </MultiBinding>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <m3:ButtonLayout Width="{TemplateBinding Width}"
                           Height="{TemplateBinding Height}"
                           MinWidth="{TemplateBinding MinWidth}"
                           MinHeight="{TemplateBinding MinHeight}"
                           HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                           VerticalAlignment="{TemplateBinding VerticalAlignment}"
                           ContainerMinHeight="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonSmall.ContainerHeight}}">
            <!-- TextElement.Foreground re-asserts the owner's content color onto the part:
                 a standalone MaterialSurface gets TextElement.Foreground from its implicit theme,
                 and any set value there would shadow the Button.Foreground inheritance. Template
                 priority beats the theme frame, so this mirrors Compose's "Button passes its
                 contentColor into Surface". -->
            <m3:MaterialSurface x:Name="PART_Container"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                PressedCornerRadius="{TemplateBinding m3:MaterialButton.PressedCornerRadius}">
              <m3:ButtonContentRow FillContentWhenNoIcon="True"
                                   IconSize="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonSmall.IconSize}}"
                                   IconSpacing="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonSmall.IconLabelSpace}}">
                <!-- Keep the label presenter first for existing template consumers and preserve
                     its full allocation when no icon is set. -->
                <m3:ButtonContentPresenter x:Name="PART_ContentPresenter"
                                           Content="{TemplateBinding Content}"
                                           ContentTemplate="{TemplateBinding ContentTemplate}"
                                           Padding="{TemplateBinding Padding}"
                                           HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                           TextWrapping="Wrap"
                                           />
                <ContentPresenter x:Name="PART_IconPresenter"
                                  Content="{TemplateBinding m3:MaterialButton.Icon}"
                                  ContentTemplate="{TemplateBinding m3:MaterialButton.IconTemplate}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  m3:MaterialIcon.DefaultSize="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonSmall.IconSize}}" />
                <!-- Internal trailing icon box, bare on purpose: no bindings or token values, so
                     buttons other than DropDownButton only carry an empty zero-size presenter.
                     The global DropDownButton styles at the end of this file fill it. -->
                <ContentPresenter x:Name="PART_TrailingIconPresenter" />
              </m3:ButtonContentRow>
            </m3:MaterialSurface>
          </m3:ButtonLayout>
        </ControlTemplate>
      </Setter>


      <!-- §7.4 with the motion slice: the controller owns state-layer opacity and the press ripple,
           so pseudo-class styles only pick the layer's color. Later selectors win on ties, so the
           declaration order hover < focus < pressed is load-bearing: pressed must beat hover when
           both pseudo-classes are active, because its brush is the ripple ink. BasedOn variants
           re-declare the StateLayerBrush setters with their own slots. -->
      <Style Selector="^ /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledButton.StateLayerColor}}" />
      </Style>
      <Style Selector="^:pointerover /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledButton.HoverStateLayerColor}}" />
      </Style>
      <Style Selector="^:focus-visible /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledButton.FocusedStateLayerColor}}" />
      </Style>
      <Style Selector="^:pressed /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledButton.PressedStateLayerColor}}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="m3:ButtonThemeProperties.Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledButton.DisabledContainerColor}}" />
        <Setter Property="m3:ButtonThemeProperties.Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+FilledButton.DisabledContentColor}}" />
      </Style>

      <!-- Size axis. Metrics come from each size table; outlinedButtonBorder uses the small width. -->
      <Style Selector="^.xsmall">
        <Setter Property="m3:ButtonThemeProperties.CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXSmall.ContainerShapeRound}}" />
        <Setter Property="m3:ButtonThemeProperties.Padding" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXSmall.ContentPadding}}" />
        <Setter Property="m3:ButtonThemeProperties.TextStyle" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXSmall.LabelTextStyle}}" />
      </Style>
      <Style Selector="^.xsmall /template/ m3|ButtonLayout">
        <Setter Property="ContainerMinHeight" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXSmall.ContainerHeight}}" />
      </Style>
      <Style Selector="^.xsmall /template/ m3|ButtonContentRow">
        <Setter Property="IconSize" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXSmall.IconSize}}" />
        <Setter Property="IconSpacing" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ToggleButton.ExtraSmallIconSpacing}}" />
      </Style>
      <Style Selector="^.xsmall /template/ ContentPresenter#PART_IconPresenter"><Setter Property="m3:MaterialIcon.DefaultSize" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXSmall.IconSize}}" /></Style>

      <Style Selector="^.medium">
        <Setter Property="m3:ButtonThemeProperties.CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonMedium.ContainerShapeRound}}" />
        <Setter Property="m3:ButtonThemeProperties.Padding" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonMedium.ContentPadding}}" />
        <Setter Property="m3:ButtonThemeProperties.TextStyle" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonMedium.LabelTextStyle}}" />
      </Style>
      <Style Selector="^.medium /template/ m3|ButtonLayout">
        <Setter Property="ContainerMinHeight" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonMedium.ContainerHeight}}" />
      </Style>
      <Style Selector="^.medium /template/ m3|ButtonContentRow">
        <Setter Property="IconSize" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonMedium.IconSize}}" />
        <Setter Property="IconSpacing" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonMedium.IconLabelSpace}}" />
      </Style>
      <Style Selector="^.medium /template/ ContentPresenter#PART_IconPresenter"><Setter Property="m3:MaterialIcon.DefaultSize" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonMedium.IconSize}}" /></Style>

      <Style Selector="^.large">
        <Setter Property="m3:ButtonThemeProperties.CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonLarge.ContainerShapeRound}}" />
        <Setter Property="m3:ButtonThemeProperties.Padding" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonLarge.ContentPadding}}" />
        <Setter Property="m3:ButtonThemeProperties.TextStyle" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonLarge.LabelTextStyle}}" />
      </Style>
      <Style Selector="^.large /template/ m3|ButtonLayout">
        <Setter Property="ContainerMinHeight" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonLarge.ContainerHeight}}" />
      </Style>
      <Style Selector="^.large /template/ m3|ButtonContentRow">
        <Setter Property="IconSize" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonLarge.IconSize}}" />
        <Setter Property="IconSpacing" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonLarge.IconLabelSpace}}" />
      </Style>
      <Style Selector="^.large /template/ ContentPresenter#PART_IconPresenter"><Setter Property="m3:MaterialIcon.DefaultSize" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonLarge.IconSize}}" /></Style>

      <Style Selector="^.xlarge">
        <Setter Property="m3:ButtonThemeProperties.CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXLarge.ContainerShapeRound}}" />
        <Setter Property="m3:ButtonThemeProperties.Padding" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXLarge.ContentPadding}}" />
        <Setter Property="m3:ButtonThemeProperties.TextStyle" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXLarge.LabelTextStyle}}" />
      </Style>
      <Style Selector="^.xlarge /template/ m3|ButtonLayout">
        <Setter Property="ContainerMinHeight" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXLarge.ContainerHeight}}" />
      </Style>
      <Style Selector="^.xlarge /template/ m3|ButtonContentRow">
        <Setter Property="IconSize" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXLarge.IconSize}}" />
        <Setter Property="IconSpacing" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXLarge.IconLabelSpace}}" />
      </Style>
      <Style Selector="^.xlarge /template/ ContentPresenter#PART_IconPresenter"><Setter Property="m3:MaterialIcon.DefaultSize" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXLarge.IconSize}}" /></Style>
    </ControlTheme>

    <!-- Resolve the five heights at the button. Its controller animates the Surface's value. -->
    <ControlTheme x:Key="MaterialElevatedButtonTheme" TargetType="Button"
                  BasedOn="{StaticResource MaterialFilledButtonTheme}">
      <Setter Property="Background" Value="{Binding Path=(m3:ButtonThemeProperties.Background), RelativeSource={RelativeSource Self}}" />
      <Setter Property="m3:ButtonThemeProperties.Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ElevatedButton.ContainerColor}}" />
      <Setter Property="Foreground" Value="{Binding Path=(m3:ButtonThemeProperties.Foreground), RelativeSource={RelativeSource Self}}" />
      <Setter Property="m3:ButtonThemeProperties.Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ElevatedButton.ContentColor}}" />
      <Setter Property="m3:MaterialButton.Elevation">
        <MultiBinding Converter="{x:Static m3:ButtonElevation.FromValues}">
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ElevatedButton.ContainerElevation}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ElevatedButton.PressedContainerElevation}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ElevatedButton.FocusedContainerElevation}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ElevatedButton.HoveredContainerElevation}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+ElevatedButton.DisabledContainerElevation}" />
        </MultiBinding>
      </Setter>

      <Style Selector="^ /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ElevatedButton.StateLayerColor}}" />
      </Style>
      <Style Selector="^:pointerover /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ElevatedButton.HoverStateLayerColor}}" />
      </Style>
      <Style Selector="^:focus-visible /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ElevatedButton.FocusedStateLayerColor}}" />
      </Style>
      <Style Selector="^:pressed /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ElevatedButton.PressedStateLayerColor}}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="m3:ButtonThemeProperties.Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ElevatedButton.DisabledContainerColor}}" />
        <Setter Property="m3:ButtonThemeProperties.Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ElevatedButton.DisabledContentColor}}" />
      </Style>
    </ControlTheme>

    <!-- Tonal: secondary container with on-secondary-container content. -->
    <ControlTheme x:Key="MaterialTonalButtonTheme" TargetType="Button"
                  BasedOn="{StaticResource MaterialFilledButtonTheme}">
      <Setter Property="Background" Value="{Binding Path=(m3:ButtonThemeProperties.Background), RelativeSource={RelativeSource Self}}" />
      <Setter Property="m3:ButtonThemeProperties.Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TonalButton.ContainerColor}}" />
      <Setter Property="Foreground" Value="{Binding Path=(m3:ButtonThemeProperties.Foreground), RelativeSource={RelativeSource Self}}" />
      <Setter Property="m3:ButtonThemeProperties.Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TonalButton.ContentColor}}" />
      <Setter Property="m3:MaterialButton.Elevation">
        <MultiBinding Converter="{x:Static m3:ButtonElevation.FromValues}">
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+TonalButton.ContainerElevation}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+TonalButton.PressedContainerElevation}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+TonalButton.FocusedContainerElevation}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+TonalButton.HoveredContainerElevation}" />
          <m3:Token Key="{x:Static m3:MaterialTokens+Comp+TonalButton.DisabledContainerElevation}" />
        </MultiBinding>
      </Setter>

      <Style Selector="^ /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TonalButton.StateLayerColor}}" />
      </Style>
      <Style Selector="^:pointerover /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TonalButton.HoverStateLayerColor}}" />
      </Style>
      <Style Selector="^:focus-visible /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TonalButton.FocusedStateLayerColor}}" />
      </Style>
      <Style Selector="^:pressed /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TonalButton.PressedStateLayerColor}}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="m3:ButtonThemeProperties.Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TonalButton.DisabledContainerColor}}" />
        <Setter Property="m3:ButtonThemeProperties.Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TonalButton.DisabledContentColor}}" />
      </Style>
    </ControlTheme>

    <!-- Outlined: transparent container, outline-variant border whose width comes from the size
           table. The disabled border is the outline color at the disabled-container opacity
           (the upstream composable's derivation, not the raw DisabledOutlineColor token). -->
    <ControlTheme x:Key="MaterialOutlinedButtonTheme" TargetType="Button"
                  BasedOn="{StaticResource MaterialFilledButtonTheme}">
      <Setter Property="Background" Value="{Binding Path=(m3:ButtonThemeProperties.Background), RelativeSource={RelativeSource Self}}" />
      <Setter Property="m3:ButtonThemeProperties.Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+OutlinedButton.ContainerColor}}" />
      <Setter Property="Foreground" Value="{Binding Path=(m3:ButtonThemeProperties.Foreground), RelativeSource={RelativeSource Self}}" />
      <Setter Property="m3:ButtonThemeProperties.Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+OutlinedButton.ContentColor}}" />
      <Setter Property="m3:MaterialButton.Elevation" Value="{x:Null}" />
      <Setter Property="BorderBrush" Value="{Binding Path=(m3:ButtonThemeProperties.BorderBrush), RelativeSource={RelativeSource Self}}" />
      <Setter Property="m3:ButtonThemeProperties.BorderBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+OutlinedButton.OutlineColor}}" />
      <Setter Property="BorderThickness" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonSmall.OutlinedOutlineWidth}}" />

      <Style Selector="^ /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+OutlinedButton.StateLayerColor}}" />
      </Style>
      <Style Selector="^:pointerover /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+OutlinedButton.HoverStateLayerColor}}" />
      </Style>
      <Style Selector="^:focus-visible /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+OutlinedButton.FocusedStateLayerColor}}" />
      </Style>
      <Style Selector="^:pressed /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+OutlinedButton.PressedStateLayerColor}}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="m3:ButtonThemeProperties.Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+OutlinedButton.DisabledContainerColor}}" />
        <Setter Property="m3:ButtonThemeProperties.Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+OutlinedButton.DisabledContentColor}}" />
        <Setter Property="m3:ButtonThemeProperties.BorderBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+OutlinedButton.DisabledOutlineColor}}" />
      </Style>

    </ControlTheme>

    <!-- Text: transparent container, primary content. ContentColor follows the upstream
         composable (Primary), which overrides its own buggy LabelColor token. -->
    <ControlTheme x:Key="MaterialTextButtonTheme" TargetType="Button"
                  BasedOn="{StaticResource MaterialFilledButtonTheme}">
      <Setter Property="Background" Value="{Binding Path=(m3:ButtonThemeProperties.Background), RelativeSource={RelativeSource Self}}" />
      <Setter Property="m3:ButtonThemeProperties.Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TextButton.ContainerColor}}" />
      <Setter Property="Foreground" Value="{Binding Path=(m3:ButtonThemeProperties.Foreground), RelativeSource={RelativeSource Self}}" />
      <Setter Property="m3:ButtonThemeProperties.Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TextButton.ContentColor}}" />
      <Setter Property="m3:MaterialButton.Elevation" Value="{x:Null}" />

      <Style Selector="^ /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TextButton.StateLayerColor}}" />
      </Style>
      <Style Selector="^:pointerover /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TextButton.HoverStateLayerColor}}" />
      </Style>
      <Style Selector="^:focus-visible /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TextButton.FocusedStateLayerColor}}" />
      </Style>
      <Style Selector="^:pressed /template/ m3|MaterialSurface#PART_Container">
        <Setter Property="StateLayerBrush" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TextButton.PressedStateLayerColor}}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="m3:ButtonThemeProperties.Background" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TextButton.DisabledContainerColor}}" />
        <Setter Property="m3:ButtonThemeProperties.Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+TextButton.DisabledContentColor}}" />
      </Style>
    </ControlTheme>

    <!-- The implicit Button theme IS filled (M3 baseline). BasedOn inherits the setters and
         nested styles (StyledElement.ApplyControlTheme recurses into BasedOn first), and a
         derived theme's own setters win over the inherited ones on ties. -->
    <ControlTheme x:Key="{x:Type Button}" TargetType="Button"
                  BasedOn="{StaticResource MaterialFilledButtonTheme}" />

    <!-- RepeatButton is a Button: the same filled default, and every keyed Button theme and size
         class applies to it unchanged. Delay / Interval repetition stays native; it stops when
         IsPressed clears, which the shared interaction does on release, capture loss, and on
         leaving the bounds while held. Template parts that name a RepeatButton theme explicitly
         (ScrollBar, ButtonSpinner, Fluent pickers) are unaffected. -->
    <ControlTheme x:Key="{x:Type RepeatButton}" TargetType="RepeatButton"
                  BasedOn="{StaticResource MaterialFilledButtonTheme}" />

    <!-- HyperlinkButton: M3 has no link button, so it is the Text button with an underlined label.
         The underline is inherited from the label presenter only, so string labels and custom
         label content get it while the icon slot does not. M3 has no visited color: :visited
         toggles natively and keeps the same look. NavigateUri launching stays native. -->
    <ControlTheme x:Key="{x:Type HyperlinkButton}" TargetType="HyperlinkButton"
                  BasedOn="{StaticResource MaterialTextButtonTheme}">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextBlock.TextDecorations" Value="Underline" />
      </Style>
    </ControlTheme>

    <!-- DropDownButton: M3 has no dropdown button, so it is the Filled button. Its chevron is not
         part of any ControlTheme; see the DropDownButton styles below. -->
    <ControlTheme x:Key="{x:Type DropDownButton}" TargetType="DropDownButton"
                  BasedOn="{StaticResource MaterialFilledButtonTheme}" />

  </Styles.Resources>

  <!-- DropDownButton's trailing keyboard_arrow_down chevron, as global type-selector styles rather
       than ControlTheme styles: they apply whichever Button theme is set (the implicit one, any
       keyed variant, or a runtime switch between them), and no Button theme knows about the
       subclass. They fill the shared template's empty PART_TrailingIconPresenter, so a custom
       template without that part simply gets no chevron. Size and spacing follow the leading icon:
       ButtonContentRow already gives the trailing box IconSize/IconSpacing, and DefaultSize below
       repeats the leading icon's per-size tokens. Color is the inherited content color.
       While the flyout is open the angle targets 180; the declaration's default spring is Compose's
       spring(), the animateFloatAsState spec upstream's SplitButtonSamples use for the same
       trailing-chevron rotation. -->
  <Style Selector="DropDownButton /template/ ContentPresenter#PART_TrailingIconPresenter">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="m3:MaterialIcon.DefaultSize" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonSmall.IconSize}}" />
    <Setter Property="ContentTemplate">
      <DataTemplate>
        <m3:MaterialSymbol Symbol="KeyboardArrowDown" />
      </DataTemplate>
    </Setter>
    <Setter Property="m3:ChevronRotation.Angle" Value="0" />
    <Setter Property="ca:Animated.Properties">
      <ca:AnimatedPropertyCollection>
        <ca:AnimatedDouble Property="{x:Static m3:ChevronRotation.AngleProperty}" />
      </ca:AnimatedPropertyCollection>
    </Setter>
  </Style>
  <Style Selector="DropDownButton:flyout-open /template/ ContentPresenter#PART_TrailingIconPresenter">
    <Setter Property="m3:ChevronRotation.Angle" Value="180" />
  </Style>
  <Style Selector="DropDownButton.xsmall /template/ ContentPresenter#PART_TrailingIconPresenter">
    <Setter Property="m3:MaterialIcon.DefaultSize" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonXSmall.IconSize}}" />
  </Style>
  <Style Selector="DropDownButton.medium /template/ ContentPresenter#PART_TrailingIconPresenter">
    <Setter Property="m3:MaterialIcon.DefaultSize" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+ButtonMedium.IconSize}}" />
  </Style>
  <Style Selector="DropDownButton.large /template/ ContentPresenter#PART_TrailingIconPresenter">
