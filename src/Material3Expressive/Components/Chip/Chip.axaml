<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">
  <Styles.Resources>
    <ControlTheme x:Key="MaterialChipTheme" TargetType="m3:Chip">
      <Setter Property="m3:MaterialInteraction.IsInteractive" Value="True" />
      <Setter Property="CornerRadius" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Chip.ContainerShape}}" />
      <Setter Property="m3:MaterialText.DefaultStyle" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Chip.LabelTextStyle}}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <m3:ChipLayout Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
              MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}" HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
              VerticalAlignment="{TemplateBinding VerticalAlignment}"
              ContainerMinHeight="{m3:Token {x:Static m3:MaterialTokens+Comp+Chip.ContainerHeight}}">
            <m3:MaterialSurface x:Name="PART_Container" Background="{TemplateBinding Background}"
                StateLayerBrush="{m3:ContentColorFor AmbientContentColor={Binding Parent.(TextElement.Foreground), RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type m3:Chip}}}}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                TextElement.Foreground="{TemplateBinding Foreground}">
              <Border Padding="{TemplateBinding Padding}">
                <m3:ChipContentLayout x:Name="PART_Layout">
                  <m3:ChipIconSlot x:Name="PART_LeadingIcon">
                    <Border RenderOptions.RequiresFullOpacityHandling="True"><ContentPresenter /></Border>
                  </m3:ChipIconSlot>
                  <m3:ButtonContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                      ContentTemplate="{TemplateBinding ContentTemplate}" TextWrapping="Wrap"
                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" m3:TextStyleHost.IsEnabled="True" />
                  <m3:ChipIconSlot x:Name="PART_TrailingIcon">
                    <Border RenderOptions.RequiresFullOpacityHandling="True"><ContentPresenter /></Border>
                  </m3:ChipIconSlot>
                </m3:ChipContentLayout>
              </Border>
            </m3:MaterialSurface>
          </m3:ChipLayout>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m3:AssistChip}" TargetType="m3:AssistChip" BasedOn="{StaticResource MaterialChipTheme}" />
    <ControlTheme x:Key="{x:Type m3:SuggestionChip}" TargetType="m3:SuggestionChip" BasedOn="{StaticResource MaterialChipTheme}" />
    <ControlTheme x:Key="{x:Type m3:FilterChip}" TargetType="m3:FilterChip" BasedOn="{StaticResource MaterialChipTheme}" />
    <ControlTheme x:Key="{x:Type m3:InputChip}" TargetType="m3:InputChip" BasedOn="{StaticResource MaterialChipTheme}" />
  </Styles.Resources>
</Styles>
