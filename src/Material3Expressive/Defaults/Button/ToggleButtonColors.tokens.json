{
  "kind": "componentDefaults",
  "name": "ToggleButtonColorTokens",
  "namespace": "Material3Expressive.Foundation",
  "resolvedName": "ToggleButtonColors",
  "version": "v0_11_0",
  "source": "androidx compose/material3 ToggleButtonDefaults, assembled from Button tokens",
  "summary": "The independent checked, unchecked and disabled colours of one toggle button variant.",

  // ToggleButton owns a six-colour state contract rather than reusing ButtonColors' selected
  // fields. The state layer is selected in Controls/Button C# from the active content colour.
  "variantEnum": "ToggleButtonVariant",
  "variantEnumSummary": "The button colour families available to a toggle button.",

  "properties": {
    "UncheckedContainerColor": { "type": "color", "summary": "The enabled unchecked container." },
    "UncheckedContentColor": { "type": "color", "summary": "The enabled unchecked content." },
    "CheckedContainerColor": { "type": "color", "summary": "The enabled checked container." },
    "CheckedContentColor": { "type": "color", "summary": "The enabled checked content." },
    "DisabledContainerColor": { "type": "color", "opacity": "DisabledContainerOpacity", "summary": "The disabled container." },
    "DisabledContainerOpacity": { "type": "opacity" },
    "DisabledContentColor": { "type": "color", "opacity": "DisabledContentOpacity", "summary": "The disabled content." },
    "DisabledContentOpacity": { "type": "opacity" },
    "OutlineColor": { "type": "color", "summary": "The unchecked outline." },
    "DisabledOutlineColor": { "type": "color", "summary": "The disabled outline." },
    "HasOutline": { "type": "bool", "summary": "Whether the unchecked state draws an outline." }
  },

  "sets": [
    {
      "name": "Filled",
      "values": {
        "UncheckedContainerColor": "@FilledButtonTokens.UnselectedContainerColor",
        "UncheckedContentColor": "@FilledButtonTokens.LabelTextUnselectedColor",
        "CheckedContainerColor": "@FilledButtonTokens.SelectedContainerColor",
        "CheckedContentColor": "@FilledButtonTokens.LabelTextSelectedColor",
        "DisabledContainerColor": "@FilledButtonTokens.DisabledContainerColor",
        "DisabledContainerOpacity": "@FilledButtonTokens.DisabledContainerOpacity",
        "DisabledContentColor": "@FilledButtonTokens.DisabledLabelTextColor",
        "DisabledContentOpacity": "@FilledButtonTokens.DisabledLabelTextOpacity",
        "OutlineColor": "#00000000",
        "DisabledOutlineColor": "#00000000",
        "HasOutline": false
      }
    },
    {
      "name": "Tonal",
      "values": {
        "UncheckedContainerColor": "@TonalButtonTokens.UnselectedContainerColor",
        "UncheckedContentColor": "@TonalButtonTokens.UnselectedLabelTextColor",
        "CheckedContainerColor": "@TonalButtonTokens.SelectedContainerColor",
        "CheckedContentColor": "@TonalButtonTokens.SelectedLabelTextColor",
        "DisabledContainerColor": "@TonalButtonTokens.DisabledContainerColor",
        "DisabledContainerOpacity": "@TonalButtonTokens.DisabledContainerOpacity",
        "DisabledContentColor": "@TonalButtonTokens.DisabledLabelTextColor",
        "DisabledContentOpacity": "@TonalButtonTokens.DisabledLabelTextOpacity",
        "OutlineColor": "#00000000",
        "DisabledOutlineColor": "#00000000",
        "HasOutline": false
      }
    },
    {
      "name": "Elevated",
      "values": {
        "UncheckedContainerColor": "@ElevatedButtonTokens.UnselectedContainerColor",
        "UncheckedContentColor": "@ElevatedButtonTokens.LabelTextUnselectedColor",
        "CheckedContainerColor": "@ElevatedButtonTokens.SelectedContainerColor",
        "CheckedContentColor": "@ElevatedButtonTokens.LabelTextSelectedColor",
        "DisabledContainerColor": "@ElevatedButtonTokens.DisabledContainerColor",
        "DisabledContainerOpacity": "@ElevatedButtonTokens.DisabledContainerOpacity",
        "DisabledContentColor": "@ElevatedButtonTokens.DisabledLabelTextColor",
        "DisabledContentOpacity": "@ElevatedButtonTokens.DisabledLabelTextOpacity",
        "OutlineColor": "#00000000",
        "DisabledOutlineColor": "#00000000",
        "HasOutline": false
      }
    },
    {
      "name": "Outlined",
      "values": {
        "UncheckedContainerColor": "#00000000",
        "UncheckedContentColor": "@OutlinedButtonTokens.UnselectedLabelTextColor",
        "CheckedContainerColor": "@OutlinedButtonTokens.SelectedContainerColor",
        "CheckedContentColor": "@OutlinedButtonTokens.SelectedLabelTextColor",
        "DisabledContainerColor": "#00000000",
        "DisabledContainerOpacity": "@OutlinedButtonTokens.DisabledContainerOpacity",
        "DisabledContentColor": "@OutlinedButtonTokens.DisabledLabelTextColor",
        "DisabledContentOpacity": "@OutlinedButtonTokens.DisabledLabelTextOpacity",
        "OutlineColor": "@OutlinedButtonTokens.OutlineColor",
        "DisabledOutlineColor": "@OutlinedButtonTokens.DisabledOutlineColor",
        "HasOutline": true
      }
    },
    {
      "name": "Text",
      "values": {
        "UncheckedContainerColor": "#00000000",
        "UncheckedContentColor": "Primary",
        "CheckedContainerColor": "#00000000",
        "CheckedContentColor": "Primary",
        "DisabledContainerColor": "#00000000",
        "DisabledContainerOpacity": 0.1,
        "DisabledContentColor": "@TextButtonTokens.DisabledLabelColor",
        "DisabledContentOpacity": "@TextButtonTokens.DisabledLabelOpacity",
        "OutlineColor": "#00000000",
        "DisabledOutlineColor": "#00000000",
        "HasOutline": false
      }
    }
  ]
}
