        "ActiveLabelTextColor": "Secondary",
        "InactiveIconColor": "OnSurfaceVariant",
        "InactiveLabelTextColor": "OnSurfaceVariant",
        "StateLayerColor": "OnSurface",

        "ContainerElevation": "@ElevationTokens.Level2",
        "ContainerSize": 80,
        "ActiveIndicatorWidth": 56,
        "ActiveIndicatorHeight": 32,
        "ActiveIndicatorShape": "CornerFull",
        "IconSize": 24,
        "IconLabelSpace": 4,
        "ItemBetweenSpace": 0,
        "LabelTextStyle": "LabelMedium",
