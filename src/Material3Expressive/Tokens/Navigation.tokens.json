  "version": "v0_11_0",
  "source": "androidx compose/material3 tokens/NavigationBarTokens.kt, NavigationBarVerticalItemTokens.kt, NavigationRailCollapsedTokens.kt",
  "summary": "A navigation surface and its items, whether it runs along the bottom or up the side.",

  "variantEnum": "NavigationVariant",
