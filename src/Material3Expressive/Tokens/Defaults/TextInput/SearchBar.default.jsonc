{
  "kind": "componentDefaults",
 "name": "SearchBarDefaultsTokens",
  "overridesName": "SearchBarOverrides",
  "namespace": "Material3Expressive.Foundation",
  "resolvedName": "SearchBarColors",
  "version": "v0_210",
  "source": "androidx compose/material3 tokens/SearchBarTokens.kt and SearchViewTokens.kt",
  "summary": "A search bar, and the results surface it opens into.",

  "properties": {
    "ContainerColor": { "type": "color", "summary": "The bar surface." },
    "InputTextColor": { "type": "color", "summary": "What the user is typing." },
    "SupportingTextColor": { "type": "color", "summary": "The placeholder." },
    "LeadingIconColor": { "type": "color", "summary": "The search or back icon." },
    "TrailingIconColor": { "type": "color", "summary": "The clear or avatar slot." },
    "ResultsContainerColor": { "type": "color", "summary": "The results surface." },
    "DividerColor": { "type": "color", "summary": "The rule between the bar and its results." },

    "ContainerElevation": { "type": "elevation", "summary": "The bar shadow." },
    "ContainerHeight": { "type": "dimension", "summary": "The bar height." },
    "ContainerShape": { "type": "shape", "summary": "The bar corners — a pill until it opens." },
    "ResultsContainerShape": { "type": "shape", "summary": "The docked results surface." },
    "HorizontalSpace": { "type": "dimension", "summary": "Padding at each end." },
    "IconSize": { "type": "dimension", "summary": "The leading and trailing icons." },
    "IconLabelSpace": { "type": "dimension", "summary": "The gap between an icon and the input." },
    "DividerHeight": { "type": "dimension", "summary": "The rule." },
    "InputTextStyle": { "type": "typography", "summary": "The input and the placeholder." }
  },

  "sets": [
    {
      "name": "Default",
      "values": {
        "ContainerColor": "@SearchBarTokens.ContainerColor",
        "InputTextColor": "@SearchBarTokens.InputTextColor",
        "SupportingTextColor": "@SearchBarTokens.SupportingTextColor",
        "LeadingIconColor": "@SearchBarTokens.LeadingIconColor",
        "TrailingIconColor": "@SearchBarTokens.TrailingIconColor",
        "ResultsContainerColor": "@SearchViewTokens.ContainerColor",
        "DividerColor": "@SearchViewTokens.DividerColor",

        "ContainerElevation": "@SearchBarTokens.ContainerElevation",
        "ContainerHeight": "@SearchBarTokens.ContainerHeight",
        "ContainerShape": "@SearchBarTokens.ContainerShape",
        "ResultsContainerShape": "@SearchViewTokens.DockedContainerShape",
        "HorizontalSpace": 16,
        "IconSize": 24,
        "IconLabelSpace": 16,
        "DividerHeight": 1,
        "InputTextStyle": "@SearchBarTokens.InputTextFont"
      }
    }
  ]
}
