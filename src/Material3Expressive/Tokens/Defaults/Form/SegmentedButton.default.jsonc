{
  "kind": "componentDefaults",
  "name": "SegmentedButtonTokens",
  "namespace": "Material3Expressive.Foundation",
  "resolvedName": "SegmentedButtonColors",
  "version": "v0_162",
  "source": "androidx compose/material3 tokens/OutlinedSegmentedButtonTokens.kt and material3/SegmentedButton.kt (ContentPadding delegates to ButtonDefaults.ContentPadding)",
  "summary": "The shared dimensions, shape, typography, and state colours for Material segmented buttons.",

  "properties": {
    "ContainerHeight": { "type": "dimension", "summary": "The row's minimum container height." },
    "ContainerShape": { "type": "shape", "summary": "The full shape applied to a single or outer segment." },
    "LabelTextStyle": { "type": "typography", "summary": "The label type scale." },
    "IconSize": { "type": "dimension", "summary": "The icon slot size." },
    "IconSpacing": { "type": "dimension", "summary": "The gap between the icon slot and label." },
    "HorizontalContentPadding": { "type": "dimension", "summary": "The horizontal content padding." },
    "VerticalContentPadding": { "type": "dimension", "summary": "The vertical content padding inherited from ButtonDefaults." },
    "OutlineWidth": { "type": "dimension", "summary": "The segment outline width and default overlap." },
    "ActiveContainerColor": { "type": "color", "summary": "The selected container." },
    "ActiveContentColor": { "type": "color", "summary": "The selected label and icon." },
    "BorderColor": { "type": "color", "summary": "The enabled outline." },
    "InactiveContainerColor": { "type": "color", "summary": "The unselected transparent container." },
    "InactiveContentColor": { "type": "color", "summary": "The unselected label and icon." },
    "DisabledActiveContainerColor": { "type": "color", "summary": "The disabled selected container." },
    "DisabledActiveContentColor": { "type": "color", "opacity": "DisabledContentOpacity", "summary": "The disabled selected label and icon." },
    "DisabledInactiveContainerColor": { "type": "color", "summary": "The disabled unselected transparent container." },
    "DisabledInactiveContentColor": { "type": "color", "opacity": "DisabledContentOpacity", "summary": "The disabled unselected label and icon." },
    "DisabledBorderColor": { "type": "color", "opacity": "DisabledBorderOpacity", "summary": "The disabled outline." },
    "DisabledContentOpacity": { "type": "opacity", "summary": "The disabled label/icon opacity." },
    "DisabledBorderOpacity": { "type": "opacity", "summary": "The disabled outline opacity." }
  },

  "sets": [
    {
      "name": "Default",
      "summary": "Outlined segmented-button defaults from the alpha25 implementation.",
      "values": {
        "ContainerHeight": "@OutlinedSegmentedButtonTokens.ContainerHeight",
        "ContainerShape": "@OutlinedSegmentedButtonTokens.Shape",
        "LabelTextStyle": "@OutlinedSegmentedButtonTokens.LabelTextFont",
        "IconSize": "@OutlinedSegmentedButtonTokens.IconSize",
        "IconSpacing": 8,
        "HorizontalContentPadding": 12,
        "VerticalContentPadding": 8,
        "OutlineWidth": "@OutlinedSegmentedButtonTokens.OutlineWidth",
        "ActiveContainerColor": "@OutlinedSegmentedButtonTokens.SelectedContainerColor",
        "ActiveContentColor": "@OutlinedSegmentedButtonTokens.SelectedLabelTextColor",
        "BorderColor": "@OutlinedSegmentedButtonTokens.OutlineColor",
        "InactiveContainerColor": "#00000000",
        "InactiveContentColor": "@OutlinedSegmentedButtonTokens.UnselectedLabelTextColor",
        "DisabledActiveContainerColor": "@OutlinedSegmentedButtonTokens.SelectedContainerColor",
        "DisabledActiveContentColor": "@OutlinedSegmentedButtonTokens.DisabledLabelTextColor",
        "DisabledInactiveContainerColor": "#00000000",
        "DisabledInactiveContentColor": "@OutlinedSegmentedButtonTokens.DisabledLabelTextColor",
        "DisabledBorderColor": "@OutlinedSegmentedButtonTokens.DisabledOutlineColor",
        "DisabledContentOpacity": "@OutlinedSegmentedButtonTokens.DisabledLabelTextOpacity",
        "DisabledBorderOpacity": "@OutlinedSegmentedButtonTokens.DisabledOutlineOpacity"
      }
    }
  ]
}
