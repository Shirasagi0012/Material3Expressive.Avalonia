{
  "kind": "componentDefaults",
  "name": "ChipTokens",
  "namespace": "Material3Expressive.Foundation",
  "resolvedName": "ChipColors",
  "version": "7_0_1",
  "source": "androidx compose/material3 tokens/{Chips,AssistChip,FilterChip,InputChip,SuggestionChip}Tokens.kt",
  "summary": "The colours and metrics of one chip variant.",

  "variantEnum": "ChipVariant",
  "variantEnumSummary": "The four chip kinds. They differ in what they mean, and the colours follow.",

  "properties": {
    "ContainerColor": { "type": "color", "summary": "The chip's fill when unselected — transparent for the flat kinds." },
    "LabelTextColor": { "type": "color", "summary": "The label." },
    "LeadingIconColor": { "type": "color", "summary": "An icon before the label." },
    "TrailingIconColor": { "type": "color", "summary": "An icon after the label, usually a dismiss affordance." },
    "OutlineColor": { "type": "color", "summary": "The border." },
    "StateLayerColor": { "type": "color", "summary": "The state layer, which is the label colour." },

    "SelectedContainerColor": { "type": "color", "summary": "The fill once selected." },
    "SelectedLabelTextColor": { "type": "color", "summary": "The label once selected." },
    "SelectedIconColor": { "type": "color", "summary": "Icons once selected." },

    "DisabledContainerColor": { "type": "color", "opacity": "DisabledContainerOpacity", "summary": "The fill when disabled." },
    "DisabledLabelTextColor": { "type": "color", "opacity": "DisabledLabelTextOpacity", "summary": "The label when disabled." },
    "DisabledIconColor": { "type": "color", "opacity": "DisabledLabelTextOpacity", "summary": "Icons when disabled." },
    "DisabledOutlineColor": { "type": "color", "opacity": "DisabledOutlineOpacity", "summary": "The border when disabled." },
    "DisabledContainerOpacity": { "type": "opacity", "summary": "Alpha applied to the disabled fill." },
    "DisabledLabelTextOpacity": { "type": "opacity", "summary": "Alpha applied to disabled text and icons." },
    "DisabledOutlineOpacity": { "type": "opacity", "summary": "Alpha applied to the disabled border." },

    "ContainerHeight": { "type": "dimension", "summary": "The chip's height." },
    "ContainerShape": { "type": "shape", "summary": "The chip's corners when unselected." },
    "SelectedContainerShape": { "type": "shape", "summary": "The chip's corners once selected — Expressive rounds it fully." },
    "OutlineWidth": { "type": "dimension", "summary": "The border, which vanishes once the chip is filled." },
    "IconSize": { "type": "dimension", "summary": "Leading and trailing icons." },
    "HorizontalSpace": { "type": "dimension", "summary": "Padding at each end." },
    "IconLabelSpace": { "type": "dimension", "summary": "The gap between an icon and the label." },
    "LabelTextStyle": { "type": "typography", "summary": "The label's type scale." },
    "IsSelectable": { "type": "bool", "summary": "Whether this kind carries a selected state at all." }
  },

  "sets": [
    {
      "name": "Assist",
      "summary": "Suggests an action related to the content it sits with.",
      "values": {
        "ContainerColor": "#00000000",
        "LabelTextColor": "@AssistChipTokens.LabelTextColor",
        "LeadingIconColor": "@AssistChipTokens.IconColor",
        "TrailingIconColor": "@AssistChipTokens.IconColor",
        "OutlineColor": "@AssistChipTokens.FlatOutlineColor",
        "StateLayerColor": "@AssistChipTokens.LabelTextColor",

        "SelectedContainerColor": "@ChipsTokens.SelectedContainerColor",
        "SelectedLabelTextColor": "@ChipsTokens.SelectedLabelTextColor",
        "SelectedIconColor": "@ChipsTokens.SelectedLeadingIconColor",

        "DisabledContainerColor": "#00000000",
        "DisabledLabelTextColor": "@AssistChipTokens.DisabledLabelTextColor",
        "DisabledIconColor": "@AssistChipTokens.DisabledIconColor",
        "DisabledOutlineColor": "@AssistChipTokens.FlatDisabledOutlineColor",
        "DisabledContainerOpacity": 1,
        "DisabledLabelTextOpacity": "@AssistChipTokens.DisabledLabelTextOpacity",
        "DisabledOutlineOpacity": "@AssistChipTokens.FlatDisabledOutlineOpacity",

        "ContainerHeight": "@AssistChipTokens.ContainerHeight",
        "ContainerShape": "@AssistChipTokens.ContainerShape",
        "SelectedContainerShape": "@ChipsTokens.SelectedShape",
        "OutlineWidth": "@AssistChipTokens.FlatOutlineWidth",
        "IconSize": "@AssistChipTokens.IconSize",
        "HorizontalSpace": 16,
        "IconLabelSpace": 8,
        "LabelTextStyle": "@AssistChipTokens.LabelTextFont",
        "IsSelectable": false
      }
    },
    {
      "name": "Filter",
      "extends": "Assist",
      "summary": "Narrows a set. The only kind whose selected state is the point of it.",
      "values": {
        "LabelTextColor": "@FilterChipTokens.UnselectedLabelTextColor",
        "LeadingIconColor": "@FilterChipTokens.UnselectedLeadingIconColor",
        "TrailingIconColor": "@FilterChipTokens.UnselectedTrailingIconColor",
        "StateLayerColor": "@FilterChipTokens.UnselectedLabelTextColor",
        "SelectedContainerColor": "@FilterChipTokens.FlatSelectedContainerColor",
        "SelectedLabelTextColor": "@FilterChipTokens.SelectedLabelTextColor",
        "SelectedIconColor": "@FilterChipTokens.SelectedLeadingIconColor",
        "IsSelectable": true
      }
    },
    {
      "name": "Input",
      "extends": "Assist",
      "summary": "Represents something the user entered, and can usually be dismissed.",
      "values": {
        "LabelTextColor": "@InputChipTokens.UnselectedLabelTextColor",
        "LeadingIconColor": "@InputChipTokens.UnselectedLeadingIconColor",
        "TrailingIconColor": "@InputChipTokens.UnselectedTrailingIconColor",
        "StateLayerColor": "@InputChipTokens.UnselectedLabelTextColor",
        "SelectedContainerColor": "@InputChipTokens.SelectedContainerColor",
        "SelectedLabelTextColor": "@InputChipTokens.SelectedLabelTextColor",
        "SelectedIconColor": "@InputChipTokens.SelectedLeadingIconColor",
        "IsSelectable": true
      }
    },
    {
      "name": "Suggestion",
      "extends": "Assist",
      "summary": "Offers a likely next input.",
      "values": {
        "LabelTextColor": "@SuggestionChipTokens.LabelTextColor",
        "LeadingIconColor": "@SuggestionChipTokens.LeadingIconColor",
        "TrailingIconColor": "@SuggestionChipTokens.LeadingIconColor",
        "StateLayerColor": "@SuggestionChipTokens.LabelTextColor",
        "IsSelectable": false
      }
    }
  ]
}
