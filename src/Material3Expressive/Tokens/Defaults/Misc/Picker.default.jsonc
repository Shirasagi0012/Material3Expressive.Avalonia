{
  "kind": "componentDefaults",
  "name": "PickerTokens",
  "namespace": "Material3Expressive.Foundation",
  "resolvedName": "PickerColors",
  "version": "v0_210",
  "source": "androidx compose/material3 tokens/DatePickerModalTokens.kt and TimePickerTokens.kt",
  "summary": "The date and time pickers, which share a surface and differ in what they lay out on it.",

  "variantEnum": "PickerVariant",
  "variantEnumSummary": "Date or time.",

  "properties": {
    "ContainerColor": { "type": "color", "summary": "The picker surface." },
    "HeadlineColor": { "type": "color", "summary": "The current selection, shown large at the top." },
    "SupportingTextColor": { "type": "color", "summary": "The prompt above the headline." },
    "WeekdayColor": { "type": "color", "summary": "The day-of-week letters." },
    "DayColor": { "type": "color", "summary": "An unselected day or number." },
    "SelectedDayColor": { "type": "color", "summary": "The selected day's label." },
    "SelectedDayContainerColor": { "type": "color", "summary": "The circle behind the selected day." },
    "TodayOutlineColor": { "type": "color", "summary": "The ring around today, when it is not the selection." },
    "DividerColor": { "type": "color", "summary": "The rule under the headline." },

    "ContainerElevation": { "type": "elevation", "summary": "The picker shadow." },
    "ContainerShape": { "type": "shape", "summary": "The picker corners." },
    "DaySize": { "type": "dimension", "summary": "One day cell." },
    "DayShape": { "type": "shape", "summary": "The selection circle." },
    "TodayOutlineWidth": { "type": "dimension", "summary": "The ring around today." },
    "ContainerWidth": { "type": "dimension", "summary": "The picker width." },
    "HeadlineTextStyle": { "type": "typography", "summary": "The current selection." },
    "SupportingTextStyle": { "type": "typography", "summary": "The prompt." },
    "DayTextStyle": { "type": "typography", "summary": "A day or number." },
    "IsTime": { "type": "bool", "summary": "Whether this lays out a clock rather than a month." }
  },

  "sets": [
    {
      "name": "Date",
      "values": {
        "ContainerColor": "@DatePickerModalTokens.ContainerColor",
        "HeadlineColor": "@DatePickerModalTokens.HeaderHeadlineColor",
        "SupportingTextColor": "@DatePickerModalTokens.HeaderSupportingTextColor",
        "WeekdayColor": "@DatePickerModalTokens.WeekdaysLabelTextColor",
        "DayColor": "@DatePickerModalTokens.DateUnselectedLabelTextColor",
        "SelectedDayColor": "@DatePickerModalTokens.DateSelectedLabelTextColor",
        "SelectedDayContainerColor": "@DatePickerModalTokens.DateSelectedContainerColor",
        "TodayOutlineColor": "@DatePickerModalTokens.DateTodayContainerOutlineColor",
        "DividerColor": "OutlineVariant",

        "ContainerElevation": "@DatePickerModalTokens.ContainerElevation",
        "ContainerShape": "@DatePickerModalTokens.ContainerShape",
        "DaySize": "@DatePickerModalTokens.DateContainerWidth",
        "DayShape": "@DatePickerModalTokens.DateContainerShape",
        "TodayOutlineWidth": "@DatePickerModalTokens.DateTodayContainerOutlineWidth",
        "ContainerWidth": "@DatePickerModalTokens.ContainerWidth",
        "HeadlineTextStyle": "@DatePickerModalTokens.HeaderHeadlineFont",
        "SupportingTextStyle": "@DatePickerModalTokens.HeaderSupportingTextFont",
        "DayTextStyle": "@DatePickerModalTokens.DateLabelTextFont",
        "IsTime": false
      }
    },
    {
      "name": "Time",
      "extends": "Date",
      "values": {
        "ContainerColor": "@TimePickerTokens.ContainerColor",
        "HeadlineColor": "@TimePickerTokens.HeadlineColor",
        "SupportingTextColor": "@TimePickerTokens.HeadlineColor",
        "WeekdayColor": "@TimePickerTokens.ClockDialUnselectedLabelTextColor",
        "DayColor": "@TimePickerTokens.ClockDialUnselectedLabelTextColor",
        "SelectedDayColor": "@TimePickerTokens.ClockDialSelectedLabelTextColor",
        "SelectedDayContainerColor": "@TimePickerTokens.ClockDialSelectorCenterContainerColor",
        "TodayOutlineColor": "@TimePickerTokens.ClockDialSelectorTrackContainerColor",
        "ContainerElevation": "@TimePickerTokens.ContainerElevation",
        "ContainerShape": "@TimePickerTokens.ContainerShape",
        "DaySize": 48,
        "ContainerWidth": 328,
        "TodayOutlineWidth": "@TimePickerTokens.ClockDialSelectorTrackContainerWidth",
        "HeadlineTextStyle": "@TimePickerTokens.TimeSelectorLabelTextFont",
        "SupportingTextStyle": "@TimePickerTokens.HeadlineFont",
        "DayTextStyle": "@TimePickerTokens.ClockDialLabelTextFont",
        "IsTime": true
      }
    }
  ]
}
