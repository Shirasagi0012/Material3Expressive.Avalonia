{
  "kind": "componentDefaults",
 "name": "LoadingIndicatorDefaultsTokens",
  "overridesName": "LoadingIndicatorOverrides",
  "namespace": "Material3Expressive.Foundation",
  "resolvedName": "LoadingIndicatorColors",
  "version": "v0_7_0",
  "source": "androidx compose/material3 tokens/LoadingIndicatorTokens.kt",
  "summary": "The loading indicator: a shape that morphs through the Material catalog while it spins.",

  "variantEnum": "LoadingIndicatorVariant",
  "variantEnumSummary": "Whether the morphing shape sits on a container of its own.",

  "properties": {
    "ActiveIndicatorColor": { "type": "color", "summary": "The morphing shape." },
    "ContainerColor": { "type": "color", "summary": "The container behind it, if any." },

    "ActiveSize": { "type": "dimension", "summary": "The shape's box." },
    "ContainerSize": { "type": "dimension", "summary": "The container's box." },
    "ContainerShape": { "type": "shape", "summary": "The container's corners." },
    "HasContainer": { "type": "bool", "summary": "Whether a container is drawn." }
  },

  "sets": [
    {
      "name": "Standard",
      "summary": "The shape on its own.",
      "values": {
        "ActiveIndicatorColor": "@LoadingIndicatorTokens.ActiveIndicatorColor",

        "ContainerColor": "#00000000",
        "ActiveSize": "@LoadingIndicatorTokens.ActiveSize",

        "ContainerSize": "@LoadingIndicatorTokens.ContainerWidth",

        "ContainerShape": "@LoadingIndicatorTokens.ContainerShape",

        "HasContainer": false
      }
    },
    {
      "name": "Contained",
      "extends": "Standard",
      "summary": "The shape on a primary-container surface.",
      "values": {
        "ActiveIndicatorColor": "@LoadingIndicatorTokens.ContainedActiveColor",

        "ContainerColor": "@LoadingIndicatorTokens.ContainedContainerColor",

        "HasContainer": true
      }
    }
  ]
}
