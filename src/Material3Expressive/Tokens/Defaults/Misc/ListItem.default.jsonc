    "ContainerElevation": { "type": "elevation", "summary": "The resting elevation." },
    "DraggedContainerElevation": { "type": "elevation", "summary": "The reorder-drag elevation." },
    "OneLineContainerHeight": { "type": "dimension", "summary": "The alpha25 one-line minimum height." },
    "TwoLineContainerHeight": { "type": "dimension", "summary": "The alpha25 two-line minimum height." },
    "ThreeLineContainerHeight": { "type": "dimension", "summary": "The alpha25 three-line minimum height." },
    "LeadingSpace": { "type": "dimension", "summary": "The logical start inset." },
    "TrailingSpace": { "type": "dimension", "summary": "The logical end inset." },
    "TopSpace": { "type": "dimension", "summary": "The default top inset." },
    "BottomSpace": { "type": "dimension", "summary": "The default bottom inset." },
    "BetweenSpace": { "type": "dimension", "summary": "The conditional gap between a side slot and main content." },
    "SegmentedGap": { "type": "dimension", "summary": "The vertical gap between segmented list items." },
    "ContentTextStyle": { "type": "typography", "summary": "The headline typography role." },
    "SupportingTextStyle": { "type": "typography", "summary": "The supporting-text typography role." },
    "OverlineTextStyle": { "type": "typography", "summary": "The overline typography role." },
    "LeadingTextStyle": { "type": "typography", "summary": "The leading avatar-label typography role." },
    "TrailingTextStyle": { "type": "typography", "summary": "The trailing supporting-label typography role." },
    "ColorMotion": { "type": "motion", "summary": "The effects spring used for colour changes." },
    "ShapeMotion": { "type": "motion", "summary": "The spatial spring used for shape changes." },
    "ElevationMotion": { "type": "motion", "summary": "The spatial spring used for elevation changes." }
  },

