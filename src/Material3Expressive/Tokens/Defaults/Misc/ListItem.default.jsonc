{
  "kind": "componentDefaults",
  "name": "ListItemTokens",
  "namespace": "Material3Expressive.Foundation",
  "resolvedName": "ListItemColors",
  "version": "29.0.0",
  "source": "AndroidX ff0a0a99 / Material3 1.5.0-alpha25: compose/material3/material3/src/commonMain/kotlin/androidx/compose/material3/{ListItemDefaults.kt,tokens/ListTokens.kt,tokens/ReorderListTokens.kt}",
  "summary": "The alpha25 expressive list item: slot typography, line-aware layout, colours, shapes, elevation, and motion roles. Retained SelectedDisabled* entries are legacy generated-token compatibility data; ListItemColors' alpha25 resolver does not select them.",

  "properties": {
    "ContainerColor": { "type": "color", "summary": "The resting list-item surface." },
    "SegmentedContainerColor": { "type": "color", "summary": "The resting and disabled segmented-list-item surface." },
    "ContentColor": { "type": "color", "summary": "The headline colour." },
    "LeadingContentColor": { "type": "color", "summary": "The leading icon or avatar colour." },
    "TrailingContentColor": { "type": "color", "summary": "The trailing icon or supporting label colour." },
    "OverlineContentColor": { "type": "color", "summary": "The overline label colour." },
    "SupportingContentColor": { "type": "color", "summary": "The supporting label colour." },

    "SelectedContainerColor": { "type": "color", "summary": "The container when a single- or multi-selection item is selected." },
    "SelectedContentColor": { "type": "color", "summary": "The selected headline colour." },
    "SelectedLeadingContentColor": { "type": "color", "summary": "The selected leading-content colour." },
    "SelectedTrailingContentColor": { "type": "color", "summary": "The selected trailing-content colour." },
    "SelectedOverlineContentColor": { "type": "color", "summary": "The selected overline colour." },
    "SelectedSupportingContentColor": { "type": "color", "summary": "The selected supporting-content colour." },

    "DisabledContainerColor": { "type": "color", "summary": "The unselected disabled surface, which remains Surface upstream." },
    "DisabledContentColor": { "type": "color", "opacity": "DisabledContentOpacity", "summary": "The disabled headline colour." },
    "DisabledLeadingContentColor": { "type": "color", "opacity": "DisabledLeadingContentOpacity", "summary": "The disabled leading-content colour." },
    "DisabledTrailingContentColor": { "type": "color", "opacity": "DisabledTrailingContentOpacity", "summary": "The disabled trailing-content colour." },
    "DisabledOverlineContentColor": { "type": "color", "opacity": "DisabledOverlineContentOpacity", "summary": "The disabled overline colour." },
    "DisabledSupportingContentColor": { "type": "color", "opacity": "DisabledSupportingContentOpacity", "summary": "The disabled supporting-content colour." },
    "DisabledContentOpacity": { "type": "opacity", "summary": "The alpha used by disabled headline text." },
    "DisabledLeadingContentOpacity": { "type": "opacity", "summary": "The alpha used by disabled leading content." },
    "DisabledTrailingContentOpacity": { "type": "opacity", "summary": "The alpha used by disabled trailing content." },
    "DisabledOverlineContentOpacity": { "type": "opacity", "summary": "The alpha used by disabled overline text." },
    "DisabledSupportingContentOpacity": { "type": "opacity", "summary": "The alpha used by disabled supporting text." },

    "SelectedDisabledContainerColor": { "type": "color", "opacity": "SelectedDisabledContainerOpacity", "summary": "The selected disabled container colour." },
    "SelectedDisabledContentColor": { "type": "color", "opacity": "SelectedDisabledContentOpacity", "summary": "The selected disabled headline colour." },
    "SelectedDisabledLeadingContentColor": { "type": "color", "opacity": "SelectedDisabledLeadingContentOpacity", "summary": "The selected disabled leading-content colour." },
    "SelectedDisabledTrailingContentColor": { "type": "color", "opacity": "SelectedDisabledTrailingContentOpacity", "summary": "The selected disabled trailing-content colour." },
    "SelectedDisabledOverlineContentColor": { "type": "color", "opacity": "SelectedDisabledOverlineContentOpacity", "summary": "The selected disabled overline colour." },
    "SelectedDisabledSupportingContentColor": { "type": "color", "opacity": "SelectedDisabledSupportingContentOpacity", "summary": "The selected disabled supporting-content colour." },
    "SelectedDisabledContainerOpacity": { "type": "opacity", "summary": "The alpha used by a selected disabled container." },
    "SelectedDisabledContentOpacity": { "type": "opacity", "summary": "The alpha used by selected disabled headline text." },
    "SelectedDisabledLeadingContentOpacity": { "type": "opacity", "summary": "The alpha used by selected disabled leading content." },
    "SelectedDisabledTrailingContentOpacity": { "type": "opacity", "summary": "The alpha used by selected disabled trailing content." },
    "SelectedDisabledOverlineContentOpacity": { "type": "opacity", "summary": "The alpha used by selected disabled overline text." },
    "SelectedDisabledSupportingContentOpacity": { "type": "opacity", "summary": "The alpha used by selected disabled supporting text." },

    "DraggedContainerColor": { "type": "color", "summary": "The reorder-drag container colour." },
    "DraggedContentColor": { "type": "color", "summary": "The reorder-drag headline colour." },
    "DraggedLeadingContentColor": { "type": "color", "summary": "The reorder-drag leading-content colour." },
    "DraggedTrailingContentColor": { "type": "color", "summary": "The reorder-drag trailing-content colour." },
    "DraggedOverlineContentColor": { "type": "color", "summary": "The reorder-drag overline colour." },
    "DraggedSupportingContentColor": { "type": "color", "summary": "The reorder-drag supporting-content colour." },

    "RestingShape": { "type": "shape", "summary": "The expressive resting shape." },
    "SegmentedOuterShape": { "type": "shape", "summary": "The outer group corners applied to first, last, and single segmented items." },
    "SelectedShape": { "type": "shape", "summary": "The selected shape." },
    "PressedShape": { "type": "shape", "summary": "The pressed shape." },
    "FocusedShape": { "type": "shape", "summary": "The keyboard-focused shape." },
