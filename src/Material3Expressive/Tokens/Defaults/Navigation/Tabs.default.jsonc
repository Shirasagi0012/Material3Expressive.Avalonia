{
  "kind": "componentDefaults",
  "name": "TabTokens",
  "namespace": "Material3Expressive.Foundation",
  "resolvedName": "TabColors",
  "version": "v0_162",
  "source": "androidx compose/material3 tokens/{Primary,Secondary}NavigationTabTokens.kt",
  "summary": "A row of tabs and the indicator that slides between them.",

  "variantEnum": "TabVariant",
  "variantEnumSummary": "Primary tabs sit under an app bar; secondary tabs sit inside content.",

  "properties": {
    "ContainerColor": { "type": "color", "summary": "The row's surface." },
    "ActiveIndicatorColor": { "type": "color", "summary": "The bar under the selected tab." },
    "ActiveIconColor": { "type": "color", "summary": "The selected tab's icon." },
    "ActiveLabelTextColor": { "type": "color", "summary": "The selected tab's label." },
    "InactiveIconColor": { "type": "color", "summary": "An unselected tab's icon." },
    "InactiveLabelTextColor": { "type": "color", "summary": "An unselected tab's label." },
    "DividerColor": { "type": "color", "summary": "The hairline under the whole row." },
    "StateLayerColor": { "type": "color", "summary": "The state layer over a tab." },

    "ContainerHeight": { "type": "dimension", "summary": "The row's height with a label only." },
    "IconAndLabelHeight": { "type": "dimension", "summary": "The row's height when tabs carry both." },
    "ActiveIndicatorHeight": { "type": "dimension", "summary": "The indicator's thickness." },
    "ActiveIndicatorCornerRadius": { "type": "dimension", "summary": "The indicator's corners — 3dp, below the smallest shape role." },
    "DividerHeight": { "type": "dimension", "summary": "The hairline under the row." },
    "IconSize": { "type": "dimension", "summary": "A tab's icon." },
    "LabelTextStyle": { "type": "typography", "summary": "A tab's label." },
    "IndicatorSpansLabel": { "type": "bool", "summary": "Whether the indicator hugs the label rather than filling the tab — the primary form does." }
  },

  "sets": [
    {
      "name": "Primary",
      "values": {
        "ContainerColor": "Surface",
        "ActiveIndicatorColor": "Primary",
        "ActiveIconColor": "Primary",
        "ActiveLabelTextColor": "Primary",
        // Tab.kt defaults unselectedContentColor to selectedContentColor. A caller who wants
        // contrasting unselected tabs supplies it explicitly; the default Tab used by
        // PrimaryTabRow therefore keeps the primary content color for every item.
        "InactiveIconColor": "Primary",
        "InactiveLabelTextColor": "Primary",
        // TabRow's default divider is HorizontalDivider(), whose color token is OutlineVariant,
        // rather than the row's SurfaceVariant container token.
        "DividerColor": "OutlineVariant",
        "StateLayerColor": "Primary",

        "ContainerHeight": 48,
        "IconAndLabelHeight": 64,
        "ActiveIndicatorHeight": 3,
        "ActiveIndicatorCornerRadius": 3,
        "DividerHeight": 1,
        "IconSize": 24,
        "LabelTextStyle": "TitleSmall",
        "IndicatorSpansLabel": true
      }
    },
    {
      "name": "Secondary",
      "extends": "Primary",
      // The secondary tab's indicator runs the full width of the tab and its label stays neutral;
      // only the icon and indicator take the accent.
      "values": {
        "ContainerColor": "@SecondaryNavigationTabTokens.ContainerColor",
        "ActiveLabelTextColor": "@SecondaryNavigationTabTokens.ActiveLabelTextColor",
        "ActiveIconColor": "@SecondaryNavigationTabTokens.ActiveIconColor",
        "InactiveIconColor": "@SecondaryNavigationTabTokens.InactiveIconColor",
        "InactiveLabelTextColor": "@SecondaryNavigationTabTokens.InactiveLabelTextColor",
        "DividerColor": "@SecondaryNavigationTabTokens.DividerColor",
        "ContainerHeight": "@SecondaryNavigationTabTokens.ContainerHeight",
        "IconSize": "@SecondaryNavigationTabTokens.IconSize",
        "LabelTextStyle": "@SecondaryNavigationTabTokens.LabelTextFont",
        // SecondaryIndicator defaults to PrimaryNavigationTabTokens.ActiveIndicatorHeight.
        "ActiveIndicatorHeight": 3,
        "ActiveIndicatorCornerRadius": 0,
        "IndicatorSpansLabel": false
      }
    }
  ]
}
