{
  "kind": "componentDefaults",
  "name": "NavigationTokens",
  "namespace": "Material3Expressive.Foundation",
  "resolvedName": "NavigationColors",
  "version": "v0_11_0",
  "source": "androidx compose/material3 tokens/NavigationBarTokens.kt, NavigationBarHorizontalItemTokens.kt, NavigationBarVerticalItemTokens.kt, NavigationRailCollapsedTokens.kt",
  "summary": "A navigation surface and its items, whether it runs along the bottom or up the side.",

  "variantEnum": "NavigationVariant",
  "variantEnumSummary": "Bar (horizontal, along the bottom) or rail (vertical, along the side).",

  "properties": {
    "ContainerColor": { "type": "color", "summary": "The surface behind the items." },
    "ActiveIndicatorColor": { "type": "color", "summary": "The pill behind the selected item's icon." },
    "ActiveIconColor": { "type": "color", "summary": "The selected item's icon." },
    "ActiveLabelTextColor": { "type": "color", "summary": "The selected item's label." },
    "InactiveIconColor": { "type": "color", "summary": "An unselected item's icon." },
    "InactiveLabelTextColor": { "type": "color", "summary": "An unselected item's label." },
    "StateLayerColor": { "type": "color", "summary": "The state layer over an item." },

    "ContainerElevation": { "type": "elevation", "summary": "The surface's shadow." },
    "ContainerSize": { "type": "dimension", "summary": "The bar's height, or the rail's width." },
    "ActiveIndicatorWidth": { "type": "dimension", "summary": "The indicator pill." },
    "ActiveIndicatorHeight": { "type": "dimension", "summary": "The indicator pill." },
    "ActiveIndicatorShape": { "type": "shape", "summary": "The indicator's corners." },
    "IconSize": { "type": "dimension", "summary": "An item's icon." },
    "IconLabelSpace": { "type": "dimension", "summary": "The gap between the indicator and the label under it." },
    "StartActiveIndicatorHeight": { "type": "dimension", "summary": "The active indicator height when the icon leads the label." },
    "StartIndicatorHorizontalPadding": { "type": "dimension", "summary": "Padding on each horizontal side of a leading-icon indicator." },
    "StartIndicatorVerticalPadding": { "type": "dimension", "summary": "Padding on each vertical side of a leading-icon indicator." },
    "TopItemVerticalPadding": { "type": "dimension", "summary": "Padding above and below a top-icon item." },
    "ItemBetweenSpace": { "type": "dimension", "summary": "The gap between items." },
    "LabelTextStyle": { "type": "typography", "summary": "An item's label." },
    "IsVertical": { "type": "bool", "summary": "Whether items stack down the side rather than across the bottom." }
  },

  "sets": [
    {
      "name": "Bar",
      "summary": "Along the bottom of the window.",
      "values": {
        "ContainerColor": "@NavigationBarTokens.ContainerColor",
        "ActiveIndicatorColor": "@NavigationBarTokens.ItemActiveIndicatorColor",
        "ActiveIconColor": "@NavigationBarTokens.ItemActiveIconColor",
        "ActiveLabelTextColor": "@NavigationBarTokens.ItemActiveLabelTextColor",
        "InactiveIconColor": "@NavigationBarTokens.ItemInactiveIconColor",
        "InactiveLabelTextColor": "@NavigationBarTokens.ItemInactiveLabelTextColor",
        "StateLayerColor": "OnSurface",

        "ContainerElevation": "@NavigationBarTokens.ContainerElevation",
        "ContainerSize": "@NavigationBarTokens.TallContainerHeight",
        "ActiveIndicatorWidth": "@NavigationBarVerticalItemTokens.ActiveIndicatorWidth",
        "ActiveIndicatorHeight": "@NavigationBarVerticalItemTokens.ActiveIndicatorHeight",
        "ActiveIndicatorShape": "@NavigationBarTokens.ItemActiveIndicatorShape",
        "IconSize": "@NavigationBarVerticalItemTokens.IconSize",
        // Compose positions the label below the icon by its 4dp indicator padding plus the
        // 4dp indicator-to-label token gap.  This value is the effective icon-to-label gap used
        // by the shared Avalonia template.
        "IconLabelSpace": 8,
        "StartActiveIndicatorHeight": "@NavigationBarHorizontalItemTokens.ActiveIndicatorHeight",
        "StartIndicatorHorizontalPadding": "@NavigationBarHorizontalItemTokens.ActiveIndicatorLeadingSpace",
        "StartIndicatorVerticalPadding": 8,
        "TopItemVerticalPadding": 6,
        // NavigationBar.kt uses NavigationBarItemHorizontalPadding (8dp) between weighted items.
        "ItemBetweenSpace": 8,
        "LabelTextStyle": "@NavigationBarTokens.LabelTextFont",
        "IsVertical": false
      }
    },
    {
      "name": "Rail",
      "extends": "Bar",
      "summary": "Up the side of the window.",
      "values": {
        "ContainerColor": "@NavigationRailCollapsedTokens.ContainerColor",
        "ContainerElevation": "@NavigationRailCollapsedTokens.ContainerElevation",
        "ContainerSize": "@NavigationRailCollapsedTokens.ContainerWidth",
        "ActiveIndicatorColor": "@NavigationRailColorTokens.ItemActiveIndicator",
        "ActiveIconColor": "@NavigationRailColorTokens.ItemActiveIcon",
        "ActiveLabelTextColor": "@NavigationRailColorTokens.ItemActiveLabelText",
        "InactiveIconColor": "@NavigationRailColorTokens.ItemInactiveIcon",
        "InactiveLabelTextColor": "@NavigationRailColorTokens.ItemInactiveLabelText",
        "ActiveIndicatorWidth": "@NavigationRailVerticalItemTokens.ActiveIndicatorWidth",
        "ActiveIndicatorHeight": "@NavigationRailVerticalItemTokens.ActiveIndicatorHeight",
        "ActiveIndicatorShape": "@NavigationRailBaselineItemTokens.ActiveIndicatorShape",
        "IconSize": "@NavigationRailBaselineItemTokens.IconSize",
        // NavigationRail.kt uses NavigationRailVerticalPadding (4dp) both around and between items.
        "ItemBetweenSpace": "@NavigationRailCollapsedTokens.ItemVerticalSpace",
        "IconLabelSpace": "@NavigationRailVerticalItemTokens.IconLabelSpace",
        "StartIndicatorHorizontalPadding": "@NavigationRailVerticalItemTokens.LeadingSpace",
        "LabelTextStyle": "@NavigationRailVerticalItemTokens.LabelTextFont",
        "IsVertical": true
      }
    }
  ]
}
