{
  "kind": "componentDefaults",
 "name": "AppBarDefaultsTokens",
  "overridesName": "AppBarOverrides",
  "namespace": "Material3Expressive.Foundation",
  "resolvedName": "AppBarColors",
  "version": "14_0_0",
  "source": "androidx compose/material3 tokens/AppBar{Small,Medium,Large}Tokens.kt and AppBarTokens.kt",
  "summary": "A top app bar at one of its three heights.",

  "variantEnum": "AppBarSize",
  "variantEnumSummary": "Small keeps the title on one line beside the actions; medium and large drop it onto its own line below them.",

  "properties": {
    "ContainerColor": { "type": "color", "summary": "The bar's surface." },
    "ScrolledContainerColor": { "type": "color", "summary": "The surface once content has scrolled under it." },
    "TitleColor": { "type": "color", "summary": "The title." },
    "SubtitleColor": { "type": "color", "summary": "The subtitle, when there is one." },
    "IconColor": { "type": "color", "summary": "Navigation and action icons." },

    "ContainerHeight": { "type": "dimension", "summary": "The bar's height." },
    "FlexibleContainerHeight": { "type": "dimension", "summary": "The flexible bar's expanded height without a subtitle." },
    "FlexibleContainerHeightWithSubtitle": { "type": "dimension", "summary": "The flexible bar's expanded height with a subtitle." },
    "HorizontalSpace": { "type": "dimension", "summary": "Padding at each end." },
    "TitleTextStyle": { "type": "typography", "summary": "The title." },
    "SubtitleTextStyle": { "type": "typography", "summary": "The subtitle." },
    "FlexibleTitleTextStyle": { "type": "typography", "summary": "The flexible title." },
    "FlexibleSubtitleTextStyle": { "type": "typography", "summary": "The flexible subtitle." },
    "IsStacked": { "type": "bool", "summary": "Whether the title sits on its own line below the action row." }
  },

  "sets": [
    {
      "name": "Small",
      "values": {
        "ContainerColor": "@AppBarTokens.ContainerColor",
        "ScrolledContainerColor": "@AppBarTokens.OnScrollContainerColor",
        "TitleColor": "@AppBarTokens.TitleColor",
        "SubtitleColor": "@AppBarTokens.SubtitleColor",
        "IconColor": "@AppBarTokens.TrailingIconColor",

        "ContainerHeight": "@AppBarSmallTokens.ContainerHeight",
        "FlexibleContainerHeight": "@AppBarSmallTokens.ContainerHeight",
        "FlexibleContainerHeightWithSubtitle": "@AppBarSmallTokens.ContainerHeight",
        "HorizontalSpace": 16,
        "TitleTextStyle": "@AppBarSmallTokens.TitleFont",
        "SubtitleTextStyle": "@AppBarSmallTokens.SubtitleFont",
        "FlexibleTitleTextStyle": "@AppBarSmallTokens.TitleFont",
        "FlexibleSubtitleTextStyle": "@AppBarSmallTokens.SubtitleFont",
        "IsStacked": false
      }
    },
    {
      "name": "Medium",
      "extends": "Small",
      "values": {
        "ContainerHeight": "@AppBarMediumTokens.ContainerHeight",
        "TitleTextStyle": "@AppBarMediumTokens.TitleFont",
        "FlexibleContainerHeight": "@AppBarMediumFlexibleTokens.ContainerHeight",
        "FlexibleContainerHeightWithSubtitle": "@AppBarMediumFlexibleTokens.LargeContainerHeight",
        "FlexibleTitleTextStyle": "@AppBarMediumFlexibleTokens.TitleFont",
        "FlexibleSubtitleTextStyle": "@AppBarMediumFlexibleTokens.SubtitleFont",
        "IsStacked": true
      }
    },
    {
      "name": "Large",
      "extends": "Small",
      "values": {
        "ContainerHeight": "@AppBarLargeTokens.ContainerHeight",
        "TitleTextStyle": "@AppBarLargeTokens.TitleFont",
        "FlexibleContainerHeight": "@AppBarLargeFlexibleTokens.ContainerHeight",
        "FlexibleContainerHeightWithSubtitle": "@AppBarLargeFlexibleTokens.LargeContainerHeight",
        "FlexibleTitleTextStyle": "@AppBarLargeFlexibleTokens.TitleFont",
        "FlexibleSubtitleTextStyle": "@AppBarLargeFlexibleTokens.SubtitleFont",
        "IsStacked": true
      }
    }
  ]
}
