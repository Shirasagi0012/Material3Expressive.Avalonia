{
  "kind": "componentDefaults",
 "name": "FloatingToolbarDefaultsTokens",
  "overridesName": "FloatingToolbarOverrides",
  "namespace": "Material3Expressive.Foundation",
  "resolvedName": "FloatingToolbarColors",
  "version": "12_0_0",
  "source": "androidx compose/material3 tokens/FloatingToolbarTokens.kt and FloatingToolbar.kt:624-1152",
  "summary": "Geometry and colours shared by horizontal and vertical floating toolbars.",

  "variantEnum": "FloatingToolbarVariant",
  "variantEnumSummary": "The neutral standard or high-emphasis vibrant colour treatment.",

  "properties": {
    "ContainerColor": { "type": "color", "summary": "The toolbar container fill." },
    "ContentColor": { "type": "color", "summary": "Icons and text inside the toolbar." },
    "FabContainerColor": { "type": "color", "summary": "The recommended adjacent FAB fill." },
    "FabContentColor": { "type": "color", "summary": "The recommended adjacent FAB content colour." },
    "ContainerSize": { "type": "dimension", "summary": "The minimum cross-axis size." },
    "ContentPadding": { "type": "dimension", "summary": "Padding on every side of the toolbar content." },
    "ToolbarToFabGap": { "type": "dimension", "summary": "Gap between toolbar and adjacent FAB." },
    "ScreenOffset": { "type": "dimension", "summary": "Recommended offset from the containing screen edge." },
    "ScrollDistanceThreshold": { "type": "dimension", "summary": "Scroll distance that toggles expansion in threshold mode." },
    "ExpandedElevation": { "type": "elevation", "summary": "Toolbar elevation while expanded without a FAB." },
    "CollapsedElevation": { "type": "elevation", "summary": "Toolbar elevation while collapsed without a FAB." },
    "ExpandedElevationWithFab": { "type": "elevation", "summary": "Toolbar elevation while expanded beside a FAB." },
    "CollapsedElevationWithFab": { "type": "elevation", "summary": "Toolbar elevation while collapsed beside a FAB." }
  },

  "sets": [
    {
      "name": "Standard",
      "values": {
        "ContainerColor": "@FloatingToolbarTokens.StandardContainerColor",
        "ContentColor": "OnSurface",
        "FabContainerColor": "PrimaryContainer",
        "FabContentColor": "OnPrimaryContainer",
        "ContainerSize": "@FloatingToolbarTokens.ContainerHeight",
        "ContentPadding": "@FloatingToolbarTokens.ContainerLeadingSpace",
        "ToolbarToFabGap": 8,
        "ScreenOffset": "@FloatingToolbarTokens.ContainerExternalPadding",
        "ScrollDistanceThreshold": 40,
        "ExpandedElevation": 0,
        "CollapsedElevation": 0,
        "ExpandedElevationWithFab": 1,
        "CollapsedElevationWithFab": 0
      }
    },
    {
      "name": "Vibrant",
      "extends": "Standard",
      "values": {
        "ContainerColor": "@FloatingToolbarTokens.VibrantContainerColor",
        "ContentColor": "OnPrimaryContainer",
        "FabContainerColor": "TertiaryContainer",
        "FabContentColor": "OnTertiaryContainer"
      }
    }
  ]
}
