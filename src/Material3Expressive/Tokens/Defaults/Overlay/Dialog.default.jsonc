{
  "kind": "componentDefaults",
 "name": "DialogDefaultsTokens",
  "overridesName": "DialogOverrides",
  "namespace": "Material3Expressive.Foundation",
  "resolvedName": "DialogColors",
  "version": "v0_210",
  "source": "androidx compose/material3 tokens/DialogTokens.kt",
  "summary": "A dialog: a raised surface over a scrim, asking for a decision.",

  "properties": {
    "ContainerColor": { "type": "color", "summary": "The dialog surface." },
    "ScrimColor": { "type": "color", "summary": "The dimming behind it." },
    "HeadlineColor": { "type": "color", "summary": "The headline." },
    "SupportingTextColor": { "type": "color", "summary": "The body text." },
    "IconColor": { "type": "color", "summary": "The optional icon above the headline." },

    "ContainerElevation": { "type": "elevation", "summary": "The dialog shadow." },
    "ContainerShape": { "type": "shape", "summary": "The dialog corners." },
    "MinWidth": { "type": "dimension", "summary": "How narrow the dialog may get." },
    "MaxWidth": { "type": "dimension", "summary": "How wide, before the text becomes hard to read." },
    "Padding": { "type": "dimension", "summary": "Padding inside the dialog." },
    "IconSize": { "type": "dimension", "summary": "The icon." },
    "ScrimOpacity": { "type": "opacity", "summary": "How far the scrim dims the content behind." },
    "HeadlineTextStyle": { "type": "typography", "summary": "The headline." },
    "SupportingTextStyle": { "type": "typography", "summary": "The body." }
  },

  "sets": [
    {
      "name": "Default",
      "values": {
        "ContainerColor": "@DialogTokens.ContainerColor",
        "ScrimColor": "Scrim",
        "HeadlineColor": "@DialogTokens.HeadlineColor",
        "SupportingTextColor": "@DialogTokens.SupportingTextColor",
        "IconColor": "@DialogTokens.IconColor",

        "ContainerElevation": "@DialogTokens.ContainerElevation",
        "ContainerShape": "@DialogTokens.ContainerShape",
        "MinWidth": 280,
        "MaxWidth": 560,
        "Padding": 24,
        "IconSize": "@DialogTokens.IconSize",
        "ScrimOpacity": "@ScrimTokens.ContainerOpacity",
        "HeadlineTextStyle": "@DialogTokens.HeadlineFont",
        "SupportingTextStyle": "@DialogTokens.SupportingTextFont"
      }
    }
  ]
}
