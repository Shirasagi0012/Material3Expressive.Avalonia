{
  "kind": "componentDefaults",
  "name": "TooltipTokens",
  "namespace": "Material3Expressive.Foundation",
  "resolvedName": "TooltipColors",
  "version": "v0_210",
  "source": "androidx compose/material3 tokens/{Plain,Rich}TooltipTokens.kt",
  "summary": "A tooltip. The plain kind names a control; the rich kind explains one.",

  "variantEnum": "TooltipVariant",
  "variantEnumSummary": "Plain tooltips invert; rich ones sit on a normal surface and can carry a title and an action.",

  "properties": {
    "ContainerColor": { "type": "color", "summary": "The tooltip surface." },
    "SupportingTextColor": { "type": "color", "summary": "The text." },
    "TitleColor": { "type": "color", "summary": "A rich tooltip title." },
    "ActionLabelTextColor": { "type": "color", "summary": "A rich tooltip action." },

    "ContainerShape": { "type": "shape", "summary": "The tooltip corners." },
    "ContainerElevation": { "type": "elevation", "summary": "The tooltip shadow." },
    "MinHeight": { "type": "dimension", "summary": "How short it may get." },
    "MaxWidth": { "type": "dimension", "summary": "Where the text wraps." },
    "HorizontalSpace": { "type": "dimension", "summary": "Padding at each end." },
    "VerticalSpace": { "type": "dimension", "summary": "Padding above and below." },
    "SupportingTextStyle": { "type": "typography", "summary": "The text." },
    "TitleTextStyle": { "type": "typography", "summary": "A rich tooltip title." }
  },

  "sets": [
    {
      "name": "Plain",
      "values": {
        "ContainerColor": "@PlainTooltipTokens.ContainerColor",
        "SupportingTextColor": "@PlainTooltipTokens.SupportingTextColor",
        "TitleColor": "InverseOnSurface",
        "ActionLabelTextColor": "InversePrimary",

        "ContainerShape": "@PlainTooltipTokens.ContainerShape",
        "ContainerElevation": "@ElevationTokens.Level0",
        "MinHeight": 24,
        "MaxWidth": 200,
        "HorizontalSpace": 8,
        "VerticalSpace": 4,
        "SupportingTextStyle": "@PlainTooltipTokens.SupportingTextFont",
        "TitleTextStyle": "TitleSmall"
      }
    },
    {
      "name": "Rich",
      "extends": "Plain",
      "values": {
        "ContainerColor": "@RichTooltipTokens.ContainerColor",
        "SupportingTextColor": "@RichTooltipTokens.SupportingTextColor",
        "TitleColor": "@RichTooltipTokens.SubheadColor",
        "ActionLabelTextColor": "@RichTooltipTokens.ActionLabelTextColor",

        "ContainerShape": "@RichTooltipTokens.ContainerShape",
        "ContainerElevation": "@RichTooltipTokens.ContainerElevation",
        "MinHeight": 40,
        "MaxWidth": 320,
        "HorizontalSpace": 16,
        "VerticalSpace": 12,
        "SupportingTextStyle": "@RichTooltipTokens.SupportingTextFont",
        "TitleTextStyle": "@RichTooltipTokens.SubheadFont"
      }
    }
  ]
}
