{
  "kind": "component",
  "name": "FabSizeTokens",
  "namespace": "Material3Expressive.Foundation",
  "version": "v0_14_0",
  "source": "androidx compose/material3 tokens/Fab{Baseline,Medium,Large}Tokens.kt",
  "summary": "The metrics of one floating action button size.",

  "variantEnum": "FabSize",
  "variantEnumSummary": "The three floating action button sizes.",

  "properties": {
    "ContainerHeight": { "type": "dimension", "summary": "The container's height." },
    "ContainerWidth": { "type": "dimension", "summary": "The container's width when it is not extended." },
    "ContainerShape": { "type": "shape", "summary": "The resting shape." },
    "PressedContainerShape": { "type": "shape", "summary": "The shape the container morphs to while pressed." },
    "IconSize": { "type": "dimension", "summary": "The icon's size." },
    "LabelSpace": { "type": "dimension", "summary": "Horizontal padding on an extended FAB." },
    "IconLabelSpace": { "type": "dimension", "summary": "The gap between icon and label on an extended FAB." },
    "LabelTextStyle": { "type": "typography", "summary": "The type scale an extended FAB's label is set in." }
  },

  "sets": [
    {
      "name": "Small",
      "summary": "56dp — the baseline FAB.",
      "values": {
        "ContainerHeight": "@FabBaselineTokens.ContainerHeight",
        "ContainerWidth": "@FabBaselineTokens.ContainerWidth",
        "ContainerShape": "@FabBaselineTokens.ContainerShape",
        "PressedContainerShape": "CornerMedium",
        "IconSize": "@FabBaselineTokens.IconSize",
        "LabelSpace": 16,
        "IconLabelSpace": 12,
        "LabelTextStyle": "LabelLarge"
      }
    },
    {
      "name": "Medium",
      "extends": "Small",
      "summary": "80dp.",
      "values": {
        "ContainerHeight": "@FabMediumTokens.ContainerHeight",
        "ContainerWidth": "@FabMediumTokens.ContainerWidth",
        "ContainerShape": "@FabMediumTokens.ContainerShape",
        "PressedContainerShape": "CornerLarge",
        "IconSize": "@FabMediumTokens.IconSize",
        "LabelSpace": 24,
        "IconLabelSpace": 16,
        "LabelTextStyle": "TitleMedium"
      }
    },
    {
      "name": "Large",
      "extends": "Small",
      "summary": "96dp.",
      "values": {
        "ContainerHeight": "@FabLargeTokens.ContainerHeight",
        "ContainerWidth": "@FabLargeTokens.ContainerWidth",
        "ContainerShape": "@FabLargeTokens.ContainerShape",
        "PressedContainerShape": "CornerLarge",
        "IconSize": "@FabLargeTokens.IconSize",
        "LabelSpace": 28,
        "IconLabelSpace": 20,
        "LabelTextStyle": "HeadlineSmall"
      }
    }
  ]
}
