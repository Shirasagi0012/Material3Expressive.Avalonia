{
  "kind": "componentTokens",
  "name": "LargeIconButtonTokens",
  "namespace": "Material3Expressive.Foundation.Tokens",
  "version": "14_1_0",
  "source": "androidx compose/material3 tokens/LargeIconButtonTokens.kt",
  "summary": "Metrics for the large icon button size.",

  // Upstream names this size's middle width Uniform rather than Default, alone among the five.
  // Transcribed under the common name so the component table can treat the sizes uniformly.


  "tokens": {
    "ContainerHeight": { "type": "dimension", "value": 96 },
    "ContainerShapeRound": { "type": "shape", "value": "CornerFull" },
    "ContainerShapeSquare": { "type": "shape", "value": "CornerExtraLarge" },
    "PressedContainerShape": { "type": "shape", "value": "CornerLarge" },
    "SelectedContainerShapeRound": { "type": "shape", "value": "CornerExtraLarge" },
    "SelectedContainerShapeSquare": { "type": "shape", "value": "CornerFull" },
    "IconSize": { "type": "dimension", "value": 32 },
    "NarrowLeadingSpace": { "type": "dimension", "value": 16 },
    "DefaultLeadingSpace": { "type": "dimension", "value": 32 },
    "WideLeadingSpace": { "type": "dimension", "value": 48 },
    "OutlinedOutlineWidth": { "type": "dimension", "value": 2 }
  }
}
