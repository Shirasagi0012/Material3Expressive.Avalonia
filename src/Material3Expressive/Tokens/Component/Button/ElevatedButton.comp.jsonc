{
  "kind": "componentTokens",
  "name": "ElevatedButtonTokens",
  "namespace": "Material3Expressive.Foundation.Tokens",
  "version": "v0_11_0",
  "source": "androidx compose/material3 tokens/ElevatedButtonTokens.kt",
  "summary": "Colours and elevations of the elevated button.",

  "tokens": {
    "ContainerColor": { "type": "color", "value": "SurfaceContainerLow" },
    "ContainerElevation": { "type": "elevation", "value": "@ElevationTokens.Level1" },
    "DisabledContainerColor": { "type": "color", "value": "OnSurface" },
    "DisabledContainerElevation": { "type": "elevation", "value": "@ElevationTokens.Level0" },
    "DisabledContainerOpacity": { "type": "opacity", "value": 0.1 },
    "DisabledIconColor": { "type": "color", "value": "OnSurfaceVariant" },
    "DisabledIconOpacity": { "type": "opacity", "value": 0.38 },
    "DisabledLabelTextColor": { "type": "color", "value": "OnSurfaceVariant" },
    "DisabledLabelTextOpacity": { "type": "opacity", "value": 0.38 },
    "FocusedContainerElevation": { "type": "elevation", "value": "@ElevationTokens.Level1" },
    "HoveredContainerElevation": { "type": "elevation", "value": "@ElevationTokens.Level2" },
    "IconColor": { "type": "color", "value": "Primary" },
    "LabelTextColor": { "type": "color", "value": "Primary" },
    "LabelTextSelectedColor": { "type": "color", "value": "OnPrimary" },
    "LabelTextUnselectedColor": { "type": "color", "value": "Primary" },
    "PressedContainerElevation": { "type": "elevation", "value": "@ElevationTokens.Level1" },
    "SelectedContainerColor": { "type": "color", "value": "Primary" },
    "SelectedIconColor": { "type": "color", "value": "OnPrimary" },
    "UnselectedContainerColor": { "type": "color", "value": "SurfaceContainerLow" },
    // Transcribed as upstream has it. Note that every other unselected icon token in this file
    // (focused, hovered, pressed) is Primary, so OnPrimary here looks like an upstream slip;
    // it is kept faithful rather than silently corrected.
    "UnselectedIconColor": { "type": "color", "value": "OnPrimary" }
  }
}
