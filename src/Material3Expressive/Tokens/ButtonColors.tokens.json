{
  "kind": "component",
  "name": "ButtonColorTokens",
  "namespace": "Material3Expressive.Foundation",
  "resolvedName": "ButtonColors",
  "version": "v0_11_0",
  "source": "androidx compose/material3 tokens/{Filled,Tonal,Elevated,Outlined,Text}ButtonTokens.kt and ButtonDefaults",
  "summary": "The colours and elevations of one button variant.",

  "variantEnum": "ButtonVariant",
  "variantEnumSummary": "The five colour variants a button comes in.",

  "properties": {
    "ContainerColor": { "type": "color", "summary": "The container fill." },
    "LabelTextColor": { "type": "color", "summary": "The label colour, and the content colour the template hands down." },
    "IconColor": { "type": "color", "summary": "The colour of a leading or trailing icon." },
    "OutlineColor": { "type": "color", "summary": "The border colour. Transparent unless the variant is outlined." },
    "StateLayerColor": { "type": "color", "summary": "The colour of the hover, focus and press state layers — always the content colour in Material 3." },

    "DisabledContainerColor": { "type": "color", "opacity": "DisabledContainerOpacity", "summary": "The container fill when disabled, already scaled by its opacity." },
    "DisabledLabelTextColor": { "type": "color", "opacity": "DisabledLabelTextOpacity", "summary": "The label colour when disabled, already scaled by its opacity." },
    "DisabledIconColor": { "type": "color", "opacity": "DisabledIconOpacity", "summary": "The icon colour when disabled, already scaled by its opacity." },
    "DisabledOutlineColor": { "type": "color", "summary": "The border colour when disabled." },

    "DisabledContainerOpacity": { "type": "opacity", "summary": "Alpha applied to the disabled container colour." },
    "DisabledLabelTextOpacity": { "type": "opacity", "summary": "Alpha applied to the disabled label colour." },
    "DisabledIconOpacity": { "type": "opacity", "summary": "Alpha applied to the disabled icon colour." },

    "ContainerElevation": { "type": "elevation", "summary": "Resting elevation." },
    "HoveredContainerElevation": { "type": "elevation", "summary": "Elevation while hovered." },
    "FocusedContainerElevation": { "type": "elevation", "summary": "Elevation while focused." },
    "PressedContainerElevation": { "type": "elevation", "summary": "Elevation while pressed." },
    "DisabledContainerElevation": { "type": "elevation", "summary": "Elevation while disabled." },

    "HasOutline": { "type": "bool", "summary": "Whether this variant draws a border at the size's outline width." }
  },

  "sets": [
    {
      "name": "Filled",
      "summary": "High emphasis: a primary-coloured container.",
      "values": {
        "ContainerColor": "@FilledButtonTokens.ContainerColor",
        "LabelTextColor": "@FilledButtonTokens.LabelTextColor",
        "IconColor": "@FilledButtonTokens.IconColor",
        "OutlineColor": "#00000000",
        "StateLayerColor": "@FilledButtonTokens.LabelTextColor",
        "DisabledContainerColor": "@FilledButtonTokens.DisabledContainerColor",
        "DisabledLabelTextColor": "@FilledButtonTokens.DisabledLabelTextColor",
        "DisabledIconColor": "@FilledButtonTokens.DisabledIconColor",
        "DisabledOutlineColor": "#00000000",
        "DisabledContainerOpacity": "@FilledButtonTokens.DisabledContainerOpacity",
        "DisabledLabelTextOpacity": "@FilledButtonTokens.DisabledLabelTextOpacity",
        "DisabledIconOpacity": "@FilledButtonTokens.DisabledIconOpacity",
        "ContainerElevation": "@FilledButtonTokens.ContainerElevation",
        "HoveredContainerElevation": "@FilledButtonTokens.HoveredContainerElevation",
        "FocusedContainerElevation": "@FilledButtonTokens.FocusedContainerElevation",
        "PressedContainerElevation": "@FilledButtonTokens.PressedContainerElevation",
        "DisabledContainerElevation": "@FilledButtonTokens.DisabledContainerElevation",
        "HasOutline": false
      }
    },
    {
      "name": "Tonal",
      "extends": "Filled",
      "summary": "Medium emphasis: a secondary-container fill.",
      "values": {
        "ContainerColor": "@TonalButtonTokens.ContainerColor",
        "LabelTextColor": "@TonalButtonTokens.LabelTextColor",
        "IconColor": "@TonalButtonTokens.IconColor",
        "StateLayerColor": "@TonalButtonTokens.LabelTextColor",
        "DisabledContainerColor": "@TonalButtonTokens.DisabledContainerColor",
        "DisabledLabelTextColor": "@TonalButtonTokens.DisabledLabelTextColor",
        "DisabledIconColor": "@TonalButtonTokens.DisabledIconColor",
        "ContainerElevation": "@TonalButtonTokens.ContainerElevation",
        "HoveredContainerElevation": "@TonalButtonTokens.HoveredContainerElevation",
        "FocusedContainerElevation": "@TonalButtonTokens.FocusedContainerElevation",
        "PressedContainerElevation": "@TonalButtonTokens.PressedContainerElevation",
        "DisabledContainerElevation": "@TonalButtonTokens.DisabledContainerElevation"
      }
    },
    {
      "name": "Elevated",
      "extends": "Filled",
      "summary": "A low surface fill separated from the background by a shadow.",
      "values": {
        "ContainerColor": "@ElevatedButtonTokens.ContainerColor",
        "LabelTextColor": "@ElevatedButtonTokens.LabelTextColor",
        "IconColor": "@ElevatedButtonTokens.IconColor",
        "StateLayerColor": "@ElevatedButtonTokens.LabelTextColor",
        "DisabledContainerColor": "@ElevatedButtonTokens.DisabledContainerColor",
        "DisabledLabelTextColor": "@ElevatedButtonTokens.DisabledLabelTextColor",
        "DisabledIconColor": "@ElevatedButtonTokens.DisabledIconColor",
        "ContainerElevation": "@ElevatedButtonTokens.ContainerElevation",
        "HoveredContainerElevation": "@ElevatedButtonTokens.HoveredContainerElevation",
        "FocusedContainerElevation": "@ElevatedButtonTokens.FocusedContainerElevation",
        "PressedContainerElevation": "@ElevatedButtonTokens.PressedContainerElevation",
        "DisabledContainerElevation": "@ElevatedButtonTokens.DisabledContainerElevation"
      }
    },
    {
      "name": "Outlined",
      "extends": "Filled",
      // ButtonDefaults.outlinedButtonColors pins both container colours to transparent rather than
      // reading OutlinedButtonTokens, which only defines the selected/toggle containers.
      "summary": "A transparent container behind an outline.",
      "values": {
        "ContainerColor": "#00000000",
        "LabelTextColor": "@OutlinedButtonTokens.LabelTextColor",
        "IconColor": "@OutlinedButtonTokens.IconColor",
        "OutlineColor": "@OutlinedButtonTokens.OutlineColor",
        "StateLayerColor": "@OutlinedButtonTokens.LabelTextColor",
        "DisabledContainerColor": "#00000000",
        "DisabledLabelTextColor": "@OutlinedButtonTokens.DisabledLabelTextColor",
        "DisabledIconColor": "@OutlinedButtonTokens.DisabledIconColor",
        "DisabledOutlineColor": "@OutlinedButtonTokens.DisabledOutlineColor",
        "DisabledContainerOpacity": "@OutlinedButtonTokens.DisabledContainerOpacity",
        "DisabledLabelTextOpacity": "@OutlinedButtonTokens.DisabledLabelTextOpacity",
        "DisabledIconOpacity": "@OutlinedButtonTokens.DisabledIconOpacity",
        "ContainerElevation": "@ElevationTokens.Level0",
        "HoveredContainerElevation": "@ElevationTokens.Level0",
        "FocusedContainerElevation": "@ElevationTokens.Level0",
        "PressedContainerElevation": "@ElevationTokens.Level0",
        "DisabledContainerElevation": "@ElevationTokens.Level0",
        "HasOutline": true
      }
    },
    {
      "name": "Text",
      "extends": "Outlined",
      "summary": "Lowest emphasis: label only.",
      "values": {
        // ButtonDefaults.textButtonColors overrides TextButtonTokens.LabelColor with Primary and
        // marks the token as awaiting correction upstream. Primary is what actually ships.
        "LabelTextColor": "Primary",
        "IconColor": "Primary",
        "StateLayerColor": "Primary",
        "OutlineColor": "#00000000",
        "DisabledLabelTextColor": "@TextButtonTokens.DisabledLabelColor",
        "DisabledIconColor": "@TextButtonTokens.DisabledIconColor",
        "DisabledOutlineColor": "#00000000",
        "DisabledContainerOpacity": "@TextButtonTokens.DisabledContainerOpacity",
        "DisabledLabelTextOpacity": "@TextButtonTokens.DisabledLabelOpacity",
        "DisabledIconOpacity": "@TextButtonTokens.DisabledIconOpacity",
        "HasOutline": false
      }
    }
  ]
}
