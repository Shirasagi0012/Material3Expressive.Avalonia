{
  "kind": "component",
  "name": "IconButtonColorTokens",
  "namespace": "Material3Expressive.Foundation",
  "resolvedName": "IconButtonColors",
  "version": "14_1_0",
  "source": "androidx compose/material3 tokens/{,Filled,FilledTonal,Outlined}IconButtonTokens.kt",
  "summary": "The colours of one icon button variant, including its selected and unselected toggle states.",

  "variantEnum": "IconButtonVariant",
  "variantEnumSummary": "The four icon button variants.",

  "properties": {
    "ContainerColor": { "type": "color", "summary": "The container fill." },
    "IconColor": { "type": "color", "summary": "The icon." },
    "OutlineColor": { "type": "color", "summary": "The border. Transparent unless the variant is outlined." },
    "StateLayerColor": { "type": "color", "summary": "The state layer, which is the icon colour." },

    "DisabledContainerColor": { "type": "color", "opacity": "DisabledContainerOpacity", "summary": "The container when disabled." },
    "DisabledIconColor": { "type": "color", "opacity": "DisabledIconOpacity", "summary": "The icon when disabled." },
    "DisabledOutlineColor": { "type": "color", "summary": "The border when disabled." },
    "DisabledContainerOpacity": { "type": "opacity", "summary": "Alpha applied to the disabled container." },
    "DisabledIconOpacity": { "type": "opacity", "summary": "Alpha applied to the disabled icon." },

    "SelectedContainerColor": { "type": "color", "summary": "The container of a selected toggle." },
    "SelectedIconColor": { "type": "color", "summary": "The icon of a selected toggle." },
    "UnselectedContainerColor": { "type": "color", "summary": "The container of an unselected toggle." },
    "UnselectedIconColor": { "type": "color", "summary": "The icon of an unselected toggle." },
    "UnselectedOutlineColor": { "type": "color", "summary": "The border of an unselected toggle." },

    "HasOutline": { "type": "bool", "summary": "Whether this variant draws a border." }
  },

  "sets": [
    {
      "name": "Standard",
      "summary": "No container: an icon on its own.",
      "values": {
        "ContainerColor": "#00000000",
        "IconColor": "@IconButtonTokens.Color",
        "OutlineColor": "#00000000",
        "StateLayerColor": "@IconButtonTokens.Color",
        "DisabledContainerColor": "#00000000",
        "DisabledIconColor": "@IconButtonTokens.DisabledColor",
        "DisabledOutlineColor": "#00000000",
        "DisabledContainerOpacity": 1,
        "DisabledIconOpacity": "@IconButtonTokens.DisabledOpacity",
        "SelectedContainerColor": "#00000000",
        "SelectedIconColor": "@IconButtonTokens.SelectedColor",
        "UnselectedContainerColor": "#00000000",
        "UnselectedIconColor": "@IconButtonTokens.UnselectedColor",
        "UnselectedOutlineColor": "#00000000",
        "HasOutline": false
      }
    },
    {
      "name": "Filled",
      "extends": "Standard",
      "summary": "High emphasis: a primary-coloured container.",
      "values": {
        "ContainerColor": "@FilledIconButtonTokens.ContainerColor",
        "IconColor": "@FilledIconButtonTokens.Color",
        "StateLayerColor": "@FilledIconButtonTokens.Color",
        "DisabledContainerColor": "@FilledIconButtonTokens.DisabledContainerColor",
        "DisabledIconColor": "@FilledIconButtonTokens.DisabledColor",
        "DisabledContainerOpacity": "@FilledIconButtonTokens.DisabledContainerOpacity",
        "DisabledIconOpacity": "@FilledIconButtonTokens.DisabledOpacity",
        "SelectedContainerColor": "@FilledIconButtonTokens.SelectedContainerColor",
        "SelectedIconColor": "@FilledIconButtonTokens.SelectedColor",
        "UnselectedContainerColor": "@FilledIconButtonTokens.UnselectedContainerColor",
        "UnselectedIconColor": "@FilledIconButtonTokens.UnselectedColor"
      }
    },
    {
      "name": "Tonal",
      "extends": "Standard",
      "summary": "Medium emphasis: a secondary-container fill.",
      "values": {
        "ContainerColor": "@FilledTonalIconButtonTokens.ContainerColor",
        "IconColor": "@FilledTonalIconButtonTokens.Color",
        "StateLayerColor": "@FilledTonalIconButtonTokens.Color",
        "DisabledContainerColor": "@FilledTonalIconButtonTokens.DisabledContainerColor",
        "DisabledIconColor": "@FilledTonalIconButtonTokens.DisabledColor",
        "DisabledContainerOpacity": "@FilledTonalIconButtonTokens.DisabledContainerOpacity",
        "DisabledIconOpacity": "@FilledTonalIconButtonTokens.DisabledOpacity",
        "SelectedContainerColor": "@FilledTonalIconButtonTokens.SelectedContainerColor",
        "SelectedIconColor": "@FilledTonalIconButtonTokens.SelectedColor",
        "UnselectedContainerColor": "@FilledTonalIconButtonTokens.UnselectedContainerColor",
        "UnselectedIconColor": "@FilledTonalIconButtonTokens.UnselectedColor"
      }
    },
    {
      "name": "Outlined",
      "extends": "Standard",
      "summary": "A transparent container behind an outline; selected, it inverts.",
      "values": {
        "IconColor": "@OutlinedIconButtonTokens.Color",
        "OutlineColor": "@OutlinedIconButtonTokens.OutlineColor",
        "StateLayerColor": "@OutlinedIconButtonTokens.Color",
        "DisabledIconColor": "@OutlinedIconButtonTokens.DisabledColor",
        "DisabledOutlineColor": "@OutlinedIconButtonTokens.DisabledOutlineColor",
        "DisabledIconOpacity": "@OutlinedIconButtonTokens.DisabledOpacity",
        "SelectedContainerColor": "@OutlinedIconButtonTokens.SelectedContainerColor",
        "SelectedIconColor": "@OutlinedIconButtonTokens.SelectedColor",
        "UnselectedIconColor": "@OutlinedIconButtonTokens.UnselectedColor",
        "UnselectedOutlineColor": "@OutlinedIconButtonTokens.UnselectedOutlineColor",
        "HasOutline": true
      }
    }
  ]
}
