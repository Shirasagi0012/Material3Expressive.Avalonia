{
  "kind": "component",
  "name": "FabColorTokens",
  "namespace": "Material3Expressive.Foundation",
  "resolvedName": "FabColors",
  "version": "v0_14_0",
  "source": "androidx compose/material3 tokens/Fab{Primary,Secondary,Tertiary}ContainerTokens.kt",
  "summary": "The colours and elevations of one floating action button variant.",

  "variantEnum": "FabVariant",
  "variantEnumSummary": "Which container colour the FAB takes.",

  "properties": {
    "ContainerColor": { "type": "color", "summary": "The container fill." },
    "IconColor": { "type": "color", "summary": "The icon, and the label on an extended FAB." },
    "StateLayerColor": { "type": "color", "summary": "The state layer, which is the icon colour." },

    "ContainerElevation": { "type": "elevation", "summary": "Resting elevation." },
    "HoveredContainerElevation": { "type": "elevation", "summary": "Elevation while hovered." },
    "FocusedContainerElevation": { "type": "elevation", "summary": "Elevation while focused." },
    "PressedContainerElevation": { "type": "elevation", "summary": "Elevation while pressed." },
    "LoweredContainerElevation": { "type": "elevation", "summary": "Elevation in the lowered style, used when the FAB sits on a scrolling surface." }
  },

  "sets": [
    {
      "name": "Primary",
      "summary": "The default: a primary-container fill.",
      "values": {
        "ContainerColor": "@FabPrimaryContainerTokens.ContainerColor",
        "IconColor": "@FabPrimaryContainerTokens.IconColor",
        "StateLayerColor": "@FabPrimaryContainerTokens.IconColor",
        "ContainerElevation": "@FabPrimaryContainerTokens.ContainerElevation",
        "HoveredContainerElevation": "@FabPrimaryContainerTokens.HoveredContainerElevation",
        "FocusedContainerElevation": "@FabPrimaryContainerTokens.FocusedContainerElevation",
        "PressedContainerElevation": "@FabPrimaryContainerTokens.PressedContainerElevation",
        "LoweredContainerElevation": "@FabPrimaryContainerTokens.LoweredContainerElevation"
      }
    },
    {
      "name": "Secondary",
      "extends": "Primary",
      "values": {
        "ContainerColor": "@FabSecondaryContainerTokens.ContainerColor",
        "IconColor": "@FabSecondaryContainerTokens.IconColor",
        "StateLayerColor": "@FabSecondaryContainerTokens.IconColor"
      }
    },
    {
      "name": "Tertiary",
      "extends": "Primary",
      // Upstream ships no FabTertiaryContainerTokens file; the tertiary FAB is documented in the
      // spec and built from the tertiary roles directly.
      "values": {
        "ContainerColor": "TertiaryContainer",
        "IconColor": "OnTertiaryContainer",
        "StateLayerColor": "OnTertiaryContainer"
      }
    },
    {
      "name": "Surface",
      "extends": "Primary",
      "summary": "The neutral FAB, for surfaces where a coloured one would compete.",
      "values": {
        "ContainerColor": "SurfaceContainerHigh",
        "IconColor": "Primary",
        "StateLayerColor": "Primary"
      }
    }
  ]
}
