{
  "kind": "component",
  "name": "TypeScale",
  "namespace": "Material3Expressive.Foundation",
  "version": "v0_103",
  "source": "androidx compose/material3 tokens/TypeScaleTokens.kt",
  "summary": "One slot of the type scale: its metrics plus the typeface and weight it is set in.",

  "variantEnum": "TypographyRole",
  "variantEnumSummary": "The fifteen Material type scale slots, each with an emphasized counterpart.",

  "properties": {
    "FontSize": { "type": "dimension", "summary": "Font size, in logical pixels." },
    "LineHeight": { "type": "dimension", "summary": "Line height, in logical pixels." },
    "LetterSpacing": { "type": "dimension", "summary": "Tracking, in logical pixels." },
    "Font": {
      "type": "enum",
      "enumType": "Material3Expressive.Foundation.Tokens.FontFamilyToken",
      "summary": "Which of the theme's four typefaces this slot uses."
    },
    "Weight": {
      "type": "enum",
      "enumType": "Material3Expressive.Foundation.Tokens.FontWeightToken",
      "summary": "Which of the theme's three weights this slot uses."
    }
  },

  // Upstream's TypefaceTokens has only Brand and Plain; the emphasized slots reuse them with a
  // heavier weight. The scheme here keeps EmphasizedBrand and EmphasizedPlain as separate slots so
  // an app can supply a distinct emphasized face — a Roboto Flex instance, say — and they default
  // to the same families, so the out-of-the-box result matches upstream.
  "sets": [
    { "name": "DisplayLarge", "values": { "FontSize": 57, "LineHeight": 64, "LetterSpacing": -0.2, "Font": "Brand", "Weight": "Regular" } },
    { "name": "DisplayMedium", "values": { "FontSize": 45, "LineHeight": 52, "LetterSpacing": 0, "Font": "Brand", "Weight": "Regular" } },
    { "name": "DisplaySmall", "values": { "FontSize": 36, "LineHeight": 44, "LetterSpacing": 0, "Font": "Brand", "Weight": "Regular" } },

    { "name": "HeadlineLarge", "values": { "FontSize": 32, "LineHeight": 40, "LetterSpacing": 0, "Font": "Brand", "Weight": "Regular" } },
    { "name": "HeadlineMedium", "values": { "FontSize": 28, "LineHeight": 36, "LetterSpacing": 0, "Font": "Brand", "Weight": "Regular" } },
    { "name": "HeadlineSmall", "values": { "FontSize": 24, "LineHeight": 32, "LetterSpacing": 0, "Font": "Brand", "Weight": "Regular" } },

    { "name": "TitleLarge", "values": { "FontSize": 22, "LineHeight": 28, "LetterSpacing": 0, "Font": "Brand", "Weight": "Regular" } },
    { "name": "TitleMedium", "values": { "FontSize": 16, "LineHeight": 24, "LetterSpacing": 0.2, "Font": "Plain", "Weight": "Medium" } },
    { "name": "TitleSmall", "values": { "FontSize": 14, "LineHeight": 20, "LetterSpacing": 0.1, "Font": "Plain", "Weight": "Medium" } },

    { "name": "BodyLarge", "values": { "FontSize": 16, "LineHeight": 24, "LetterSpacing": 0.5, "Font": "Plain", "Weight": "Regular" } },
    { "name": "BodyMedium", "values": { "FontSize": 14, "LineHeight": 20, "LetterSpacing": 0.2, "Font": "Plain", "Weight": "Regular" } },
    { "name": "BodySmall", "values": { "FontSize": 12, "LineHeight": 16, "LetterSpacing": 0.4, "Font": "Plain", "Weight": "Regular" } },

    { "name": "LabelLarge", "values": { "FontSize": 14, "LineHeight": 20, "LetterSpacing": 0.1, "Font": "Plain", "Weight": "Medium" } },
    { "name": "LabelMedium", "values": { "FontSize": 12, "LineHeight": 16, "LetterSpacing": 0.5, "Font": "Plain", "Weight": "Medium" } },
    { "name": "LabelSmall", "values": { "FontSize": 11, "LineHeight": 16, "LetterSpacing": 0.5, "Font": "Plain", "Weight": "Medium" } },

    { "name": "DisplayLargeEmphasized", "values": { "FontSize": 57, "LineHeight": 64, "LetterSpacing": 0, "Font": "EmphasizedBrand", "Weight": "Medium" } },
    { "name": "DisplayMediumEmphasized", "values": { "FontSize": 45, "LineHeight": 52, "LetterSpacing": 0, "Font": "EmphasizedBrand", "Weight": "Medium" } },
    { "name": "DisplaySmallEmphasized", "values": { "FontSize": 36, "LineHeight": 44, "LetterSpacing": 0, "Font": "EmphasizedBrand", "Weight": "Medium" } },

    { "name": "HeadlineLargeEmphasized", "values": { "FontSize": 32, "LineHeight": 40, "LetterSpacing": 0, "Font": "EmphasizedBrand", "Weight": "Medium" } },
    { "name": "HeadlineMediumEmphasized", "values": { "FontSize": 28, "LineHeight": 36, "LetterSpacing": 0, "Font": "EmphasizedBrand", "Weight": "Medium" } },
    { "name": "HeadlineSmallEmphasized", "values": { "FontSize": 24, "LineHeight": 32, "LetterSpacing": 0, "Font": "EmphasizedBrand", "Weight": "Medium" } },

    { "name": "TitleLargeEmphasized", "values": { "FontSize": 22, "LineHeight": 28, "LetterSpacing": 0, "Font": "EmphasizedBrand", "Weight": "Medium" } },
    { "name": "TitleMediumEmphasized", "values": { "FontSize": 16, "LineHeight": 24, "LetterSpacing": 0.15, "Font": "EmphasizedPlain", "Weight": "Bold" } },
    { "name": "TitleSmallEmphasized", "values": { "FontSize": 14, "LineHeight": 20, "LetterSpacing": 0.1, "Font": "EmphasizedPlain", "Weight": "Bold" } },

    { "name": "BodyLargeEmphasized", "values": { "FontSize": 16, "LineHeight": 24, "LetterSpacing": 0.15, "Font": "EmphasizedPlain", "Weight": "Medium" } },
    { "name": "BodyMediumEmphasized", "values": { "FontSize": 14, "LineHeight": 20, "LetterSpacing": 0.25, "Font": "EmphasizedPlain", "Weight": "Medium" } },
    { "name": "BodySmallEmphasized", "values": { "FontSize": 12, "LineHeight": 16, "LetterSpacing": 0.4, "Font": "EmphasizedPlain", "Weight": "Medium" } },

    { "name": "LabelLargeEmphasized", "values": { "FontSize": 14, "LineHeight": 20, "LetterSpacing": 0.1, "Font": "EmphasizedPlain", "Weight": "Bold" } },
    { "name": "LabelMediumEmphasized", "values": { "FontSize": 12, "LineHeight": 16, "LetterSpacing": 0.5, "Font": "EmphasizedPlain", "Weight": "Bold" } },
    { "name": "LabelSmallEmphasized", "values": { "FontSize": 11, "LineHeight": 16, "LetterSpacing": 0.5, "Font": "EmphasizedPlain", "Weight": "Bold" } }
  ]
}
