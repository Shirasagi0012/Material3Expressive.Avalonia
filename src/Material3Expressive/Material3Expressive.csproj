<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Shirasagi0012.Material3Expressive.Avalonia</PackageId>
        <Version>0.2.0-alpha</Version>
        <Authors>Shirasagi0012</Authors>
        <Description>Material 3 Expressive for Avalonia, ported from androidx.compose.material3</Description>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>avalonia;material-design;material3;material-you;expressive;theming;dynamic-color</PackageTags>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\packages</PackageOutputPath>
        <PackageProjectUrl>https://github.com/Shirasagi0012/Material3Expressive.Avalonia</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Shirasagi0012/Material3Expressive.Avalonia</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="README.md" />
        <None Include="../../LICENSE.txt" Pack="true" PackagePath="LICENSE.txt" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="PropertyGenerator.Avalonia"/>
    </ItemGroup>

    <ItemGroup Condition="'$(ContinuousIntegrationBuild)' != 'true'">
        <ProjectReference Include="..\..\modules\MaterialColorUtilities\MaterialColorUtilities.Avalonia\MaterialColorUtilities.Avalonia.csproj"/>
        <ProjectReference Include="..\..\modules\MaterialColorUtilities\MaterialDesignTokens.Avalonia\MaterialDesignTokens.Avalonia.csproj"/>
        <!-- LoadingIndicator is the one component that genuinely morphs polygons. Button, FAB and
             chip press morphs are corner-radius lerps, and the wavy progress indicator's wave is a
             sampled sine — none of them need this. -->
        <ProjectReference Include="..\..\modules\MaterialShapes\MaterialShapes\MaterialShapes.csproj"/>
        <!-- Material Symbols Rounded is the first-party icon family for Material 3 Expressive.
             It also moves the resolved render stack onto the repository's pinned SkiaSharp 4
             baseline so variable fill, weight, grade and optical size remain available. -->
        <ProjectReference Include="..\..\modules\MaterialSymbols\MaterialSymbols.Avalonia.Rounded\MaterialSymbols.Avalonia.Rounded.csproj"/>
    </ItemGroup>

    <ItemGroup Condition="'$(ContinuousIntegrationBuild)' == 'true'">
        <PackageReference Include="Shirasagi0012.MaterialColorUtilities.Avalonia" />
        <PackageReference Include="Shirasagi0012.MaterialDesignTokens.Avalonia" />
        <PackageReference Include="Shirasagi0012.MaterialShapes" />
        <PackageReference Include="Shirasagi0012.MaterialSymbols.Avalonia.Rounded" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\modules\MaterialSkiaShadow\MaterialSkiaShadow.csproj"/>
        <ProjectReference Include="..\Material3Expressive.TokenGenerator\Material3Expressive.TokenGenerator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!-- The token tables are the source of truth for every token in the library; the generator
         turns each into its C# form at build time. -->
    <ItemGroup>
        <AdditionalFiles Include="Tokens\**\*.ref.jsonc" />
        <AdditionalFiles Include="Tokens\**\*.sys.jsonc" />
        <AdditionalFiles Include="Tokens\**\*.comp.jsonc" />
        <!-- ProjectReference builds do not import a dependency package's buildTransitive assets. -->
        <AdditionalFiles Include="..\..\modules\MaterialColorUtilities\MaterialColorUtilities.Avalonia\buildTransitive\MaterialColorUtilities.Avalonia.canonical-tokens.json"
                         Condition="'$(ContinuousIntegrationBuild)' != 'true'" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Styles\Foundation\" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Styles\MaterialStyles.axaml.cs">
        <DependentUpon>MaterialStyles.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
    </ItemGroup>

    <!--
      New-token architecture migration boundary.

      These component families still use the legacy ResolvedTheme/defaults transport as their
      authoritative value source. Keep them out of the production assembly until each family has
      a complete Raw -> MaterialValue -> DynamicResource path. This list is deliberately central
      and must shrink one family at a time; do not add compatibility shims to make an excluded
      component compile against the new runtime.
    -->
    <ItemGroup Label="NewTokenArchitectureComponentExclusions">
        <!-- Keep the active assembly deliberately small while the old component transport is
             removed. Scaffold has no token dependency and remains as a layout-only control. -->
        <Compile Remove="Controls\*.cs" />
        <Compile Remove="Controls\**\*.cs" />
        <Compile Include="Controls\MaterialScaffold.cs" />
        <Compile Include="Controls\MaterialScaffoldPanel.cs" />
        <Compile Include="Controls\Automation\MaterialScaffoldAutomationPeer.cs" />
        <Compile Include="Controls\IVisualBoundsProbe.cs" />
        <Compile Include="Controls\MaterialDivider.cs" />
        <Compile Include="Controls\MaterialSurface.cs" />
        <Compile Include="Controls\Defaults\DividerValueKeys.cs" />
        <Compile Include="Controls\Defaults\SurfaceValueKeys.cs" />
        <Compile Include="Controls\Interaction\MaterialContainer.cs" />

        <Compile Remove="Controls\Automation\MaterialBottomSheetScaffoldAutomationPeer.cs" />
        <Compile Remove="Controls\Automation\MaterialExposedDropdownMenuAutomationPeer.cs" />
        <Compile Remove="Controls\Automation\MaterialFloatingToolbarAutomationPeer.cs" />
        <Compile Remove="Controls\Automation\MaterialPullToRefreshBoxAutomationPeer.cs" />
        <Compile Remove="Controls\Automation\MaterialSwipeToDismissBoxAutomationPeer.cs" />

        <Compile Remove="Controls\Defaults\CarouselDefaults.cs" />
        <Compile Remove="Controls\Defaults\PickerDefaults.cs" />
        <Compile Remove="Controls\Defaults\SplitButtonDefaults.cs" />

        <Compile Remove="Controls\MaterialBottomSheetScaffold.cs" />
        <Compile Remove="Controls\MaterialBottomSheetScaffoldPanel.cs" />
        <Compile Remove="Controls\MaterialCarousel.cs" />
        <Compile Remove="Controls\MaterialDateInput.cs" />
        <Compile Remove="Controls\MaterialDatePicker.cs" />
        <Compile Remove="Controls\MaterialDateRangeInput.cs" />
        <Compile Remove="Controls\MaterialDialog.cs" />
        <Compile Remove="Controls\MaterialExposedDropdownMenu.cs" />
        <Compile Remove="Controls\MaterialFloatingToolbar.cs" />
        <Compile Remove="Controls\MaterialPullToRefreshBox.cs" />
        <Compile Remove="Controls\MaterialSplitButton.cs" />
        <Compile Remove="Controls\MaterialSwipeToDismissBox.cs" />
        <Compile Remove="Controls\MaterialTimeInput.cs" />
        <Compile Remove="Controls\MaterialTimePicker.cs" />
        <Compile Remove="Controls\PickerStates.cs" />

        <!-- Partially migrated controls still obtain shape, motion, typography, or interaction
             state from the legacy controller. Keep them out until their entire value surface is
             typed; excluding only the colour path would leave the old transport authoritative. -->
        <Compile Remove="Controls\MaterialAppBar.cs" />
        <Compile Remove="Controls\MaterialBadge.cs" />
        <Compile Remove="Controls\MaterialBottomSheet.cs" />
        <Compile Remove="Controls\MaterialButtonContainerPresenter.cs" />
        <Compile Remove="Controls\MaterialCard.cs" />
        <Compile Remove="Controls\MaterialCheckbox.cs" />
        <Compile Remove="Controls\MaterialChip.cs" />
        <Compile Remove="Controls\MaterialCircularProgressIndicator.cs" />
        <Compile Remove="Controls\MaterialFab.cs" />
        <Compile Remove="Controls\MaterialFabMenu.cs" />
        <Compile Remove="Controls\MaterialIconButtonContainerPresenter.cs" />
        <Compile Remove="Controls\MaterialLinearProgressIndicator.cs" />
        <Compile Remove="Controls\MaterialListItem.cs" />
        <Compile Remove="Controls\MaterialListItemPanel.cs" />
        <Compile Remove="Controls\MaterialLoadingIndicator.cs" />
        <Compile Remove="Controls\MaterialNavigationBar.cs" />
        <Compile Remove="Controls\MaterialNavigationDrawer.cs" />
        <Compile Remove="Controls\MaterialNavigationItem.cs" />
        <Compile Remove="Controls\MaterialNavigationSuiteScaffold.cs" />
        <Compile Remove="Controls\MaterialRadioButton.cs" />
        <Compile Remove="Controls\MaterialSearchBar.cs" />
        <Compile Remove="Controls\MaterialSegmentedButton.cs" />
        <Compile Remove="Controls\MaterialSegmentedButtonRow.cs" />
        <Compile Remove="Controls\MaterialSegmentedList.cs" />
        <Compile Remove="Controls\MaterialShortNavigationBar.cs" />
        <Compile Remove="Controls\MaterialSlider.cs" />
        <Compile Remove="Controls\MaterialSnackbarHost.cs" />
        <Compile Remove="Controls\MaterialSwitch.cs" />
        <Compile Remove="Controls\MaterialTabs.cs" />
        <Compile Remove="Controls\MaterialTextField.cs" />
        <Compile Remove="Controls\MaterialWideNavigationRail.cs" />
        <Compile Remove="Controls\MaterialSecureTextField.cs" />
        <Compile Remove="Controls\M3Button.cs" />
        <Compile Remove="Controls\M3IconButton.cs" />
        <Compile Remove="Controls\M3ToggleButton.cs" />
        <Compile Remove="Controls\M3ToggleIconButton.cs" />
        <Compile Remove="Controls\MaterialToggleButtonContainerPresenter.cs" />

        <Compile Remove="Controls\Automation\MaterialAppBarAutomationPeer.cs" />
        <Compile Remove="Controls\Automation\MaterialListItemAutomationPeer.cs" />
        <Compile Remove="Controls\Automation\MaterialNavigationItemAutomationPeer.cs" />
        <Compile Remove="Controls\Automation\MaterialNavigationSuiteScaffoldAutomationPeer.cs" />
        <Compile Remove="Controls\Automation\MaterialProgressIndicatorAutomationPeer.cs" />
        <Compile Remove="Controls\Automation\MaterialSegmentedButtonAutomationPeer.cs" />
        <Compile Remove="Controls\Automation\MaterialSegmentedButtonRowAutomationPeer.cs" />
        <Compile Remove="Controls\Automation\MaterialShortNavigationBarAutomationPeer.cs" />
        <Compile Remove="Controls\Automation\MaterialWideNavigationRailAutomationPeer.cs" />
        <Compile Remove="Controls\Automation\MaterialSegmentedListAutomationPeer.cs" />
        <Compile Remove="Controls\Automation\MaterialSnackbarHostAutomationPeer.cs" />
        <Compile Remove="Controls\Automation\MaterialSecureTextFieldAutomationPeer.cs" />

        <!-- Avalonia's SDK discovers .axaml files as AvaloniaXaml items. Remove the whole
             component directory, then restore only complete component slices. -->
        <AvaloniaXaml Remove="Styles\Components\*.axaml" />
        <AvaloniaXaml Include="Styles\Components\Scaffold.axaml" />
        <AvaloniaXaml Include="Styles\Components\Surface.axaml" />
    </ItemGroup>

</Project>
