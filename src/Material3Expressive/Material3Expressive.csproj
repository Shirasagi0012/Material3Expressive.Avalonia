<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Shirasagi0012.Material3Expressive.Avalonia</PackageId>
        <Version>0.0.4</Version>
        <Authors>Shirasagi0012</Authors>
        <Description>Material 3 Expressive theme and controls for Avalonia, ported from Compose Material3.</Description>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>avalonia;material-design;material3;material-you;expressive;theming;dynamic-color</PackageTags>
        <PackageProjectUrl>https://github.com/Shirasagi0012/Material3Expressive.Avalonia</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Shirasagi0012/Material3Expressive.Avalonia</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="PropertyGenerator.Avalonia"/>
        <PackageReference Include="Shirasagi0012.MaterialColorUtilities" />
        <!-- Material Symbols Rounded is the first-party icon family for Material 3 Expressive.
             It also moves the resolved render stack onto the repository's pinned SkiaSharp 4
             baseline so variable fill, weight, grade and optical size remain available. -->
        <PackageReference Include="Shirasagi0012.MaterialSymbols.Avalonia.Rounded" />
        <PackageReference Include="Shirasagi0012.SmoothScroll.Avalonia" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../modules/ComposeAnimation/ComposeAnimation.Avalonia/ComposeAnimation.Avalonia.csproj" />

        <ProjectReference Include="../../modules/MaterialShapes/MaterialShapes/MaterialShapes.csproj" />
        <ProjectReference Include="../../modules/MaterialSkiaShadow/MaterialSkiaShadow.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="README.md" />
        <None Include="../../LICENSE.txt" Pack="true" PackagePath="LICENSE.txt" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Material3Expressive.Tests" />
        <InternalsVisibleTo Include="Material3Expressive.Parity" />
    </ItemGroup>

</Project>
