<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Token tables carry the documentation for what they generate; the emitted members
             repeat it, so an undocumented-member warning per token would be noise. -->
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Shirasagi0012.Material3Expressive.Avalonia</PackageId>
        <Version>0.1.0-alpha</Version>
        <Authors>Shirasagi0012</Authors>
        <Description>Material 3 Expressive for Avalonia: dynamic colour, the type scale, shape and motion schemes, spring-driven interaction, and components generated from the Material token tables.</Description>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>avalonia;material-design;material3;material-you;expressive;theming;dynamic-color</PackageTags>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
        <PackageProjectUrl>https://github.com/Shirasagi0012/Material3Expressive.Avalonia</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Shirasagi0012/Material3Expressive.Avalonia</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="README.md" />
        <None Include="../../LICENSE.txt" Pack="true" PackagePath="LICENSE.txt" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="PropertyGenerator.Avalonia"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\modules\MaterialColorUtilities\MaterialColorUtilities.Avalonia\MaterialColorUtilities.Avalonia.csproj"/>
        <!-- MaterialShapes joins in phase 3, when LoadingIndicator and wavy progress need polygon
             morphing. Button/FAB/Chip press morphs are corner-radius lerps and do not. -->
        <ProjectReference Include="..\Material3Expressive.TokenGenerator\Material3Expressive.TokenGenerator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!-- The token tables are the source of truth for every token in the library; the generator
         turns each into its C# form at build time. -->
    <ItemGroup>
        <AdditionalFiles Include="Tokens\**\*.tokens.json"/>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Markups\Components\" />
      <Folder Include="Styles\Foundation\" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Styles\MaterialStyles.axaml.cs">
        <DependentUpon>MaterialStyles.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
    </ItemGroup>

</Project>
