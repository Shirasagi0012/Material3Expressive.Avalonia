<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="PropertyGenerator.Avalonia"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\modules\MaterialColorUtilities\MaterialColorUtilities.Avalonia\MaterialColorUtilities.Avalonia.csproj"/>
        <!-- MaterialShapes joins in phase 3, when LoadingIndicator and wavy progress need polygon
             morphing. Button/FAB/Chip press morphs are corner-radius lerps and do not. -->
        <ProjectReference Include="..\Material3Expressive.TokenGenerator\Material3Expressive.TokenGenerator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!-- The token tables are the source of truth for every token in the library; the generator
         turns each into its C# form at build time. -->
    <ItemGroup>
        <AdditionalFiles Include="Tokens\**\*.tokens.json"/>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Markups\Components\" />
      <Folder Include="Styles\Foundation\" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Styles\MaterialStyles.axaml.cs">
        <DependentUpon>MaterialStyles.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
    </ItemGroup>

</Project>
