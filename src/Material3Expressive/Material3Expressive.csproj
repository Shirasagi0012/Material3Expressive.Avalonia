<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="ComposeAnimation.Avalonia"/>
        <PackageReference Include="PropertyGenerator.Avalonia"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\modules\MaterialColorUtilities\MaterialColorUtilities\MaterialColorUtilities.csproj"/>
        <!-- Material Symbols Rounded is the first-party icon family for Material 3 Expressive.
             It also moves the resolved render stack onto the repository's pinned SkiaSharp 4
             baseline so variable fill, weight, grade and optical size remain available. -->
        <ProjectReference Include="..\..\modules\MaterialSymbols\MaterialSymbols.Avalonia.Rounded\MaterialSymbols.Avalonia.Rounded.csproj"/>
        
        <ProjectReference Include="..\..\modules\MaterialShapes\MaterialShapes\MaterialShapes.csproj" />
        <ProjectReference Include="..\..\modules\MaterialSkiaShadow\MaterialSkiaShadow.csproj"/>
        <ProjectReference Include="..\..\modules\SmoothScroll.Avalonia\src\SmoothScroll.Avalonia.Controls\SmoothScroll.Avalonia.Controls.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Material3Expressive.Tests" />
        <InternalsVisibleTo Include="MaterialScrollProbe" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="MaterialTheme.axaml.cs">
        <DependentUpon>MaterialTheme.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
    </ItemGroup>

</Project>
