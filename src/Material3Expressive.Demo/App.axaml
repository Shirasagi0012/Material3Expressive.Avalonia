<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Material3Expressive.Demo.App"
             xmlns:local="using:Material3Expressive.Demo"
             xmlns:m3t="clr-namespace:Material3Expressive.Themes;assembly=Material3Expressive"
             xmlns:mcu="clr-namespace:MaterialColorUtilities.Avalonia;assembly=MaterialColorUtilities.Avalonia"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
    
    <m3t:MaterialTheme.Theme>
        <m3t:MaterialTheme 
            ColorScheme="{mcu:TonalSpotScheme {DynamicResource SystemAccentColor}}"
            TypographyScheme="{m3t:Typography}"/>
    </m3t:MaterialTheme.Theme>
</Application>
