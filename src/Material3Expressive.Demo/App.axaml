<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Material3Expressive.Demo.App"
             xmlns:local="using:Material3Expressive.Demo"
             xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
             xmlns:mcu="https://github.com/Shirasagi0012/MaterialColorUtilities.Avalonia"
             xmlns:foundation="clr-namespace:Material3Expressive.Foundation;assembly=Material3Expressive"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <m3:MaterialStyles />
    </Application.Styles>
    
    <foundation:MaterialThemeScope.Theme>
        <foundation:MaterialTheme 
            ColorScheme="{mcu:TonalSpotScheme {DynamicResource SystemAccentColor}}"
            TypographyScheme="{foundation:TypographyScheme}">
            <foundation:MaterialTheme.ButtonTokens>
                <foundation:ButtonTokens
                    ContainerBrush="{mcu:MdSysColor Primary}"
                    ForegroundBrush="{mcu:MdSysColor OnPrimary}"
                    DisabledContainerBrush="{mcu:MdSysColor SurfaceContainerHigh}"
                    DisabledForegroundBrush="{mcu:MdSysColor OnSurface}"
                    StateLayerBrush="{mcu:MdSysColor OnPrimary}" />
            </foundation:MaterialTheme.ButtonTokens>
        </foundation:MaterialTheme>
    </foundation:MaterialThemeScope.Theme>
</Application>
