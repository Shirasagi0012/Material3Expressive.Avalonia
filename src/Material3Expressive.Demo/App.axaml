<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Material3Expressive.Demo.App"
             xmlns:local="using:Material3Expressive.Demo"
             xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <m3:MaterialStyles />
        <FluentTheme />
    </Application.Styles>
    
    <m3:MaterialTheme.Theme>
        <m3:MaterialTheme 
            ColorScheme="{m3:TonalSpotScheme {DynamicResource SystemAccentColor}}"
            TypographyScheme="{m3:Typography}"/>
    </m3:MaterialTheme.Theme>
</Application>
