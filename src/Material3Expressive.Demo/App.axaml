<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Material3Expressive.Demo.App"
             xmlns:local="using:Material3Expressive.Demo"
             xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
             xmlns:mcu="https://github.com/Shirasagi0012/MaterialColorUtilities.Avalonia"
             xmlns:foundation="clr-namespace:Material3Expressive.Foundation;assembly=Material3Expressive"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <m3:MaterialStyles />
    </Application.Styles>
    
    <!-- Component tokens default to system-role references, so a theme only has to name its
         colour scheme; the button's container follows Primary, its label OnPrimary, and both
         re-resolve on a light/dark switch with no wiring here.
         A literal seed rather than {DynamicResource SystemAccentColor}, so the gallery's swatches
         can reseed the live scheme without a resource binding overwriting them again. -->
    <foundation:MaterialThemeScope.Theme>
        <foundation:MaterialTheme ColorScheme="{mcu:TonalSpotScheme '#6750A4'}">
            <foundation:MaterialTheme.TypographyScheme>
                <foundation:TypographyScheme
                    BrandFontFamily="fonts:Roboto#Roboto"
                    PlainFontFamily="fonts:Roboto#Roboto"
                    EmphasizedBrandFontFamily="fonts:Roboto#Roboto"
                    EmphasizedPlainFontFamily="fonts:Roboto#Roboto" />
            </foundation:MaterialTheme.TypographyScheme>
        </foundation:MaterialTheme>
    </foundation:MaterialThemeScope.Theme>
</Application>
