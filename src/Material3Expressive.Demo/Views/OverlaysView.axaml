<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
             xmlns:mcu="https://github.com/Shirasagi0012/MaterialColorUtilities.Avalonia"
             x:Class="Material3Expressive.Demo.Views.OverlaysView">
    <Panel>
        <ScrollViewer Padding="32">
            <StackPanel Spacing="32">

                <StackPanel Spacing="4">
                    <TextBlock Classes="headline-medium" Text="Overlays" />
                    <TextBlock Classes="body-medium"
                               Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                               Text="Dialogs, sheets and snackbars live in the tree rather than in windows of their own, so they share a layout with the content they cover and stay inside whatever theme scope they were declared in." />
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Classes="title-medium" Text="Dialog and bottom sheet" />
                    <TextBlock Classes="body-small"
                               Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                               Text="The dialog scales up from 90% as its scrim fades in, from one spring. The sheet can be dragged by its handle — let go past 40% and it keeps going." />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <m3:MaterialButton Variant="Filled" Content="Show dialog" Click="OnShowDialog" />
                        <m3:MaterialButton Variant="Tonal" Content="Show sheet" Click="OnShowSheet" />
                        <m3:MaterialButton Variant="Outlined" Content="Show snackbar" Click="OnShowSnackbar" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Classes="title-medium" Text="Badges" />
                    <TextBlock Classes="body-small"
                               Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                               Text="A small badge says only that something happened; a large one says how much." />
                    <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                        <m3:MaterialBadge Variant="Small" />
                        <m3:MaterialBadge Count="3" />
                        <m3:MaterialBadge Count="128" />
                        <m3:MaterialBadge Count="999+" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Classes="title-medium" Text="Tooltips and menus" />
                    <TextBlock Classes="body-small"
                               Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                               Text="The tooltip attaches to a control rather than wrapping it, so it does not change the layout. The menu is a restyle of Avalonia's, which already handles keyboard navigation, submenus and placement — Material only changes how it looks." />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <m3:MaterialButton Variant="Tonal" Content="Hover me"
                                           m3:MaterialTooltip.Tip="Archives the conversation" />
                        <m3:MaterialButton Variant="Tonal" Content="Rich tooltip"
                                           m3:MaterialTooltip.Variant="Rich"
                                           m3:MaterialTooltip.Tip="Moves this to the archive, where it stays searchable." />
                        <Button Content="Open menu">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="Cut" />
                                    <MenuItem Header="Copy" />
                                    <Separator />
                                    <MenuItem Header="Paste" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- The overlays sit above the page, inside the same panel. -->
        <m3:MaterialSnackbar x:Name="Snackbar"
                             Message="Conversation archived"
                             Action="Undo"
                             Margin="0,0,0,24"
                             VerticalAlignment="Bottom" />

        <m3:MaterialBottomSheet x:Name="Sheet">
            <StackPanel Margin="24,0,24,32" Spacing="8">
                <TextBlock Classes="title-large" Text="Share" />
                <TextBlock Classes="body-medium"
                           Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                           Text="Drag the handle at the top of this sheet, or tap outside it." />
            </StackPanel>
        </m3:MaterialBottomSheet>

        <m3:MaterialDialog x:Name="Dialog">
            <StackPanel Spacing="16">
                <TextBlock Classes="headline-small" Text="Delete this draft?" />
                <TextBlock Classes="body-medium" TextWrapping="Wrap"
                           Text="The draft and everything in it will be removed. This cannot be undone." />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <m3:MaterialButton Variant="Text" Content="Cancel" Click="OnCloseDialog" />
                    <m3:MaterialButton Variant="Filled" Content="Delete" Click="OnCloseDialog" />
                </StackPanel>
            </StackPanel>
        </m3:MaterialDialog>
    </Panel>
</UserControl>
