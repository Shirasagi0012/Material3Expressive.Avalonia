<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Material3Expressive.Demo.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
             xmlns:mcu="https://github.com/Shirasagi0012/MaterialColorUtilities.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Material3Expressive.Demo.Views.TypographyView"
             x:DataType="vm:MainWindowViewModel">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <StackPanel Margin="24" Spacing="16">
        <TextBlock Text="TextBlock Style Validation"
                   Foreground="{mcu:MdSysColor OnBackground}"/>

        <ComboBox Width="320"
                  ItemsSource="{Binding TextStyles}"
                  SelectedItem="{Binding SelectedTextStyle}" />

        <TextBlock Text="{Binding SelectedTextStyle}"
                   Foreground="{mcu:MdSysColor OnBackground}" />

        <TextBlock Foreground="{mcu:MdSysColor OnBackground}"
                   Text="{Binding Greeting}"
                   m3:TypographyScheme.TextStyle="{Binding SelectedTextStyle}" />
    </StackPanel>

</UserControl>
