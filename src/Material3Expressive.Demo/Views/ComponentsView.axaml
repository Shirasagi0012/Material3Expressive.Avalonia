<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
             xmlns:mcu="https://github.com/Shirasagi0012/MaterialColorUtilities.Avalonia"
             xmlns:ms="using:MaterialSymbols.Avalonia"
             x:Class="Material3Expressive.Demo.Views.ComponentsView">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="32">

            <!-- Icon button -->
            <StackPanel Spacing="12">
                <TextBlock Classes="headline-medium" Text="Icon button" />
                <TextBlock Classes="body-medium"
                           Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                           Text="Four variants, five sizes and three widths, all independent axes." />

                <TextBlock Classes="title-small" Text="Variants" />
                <WrapPanel ItemSpacing="12" LineSpacing="12">
                    <m3:MaterialIconButton Variant="Standard">
                        <ms:MaterialSymbol Symbol="Star" />
                    </m3:MaterialIconButton>
                    <m3:MaterialIconButton Variant="Filled">
                        <ms:MaterialSymbol Symbol="Star" />
                    </m3:MaterialIconButton>
                    <m3:MaterialIconButton Variant="Tonal">
                        <ms:MaterialSymbol Symbol="Star" />
                    </m3:MaterialIconButton>
                    <m3:MaterialIconButton Variant="Outlined">
                        <ms:MaterialSymbol Symbol="Star" />
                    </m3:MaterialIconButton>
                    <m3:MaterialIconButton Variant="Filled" IsEnabled="False">
                        <ms:MaterialSymbol Symbol="Star" />
                    </m3:MaterialIconButton>
                </WrapPanel>

                <TextBlock Classes="title-small" Text="Sizes, and square containers" />
                <WrapPanel ItemSpacing="12" LineSpacing="12" VerticalAlignment="Center">
                    <m3:MaterialIconButton Variant="Filled" Size="ExtraSmall">
                        <ms:MaterialSymbol Symbol="Edit" />
                    </m3:MaterialIconButton>
                    <m3:MaterialIconButton Variant="Filled" Size="Small">
                        <ms:MaterialSymbol Symbol="Edit" />
                    </m3:MaterialIconButton>
                    <m3:MaterialIconButton Variant="Filled" Size="Medium">
                        <ms:MaterialSymbol Symbol="Edit" />
                    </m3:MaterialIconButton>
                    <m3:MaterialIconButton Variant="Tonal" Size="Medium" IsSquare="True">
                        <ms:MaterialSymbol Symbol="Edit" />
                    </m3:MaterialIconButton>
                    <m3:MaterialIconButton Variant="Filled" Size="Large">
                        <ms:MaterialSymbol Symbol="Edit" />
                    </m3:MaterialIconButton>
                </WrapPanel>

                <TextBlock Classes="title-small" Text="Widths" />
                <WrapPanel ItemSpacing="12" LineSpacing="12">
                    <m3:MaterialIconButton Variant="Tonal" Size="Medium" ButtonWidth="Narrow">
                        <ms:MaterialSymbol Symbol="Close" />
                    </m3:MaterialIconButton>
                    <m3:MaterialIconButton Variant="Tonal" Size="Medium" ButtonWidth="Default">
                        <ms:MaterialSymbol Symbol="Close" />
                    </m3:MaterialIconButton>
                    <m3:MaterialIconButton Variant="Tonal" Size="Medium" ButtonWidth="Wide">
                        <ms:MaterialSymbol Symbol="Close" />
                    </m3:MaterialIconButton>
                </WrapPanel>
            </StackPanel>

            <!-- Toggles -->
            <StackPanel Spacing="12">
                <TextBlock Classes="headline-medium" Text="Toggles" />
                <TextBlock Classes="body-medium"
                           Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                           Text="Checking a toggle swaps its shape as well as its colours — a round button squares off, and back. It is the same spring morph as the press, so interrupting it mid-flight reverses rather than restarting." />
                <WrapPanel ItemSpacing="12" LineSpacing="12" VerticalAlignment="Center">
                    <m3:MaterialToggleButton Variant="Filled">Filled</m3:MaterialToggleButton>
                    <m3:MaterialToggleButton Variant="Tonal" IsChecked="True">Tonal</m3:MaterialToggleButton>
                    <m3:MaterialToggleButton Variant="Outlined">Outlined</m3:MaterialToggleButton>
                    <m3:MaterialToggleIconButton Variant="Standard">
                        <ms:MaterialSymbol Symbol="Star" />
                    </m3:MaterialToggleIconButton>
                    <m3:MaterialToggleIconButton Variant="Filled" IsChecked="True">
                        <ms:MaterialSymbol Symbol="Star" />
                    </m3:MaterialToggleIconButton>
                    <m3:MaterialToggleIconButton Variant="Outlined">
                        <ms:MaterialSymbol Symbol="Star" />
                    </m3:MaterialToggleIconButton>
                </WrapPanel>
            </StackPanel>

            <!-- FAB -->
            <StackPanel Spacing="12">
                <TextBlock Classes="headline-medium" Text="Floating action button" />
                <TextBlock Classes="body-medium"
                           Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                           Text="Extended and unextended are one control: setting a label extends it." />
                <WrapPanel ItemSpacing="16" LineSpacing="16" VerticalAlignment="Center">
                    <m3:MaterialFab>
                        <ms:MaterialSymbol Symbol="Add" />
                    </m3:MaterialFab>
                    <m3:MaterialFab Size="Medium" Variant="Secondary">
                        <ms:MaterialSymbol Symbol="Add" />
                    </m3:MaterialFab>
                    <m3:MaterialFab Size="Large" Variant="Tertiary">
                        <ms:MaterialSymbol Symbol="Add" />
                    </m3:MaterialFab>
                    <m3:MaterialFab Variant="Surface" Label="Compose">
                        <ms:MaterialSymbol Symbol="Edit" />
                    </m3:MaterialFab>
                    <m3:MaterialFab Label="Lowered" IsLowered="True">
                        <ms:MaterialSymbol Symbol="Edit" />
                    </m3:MaterialFab>
                </WrapPanel>

                <TextBlock Classes="title-small" Text="FAB menu" />
                <TextBlock Classes="body-small"
                           Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                           Text="Items arrive in sequence rather than together, read off one spring at staggered offsets — so closing halfway through opening unwinds in the right order." />
                <Border Height="300" Padding="16" CornerRadius="16"
                        Background="{mcu:MdSysColor SurfaceContainer}"
                        HorizontalAlignment="Left" Width="320">
                    <m3:MaterialFabMenu>
                        <m3:MaterialFabMenu.Icon>
                            <ms:MaterialSymbol Symbol="Add" />
                        </m3:MaterialFabMenu.Icon>
                        <m3:MaterialFab Label="Reply">
                            <ms:MaterialSymbol Symbol="Reply" />
                        </m3:MaterialFab>
                        <m3:MaterialFab Label="Star">
                            <ms:MaterialSymbol Symbol="Star" />
                        </m3:MaterialFab>
                        <m3:MaterialFab Label="Dismiss">
                            <ms:MaterialSymbol Symbol="Close" />
                        </m3:MaterialFab>
                    </m3:MaterialFabMenu>
                </Border>
            </StackPanel>

            <!-- Selection -->
            <StackPanel Spacing="12">
                <TextBlock Classes="headline-medium" Text="Selection" />
                <TextBlock Classes="body-medium"
                           Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                           Text="The switch runs two springs: the handle slides along the track, and its size changes separately — 16dp off, 24dp on, 28dp while held. Press and hold one to see them come apart." />
                <WrapPanel ItemSpacing="32" LineSpacing="12">
                    <StackPanel Spacing="8">
                        <m3:MaterialCheckbox Content="Unchecked" />
                        <m3:MaterialCheckbox Content="Checked" IsChecked="True" />
                        <m3:MaterialCheckbox Content="Indeterminate" IsThreeState="True" IsChecked="{x:Null}" />
                        <m3:MaterialCheckbox Content="Error" IsError="True" />
                        <m3:MaterialCheckbox Content="Disabled" IsChecked="True" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <m3:MaterialRadioButton GroupName="demo" Content="First" IsChecked="True" />
                        <m3:MaterialRadioButton GroupName="demo" Content="Second" />
                        <m3:MaterialRadioButton GroupName="demo" Content="Third" />
                        <m3:MaterialRadioButton Content="Disabled" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <m3:MaterialSwitch Content="Off" />
                        <m3:MaterialSwitch Content="On" IsChecked="True" />
                        <m3:MaterialSwitch Content="Disabled, off" IsEnabled="False" />
                        <m3:MaterialSwitch Content="Disabled, on" IsChecked="True" IsEnabled="False" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>

            <!-- Text fields -->
            <StackPanel Spacing="12">
                <TextBlock Classes="headline-medium" Text="Text field" />
                <TextBlock Classes="body-medium"
                           Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                           Text="The label is the component. Click into one and watch it travel to the top edge and shrink — one sprung fraction drives its position, size and colour together, so clicking away mid-float reverses instead of snapping. The outlined variant notches its border to let the label through." />
                <StackPanel Spacing="20" MaxWidth="320" HorizontalAlignment="Left">
                    <m3:MaterialTextField Label="Name" />
                    <m3:MaterialTextField Label="Email" Text="ada@example.com"
                                          SupportingText="We will not share this." />
                    <m3:MaterialTextField Label="Full name" Variant="Outlined" />
                    <m3:MaterialTextField Label="Password" Variant="Outlined" IsError="True"
                                          SupportingText="Must be at least 12 characters." />
                    <m3:MaterialTextField Label="Read only" Variant="Outlined" Text="Locked" IsEnabled="False" />
                </StackPanel>
            </StackPanel>

            <!-- Grouped buttons -->
            <StackPanel Spacing="12">
                <TextBlock Classes="headline-medium" Text="Grouped buttons" />
                <TextBlock Classes="body-medium"
                           Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                           Text="A connected group keeps the row's outer corners round and tightens the ones where segments meet — something no button can work out about itself, which is why the group is a panel and not a StackPanel with a margin." />
                <StackPanel Spacing="16" HorizontalAlignment="Left">
                    <m3:MaterialButtonGroup Variant="Connected">
                        <m3:MaterialToggleButton Variant="Tonal" Content="Day" IsChecked="True" />
                        <m3:MaterialToggleButton Variant="Tonal" Content="Week" />
                        <m3:MaterialToggleButton Variant="Tonal" Content="Month" />
                        <m3:MaterialToggleButton Variant="Tonal" Content="Year" />
                    </m3:MaterialButtonGroup>
                    <m3:MaterialButtonGroup Variant="Standard">
                        <m3:MaterialButton Variant="Outlined" Content="Cancel" />
                        <m3:MaterialButton Variant="Filled" Content="Confirm" />
                    </m3:MaterialButtonGroup>
                    <m3:MaterialSplitButton Content="Save">
                        <m3:MaterialSplitButton.TrailingIcon>
                            <ms:MaterialSymbol Symbol="ArrowDropDown" />
                        </m3:MaterialSplitButton.TrailingIcon>
                    </m3:MaterialSplitButton>
                </StackPanel>
            </StackPanel>

            <!-- Chips -->
            <StackPanel Spacing="12">
                <TextBlock Classes="headline-medium" Text="Chips" />
                <TextBlock Classes="body-medium"
                           Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                           Text="Four kinds that differ in what they mean rather than how they behave. Selecting one fills it, drops its outline and rounds it fully — the same spring morph the buttons use." />
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                    <m3:MaterialChip Variant="Assist" Content="Assist">
                        <m3:MaterialChip.LeadingIcon>
                            <ms:MaterialSymbol Symbol="Star" />
                        </m3:MaterialChip.LeadingIcon>
                    </m3:MaterialChip>
                    <m3:MaterialChip Variant="Filter" Content="Filter" />
                    <m3:MaterialChip Variant="Filter" Content="Selected" IsChecked="True" />
                    <m3:MaterialChip Variant="Input" Content="Input">
                        <m3:MaterialChip.TrailingIcon>
                            <ms:MaterialSymbol Symbol="Close" />
                        </m3:MaterialChip.TrailingIcon>
                    </m3:MaterialChip>
                    <m3:MaterialChip Variant="Suggestion" Content="Suggestion" />
                    <m3:MaterialChip Variant="Assist" Content="Disabled" IsEnabled="False" />
                </WrapPanel>
            </StackPanel>

            <!-- Slider -->
            <StackPanel Spacing="12">
                <TextBlock Classes="headline-medium" Text="Slider" />
                <TextBlock Classes="body-medium"
                           Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                           Text="Expressive replaced the round thumb with a tall bar and thickened the track to 16dp. Drag one: the handle narrows to 2dp while held, so the value under it stays visible." />
                <StackPanel Spacing="8" MaxWidth="420" HorizontalAlignment="Left">
                    <m3:MaterialSlider Value="0.3" />
                    <m3:MaterialSlider Value="0.75" />
                    <m3:MaterialSlider Value="0.5" IsEnabled="False" />
                </StackPanel>
            </StackPanel>

            <!-- Progress -->
            <StackPanel Spacing="12">
                <TextBlock Classes="headline-medium" Text="Progress" />
                <TextBlock Classes="body-medium"
                           Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                           Text="Expressive separates the active indicator from the track and marks the far end with a stop dot. The wavy form is the same indicator drawn along a travelling sine." />
                <StackPanel Spacing="16" MaxWidth="420" HorizontalAlignment="Left">
                    <m3:MaterialLinearProgressIndicator Value="0.35" />
                    <m3:MaterialLinearProgressIndicator Value="0.7" IsWavy="True" />
                    <m3:MaterialLinearProgressIndicator IsIndeterminate="True" />
                    <m3:MaterialLinearProgressIndicator IsIndeterminate="True" IsWavy="True" />
                    <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                        <m3:MaterialCircularProgressIndicator Value="0.35" />
                        <m3:MaterialCircularProgressIndicator Value="0.75" />
                        <m3:MaterialCircularProgressIndicator IsIndeterminate="True" />
                        <m3:MaterialLoadingIndicator />
                        <m3:MaterialLoadingIndicator Variant="Contained" />
                    </StackPanel>
                    <TextBlock Classes="body-small"
                               Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                               Text="The last two are the loading indicator — the one component that genuinely morphs polygons, cycling the Material shape catalog while it turns." />
                </StackPanel>
            </StackPanel>

            <!-- Card -->
            <StackPanel Spacing="12">
                <TextBlock Classes="headline-medium" Text="Card" />
                <TextBlock Classes="body-medium"
                           Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                           Text="A card is inert until it is told it is clickable — Material only gives it a state layer when it is genuinely actionable." />
                <WrapPanel ItemSpacing="16" LineSpacing="16">
                    <m3:MaterialCard Variant="Elevated" Width="200" Height="120">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Classes="title-medium" Text="Elevated" />
                            <TextBlock Classes="body-small" Text="Surface container low, level 1." />
                        </StackPanel>
                    </m3:MaterialCard>
                    <m3:MaterialCard Variant="Filled" Width="200" Height="120">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Classes="title-medium" Text="Filled" />
                            <TextBlock Classes="body-small" Text="Surface container highest, flat." />
                        </StackPanel>
                    </m3:MaterialCard>
                    <m3:MaterialCard Variant="Outlined" Width="200" Height="120">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Classes="title-medium" Text="Outlined" />
                            <TextBlock Classes="body-small" Text="Surface behind a hairline." />
                        </StackPanel>
                    </m3:MaterialCard>
                    <m3:MaterialCard Variant="Elevated" IsClickable="True" Width="200" Height="120">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Classes="title-medium" Text="Clickable" />
                            <TextBlock Classes="body-small" Text="Hover and press me." />
                        </StackPanel>
                    </m3:MaterialCard>
                </WrapPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
