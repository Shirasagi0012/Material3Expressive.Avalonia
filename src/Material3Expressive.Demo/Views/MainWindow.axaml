<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Material3Expressive.Demo.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Material3Expressive.Demo.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        xmlns:m3t="using:Material3Expressive.Themes"
        xmlns:mcu="clr-namespace:MaterialColorUtilities.Avalonia;assembly=MaterialColorUtilities.Avalonia"
        Icon="/Assets/avalonia-logo.ico"
        Title="Material3Expressive.Demo"
        Background="{mcu:MdSysColor Background}">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <TextBlock Foreground="{mcu:MdSysColor OnBackground}" 
               Text="{Binding Greeting}" 
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />

</Window>
