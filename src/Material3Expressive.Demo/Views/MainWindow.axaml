<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:Material3Expressive.Demo.Views"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
        xmlns:mcu="https://github.com/Shirasagi0012/MaterialColorUtilities.Avalonia"
        mc:Ignorable="d"
        d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="Material3Expressive.Demo.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="Material 3 Expressive Playground"
        Width="1440" Height="900" MinWidth="1080" MinHeight="680"
        Background="{mcu:MdSysColor Surface}">

    <Grid ColumnDefinitions="248,*,300">
        <!-- The gallery navigation deliberately describes intent, not control names. -->
        <Border Grid.Column="0" Background="{mcu:MdSysColor SurfaceContainerLow}">
            <DockPanel Margin="12,20">
                <StackPanel DockPanel.Dock="Bottom" Spacing="12">
                    <Border Padding="16" CornerRadius="20" Background="{mcu:MdSysColor SecondaryContainer}">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="label-large" Text="BUILD WITH IT" />
                            <TextBlock Classes="body-small" TextWrapping="Wrap"
                                       Text="Every example is a real Avalonia control — interact with it, then make it yours." />
                            <m3:MaterialButton Variant="Text" Size="Small" HorizontalAlignment="Left">View source</m3:MaterialButton>
                        </StackPanel>
                    </Border>
                    <TextBlock Classes="label-medium" Foreground="{mcu:MdSysColor OnSurfaceVariant}" Text="APPEARANCE" Margin="12,0,0,0" />
                    <ToggleSwitch x:Name="DarkToggle" Content="Dark theme" IsCheckedChanged="OnDarkToggled" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <StackPanel Margin="12,0,12,18" Spacing="2">
                        <TextBlock Classes="headline-small" Text="Material 3" />
                        <TextBlock Classes="title-medium" Foreground="{mcu:MdSysColor Primary}" Text="Expressive" />
                    </StackPanel>

                    <TextBox PlaceholderText="Search the gallery" Margin="0,0,0,10" />

                    <TextBlock Classes="label-medium" Foreground="{mcu:MdSysColor OnSurfaceVariant}" Text="EXPLORE" Margin="12,0,0,2" />
                    <ListBox x:Name="Pages" SelectedIndex="0" Background="Transparent" SelectionChanged="OnPageChanged">
                        <ListBoxItem Content="Overview" />
                        <ListBoxItem Content="Buttons &amp; actions" />
                        <ListBoxItem Content="Inputs &amp; surfaces" />
                        <ListBoxItem Content="Navigation patterns" />
                        <ListBoxItem Content="Overlays &amp; feedback" />
                        <ListBoxItem Content="Type &amp; foundations" />
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" BorderBrush="{mcu:MdSysColor OutlineVariant}" BorderThickness="0,0,1,0">
            <ContentControl x:Name="PageHost">
                <views:GalleryHomeView />
            </ContentControl>
        </Border>

        <!-- A permanent inspector makes the gallery useful as a design workbench. -->
        <Border Grid.Column="2" Background="{mcu:MdSysColor SurfaceContainerLowest}">
            <ScrollViewer Padding="20">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="label-medium" Foreground="{mcu:MdSysColor OnSurfaceVariant}" Text="LIVE INSPECTOR" />
                        <TextBlock Classes="title-large" Text="Theme lab" />
                        <TextBlock Classes="body-small" Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                                   TextWrapping="Wrap" Text="Tune the gallery while you browse. Every color role updates from a single seed." />
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock Classes="title-small" Text="Color seed" />
                        <WrapPanel ItemSpacing="10" LineSpacing="10">
                            <Button Tag="#6750A4" Click="OnSeedChosen" Background="#6750A4" Width="42" Height="42" CornerRadius="21" ToolTip.Tip="Purple" />
                            <Button Tag="#006874" Click="OnSeedChosen" Background="#006874" Width="42" Height="42" CornerRadius="21" ToolTip.Tip="Teal" />
                            <Button Tag="#3E6837" Click="OnSeedChosen" Background="#3E6837" Width="42" Height="42" CornerRadius="21" ToolTip.Tip="Green" />
                            <Button Tag="#B3261E" Click="OnSeedChosen" Background="#B3261E" Width="42" Height="42" CornerRadius="21" ToolTip.Tip="Red" />
                            <Button Tag="#8F4C38" Click="OnSeedChosen" Background="#8F4C38" Width="42" Height="42" CornerRadius="21" ToolTip.Tip="Terracotta" />
                        </WrapPanel>
                    </StackPanel>

                    <Border Padding="16" CornerRadius="20" Background="{mcu:MdSysColor SurfaceContainerHigh}">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="title-small" Text="Preview modes" />
                            <m3:MaterialToggleButton Variant="Tonal" IsChecked="True">Desktop</m3:MaterialToggleButton>
                            <m3:MaterialToggleButton Variant="Outlined">Tablet</m3:MaterialToggleButton>
                            <m3:MaterialToggleButton Variant="Outlined">Mobile</m3:MaterialToggleButton>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="10">
                        <TextBlock Classes="title-small" Text="What you’re seeing" />
                        <Border Padding="14" CornerRadius="16" BorderBrush="{mcu:MdSysColor OutlineVariant}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="label-large" Foreground="{mcu:MdSysColor Primary}" Text="PATTERN SHOWCASE" />
                                <TextBlock Classes="body-small" TextWrapping="Wrap" Text="Realistic compositions reveal spacing, hierarchy and state changes better than an isolated control grid." />
                            </StackPanel>
                        </Border>
                        <Border Padding="14" CornerRadius="16" BorderBrush="{mcu:MdSysColor OutlineVariant}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="label-large" Foreground="{mcu:MdSysColor Primary}" Text="COMPONENT CATALOG" />
                                <TextBlock Classes="body-small" TextWrapping="Wrap" Text="Use the pages on the left to inspect all variants, sizes, states and expressive motion." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
