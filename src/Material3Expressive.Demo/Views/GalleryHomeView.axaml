<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
             xmlns:mcu="https://github.com/Shirasagi0012/MaterialColorUtilities.Avalonia"
             xmlns:ms="using:MaterialSymbols.Avalonia"
             x:Class="Material3Expressive.Demo.Views.GalleryHomeView">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7655C7" Offset="0" />
            <GradientStop Color="#A68BE0" Offset="0.52" />
            <GradientStop Color="#E9DDFF" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <ScrollViewer Padding="32,28,36,48">
        <StackPanel Spacing="28">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                <StackPanel Spacing="8">
                    <TextBlock Classes="label-large" Foreground="{mcu:MdSysColor Primary}" Text="MATERIAL 3 EXPRESSIVE FOR AVALONIA" />
                    <TextBlock Classes="display-small" Text="Build interfaces with a pulse." />
                    <TextBlock Classes="body-large" MaxWidth="630" TextWrapping="Wrap"
                               Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                               Text="Explore Material components in the places they belong: delightful, responsive product patterns — not a wall of disconnected controls." />
                </StackPanel>
                <Border Width="118" Height="118" CornerRadius="36" Background="{StaticResource HeroGradient}" BoxShadow="0 12 24 0 #2A000000">
                    <ms:MaterialSymbol Width="54"
                                       Height="54"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Symbol="AutoAwesome"
                                       Foreground="#FFFFFF" />
                </Border>
            </Grid>

            <WrapPanel ItemSpacing="12" LineSpacing="12">
                <m3:MaterialButton Variant="Filled">Start exploring</m3:MaterialButton>
                <m3:MaterialButton Variant="Outlined">Copy a pattern</m3:MaterialButton>
                <m3:MaterialChip Variant="Suggestion" Content="58 interactive components" />
                <m3:MaterialChip Variant="Suggestion" Content="Dynamic color" />
            </WrapPanel>

            <Grid ColumnDefinitions="1.18*,*" ColumnSpacing="20">
                <!-- A product-shaped example gives users a richer first impression than a catalog. -->
                <m3:MaterialCard Grid.Column="0" Variant="Elevated" Padding="0" MinHeight="315">
                    <Grid RowDefinitions="148,*">
                        <Border Grid.Row="0" CornerRadius="24,24,0,0" Background="{StaticResource HeroGradient}">
                            <Grid Margin="22">
                                <TextBlock Classes="label-large" Text="NOW PLAYING" Foreground="#FFFFFF" VerticalAlignment="Top" />
                                <ms:MaterialSymbol Width="82"
                                                   Height="82"
                                                   Symbol="Orbit"
                                                   Opacity="0.34"
                                                   Foreground="#FFFFFF"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" Margin="22" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,*" ColumnSpacing="16">
                            <TextBlock Classes="title-large" Text="Orbiting" />
                            <TextBlock Grid.Row="1" Classes="body-medium" Foreground="{mcu:MdSysColor OnSurfaceVariant}" Text="Hana Vu · Halo" />
                            <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <m3:MaterialIconButton Variant="Standard"><ms:MaterialSymbol Symbol="Favorite" /></m3:MaterialIconButton>
                                <m3:MaterialIconButton Variant="Filled"><ms:MaterialSymbol Symbol="PlayArrow" /></m3:MaterialIconButton>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,18,0,0" Spacing="8">
                                <m3:MaterialLinearProgressIndicator Value="0.62" IsWavy="True" />
                                <Grid ColumnDefinitions="Auto,*,Auto"><TextBlock Classes="label-small" Text="1:42" /><TextBlock Grid.Column="2" Classes="label-small" Text="3:12" /></Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </m3:MaterialCard>

                <m3:MaterialCard Grid.Column="1" Variant="Filled" Padding="22" MinHeight="315">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3"><TextBlock Classes="title-large" Text="Today’s focus" /><TextBlock Classes="body-small" Foreground="{mcu:MdSysColor OnSurfaceVariant}" Text="3 of 5 tasks complete" /></StackPanel>
                            <Border Grid.Column="1" Background="{mcu:MdSysColor PrimaryContainer}" CornerRadius="16" Padding="10,6"><TextBlock Classes="label-large" Text="60%" /></Border>
                        </Grid>
                        <Border Background="{mcu:MdSysColor SurfaceContainerLowest}" CornerRadius="16" Padding="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <m3:MaterialCheckbox IsChecked="True" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock Classes="title-small" Text="Refine expressive motion" /><TextBlock Classes="body-small" Foreground="{mcu:MdSysColor OnSurfaceVariant}" Text="Design system" /></StackPanel>
                                <TextBlock Grid.Column="2" Classes="label-medium" Foreground="{mcu:MdSysColor Primary}" VerticalAlignment="Center" Text="Today" />
                            </Grid>
                        </Border>
                        <Border Background="{mcu:MdSysColor SurfaceContainerLowest}" CornerRadius="16" Padding="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <m3:MaterialCheckbox VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock Classes="title-small" Text="Review component states" /><TextBlock Classes="body-small" Foreground="{mcu:MdSysColor OnSurfaceVariant}" Text="Engineering" /></StackPanel>
                                <TextBlock Grid.Column="2" Classes="label-medium" Foreground="{mcu:MdSysColor OnSurfaceVariant}" VerticalAlignment="Center" Text="Tomorrow" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </m3:MaterialCard>
            </Grid>

            <StackPanel Spacing="4">
                <TextBlock Classes="headline-small" Text="Explore by experience" />
                <TextBlock Classes="body-medium" Foreground="{mcu:MdSysColor OnSurfaceVariant}" Text="Start with a complete interaction, then drill into the parts that make it work." />
            </StackPanel>

            <WrapPanel ItemWidth="230" ItemHeight="174" ItemSpacing="16" LineSpacing="16">
                <m3:MaterialCard Variant="Outlined" IsClickable="True" Padding="18">
                    <StackPanel Spacing="10">
                        <Border Width="42"
                                Height="42"
                                CornerRadius="14"
                                Background="{mcu:MdSysColor PrimaryContainer}">
                            <ms:MaterialSymbol HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Symbol="Palette"
                                               Foreground="{mcu:MdSysColor OnPrimaryContainer}" />
                        </Border>
                        <TextBlock Classes="title-medium" Text="Foundations" />
                        <TextBlock Classes="body-small"
                                   TextWrapping="Wrap"
                                   Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                                   Text="Color roles, type scale, shape and elevation." />
                    </StackPanel>
                </m3:MaterialCard>
                <m3:MaterialCard Variant="Outlined" IsClickable="True" Padding="18">
                    <StackPanel Spacing="10">
                        <Border Width="42"
                                Height="42"
                                CornerRadius="14"
                                Background="{mcu:MdSysColor SecondaryContainer}">
                            <ms:MaterialSymbol HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Symbol="Widgets"
                                               Foreground="{mcu:MdSysColor OnSecondaryContainer}" />
                        </Border>
                        <TextBlock Classes="title-medium" Text="Components" />
                        <TextBlock Classes="body-small"
                                   TextWrapping="Wrap"
                                   Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                                   Text="States, sizes and expressive variants." />
                    </StackPanel>
                </m3:MaterialCard>
                <m3:MaterialCard Variant="Outlined" IsClickable="True" Padding="18">
                    <StackPanel Spacing="10">
                        <Border Width="42"
                                Height="42"
                                CornerRadius="14"
                                Background="{mcu:MdSysColor TertiaryContainer}">
                            <ms:MaterialSymbol HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Symbol="Schema"
                                               Foreground="{mcu:MdSysColor OnTertiaryContainer}" />
                        </Border>
                        <TextBlock Classes="title-medium" Text="Patterns" />
                        <TextBlock Classes="body-small"
                                   TextWrapping="Wrap"
                                   Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                                   Text="Production-shaped flows to adapt directly." />
                    </StackPanel>
                </m3:MaterialCard>
                <m3:MaterialCard Variant="Outlined" IsClickable="True" Padding="18">
                    <StackPanel Spacing="10">
                        <Border Width="42"
                                Height="42"
                                CornerRadius="14"
                                Background="{mcu:MdSysColor ErrorContainer}">
                            <ms:MaterialSymbol HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Symbol="Animation"
                                               Foreground="{mcu:MdSysColor OnErrorContainer}" />
                        </Border>
                        <TextBlock Classes="title-medium" Text="Motion" />
                        <TextBlock Classes="body-small"
                                   TextWrapping="Wrap"
                                   Foreground="{mcu:MdSysColor OnSurfaceVariant}"
                                   Text="Springs, morphs and tactile feedback." />
                    </StackPanel>
                </m3:MaterialCard>
            </WrapPanel>

            <Border Padding="20" CornerRadius="24" Background="{mcu:MdSysColor InverseSurface}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="6"><TextBlock Classes="title-large" Foreground="{mcu:MdSysColor InverseOnSurface}" Text="Make the system unmistakably yours." /><TextBlock Classes="body-medium" Foreground="{mcu:MdSysColor InverseOnSurface}" Opacity="0.8" Text="Choose a seed in the inspector and watch every role recompose." /></StackPanel>
                    <m3:MaterialButton Grid.Column="1" Variant="Tonal" VerticalAlignment="Center">Open theme lab</m3:MaterialButton>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
