<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
        xmlns:sources="clr-namespace:Material3ExpressiveRefactor.Foundation.Tokens.Sources"
        xmlns:controls="clr-namespace:Material3ExpressiveRefactor.Controls"
        x:Class="Material3ExpressiveRefactor.Styles.MaterialTheme">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <m3:MaterialResource>
                    <sources:ColorScheme />
                    <sources:StateTokenSource />
                    <sources:ShapeTokenSource />
                    <sources:TypographyTokenSource />
                    <sources:ElevationTokenSource />
                    <sources:MotionTokenSource />

                    <controls:ButtonSizesTokenSource />
                    <controls:FilledButtonTokenSource />
                    <controls:ElevatedButtonTokenSource />
                    <controls:TonalButtonTokenSource />
                    <controls:OutlinedButtonTokenSource />
                    <controls:TextButtonTokenSource />
                </m3:MaterialResource>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    
    <StyleInclude Source="Button.axaml" />
</Styles>
