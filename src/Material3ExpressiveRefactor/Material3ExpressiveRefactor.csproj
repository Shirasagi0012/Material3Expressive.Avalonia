<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="PropertyGenerator.Avalonia"/>
        <!-- Direct API dependencies of the in-house symbol render stack
             (Foundation/Rendering/Symbols): ISkiaSharpApiLeaseFeature from Avalonia.Skia, the
             variable-font instancing API from SkiaSharp. They also flow transitively through
             MaterialSymbols.Avalonia; the explicit references keep that from being load-bearing. -->
        <PackageReference Include="Avalonia.Skia"/>
        <PackageReference Include="SkiaSharp"/>
    </ItemGroup>

    <ItemGroup Condition="'$(ContinuousIntegrationBuild)' != 'true'">
        <ProjectReference Include="..\..\modules\MaterialColorUtilities\MaterialColorUtilities\MaterialColorUtilities.csproj"/>
        <!-- LoadingIndicator is the one component that genuinely morphs polygons. Button, FAB and
             chip press morphs are corner-radius lerps, and the wavy progress indicator's wave is a
             sampled sine — none of them need this. -->
        <ProjectReference Include="..\..\modules\MaterialShapes\MaterialShapes\MaterialShapes.csproj"/>
        <!-- Material Symbols Rounded is the first-party icon family for Material 3 Expressive.
             It also moves the resolved render stack onto the repository's pinned SkiaSharp 4
             baseline so variable fill, weight, grade and optical size remain available. -->
        <ProjectReference Include="..\..\modules\MaterialSymbols\MaterialSymbols.Avalonia.Rounded\MaterialSymbols.Avalonia.Rounded.csproj"/>
    </ItemGroup>

    <ItemGroup Condition="'$(ContinuousIntegrationBuild)' == 'true'">
        <PackageReference Include="Shirasagi0012.MaterialColorUtilities" />
        <PackageReference Include="Shirasagi0012.MaterialShapes" />
        <PackageReference Include="Shirasagi0012.MaterialSymbols.Avalonia.Rounded" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Material3ExpressiveRefactor.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\modules\MaterialSkiaShadow\MaterialSkiaShadow.csproj"/>
        <!-- TokenGenerator is intentionally NOT referenced yet: token keys are hand-written
             (Tokens/MaterialTokens.cs) and no *.jsonc token tables exist here. The generator
             hard-requires a '*.canonical-tokens.json' AdditionalFile (M3ETOK005) whose owner is
             MaterialDesignTokens.Avalonia — the very dependency this project dropped. Re-add the
             analyzer together with a manifest AdditionalFile if/when jsonc-driven generation is
             adopted. -->
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Foundation\Interaction\" />
    </ItemGroup>
    
</Project>
