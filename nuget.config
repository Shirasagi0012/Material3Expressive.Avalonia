<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <add key="CommunityToolkit-Latest" value="https://pkgs.dev.azure.com/dotnet/CommunityToolkit/_packaging/CommunityToolkit-MainLatest/nuget/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/Shirasagi0012/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
    <packageSource key="CommunityToolkit-Latest">
      <package pattern="CommunityToolkit.*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Shirasagi0012.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
