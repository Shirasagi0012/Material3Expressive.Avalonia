<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <add key="shirasagi0012" value="https://nuget.pkg.github.com/Shirasagi0012/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="shirasagi0012">
      <package pattern="Shirasagi0012.*" />
    </packageSource>
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
