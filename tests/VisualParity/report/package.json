{
  "name": "material3-parity-report",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host localhost",
    "test": "vitest run",
    "format": "prettier --write src server tests vite.config.ts",
    "format:check": "prettier --check src server tests vite.config.ts"
  },
  "dependencies": {
    "fast-png": "8.0.0",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@vitejs/plugin-vue": "6.0.9",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
