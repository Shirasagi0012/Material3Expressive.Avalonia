<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
             x:Class="Material3Expressive.Tests.TokenOverrideXamlProbe">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <m3:FilledButtonTokensOverrides
            ContainerColor="#FFFF0000"
            LabelTextColor="{m3:TokenRef Token={x:Static m3:SystemColorTokens.Primary}}" />
        <m3:SystemTypeScaleOverrides
            Role="BodyLarge"
            FontSize="17.5"
            Weight="Bold" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
</UserControl>
